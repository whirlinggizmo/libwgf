wgf-scene 2
# The racer's things as data: the track (a glTF file, assets/track/track.glb, written by
# tools/gen_track.py), its surfaces' bodies and shadows, and its checkpoints; and the car,
# a prefab of generated meshes with its physics. Physics is started (Physics.setGravity)
# before this loads; the sun that casts is made in code (src/Main.hx: a scene has no light).

# The car: a dynamic box body with a vehicle on it (Jolt's wheeled vehicle), driven by
# src/Drive.hx's intent each tick. It faces +z, its origin the body's center. Each wheel is
# an axle the vehicle places, steers, and turns about its x each tick, with the tire's
# cylinder lying across it; left and right pairs, front first (left is +x, facing +z).
# The body's box is flat and its wheels attach near its middle, so its center of mass (the
# box's center: there is no offset to set) sits low between them and it doesn't roll over.
prefab car
  body type=dynamic shape=box size=1.9,0.4,4.0 mass=1200 layer=1
  vehicle wheels=wheel_fl,wheel_fr,wheel_rl,wheel_rr radius=0.36 width=0.26 suspension=0.25 stiffness=1.8 damping=0.5 steering=0.5 grip=1.5 engine_torque=550 max_rpm=7200 gears=3.2,2.1,1.5,1.15,0.92 drive=rear
  behavior name=Car
end
prefab car/body
  model cube=1.66,0.55,4.0 tint=#C8282C
  transform position=0,0.07,0
end
prefab car/cabin
  model cube=1.4,0.45,1.9 tint=#1E2630
  transform position=0,0.57,-0.3
end
prefab car/wing
  model cube=1.8,0.08,0.45 tint=#2A2A2A
  transform position=0,0.75,-1.85
end
prefab car/lamp_l
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=0.6,0.12,2.01
end
prefab car/lamp_r
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=-0.6,0.12,2.01
end
prefab car/wheel_fl
  transform position=1.0,-0.05,1.3
end
prefab car/wheel_fl/tire
  model cylinder=0.36,0.26,16 tint=#151515
  transform rotation=0,0,1.5708
end
prefab car/wheel_fr
  transform position=-1.0,-0.05,1.3
end
prefab car/wheel_fr/tire
  model cylinder=0.36,0.26,16 tint=#151515
  transform rotation=0,0,1.5708
end
prefab car/wheel_rl
  transform position=1.0,-0.05,-1.3
end
prefab car/wheel_rl/tire
  model cylinder=0.36,0.26,16 tint=#151515
  transform rotation=0,0,1.5708
end
prefab car/wheel_rr
  transform position=-1.0,-0.05,-1.3
end
prefab car/wheel_rr/tire
  model cylinder=0.36,0.26,16 tint=#151515
  transform rotation=0,0,1.5708
end

# A checkpoint: a sensor box across the track and its curbs at the line, its center 2 m up
# (offset: it is spawned under its gate, a node of assets/track/track.glb, on the road),
# meeting the car's layer. The gate's posts and banner are the track file's.
prefab checkpoint
  body type=sensor shape=box size=15,4,1 offset=0,2,0 layer=2 mask=1
  behavior name=Checkpoint
end

# The track: the file's nodes are these blocks (no actor made for them), applied once it has
# loaded. Each surface is a static body of its triangles, at its own friction. The flat
# surfaces receive shadows and cast none (a plane casting onto itself is only acne and a
# draw); the barriers and gates cast onto them, as the car does. Each gate's node has a
# block (empty: the file's as it is) so its checkpoint, a new actor, has a parent above it.
actor track
  model path="track/track.glb"
end
actor track/ground
  model cast_shadows=false
  body type=static shape=mesh friction=0.7
end
actor track/road
  model cast_shadows=false
  body type=static shape=mesh friction=1
end
actor track/road/curbs
  model cast_shadows=false
end
actor track/road/line
  model cast_shadows=false
end
actor track/barriers
  body type=static shape=mesh friction=0.3
end
actor track/gates
  body type=static shape=mesh friction=0.3
end
actor track/gates/gate_0
end
actor track/gates/gate_0/checkpoint
  from checkpoint
  behavior index=0
end
actor track/gates/gate_1
end
actor track/gates/gate_1/checkpoint
  from checkpoint
  behavior index=1
end
actor track/gates/gate_2
end
actor track/gates/gate_2/checkpoint
  from checkpoint
  behavior index=2
end
actor track/gates/gate_3
end
actor track/gates/gate_3/checkpoint
  from checkpoint
  behavior index=3
end
actor track/gates/gate_4
end
actor track/gates/gate_4/checkpoint
  from checkpoint
  behavior index=4
end
actor track/gates/gate_5
end
actor track/gates/gate_5/checkpoint
  from checkpoint
  behavior index=5
end
actor track/gates/gate_6
end
actor track/gates/gate_6/checkpoint
  from checkpoint
  behavior index=6
end
actor track/gates/gate_7
end
actor track/gates/gate_7/checkpoint
  from checkpoint
  behavior index=7
end
