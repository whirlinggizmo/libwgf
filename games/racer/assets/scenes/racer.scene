wgf-scene 2
# The car as data: a prefab of generated meshes with its physics (the track is
# scenes/track.scene and its sections, written by tools/gen_track.py). Physics is started
# (Physics.setGravity) before this loads; the sun that casts is made in code (src/Main.hx: a
# scene has no light).

# The car: a dynamic box body with a vehicle on it (Jolt's wheeled vehicle), driven by
# src/Drive.hx's intent each tick. It faces +z, its origin the body's center. Each wheel is
# an axle the vehicle places, steers, and turns about its x each tick, with the tire's
# cylinder lying across it; left and right pairs, front first (left is +x, facing +z).
# The body's box is flat and its wheels attach near its middle, so its center of mass (the
# box's center: there is no offset to set) sits low between them and it doesn't roll over.
prefab car
  body type=dynamic shape=box size=1.9,0.4,4.0 mass=1200 layer=1
  vehicle wheels=wheel_fl,wheel_fr,wheel_rl,wheel_rr radius=0.36 width=0.26 suspension=0.25 stiffness=1.8 damping=0.5 steering=0.5 grip=1.5 engine_torque=550 max_rpm=7200 gears=3.2,2.1,1.5,1.15,0.92 drive=rear
  behavior name=Car
end
prefab car/body
  model cube=1.66,0.55,4.0 tint=#C8282C
  transform position=0,0.07,0
end
prefab car/cabin
  model cube=1.4,0.45,1.9 tint=#1E2630
  transform position=0,0.57,-0.3
end
prefab car/wing
  model cube=1.8,0.08,0.45 tint=#2A2A2A
  transform position=0,0.75,-1.85
end
prefab car/lamp_l
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=0.6,0.12,2.01
end
prefab car/lamp_r
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=-0.6,0.12,2.01
end
# Tire smoke: an emitter behind each rear tire's contact patch, a little up, its rate set
# from that wheel's slip (src/Car.hx). Its curves: a puff fades in as it leaves the tire,
# grows fast and then slowly, and greys as it thins. They hang from the car, not the wheels: a wheel turns about its x each tick,
# and an emitter's particle velocity turns with its actor, so under a wheel they'd be
# thrown round it. Each puff drifts up and back from the tire and stays where it was born
# as the car goes on.
prefab car/smoke_rl
  emitter3d texture="fx/puff.png" rate=0 max=384 life=1.0,1.8 spawn_box=0.12,0.04,0.2 velocity=0,1.4,-1.0,0.9,0.4 gravity=0,0.9,0 drag=1.4 inherit=0.1 spin=-0.8,0.8 alpha=blend size_keys=0:0.4,0.25:1.8,1:3.6 color_keys=0:#EBEBEB00,0.08:#EBEBEB6E,0.5:#CDCDCD3C,1:#B4B4B400
  transform position=1.0,-0.22,-1.65
end
prefab car/smoke_rr
  emitter3d texture="fx/puff.png" rate=0 max=384 life=1.0,1.8 spawn_box=0.12,0.04,0.2 velocity=0,1.4,-1.0,0.9,0.4 gravity=0,0.9,0 drag=1.4 inherit=0.1 spin=-0.8,0.8 alpha=blend size_keys=0:0.4,0.25:1.8,1:3.6 color_keys=0:#EBEBEB00,0.08:#EBEBEB6E,0.5:#CDCDCD3C,1:#B4B4B400
  transform position=-1.0,-0.22,-1.65
end
prefab car/wheel_fl
  transform position=1.0,-0.05,1.3
end
prefab car/wheel_fl/tire
  model cylinder=0.36,0.26,16 tint=#151515
  transform rotation=0,0,1.5708
end
