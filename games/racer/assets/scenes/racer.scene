wgf-scene 2
# The racer's things as data: the car and the checkpoint, each a prefab of generated
# meshes. The track is built in code from its centerline (src/Track.hx).

# The car: a plain actor the ecs moves (its motion, set by src/ArcadeDrive.hx each tick),
# with a trigger sphere for the checkpoints, and its parts as models under it. It faces +z.
prefab car
  motion
  collider radius=1.2 layer=1 mask=2
  behavior name=Car
end
prefab car/body
  model cube=1.8,0.5,4.0 tint=#C8282C
  transform position=0,0.6,0
end
prefab car/cabin
  model cube=1.5,0.45,1.9 tint=#1E2630
  transform position=0,1.07,-0.3
end
prefab car/wing
  model cube=1.8,0.08,0.45 tint=#2A2A2A
  transform position=0,1.25,-1.85
end
prefab car/wheel_fl
  model cylinder=0.36,0.3,16 tint=#151515
  transform position=0.95,0.36,1.3 rotation=0,0,1.5708
end
prefab car/wheel_fr
  model cylinder=0.36,0.3,16 tint=#151515
  transform position=-0.95,0.36,1.3 rotation=0,0,1.5708
end
prefab car/wheel_rl
  model cylinder=0.36,0.3,16 tint=#151515
  transform position=0.95,0.36,-1.3 rotation=0,0,1.5708
end
prefab car/wheel_rr
  model cylinder=0.36,0.3,16 tint=#151515
  transform position=-0.95,0.36,-1.3 rotation=0,0,1.5708
end
prefab car/lamp_l
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=0.6,0.65,2.01
end
prefab car/lamp_r
  model cube=0.4,0.15,0.05 tint=#FFF4C0
  transform position=-0.6,0.65,2.01
end

# A checkpoint: a trigger sphere across the track (its radius past the track's half
# width, so the car can't pass beside it on the asphalt), meeting the car's layer, and a
# gate over it. Spawned along the track by Main, its index set as the behavior's parameter.
prefab checkpoint
  collider radius=7.5 layer=2 mask=1
  behavior name=Checkpoint
end
prefab checkpoint/post_l
  model cylinder=0.15,3.6,8 tint=#E8E8E8
  transform position=7.3,1.8,0
end
prefab checkpoint/post_r
  model cylinder=0.15,3.6,8 tint=#E8E8E8
  transform position=-7.3,1.8,0
end
prefab checkpoint/banner
  model cube=14.9,0.7,0.12 tint=#2860C8
  transform position=0,3.6,0
end
