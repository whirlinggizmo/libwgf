wgf-scene 2
# The track's collision and checkpoints, generated by tools/gen_track.py (its drawn
# pieces are the sections', assets/track/section_<n>.scene, streamed in). Each surface a
# static body of its own triangles at its own friction; the road and walls are hidden by
# the game (src/Track.hx: a scene line can't hide a model), the ground is the field.
actor track
  model path="track/collision.glb"
end
actor track/ground
  model cast_shadows=false
  body type=static shape=mesh friction=0.7
end
actor track/road
  model cast_shadows=false
  body type=static shape=mesh friction=1
end
actor track/walls
  model cast_shadows=false
  body type=static shape=mesh friction=0.3
end

# A checkpoint: a sensor box across the track, barrier to barrier, its middle 2 m up,
# meeting the car's layer.
prefab checkpoint
  body type=sensor shape=box size=23,4,1 offset=0,2,0 layer=2 mask=1
  behavior name=Checkpoint
end
actor checkpoint_0
  from checkpoint
  transform position=0,0,32 rotation=0,0,0
  behavior index=0
end
actor checkpoint_1
  from checkpoint
  transform position=10.7324,0,123.2656 rotation=0,0.75,0
  behavior index=1
end
actor checkpoint_2
  from checkpoint
  transform position=100.5173,0,132.4772 rotation=0,2.119469,0
  behavior index=2
end
actor checkpoint_3
  from checkpoint
  transform position=167.3646,0,84.9314 rotation=0,1.965044,0
  behavior index=3
end
actor checkpoint_4
  from checkpoint
  transform position=192,0,1.0619 rotation=0,3.141593,0
  behavior index=4
end
actor checkpoint_5
  from checkpoint
  transform position=137.8938,0,-56 rotation=0,-1.570796,0
  behavior index=5
end
actor checkpoint_6
  from checkpoint
  transform position=70.2781,0,-99.2908 rotation=0,-2.207963,0
  behavior index=6
end
actor checkpoint_7
  from checkpoint
  transform position=0.0002,0,-64.1239 rotation=0,-0.003096,0
  behavior index=7
end
