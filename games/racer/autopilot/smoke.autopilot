wgf-autopilot 1
# a smoke run (wgf export): loaded and on the grid, the throttle starting the countdown,
# then racing
seed 1
at 1 wait racer.state >= 1
at 2 expect racer.state == 1
at 10 key down up
at 11 expect racer.state == 2
at 200 expect racer.state == 3
at 230 expect racer.speed > 5
at 230 end
