wgf-autopilot 1
# The controls on a pad, through the same actions as the keys: the right trigger starts
# the race and drives, the left stick steers (past its 0.2 dead band), the left trigger
# brakes, and Start puts the car back on the grid.
seed 1
at 1 wait racer.state >= 1
at 2 pad 0 connect
at 10 pad 0 axis right_trigger 1
at 11 expect racer.state == 2
at 200 expect racer.state == 3
at 260 expect racer.speed > 8
at 260 pad 0 axis left_x 0.1
at 269 expect racer.steer == 0         # 0.1 is inside the dead band
at 270 pad 0 axis left_x -1
at 299 expect racer.steer == -1
at 300 pad 0 axis left_x 1
at 329 expect racer.steer == 1
at 330 pad 0 axis left_x 0
at 330 pad 0 axis right_trigger 0
at 330 pad 0 axis left_trigger 1
at 420 expect racer.speed < 1
at 420 pad 0 axis left_trigger 0
at 430 pad 0 tap start
at 432 expect racer.state == 2
at 432 expect racer.speed == 0
at 440 end
