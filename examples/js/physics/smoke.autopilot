wgf-autopilot 1
# A smoke run: the pile falls through the sensor and settles, the body under the pointer is
# kicked back up through it, and R puts the pile back.
at 10 expect physics.bodies == 18
at 90 expect physics.sensed >= 18
at 300 expect physics.settled == 1
at 300 mouse move 480 330
at 302 expect physics.hovered == 1
at 310 key tap space
at 312 expect physics.kicks == 1
at 312 expect physics.settled == 0
at 340 expect physics.sensed >= 19
at 345 key tap r
at 346 expect physics.sensed == 0
at 346 expect physics.kicks == 0
at 346 end
