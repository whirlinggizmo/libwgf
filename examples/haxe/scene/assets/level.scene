wgf-scene 2
# The scene example's level: a floor, two ledges, two clouds, and a dropper that patrols above
# them. Edit this file to change the level. The program only loads it, finds the dropper by its
# name, and spawns the crate prefab under it. Layers: the ground is 1.

# A cloud drifts and wraps around the screen.
prefab cloud
  shape2d rectangle=120,36 corner=18 color=#FFFFFF
  motion velocity=18,0,0
  bounds rect=0,0,800,450 mode=wrap margin=70
end

# A crate falls, lands on the ground, and is gone after 8 seconds.
prefab crate
  shape2d rectangle=26,26 corner=3 outline=0 color=#D9A441
  arcade2d size=26,26 gravity=900 max_fall=700 solid_mask=1
  lifetime seconds=8
end

actor floor
  transform position=400,430,0
  shape2d rectangle=800,40 color=#3C6E47
  collider rectangle=800,40 layer=1 mask=0
end

actor ledge_left
  transform position=200,300,0
  shape2d rectangle=220,16 corner=4 color=#7A5A40
  collider rectangle=220,16 layer=1 mask=0
end

actor ledge_right
  transform position=610,240,0
  shape2d rectangle=180,16 corner=4 color=#7A5A40
  collider rectangle=180,16 layer=1 mask=0
end

# The dropper: its Patrol behavior, the program's code, turns it at left and right.
actor dropper
  transform position=400,140,0
  shape2d polygon=-18,-10,18,-10,0,14 color=#E05A47
  motion velocity=150,0,0
  behavior name=Patrol left=60 right=740
end
actor dropper/label
  transform position=0,-24,0
  text string="dropper" size=14 color=#2B2F3A align=center,middle
end

actor
  from cloud
  transform position=170,200,0
end

actor
  from cloud
  transform position=560,60,0 scale=0.7,0.7,1
  motion velocity=30,0,0
end
