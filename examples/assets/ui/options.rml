<rml>
<head>
    <title>Options</title>
    <link type="text/rcss" href="options.rcss"/>
</head>
<body>
<div id="window">
    <h1>Options</h1>
    <tabset id="tabs">
        <tab id="tab-game">Game</tab>
        <panel>
            <div class="row"><label for="name">Name</label><input id="name" type="text" value="Player" maxlength="16"/></div>
            <div class="row"><label for="difficulty">Difficulty</label>
                <select id="difficulty">
                    <option value="easy">Easy</option>
                    <option value="normal" selected="selected">Normal</option>
                    <option value="hard">Hard</option>
                </select>
                <div class="hint">?<div class="tip"><b>Hard</b> keeps the <i>night</i> levels dark.</div></div>
            </div>
            <div class="row"><label for="sound">Sound</label><input id="sound" type="checkbox" value="on" checked="checked"/></div>
            <div class="row"><label for="volume">Volume</label><input id="volume" type="range" min="0" max="10" step="1" value="7"/><span id="volume-value">7</span></div>
        </panel>
        <tab id="tab-levels">Levels</tab>
        <panel>
            <div id="levels">
        <button class="level" id="level-1">Level 1: The Gate</button>
        <button class="level" id="level-2">Level 2: Old Road</button>
        <button class="level" id="level-3">Level 3: Mill Bridge</button>
        <button class="level" id="level-4">Level 4: Fen Watch</button>
        <button class="level" id="level-5">Level 5: The Barrows</button>
        <button class="level" id="level-6">Level 6: Lantern Hill</button>
        <button class="level" id="level-7">Level 7: Ash Wood</button>
        <button class="level" id="level-8">Level 8: Grey Tower</button>
        <button class="level" id="level-9">Level 9: Salt Marsh</button>
        <button class="level" id="level-10">Level 10: The Ford</button>
        <button class="level" id="level-11">Level 11: Crown Keep</button>
        <button class="level" id="level-12">Level 12: Last Light</button>
            </div>
        </panel>
    </tabset>
    <div id="buttons"><button id="play">Play</button><button id="quit">Quit</button></div>
    <p id="status"><b>Tab</b>, the arrows, or a pad's D-pad move; <b>Enter</b> or its south button chooses. <i>Point at the ? for a tip.</i></p>
</div>
</body>
</rml>
