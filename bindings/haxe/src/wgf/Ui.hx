	**/
	public static inline function setSkin(widget:UiWidget, part:UiPart, state:UiState, texture:Texture, source_x:Float, source_y:Float, source_width:Float, source_height:Float):Bool
		return Raw.wgf_ui_set_skin(widget, part, state, texture, source_x, source_y, source_width, source_height);

