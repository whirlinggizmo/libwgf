	static final counts:Array<Int> = [for (_ in 0...623) 0];

	public static inline function hit(index:Int):Void
		counts[index]++;

	/** How often `name` was called; -1 for a name that isn't a call. **/
	public static function count(name:String):Int {
		final i = NAMES.indexOf(name);
		return i < 0 ? -1 : counts[i];
	}

	/** The calls never made. **/
	public static function missing():Array<String>
		return [for (i in 0...NAMES.length) if (counts[i] == 0) NAMES[i]];
