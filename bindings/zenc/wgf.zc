extern let WGF_EASING_CUBIC_IN_OUT: wgf_easing_t;
extern let WGF_EASING_QUART_IN: wgf_easing_t;
extern let WGF_EASING_QUART_OUT: wgf_easing_t;
extern let WGF_EASING_QUART_IN_OUT: wgf_easing_t;
extern let WGF_EASING_SINE_IN: wgf_easing_t;
extern let WGF_EASING_SINE_OUT: wgf_easing_t;
extern let WGF_EASING_SINE_IN_OUT: wgf_easing_t;
extern let WGF_EASING_EXPO_IN: wgf_easing_t;
extern let WGF_EASING_EXPO_OUT: wgf_easing_t;
extern let WGF_EASING_EXPO_IN_OUT: wgf_easing_t;
extern let WGF_EASING_CIRC_IN: wgf_easing_t;
extern let WGF_EASING_CIRC_OUT: wgf_easing_t;
extern let WGF_EASING_CIRC_IN_OUT: wgf_easing_t;
extern let WGF_EASING_BACK_IN: wgf_easing_t;
extern let WGF_EASING_BACK_OUT: wgf_easing_t;
extern let WGF_EASING_BACK_IN_OUT: wgf_easing_t;
extern let WGF_EASING_ELASTIC_IN: wgf_easing_t;
extern let WGF_EASING_ELASTIC_OUT: wgf_easing_t;
extern let WGF_EASING_ELASTIC_IN_OUT: wgf_easing_t;
extern let WGF_EASING_BOUNCE_IN: wgf_easing_t;
extern let WGF_EASING_BOUNCE_OUT: wgf_easing_t;
extern let WGF_EASING_BOUNCE_IN_OUT: wgf_easing_t;

/// Returns `t` eased by `easing`.
///
/// `t` runs from 0 to 1, and is clamped to that range. The result is 0 at 0 and 1 at 1. In
/// between, BACK and ELASTIC go past that range. An `easing` that isn't one of
/// wgf_easing_t's values is treated as LINEAR.
extern fn wgf_ease_value(easing: wgf_easing_t, t: f32) -> f32;

