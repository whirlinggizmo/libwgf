extern let WGF_KEY_LEFT_SHIFT: wgf_keyboard_key_t;
extern let WGF_KEY_LEFT_CONTROL: wgf_keyboard_key_t;
extern let WGF_KEY_LEFT_ALT: wgf_keyboard_key_t;
extern let WGF_KEY_LEFT_SUPER: wgf_keyboard_key_t;
extern let WGF_KEY_RIGHT_SHIFT: wgf_keyboard_key_t;
extern let WGF_KEY_RIGHT_CONTROL: wgf_keyboard_key_t;
extern let WGF_KEY_RIGHT_ALT: wgf_keyboard_key_t;
extern let WGF_KEY_RIGHT_SUPER: wgf_keyboard_key_t;
extern let WGF_KEY_MENU: wgf_keyboard_key_t;

/// Returns the state of `key`: UP, PRESSED (went down since the previous tick or frame), DOWN,
/// or RELEASED.
///
/// A key the keyboard doesn't have is UP. A key pressed and released between two reads is
/// PRESSED for one read, so no tap is missed.
extern fn wgf_keyboard_get_state(key: wgf_keyboard_key_t) -> wgf_input_state_t;

/// Returns whether `key` is PRESSED or DOWN.
extern fn wgf_keyboard_is_down(key: wgf_keyboard_key_t) -> bool;

/// Returns whether `key` went down since the previous tick or frame. A held key repeating
/// doesn't count.
extern fn wgf_keyboard_is_pressed(key: wgf_keyboard_key_t) -> bool;

/// Returns whether `key` went up since the previous tick or frame.
extern fn wgf_keyboard_is_released(key: wgf_keyboard_key_t) -> bool;

/// Returns whether `key` was pressed, or repeated by being held (the system's key repeat).
///
/// Use it for a menu's cursor moving while an arrow is held, or a text field's backspace.
extern fn wgf_keyboard_is_repeated(key: wgf_keyboard_key_t) -> bool;

/// Returns the last key pressed in this frame (in a tick, in that tick), not counting repeats.
///
/// Returns WGF_KEY_NONE if none was. A rebinding screen's "press a key" uses it.
extern fn wgf_keyboard_get_last_pressed() -> wgf_keyboard_key_t;

// ---- wgf_mouse.h ----

/// The mouse, read inside a tick or a frame.
///
/// A read reports what changed since the previous tick, or the previous frame. Positions are in
/// logical pixels from the window's top-left, with y down, as gfx draws.
extern wgf_mouse_button_t;
extern let WGF_MOUSE_BUTTON_LEFT: wgf_mouse_button_t;
extern let WGF_MOUSE_BUTTON_RIGHT: wgf_mouse_button_t;
extern let WGF_MOUSE_BUTTON_MIDDLE: wgf_mouse_button_t;

/// Returns where the pointer is: where it last moved over the window.
extern fn wgf_mouse_get_position() -> wgf_vec2_t;

/// Returns whether the pointer is over the window.
///
/// - A mouse is over the window from when it enters or moves over it until it leaves.
/// - A finger driving the pointer (wgf_touch_set_mouse_emulated) is over it while it is down.
///
/// Returns false until the pointer has been seen.
extern fn wgf_mouse_is_over_window() -> bool;

/// Returns how far the pointer moved since the previous tick or frame.
///
/// While the mouse is locked, this is the only way to read its movement.
extern fn wgf_mouse_get_delta() -> wgf_vec2_t;

/// Returns the scrolling since the previous tick or frame.
///
/// y is vertical (up is positive) and x horizontal. A wheel notch is about 1, and trackpads give
/// fractions.
extern fn wgf_mouse_get_wheel() -> wgf_vec2_t;

/// Returns the state of `button`: UP, PRESSED, DOWN, or RELEASED, as for keys.
extern fn wgf_mouse_get_button_state(button: wgf_mouse_button_t) -> wgf_input_state_t;

extern fn wgf_mouse_is_down(button: wgf_mouse_button_t) -> bool;

extern fn wgf_mouse_is_pressed(button: wgf_mouse_button_t) -> bool;

extern fn wgf_mouse_is_released(button: wgf_mouse_button_t) -> bool;

/// Sets or gets whether the pointer is locked to the window and hidden, for mouse look
/// (default: off).
///
/// While locked, the position stays put and the delta keeps coming. On the web the browser
/// grants the lock only during a click or key press, and the user can end it (Escape).
extern fn wgf_mouse_set_locked(locked: bool);

extern fn wgf_mouse_is_locked() -> bool;

/// Sets or gets whether the pointer shows over the window (default: true).
extern fn wgf_mouse_set_cursor_visible(visible: bool);

extern fn wgf_mouse_is_cursor_visible() -> bool;

/// The cursor's shape over the window, set and read with wgf_mouse_set_cursor and
/// wgf_mouse_get_cursor.
///
/// DEFAULT is the system's cursor. The others include a hand over a button, an I-beam over
/// text, and the resizing arrows. Setting it does nothing on a phone. wgf_mouse_set_cursor
/// returns false for a value that isn't a cursor.
extern wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_DEFAULT: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_ARROW: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_IBEAM: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_CROSSHAIR: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_HAND: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_RESIZE_EW: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_RESIZE_NS: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_RESIZE_NWSE: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_RESIZE_NESW: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_RESIZE_ALL: wgf_mouse_cursor_t;
extern let WGF_MOUSE_CURSOR_NOT_ALLOWED: wgf_mouse_cursor_t;

extern fn wgf_mouse_set_cursor(cursor: wgf_mouse_cursor_t) -> bool;

extern fn wgf_mouse_get_cursor() -> wgf_mouse_cursor_t;

// ---- wgf_tilt.h ----

/// The device's tilt, for a game steered by tilting a phone or a tablet.
///
/// The tilt is measured from level, and turns with the screen. On the web it comes from the
/// page's device orientation. Natively it is UNAVAILABLE. Ask for it with wgf_tilt_request,
/// then read it each frame:
///
///   x += speed * wgf_tilt_get_x() * dt;
///
/// - A page may need permission, asked at the player's next tap (iOS, and Chrome on Android).
///   So a game asks before the tap that starts play.
/// - Level is measured once the device is held within 3 degrees for half a second. That happens
///   as the tilt starts, after the screen turns, and after wgf_tilt_calibrate. The tilt reads 0
///   meanwhile.
/// - Once asked for, readings are taken as each frame ends. A program that never asks links
///   none of the tilt's code.
extern wgf_tilt_status_t;
extern let WGF_TILT_STATUS_OFF: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_WAITING_FOR_TAP: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_STARTING: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_ON: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_REFUSED: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_UNAVAILABLE: wgf_tilt_status_t;
extern let WGF_TILT_STATUS_NEEDS_HTTPS: wgf_tilt_status_t;

/// Asks for the tilt.
///
/// Returns false if it can't be had at once (UNAVAILABLE, NEEDS_HTTPS). Returns true once asked,
/// and the status then says how it goes. Asking again while asked does nothing.
extern fn wgf_tilt_request() -> bool;

/// Stops the readings: the status is OFF, and the tilt reads 0 from then. A permission granted
/// stays granted.
extern fn wgf_tilt_release();

extern fn wgf_tilt_get_status() -> wgf_tilt_status_t;

/// Returns whether level is being measured. The tilt reads 0 until it is.
extern fn wgf_tilt_is_calibrating() -> bool;

/// Returns whether the status is ON and level is measured, so the tilt steers.
extern fn wgf_tilt_is_ready() -> bool;

/// Measures level again from how the device is held next, as a game's "Level" button does.
extern fn wgf_tilt_calibrate();

/// Returns how far the device is tilted from level, -1 to 1. A tilt of the range's degrees
/// reads 1 (see wgf_tilt_set_range).
///
/// - x is across the screen, right positive.
/// - y is up and down the screen, down positive.
///
/// Returns 0 while calibrating, or while the status isn't ON.
extern fn wgf_tilt_get_x() -> f32;

extern fn wgf_tilt_get_y() -> f32;

/// Sets or gets the tilt, in degrees, that reads 1. It is at least 1 (default: 30).
extern fn wgf_tilt_set_range(degrees: f32);

extern fn wgf_tilt_get_range() -> f32;

// ---- wgf_touch.h ----

/// Returns the number of fingers down, plus those lifted since the previous tick or frame.
extern fn wgf_touch_get_count() -> i32;

/// Returns the id of the finger at `index` (0 up to the count), oldest first.
///
/// Ids are 0 to 7. An id stays the same while its finger is down, and is reused once the finger
/// has lifted. Returns -1 past the count.
extern fn wgf_touch_get_id(index: i32) -> i32;

/// Returns the state of finger `id`: PRESSED (touched down since the previous tick or frame),
/// DOWN, or RELEASED.
///
/// A tap within one read is PRESSED. Returns UP for an id with no finger.
extern fn wgf_touch_get_state(id: i32) -> wgf_input_state_t;

/// Returns where the finger is, or where it lifted. Returns (0, 0) for an id with no finger.
extern fn wgf_touch_get_position(id: i32) -> wgf_vec2_t;

/// Returns how far the finger moved since the previous tick or frame.
extern fn wgf_touch_get_delta(id: i32) -> wgf_vec2_t;

/// Sets or gets whether the first finger also drives the mouse, so mouse code works by touch
/// (default: on).
///
/// The finger moves the pointer and holds the left button. A second finger cancels that press:
/// the pointer lets go off the window, at (-1, -1), so nothing under it is clicked. The mouse
/// then stays up until every finger has lifted.
extern fn wgf_touch_set_mouse_emulated(emulated: bool);

extern fn wgf_touch_is_mouse_emulated() -> bool;

/// Sets or gets whether the mouse's left button acts as a finger, so touch controls can be tried
/// with a mouse on a desktop (default: off).
///
/// - While the button is pressed, a finger touches down where the pointer is, follows it, and
///   lifts with the button.
/// - That finger has its own id, as any finger does.
/// - The two settings don't feed each other: the finger a press makes doesn't drive the mouse
///   back.
/// - Turned off while the button is pressed, the finger lifts.
extern fn wgf_touch_set_from_mouse(from_mouse: bool);

extern fn wgf_touch_is_from_mouse() -> bool;

/// Returns whether two or more fingers are down.
extern fn wgf_touch_is_gesture() -> bool;

/// Returns the point between the two fingers, in logical pixels. Returns (0, 0) with fewer than
/// two.
extern fn wgf_touch_get_gesture_center() -> wgf_vec2_t;

/// Returns how far that point moved since the previous tick or frame.
extern fn wgf_touch_get_gesture_pan() -> wgf_vec2_t;

/// Returns the pinch since the previous tick or frame: how many times farther apart the fingers
/// are. 1 is no pinch, 2 twice as far apart, and 0.5 half as far.
extern fn wgf_touch_get_gesture_scale() -> f32;

/// Returns the twist since the previous tick or frame, in radians, clockwise on the
/// screen.
extern fn wgf_touch_get_gesture_rotation() -> f32;

/// Returns one finger's gestures. Each is made by a finger that was alone while it was down.
///
/// - A tap: lifted within 0.3 seconds, having moved under 12 logical pixels. is_tapped says
///   whether one happened in this frame (in a tick, in that tick).
/// - A double tap: a second tap within 0.35 seconds of the last, near it. is_double_tapped
///   says whether one happened.
/// - get_tap_position returns where the tap or double tap was.
/// - A swipe: lifted within 0.5 seconds, having gone 50 logical pixels or more. get_swipe
///   returns how far it went, or 0, 0 for none.
/// - A hold: down for 0.5 seconds or more, still. is_holding is true while it lasts.
extern fn wgf_touch_is_tapped() -> bool;

extern fn wgf_touch_is_double_tapped() -> bool;

extern fn wgf_touch_get_tap_position() -> wgf_vec2_t;

extern fn wgf_touch_get_swipe() -> wgf_vec2_t;

extern fn wgf_touch_is_holding() -> bool;

// ---- wgf_window.h ----

/// Sets or gets the window's title (default: "libwgf").
///
/// Natively it is the window's title bar. On the web it is the page's title. NULL counts as "".
extern fn wgf_window_set_title(title: const char*);

extern fn wgf_window_get_title() -> const char*;

/// Sets or gets the size inside the window's frame, in logical pixels (default: 1024 by 768).
///
/// Returns false for a width or height under 1.
///
/// On the web the window is the page's canvas, and the page sizes it:
///
/// - Setting the size changes nothing there, and returns true.
/// - The getters return the canvas's size on the page, before the run and during it.
/// - A page that wants a fixed size gives the canvas one in its CSS.
///
/// A game written for one size sets a presentation (wgf_presentation.h). That fits the game to
/// whatever size the window is. Natively, it also opens the window at that size when this size
/// isn't set.
extern fn wgf_window_set_size(width: i32, height: i32) -> bool;

extern fn wgf_window_get_width() -> i32;

extern fn wgf_window_get_height() -> i32;

/// Asks for the window to fill the screen, or to stop (default: off).
///
/// The answer is wgf_window_is_fullscreen, not the return value.
/// - Returns false if there is nothing to request (see wgf_window_can_fullscreen).
/// - Returns true if the request was made. That doesn't mean it was granted. Even on the
///   desktop, the switch has not happened yet when this returns.
///
/// On the web the browser grants it only inside a tap, a click, or a key press, and a frame
/// comes after those. So a refused request is held, and asked again inside the next one.
/// - Asked as Play is pressed, it is granted by that tap's release or the next.
/// - Asked at start, it is granted by the player's first tap anywhere.
/// - Once granted, it is no longer held. A player who leaves fullscreen stays out until it is
///   asked again.
///
/// Asked before the window opens, the window opens filling the screen. On the web the request
/// is held for the first tap.
///
/// The call is named request_ because the platform may refuse it, as every such call is.
extern fn wgf_window_request_fullscreen(fullscreen: bool) -> bool;

extern fn wgf_window_is_fullscreen() -> bool;

/// Returns whether the window can fill the screen at all.
///
/// It is true on the desktop. On the web it is what the browser says: false in a frame that
/// doesn't allow it. Ask before offering a fullscreen key.
extern fn wgf_window_can_fullscreen() -> bool;

/// Sets or gets where the window is: its top-left in the desktop's coordinates.
///
/// 0, 0 is the top-left of the main monitor. These work only once the window is open. Setting
/// returns false, and getting returns 0, where programs don't place their windows: the web, and
/// a Wayland desktop, whose compositor places them.
extern fn wgf_window_set_position(x: i32, y: i32) -> bool;

extern fn wgf_window_get_x() -> i32;

extern fn wgf_window_get_y() -> i32;

/// Lists the monitors, numbered 0 up to the count, and sets or gets the one the window is on.
///
/// - There is at least one monitor: the screen.
/// - Moving the window to another monitor returns false where programs don't place their
///   windows.
/// - A monitor's size is in logical pixels, and its position in the desktop's coordinates.
/// - A monitor that isn't there gives 0 and "".
///
/// These work only once the window is open.
extern fn wgf_window_get_monitor_count() -> i32;

extern fn wgf_window_set_monitor(monitor: i32) -> bool;

extern fn wgf_window_get_monitor() -> i32;

extern fn wgf_window_get_monitor_width(monitor: i32) -> i32;

extern fn wgf_window_get_monitor_height(monitor: i32) -> i32;

extern fn wgf_window_get_monitor_x(monitor: i32) -> i32;

extern fn wgf_window_get_monitor_y(monitor: i32) -> i32;

extern fn wgf_window_get_monitor_name(monitor: i32) -> const char*;

/// Sets or gets whether the window is shown or hidden (default: shown).
///
/// The program runs either way. Hiding the window at open, then showing it once loaded, avoids
/// showing an empty window.
extern fn wgf_window_set_visible(visible: bool);

extern fn wgf_window_is_visible() -> bool;

/// Sets or gets whether the user can resize the window (default: true), and whether it has a
/// title bar and border (default: true).
///
/// These are for the desktop only. The web ignores them.
extern fn wgf_window_set_resizable(resizable: bool);

extern fn wgf_window_is_resizable() -> bool;

extern fn wgf_window_set_decorated(decorated: bool);

extern fn wgf_window_is_decorated() -> bool;

/// Returns whether the window has the keyboard. A game that wants to pause on losing it does so
/// itself (wgf_loop_set_time_scale).
extern fn wgf_window_is_focused() -> bool;

/// Returns whether the window's size (wgf_window_get_width, _height) differs from its size as
/// the last frame ended. It is true for that one frame.
extern fn wgf_window_is_resized() -> bool;

/// Sets the window's icon (on the web, the page's) from RGBA pixels, `width` by `height`.
///
/// `rgba` holds `size` bytes: width x height x 4, row by row from the top.
///
/// Returns false for no pixels, a width or height of 0 or over 1024, or a byte count that
/// doesn't fit them.
extern fn wgf_window_set_icon(rgba: const u8*, size: i32, width: i32, height: i32) -> bool;

/// The options fixed when the window opens. Add them together with |.
extern wgf_window_flag_t;
extern let WGF_WINDOW_FLAG_NONE: wgf_window_flag_t;
extern let WGF_WINDOW_FLAG_TRANSPARENT: wgf_window_flag_t;
extern let WGF_WINDOW_FLAG_MSAA: wgf_window_flag_t;
extern let WGF_WINDOW_FLAG_VSYNC_OFF: wgf_window_flag_t;
extern let WGF_WINDOW_FLAG_LOW_DPI: wgf_window_flag_t;

/// Sets or gets the options fixed when the window opens (default: WGF_WINDOW_FLAG_NONE).
///
/// Call it before wgf_app_run, with every flag wanted: it replaces the flags set before.
///
///   TRANSPARENT  Desktop: where the window system allows it. Web: the page under the canvas
///                shows.
///   MSAA         A request. A platform may give fewer samples, and gfx draws with what the
///                window got (wgf_window_get_msaa_samples).
///   VSYNC_OFF    Frames run as fast as they can, or at the target fps. The web is always in
///                step with the display.
///   LOW_DPI      Fewer pixels and softer edges. Without it, drawing is at the display's full
///                density.
///
/// Returns false, changing nothing, once the window has opened (logged), or for a bit that
/// isn't a flag.
extern fn wgf_window_set_flags(flags: i32) -> bool;

extern fn wgf_window_get_flags() -> i32;

/// Returns each open flag's answer: transparent, drawing at full density, in step with the
/// display, and MSAA asked for.
extern fn wgf_window_is_transparent() -> bool;

extern fn wgf_window_is_high_dpi() -> bool;

extern fn wgf_window_is_vsync() -> bool;

extern fn wgf_window_is_msaa() -> bool;

/// Returns how many samples a pixel the window draws with: 1 without MSAA.
///
/// Before the window opens, it is what was asked for (4 with WGF_WINDOW_FLAG_MSAA). Once open,
/// it is what the window got, which may be fewer.
extern fn wgf_window_get_msaa_samples() -> i32;

/// Opens `url` in the system's browser, such as a store page or the credits' links.
///
/// On the web it opens in a new tab, and only in the frame of an input, as browsers allow.
///
/// Returns false for NULL, an empty URL, or one the system refused.
extern fn wgf_window_open_url(url: const char*) -> bool;

/// Returns the safe area's insets: how far in from each edge of the window the display covers
/// or keeps for itself, in logical pixels.
///
/// That covered area is a phone's notch, rounded corners, and home indicator, where a HUD and
/// buttons shouldn't go.
/// - On the web, they are the page's CSS safe-area insets (env(safe-area-inset-*)), less what
///   lies outside the canvas, each at most the window's size. A browser reports them only to a
///   page whose viewport meta has viewport-fit=cover, as libwgf's pages do.
/// - Natively they are 0, since nothing covers a desktop's window.
///
/// They are read as they are now, and change as the device turns or the window is resized.
extern fn wgf_window_get_safe_inset_top() -> i32;

extern fn wgf_window_get_safe_inset_right() -> i32;

extern fn wgf_window_get_safe_inset_bottom() -> i32;

extern fn wgf_window_get_safe_inset_left() -> i32;

/// Which way up the screen is held.
extern wgf_window_orientation_t;
extern let WGF_WINDOW_ORIENTATION_ANY: wgf_window_orientation_t;
extern let WGF_WINDOW_ORIENTATION_LANDSCAPE: wgf_window_orientation_t;
extern let WGF_WINDOW_ORIENTATION_PORTRAIT: wgf_window_orientation_t;

/// Asks for the screen to be held LANDSCAPE or PORTRAIT whichever way the device turns, or to
/// let go (ANY).
///
/// The answer is wgf_window_get_orientation_lock, a frame or more later, not the return value.
///
/// On the web this is the browser's screen.orientation.lock. Most browsers grant it only to a
/// page in fullscreen on a phone (Android's Chrome).
/// - Asked outside fullscreen, the request is held, and asked again as the page goes fullscreen
///   (wgf_window_request_fullscreen).
/// - A refusal in fullscreen is warned about at the next frame, with the browser's reason.
///
/// Returns false for a value that isn't an orientation, and where nothing can lock: natively,
/// and in a browser without screen.orientation.lock (iOS).
///
/// Where the lock is refused, a game says "turn your device" while wgf_window_get_orientation
/// is the wrong one.
extern fn wgf_window_request_orientation(orientation: wgf_window_orientation_t) -> bool;

/// Returns the lock granted: LANDSCAPE or PORTRAIT, or ANY with no lock.
///
/// The browser lets go of the lock as the page leaves fullscreen, so outside fullscreen it reads
/// ANY. It changes only at a frame's start.
extern fn wgf_window_get_orientation_lock() -> wgf_window_orientation_t;

/// Returns whether an orientation lock can be asked for at all.
///
/// On the web it is true in a browser with screen.orientation.lock on a device with touch. A
/// desktop browser's lock is always refused. Natively it is false. Ask before offering a lock.
extern fn wgf_window_can_lock_orientation() -> bool;

/// Returns which way the window is now, by its shape (wgf_window_get_width against _height).
///
/// Returns PORTRAIT when it is taller than wide, and LANDSCAPE otherwise. It never returns ANY.
extern fn wgf_window_get_orientation() -> wgf_window_orientation_t;

/// The device's operating system, and what the device has.
///
/// - wgf_window_has_touch: whether it has touch, to decide on showing on-screen controls.
/// - wgf_window_has_fine_pointer: whether it has a fine pointer (a mouse or a pad), so hover
///   matters.
/// - wgf_window_get_os: its system. On the web, it is the system the browser runs on.
extern wgf_window_os_t;
extern let WGF_WINDOW_OS_OTHER: wgf_window_os_t;
extern let WGF_WINDOW_OS_LINUX: wgf_window_os_t;
extern let WGF_WINDOW_OS_WINDOWS: wgf_window_os_t;
extern let WGF_WINDOW_OS_MACOS: wgf_window_os_t;
extern let WGF_WINDOW_OS_ANDROID: wgf_window_os_t;
extern let WGF_WINDOW_OS_IOS: wgf_window_os_t;

extern fn wgf_window_has_touch() -> bool;

extern fn wgf_window_has_fine_pointer() -> bool;

extern fn wgf_window_get_os() -> wgf_window_os_t;

/// Returns whether the program runs in a web page.
extern fn wgf_window_is_web() -> bool;

// ---- wgf_asset.h ----

/// Assets: where a resource's file comes from.
///
/// A path is an asset. Creating a resource from a path goes through here, as does every
/// call below. That includes wgf_texture_create, wgf_font_create, wgf_sound_create, and a
/// scene's files. Those calls are what link this layer, so a program that only makes
/// generated content links none of it.
///
/// A relative path is looked for under the asset host, which needs no setting:
///
///   natively  the host is the program's own directory (where its executable is,
///             wherever it was started from), which is the file storage's root
///             (wgf_fs.h). Files are read where they are, as without this layer
///   web       the host is the page's own directory: its document's base URL, so a
///             <base href> moves it. A file that isn't bundled into the page and isn't
///             cached is fetched from beside the page and cached in the browser's
///             storage. On later visits it is checked again as the cache mode says. A
///             file asked for before that storage has opened (the first frames) waits
///             for it. So no kept file is lost, and a game needs no wait of its own
///
/// So a web page loads its files with no call here at all. A page that should never fetch
/// bundles what it loads.
///
/// - Set another host to fetch from elsewhere, such as a CDN, or natively to download (see
///   fetching, below).
/// - A path that is a URL ("https://...") is fetched from there, and cached under its own
///   name. Natively that needs fetching turned on. Without it the load fails, logged with
///   the URL.
///
/// A resource makes its own file local as it loads (wgf_resource.h). So a program only
/// ENSURES a file to have it local without loading it:
/// - to fetch ahead, such as a level's files during a menu
/// - to fetch from an explicit source (a fetch_url)
/// - to read the file itself
///
/// An ensure is a task: a handle whose status, local path, and progress the program reads.
/// Nothing is called back. Destroy the task when you are done with it. A path ensured from
/// an explicit source is what a later create of that path loads, wherever it was found.
///
/// A file in a format that names other files is ensured with them, when the layer that
/// reads the format registers how to list them (core's lister, wgf_core_load_priv.h). The
/// task is DONE once all of them are local.
/// - A glTF file's buffers and images are listed, in a program with glTF (one that calls
///   wgf_mesh_create).
/// - A scene's files aren't listed yet. To ensure a scene ahead, also ensure the files its
///   lines name.
extern wgf_asset_task_status_t;
extern let WGF_ASSET_TASK_STATUS_NONE: wgf_asset_task_status_t;
extern let WGF_ASSET_TASK_STATUS_PENDING: wgf_asset_task_status_t;
extern let WGF_ASSET_TASK_STATUS_DONE: wgf_asset_task_status_t;
extern let WGF_ASSET_TASK_STATUS_FAILED: wgf_asset_task_status_t;

/// Sets the asset host that relative paths resolve against.
///
/// - A URL ("https://host/assets") is a fetch origin on both platforms. A missing file is
///   downloaded from it and cached: on the web in the browser's storage, and natively in
///   the cache directory, by the program (see fetching, below).
/// - Anything else is a local directory. An absolute path is used as it is.
/// - A relative path ("../assets") is read against the program's own directory on both
///   platforms: the executable's natively, and the page's on the web. It is never read
///   against the working directory. So the same line in a program means the same
///   everywhere, and a double-clicked program finds its files.
/// - A file: URL ("file:///opt/game/assets") names a local directory too, natively only. A
///   browser reads no file: URLs.
/// - NULL or "" puts back the default above, the program's directory, as "." does.
///
/// A local host is only ever read. A file downloaded under one, such as a fetch_url's file
/// or a "://" redirect's, goes in the cache directory, so a shipped file is never
/// overwritten. The paths are the same everywhere, and only the host differs.
///
/// Returns false for a host of 512 bytes or more, or for a relative one that makes too long
/// a path under the program's directory.
extern fn wgf_asset_set_host(host: const char*) -> bool;

/// Returns the host, as set or the default, without a trailing slash.
///
/// - Natively it is the storage root: the program's directory or the directory set, as a
///   path. A relative one is joined to the program's directory.
/// - On the web it is the directory of the document's base URL.
extern fn wgf_asset_get_host() -> const char*;

/// Sets the cache directory, natively: where downloads land and later runs find them.
///
/// It is a local directory, made as needed. By default it is the program's own directory
/// under the user's cache directory: <user cache>/<company>/<product>, by the program's
/// identity (see wgf_identity.h: set it for anything you ship).
/// - On Linux, <user cache> is $XDG_CACHE_HOME or ~/.cache.
/// - On macOS it is ~/Library/Caches.
/// - On Windows the directory is %LOCALAPPDATA%'s <company>/<product>/cache.
/// - Where there is no user cache directory, it is ".wgf-cache" in the storage root.
///
/// Set it before the first download. Returns false on the web, which caches in the
/// browser, and for a path of 512 bytes or more.
extern fn wgf_asset_set_cache_dir(dir: const char*) -> bool;

/// Returns the directory downloads go in, as set or the default above. Returns "" on the
/// web.
extern fn wgf_asset_get_cache_dir() -> const char*;

/// Sets or gets whether the program does downloads (default: off).
///
/// Turning it off fails the requests not yet taken, at the next update. Requests already
/// taken are still answered. The setter returns false on the web, where the browser
/// downloads.
extern fn wgf_asset_set_fetching(enabled: bool) -> bool;

extern fn wgf_asset_is_fetching() -> bool;

/// Returns the next download to do, oldest first, or 0 if there is none. Each one is handed
/// out once.
extern fn wgf_asset_fetch_next() -> wgf_asset_task_t;

/// Returns the URL a request downloads, and the destination to write it to.
///
/// Each string is borrowed, valid until the next call. Returns "" for a handle that isn't a
/// request waiting on its answer, and for a ping's destination.
extern fn wgf_asset_fetch_get_url(request: wgf_asset_task_t) -> const char*;

extern fn wgf_asset_fetch_get_dest(request: wgf_asset_task_t) -> const char*;

/// Returns whether a request is a ping.
///
/// For a ping, ask the URL, as a HEAD request does, and write nothing. Answer
/// wgf_asset_fetch_done with whether the host replied at all, with any status counting.
///
/// Returns false for a handle that isn't a request waiting on its answer.
extern fn wgf_asset_fetch_is_ping(request: wgf_asset_task_t) -> bool;

/// Answers a request with whether its download succeeded, or for a ping, whether the host
/// answered. Call it from any thread.
///
/// Returns false if the answer can't be taken: `request` isn't a request waiting on its
/// answer, or libwgf stopped meanwhile.
extern fn wgf_asset_fetch_done(request: wgf_asset_task_t, ok: bool) -> bool;

/// Sets or gets the fetch timeout, natively: the seconds a request may go unanswered, once
/// the downloader has taken it, before it fails (default: 0, which waits for ever).
///
/// Only a downloader can tell a slow download from a stalled one, as curl's low-speed limit
/// does. So the default hides nothing: a downloader that drops requests is a bug that shows
/// as tasks staying PENDING.
///
/// The setter returns false for a negative or non-finite value. It also returns false on
/// the web, where the browser fetches and the fetch has no timeout of its own, and stores
/// nothing there.
extern fn wgf_asset_set_fetch_timeout(seconds: f32) -> bool;

extern fn wgf_asset_get_fetch_timeout() -> f32;

/// Forgets a cached file, so the next load or ensure fetches it again.
///
/// It removes the file, and what was kept about it, from the browser's storage or the cache
/// directory. It never removes a local host's own file.
///
/// A cache can hold a file that is wrong rather than old, such as from a host that once
/// served gzip bytes under its name. Revalidation keeps such a file, and this drops it.
/// libwgf also drops a cached file itself when a loader rejects it, and fetches it once
/// more.
///
/// Returns false if there was no cached file, or for a path that isn't under the host (as
/// wgf_asset_ensure reads a path).
extern fn wgf_asset_evict(path: const char*) -> bool;

/// Enables loading assets again in place (wgf_asset_reload), or says whether it is enabled.
///
/// - The wgf tool's own builds enable it (`wgf serve`, `build`, and `run`); a game's export
///   doesn't. On the web the host decides: it is enabled when the host exports this call.
/// - Call it before the assets are made. What a reload keeps is kept from then on: the
///   changes a program makes to a document's elements, the name of a model's clip playing.
/// - Natively, with a local host, the files loaded are watched: a file saved, or one a loaded
///   file names, loads again by itself (wgf_asset_reload) once its save has settled, within
///   half a second. On the web `wgf serve` tells the page instead.
/// - Without it, nothing is kept for a reload, and a program pays nothing for one.
///
/// Returns true.
extern fn wgf_asset_enable_reload() -> bool;

extern fn wgf_asset_is_reload_enabled() -> bool;

/// Loads again, in place, every resource made from `path`, and every file that names it,
/// such as a glTF whose buffer or image it is. `wgf serve` does this with an asset saved
/// while the game runs. It needs wgf_asset_enable_reload.
///
/// - Each file is fetched anew, never from the cache or this run's store.
/// - Each resource keeps its handle, and stays READY all the while. Whatever uses it draws
///   the old data until the new file is in, then the new data, from that frame on.
/// - A glTF's tree is kept too (wgf_model.h). Each node's actor stays, moved and given its
///   new mesh. A node the file no longer has is removed with its actor, and a new node gets
///   a new actor.
/// - A file that doesn't load keeps what was loaded, with one error logged.
/// - A FAILED resource that now loads becomes READY.
/// - These load again: a texture (compressed ones too), an image, a cubemap, a glTF mesh
///   with its images, a sprite sheet, a Tiled map, an environment, a shader, a sound, a
///   font, a text buffer, a UI document, and a scene (with wgf_scene_enable_reload). Each
///   kind's header says what is kept across it.
/// - A resource still loading is left as it is.
///
/// Returns the number of resources set loading. Returns 0 if nothing was made from `path`,
/// for a path that isn't under the host, or when reload isn't enabled (logged once).
extern fn wgf_asset_reload(path: const char*) -> i32;

/// Returns true if wgf_asset_reload(path) would bring the saved file into everything made
/// from it: at least one resource was made from `path` or from a file that names it, and
/// each is of a kind that loads again. A tool that watches files asks this first, and starts
/// the program again for a file it can't load again in place.
///
/// Returns false if any resource made from it is of a kind that doesn't load again, if
/// nothing was made from it (a file not loaded yet),
/// for a path that isn't under the host, or when reload isn't enabled.
extern fn wgf_asset_can_reload(path: const char*) -> bool;

/// Forgets every cached file, so the next ensure of any file fetches it again. It also
/// forgets what was read of the manifests, so the root manifest is asked about again.
///
/// Natively, every file libwgf downloaded into the cache directory is deleted, with its
/// metadata and the directories that leaves empty. libwgf keeps a list of its downloads
/// there (".wgf-downloads"), and never deletes a file it didn't download.
///
/// Resources already made stay as they are. Call it while nothing is loading, since a load
/// in flight may fail.
extern fn wgf_asset_clear_cache();

/// How a cached file is treated on a later run.
///
///   REVALIDATE  the default. A copy still fresh by its Cache-Control (max-age not
///               passed, or immutable) is used without a request. Any other copy is
///               checked with the server first:
///               - 304: the copy is used, and is fresh again.
///               - 200: the new file replaces it.
///               - 4xx: the copy is deleted and the load fails.
///               - 5xx, or no answer (offline, a timeout): the copy is used.
///               no-cache and no-store make a copy never fresh, but it is kept, for the
///               next check and for starting offline. On the page's own origin the
///               check is a conditional GET. On another origin it is a GET the browser
///               revalidates from its own cache, since a conditional header there needs
///               CORS consent. So a changed file is always noticed, and an unchanged one
///               is stored again.
///   TRUST       a cached copy is used without asking, however old. For offline-first
///               play, a deploy whose files never change, or a program that evicts by
///               itself.
///   OFF         nothing is kept between runs, and what earlier runs kept is neither
///               used nor deleted. For development.
///
/// Natively, downloads in the cache directory are used as they are, in every mode. Asking
/// the server needs headers the program's fetcher doesn't carry. (Manifests do work
/// natively; see below.)
///
/// FORCE_FETCH is a plain GET in every mode, and fails without an answer. A mode applies to
/// every file checked after it is set.
extern wgf_asset_cache_mode_t;
extern let WGF_ASSET_CACHE_MODE_REVALIDATE: wgf_asset_cache_mode_t;
extern let WGF_ASSET_CACHE_MODE_TRUST: wgf_asset_cache_mode_t;
extern let WGF_ASSET_CACHE_MODE_OFF: wgf_asset_cache_mode_t;

/// Sets or gets the cache mode (default: REVALIDATE). The setter returns false for a value
/// that isn't a mode.
extern fn wgf_asset_set_cache_mode(mode: wgf_asset_cache_mode_t) -> bool;

extern fn wgf_asset_get_cache_mode() -> wgf_asset_cache_mode_t;

/// Sets the asset manifest, which holds a hash of each file's contents.
///
/// With a manifest, a cached copy whose hash still matches is used with no request, and a
/// file that changed is fetched once. tools/gen_manifest.py writes manifests, and `wgf
/// export` writes them into a game's web export.
///
/// - `path` is the root manifest's path, under the host ("manifest.json").
/// - A manifest lists the files beside it. For each directory it lists the hash of that
///   directory's own manifest.json. That manifest is fetched only when a file under it is
///   first needed, and only if its hash changed.
/// - The root is asked about once a run, as REVALIDATE asks, whatever the mode. Without an
///   answer the cached root is used. Without either, nothing is listed.
/// - A listed file is fetched past the browser's cache, and hashed before it is kept.
///   Bytes that don't match, such as from a host still serving the old file or a deploy
///   half done, are not kept, and the load fails (logged).
/// - These files are cached as the cache mode says: a file no manifest lists, a file
///   ensured with a fetch_url, and every file under a manifest that couldn't be read or
///   didn't match its hash.
/// - Natively a manifest needs a URL host and fetching.
///
/// NULL or "" sets no manifest (the default). Set it before the loads it should cover.
/// Setting it again forgets what was read of the last one.
///
/// Returns false for a path that isn't relative (one starting with "/" or holding "://"),
/// or for one of 512 bytes or more.
extern fn wgf_asset_set_manifest(path: const char*) -> bool;

/// Returns the root manifest's path, as set, or "" if there is none.
extern fn wgf_asset_get_manifest() -> const char*;

/// Makes a file local. Returns a task that is PENDING, then DONE or FAILED in a later
/// update, never in this call. A DONE task has a local path that opens directly.
///
///   path       the file, under the host, as a resource's create names it. "\" is read
///              as "/", and "." and ".." are resolved. A path that is absolute, names a
///              drive (any ":"), or climbs above the host is refused (0)
///   fetch_url  NULL, or the SOURCE only, for this call: a mirror, a signed link, or a
///              versioned name. The bytes are still cached and found under `path`. It
///              is read against the host as a browser reads a URL against a directory:
///              "music/v2/a.mp3" under it, "../x" beside it, "/x" at its origin's root,
///              and an absolute URL as it is. Natively an absolute one must be http or
///              https, and needs fetching, not a URL host. Under a local host a relative
///              one is a file under it, read where it is, held to `path`'s rules.
///              Anything else, such as a file: URL or one leaving a local host, is
///              refused (0)
///   flags      WGF_ASSET_ENSURE_* flags
///
/// The task is kept until wgf_asset_task_destroy. Returns 0 if a path is refused as above,
/// or if there is no room for another task.
extern fn wgf_asset_ensure(path: const char*, fetch_url: const char*, flags: u32) -> wgf_asset_task_t;

/// Returns a task's status, for a file, a group, or a ping. Returns NONE for a handle that
/// isn't a task. The status changes only in an update, so a frame reading it sees each
/// change once.
extern fn wgf_asset_task_get_status(task: wgf_asset_task_t) -> wgf_asset_task_status_t;

/// Returns the local path of a DONE file task, which opens directly.
///
/// It is where the file was found, such as through a redirect or a fetch_url. The path is
/// borrowed, valid while the task is, until the next ensure. Returns "" until the task is
/// DONE, for a group, and for a handle that isn't a task.
extern fn wgf_asset_task_get_path(task: wgf_asset_task_t) -> const char*;

/// Returns a task's rough progress, from 0 to 1.
///
/// - A file counts half for being local, and half for the files it names.
/// - A group's progress is its members' average.
/// - It is 1 once DONE or FAILED.
///
/// Returns 0 for a handle that isn't a task. For resources that are loading, read their
/// statuses instead (wgf_resource.h).
extern fn wgf_asset_task_get_progress(task: wgf_asset_task_t) -> f32;

/// Destroys a task. A task still PENDING runs on, and its result is dropped, though a file
/// still lands in the cache. A group's members are destroyed with it. Returns false for a
/// handle that isn't a task.
extern fn wgf_asset_task_destroy(task: wgf_asset_task_t) -> bool;

/// Creates a group: one task for many files, such as a level's files fetched ahead.
///
/// - A group is DONE once every member is.
/// - It is FAILED once every member has finished and any of them failed.
/// - An empty group is DONE at the next update.
/// - Members keep their own statuses and paths.
extern fn wgf_asset_group_create() -> wgf_asset_task_t;

/// Adds a file task (from wgf_asset_ensure) to a group, whether or not it has finished.
/// Returns false for a handle that isn't a file task, for a task already in a group, or for
/// a group that has finished.
extern fn wgf_asset_group_add(group: wgf_asset_task_t, task: wgf_asset_task_t) -> bool;

/// Adds a redirect, or clears them all. A redirect takes files from somewhere else, for
/// mods, translations, or a CDN. Files whose path starts with `prefix` are looked for under
/// `target` instead:
///
///   wgf_asset_add_redirect("textures/", "mods/hd/textures/");
///       textures/rock.png loads mods/hd/textures/rock.png if it exists, else its own
///   wgf_asset_add_redirect("models/", "https://cdn.example.com/game/models/");
///       a target with "://" is where the file downloads from (by the browser, or
///       natively by the program's fetcher). It is still cached and loaded as models/...
///
/// - Path rules stack. Every matching rule is tried, the last added first, then the file's
///   own path. So later rules sit on top: a mod over a mod, or fr-CA over fr.
/// - A file missing under a path rule isn't an error. The next rule is tried (on the web,
///   with a request each).
/// - A download rule doesn't stack. The newest matching one is where the file downloads
///   from.
/// - Prefixes are plain text, matched at the start: "textures/", not "*.png".
///
/// Redirects apply to every file a create loads, or an ensure makes local unless it gave a
/// fetch_url. They also apply to the files those name, such as a model's buffers and images,
/// beside wherever the model came from. wgf_resource_get_path and wgf_asset_task_get_path
/// say which file was found.
///
/// There can be up to 32 rules. add_redirect returns false when they are full, for an empty
/// prefix or target, or for a prefix or path target not under the host (as
/// wgf_asset_ensure reads a path). A trailing "/" is kept.
extern fn wgf_asset_add_redirect(prefix: const char*, target: const char*) -> bool;

extern fn wgf_asset_clear_redirects();

/// Pings an asset host. Returns a task that, in a later update, is DONE if the host answered
/// within `timeout_ms` milliseconds, or FAILED if it didn't.
///
/// - A `timeout_ms` of 0 or less means 5000.
/// - NULL pings the current host.
/// - On the web it is a HEAD request. Any response counts, even a 404, and another origin
///   needs no CORS headers.
/// - Natively, a local host is DONE if its directory exists. A URL host is asked through
///   the program's fetcher, as a ping request (wgf_asset_fetch_is_ping). Without fetching,
///   the task is FAILED.
///
/// Returns 0 if there is no room for another task.
extern fn wgf_asset_ping_host(host: const char*, timeout_ms: i32) -> wgf_asset_task_t;

/// Returns a DONE ping's round trip, in milliseconds. Returns 0 for a ping that isn't DONE,
/// and for a handle that isn't a ping.
extern fn wgf_asset_ping_get_milliseconds(ping: wgf_asset_task_t) -> f32;

// ---- wgf_text_buffer.h ----

/// Creates a text buffer from a file, read as UTF-8 (a byte order mark at its start is
/// dropped).
///
/// Returns 0 only if there is no room for another buffer. A path or file that can't be loaded
/// gives a buffer that FAILED (logged once, naming the file). A file over 16 MiB fails.
extern fn wgf_text_buffer_create(path: const char*) -> wgf_text_buffer_t;

/// Creates a text buffer holding `text` (NULL is ""), READY at once.
///
/// Returns 0 if there is no room for another buffer, no memory, or `text` is over 16 MiB
/// (logged).
extern fn wgf_text_buffer_create_text(text: const char*) -> wgf_text_buffer_t;

/// Sets or gets the buffer's text.
///
/// The text read is the buffer's own: valid until the buffer's text next changes or it is
/// released. Copy it to keep it.
///
/// set_text returns false, changing nothing, for a buffer that isn't READY, or a text that
/// would take it over 16 MiB (logged). NULL is "".
extern fn wgf_text_buffer_set_text(buffer: wgf_text_buffer_t, text: const char*) -> bool;

extern fn wgf_text_buffer_get_text(buffer: wgf_text_buffer_t) -> const char*;

/// Adds `text` to the end of the buffer: a chat's new message, a log's new line.
///
/// Returns false, changing nothing, as set_text does. Adding "" or NULL changes nothing and
/// returns true.
extern fn wgf_text_buffer_append(buffer: wgf_text_buffer_t, text: const char*) -> bool;

/// Returns the text's length in bytes, without its ending NUL: 0 for a buffer that isn't
/// READY.
extern fn wgf_text_buffer_get_length(buffer: wgf_text_buffer_t) -> i32;

/// Returns a number that changes each time the buffer's text does: set, added to, or loaded
/// again. Compare it with the one last seen to know the text changed. 0 for a buffer that
/// isn't READY.
extern fn wgf_text_buffer_get_version(buffer: wgf_text_buffer_t) -> i32;

// ---- wgf_actor.h ----

extern wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_NONE: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_PLAIN: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_STAGE2D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_SPRITE: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_CAMERA2D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_TEXT: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_SHAPE2D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_EMITTER2D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_CAMERA3D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_STAGE3D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_LIGHT: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_MODEL: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_SHAPE3D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_EMITTER3D: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_SPRITE_BATCH: wgf_actor_kind_t;
extern let WGF_ACTOR_KIND_TILEMAP_LAYER: wgf_actor_kind_t;

/// What wgf_actor_destroy does with the actor's children.
extern wgf_actor_destroy_t;
extern let WGF_ACTOR_DESTROY_CHILDREN: wgf_actor_destroy_t;
extern let WGF_ACTOR_KEEP_CHILDREN: wgf_actor_destroy_t;

/// Creates a plain actor: a transform, with no parent.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_actor_create() -> wgf_actor_t;

/// Destroys an actor of any kind, at once.
///
/// The resources it held are released, never destroyed. For example, a sprite drops its
/// reference to its texture.
extern fn wgf_actor_destroy(actor: wgf_actor_t, children: wgf_actor_destroy_t);

/// Returns the actor's kind (a sprite, a model, a stage), which says which calls it takes.
///
/// Returns NONE if `actor` isn't an actor, or is gone.
extern fn wgf_actor_get_kind(actor: wgf_actor_t) -> wgf_actor_kind_t;

/// Sets or gets the actor's parent, and reads its children.
///
/// set_parent puts `actor` under `parent`, last among its children. The actor keeps its own
/// transform, so it moves to where that transform places it relative to the new parent.
/// A `parent` of 0 detaches it, and a detached actor is not drawn.
///
/// set_parent returns false if:
/// - `parent` isn't an actor.
/// - `parent` is `actor`, or is under it.
/// - `actor` is a 2D or 3D stage. Stages are always roots.
extern fn wgf_actor_set_parent(actor: wgf_actor_t, parent: wgf_actor_t) -> bool;

extern fn wgf_actor_get_parent(actor: wgf_actor_t) -> wgf_actor_t;

extern fn wgf_actor_get_child_count(actor: wgf_actor_t) -> i32;

/// Returns the child at `index`, 0 first. Returns 0 if there is none.
extern fn wgf_actor_get_child(actor: wgf_actor_t, index: i32) -> wgf_actor_t;

/// Sets or gets where `actor` is among its parent's children.
///
/// On a 2D stage this is the drawing order: later children draw over earlier ones. An index
/// past either end is clamped to that end, so a large index moves the actor to the front.
///
/// set_index returns false if the actor has no parent.
extern fn wgf_actor_set_index(actor: wgf_actor_t, index: i32) -> bool;

extern fn wgf_actor_get_index(actor: wgf_actor_t) -> i32;

/// Moves `actor` to the last place among its parent's children, or the first.
///
/// On a 2D stage the last child draws over the others (the front), and the first under them
/// (the back). Each returns false if the actor has no parent.
extern fn wgf_actor_move_to_front(actor: wgf_actor_t) -> bool;

extern fn wgf_actor_move_to_back(actor: wgf_actor_t) -> bool;

/// Sets or gets the actor's transform, relative to its parent.
///
/// - Rotation is three angles in radians, about x, then y, then z (see wgf_quat_from_euler).
///   It is kept as the rotation those angles make. get_rotation returns angles for the same
///   rotation, which may not be the ones given (past a half turn, for example).
/// - Scale 1 is the actor's own size.
extern fn wgf_actor_set_position(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_actor_get_position(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_actor_set_rotation(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_actor_get_rotation(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_actor_set_scale(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_actor_get_scale(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets position, rotation, and scale at once. It is the cheapest way to move an actor each frame.
extern fn wgf_actor_set_transform(
    actor: wgf_actor_t,
    position_x: f32,
    position_y: f32,
    position_z: f32,
    rotation_x: f32,
    rotation_y: f32,
    rotation_z: f32,
    scale_x: f32,
    scale_y: f32,
    scale_z: f32
) -> bool;

/// Ends the smoothing of a simulated actor, so it is drawn where it is now.
///
/// An actor with a simulated component (motion, bounds, lifetime, or a collider: see
/// wgf_component.h) moves at the tick rate. Its transform is the simulation's. Each frame it is
/// drawn between its last two ticks' transforms, at the frame's tick fraction, so it moves
/// smoothly at any frame rate. A change made in a tick is smoothed into the frames after it.
/// Snap ends that smoothing: an actor put somewhere new isn't seen sweeping there.
///
/// Returns false if `actor` isn't an actor. Returns true, and does nothing, for an actor that
/// isn't simulated.
extern fn wgf_actor_snap(actor: wgf_actor_t) -> bool;

/// Sets or gets the positions, rotations, and scales of many actors at once: one call for all
/// of `actors` (`count` of them), where a call each would cross into the library once an actor.
///
/// Each array holds x, y, z for each actor in turn, as the one-actor calls above take and give
/// them: a rotation as three angles in radians. Any of the three may be NULL, with a count of
/// 0: set_transforms leaves that part of each actor as it is, and get_transforms fills nothing
/// there. So moving many actors is set_transforms with positions alone.
///
/// set_transforms skips a handle that isn't an actor. It returns false, and sets nothing, if
/// an array that isn't NULL hasn't three floats for each actor, or a count is below 0.
///
/// get_transforms reads as many actors as fit in every array given, and returns how many floats
/// it filled in each: three an actor. A handle that isn't an actor reads as 0, 0, 0.
extern fn wgf_actor_set_transforms(
    actors: const wgf_actor_t*,
    count: i32,
    positions: const f32*,
    positions_count: i32,
    rotations: const f32*,
    rotations_count: i32,
    scales: const f32*,
    scales_count: i32
) -> bool;

extern fn wgf_actor_get_transforms(
    actors: const wgf_actor_t*,
    count: i32,
    positions: f32*,
    positions_count: i32,
    rotations: f32*,
    rotations_count: i32,
    scales: f32*,
    scales_count: i32
) -> i32;

/// Returns where the actor is in its tree's root's space. On a 2D stage, that is stage units.
///
/// - The world position is the simulation's, as the transform is (see wgf_actor_snap). It is
///   the same in a tick and in a frame.
/// - The drawn position is where the actor is drawn this frame. A simulated actor, or one under
///   a simulated actor, is drawn between its last two ticks. A camera that follows the actor in
///   the frame reads this, so the camera moves as smoothly as the actor does.
///
/// The two are the same for an actor with nothing simulated at or above it.
extern fn wgf_actor_get_world_position(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_actor_get_drawn_position(actor: wgf_actor_t) -> wgf_vec3_t;

/// Turns a direction in the actor's own space into its tree's root's space, at unit length.
///
/// For example, (0, 0, -1) gives the actor's heading in the world, with no angles to read back
/// (get_rotation's angles may not be the ones set). The world direction is the simulation's,
/// and the drawn direction is this frame's, as with the positions above.
///
/// Returns 0, 0, 0 for a direction of (0, 0, 0), or if `actor` isn't an actor.
extern fn wgf_actor_get_world_direction(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> wgf_vec3_t;

extern fn wgf_actor_get_drawn_direction(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> wgf_vec3_t;

/// Turns the actor so its -z points at the target (x, y, z).
///
/// Its +y is turned as near to the up direction (up_x, up_y, up_z) as it can be. The target
/// and up direction are both in its tree's root's space. This is how you aim a camera, since a
/// camera looks down its -z. The rotation is set relative to the parent, so the actor points at
/// the target from where it is placed now.
///
/// Returns false if the target is where the actor is, or if the up direction lies along the
/// line to the target.
extern fn wgf_actor_look_at(actor: wgf_actor_t, x: f32, y: f32, z: f32, up_x: f32, up_y: f32, up_z: f32) -> bool;

/// Sets or gets a name to find the actor by.
///
/// - NULL or "" means no name (default: no name).
/// - get_name returns "" for no name. The string is borrowed, and valid until the name changes
///   or the actor is gone.
/// - Its stage finds the actor by name (wgf_stage2d_find, wgf_stage3d_find) when it is the only
///   actor so named there.
/// - A path from any actor finds it (wgf_actor_find) when its name is unique among its
///   siblings.
extern fn wgf_actor_set_name(actor: wgf_actor_t, name: const char*) -> bool;

extern fn wgf_actor_get_name(actor: wgf_actor_t) -> const char*;

/// Returns the actor at `path` from `actor`.
///
/// A path is child names joined by '/'. So "wheel_rl/smoke" is the child "smoke" of the child
/// "wheel_rl". Each step looks only among one actor's children, never through the tree, and
/// takes the first child so named, in order.
///
/// Returns 0 if no actor is found, if a step is empty ("a//b"), or if `path` is empty or
/// NULL.
extern fn wgf_actor_find(actor: wgf_actor_t, path: const char*) -> wgf_actor_t;

/// Sets or gets the four flags that say what an actor takes part in.
///
/// Each flag is the actor's own, and reads back as it was set.
///
///   enabled   off: the actor and every actor under it are skipped altogether, by drawing and
///             by every update, as if they weren't in the tree. An emitter under it isn't
///             moved on. Use it to switch off a part of the game for now. It is the only flag
///             that reaches the children. Their own flags are kept, so enabling the actor
///             again brings each back as it was set.
///   visible   off: the actor's own output is off. A sprite, shape, text, or emitter isn't
///             drawn. The actor is still placed, and its children are as they are. A glTF
///             file's root (wgf_model.h) draws nothing itself, and stands for its file:
///             hidden, its file's nodes aren't drawn or picked either. Actors a game put under
///             those nodes are as they are. To hide a whole tree, turn enabled off.
///   paused    on: the actor and every actor under it are frozen, but still drawn. Their
///             behaviors don't tick. Their components' systems (motion, arcade bodies, bounds,
///             lifetimes) and tweens leave them. What moves by itself holds still: an
///             emitter's particles, a sprite's clip, a model's animation. Use it to hold a
///             level under a pause menu (wgf_screen.h pauses the screens under the top one).
///             Its colliders still meet as triggers. is_frozen returns true if the actor or
///             any actor above it is paused.
///   pickable  off: a pick (wgf_stage2d_pick, wgf_stage3d_pick) and the pointer
///             (wgf_pointer.h) pass through the actor to what is under it. Its children can
///             still be hit, as a panel that isn't clickable can hold buttons that are. Only
///             actors with a surface to hit are ever picked: a sprite, a 2D shape, a text, a
///             model, or a 3D shape. For any other kind this flag changes nothing.
///
/// Defaults: enabled, visible, not paused, pickable.
extern fn wgf_actor_set_enabled(actor: wgf_actor_t, enabled: bool) -> bool;

extern fn wgf_actor_is_enabled(actor: wgf_actor_t) -> bool;

extern fn wgf_actor_set_paused(actor: wgf_actor_t, paused: bool) -> bool;

extern fn wgf_actor_is_paused(actor: wgf_actor_t) -> bool;

extern fn wgf_actor_is_frozen(actor: wgf_actor_t) -> bool;

extern fn wgf_actor_set_visible(actor: wgf_actor_t, visible: bool) -> bool;

extern fn wgf_actor_is_visible(actor: wgf_actor_t) -> bool;

extern fn wgf_actor_set_pickable(actor: wgf_actor_t, pickable: bool) -> bool;

extern fn wgf_actor_is_pickable(actor: wgf_actor_t) -> bool;

// ---- wgf_camera2d.h ----

/// Creates a 2D camera, at zoom 1.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_camera2d_create() -> wgf_actor_t;

/// Sets or gets the camera's zoom: how big actors look. A zoom of 2 draws everything twice as
/// big (default: 1).
///
/// set_zoom returns false for a zoom of 0 or less.
extern fn wgf_camera2d_set_zoom(camera: wgf_actor_t, zoom: f32) -> bool;

extern fn wgf_camera2d_get_zoom(camera: wgf_actor_t) -> f32;

// ---- wgf_camera3d.h ----

/// Creates a 3D camera with a 60 degree vertical field of view, seeing from 0.1 to 1000 units
/// in front of it.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_camera3d_create() -> wgf_actor_t;

/// Sets or gets the vertical field of view, in radians.
///
/// It is clamped to 0.01 to 3.13 (just short of a half turn).
extern fn wgf_camera3d_set_fov(camera: wgf_actor_t, radians: f32) -> bool;

extern fn wgf_camera3d_get_fov(camera: wgf_actor_t) -> f32;

/// Sets or gets how near and how far in front of the camera it sees, in units.
///
/// set_clip returns false unless 0 < `near_z` < `far_z`.
extern fn wgf_camera3d_set_clip(camera: wgf_actor_t, near_z: f32, far_z: f32) -> bool;

extern fn wgf_camera3d_get_near(camera: wgf_actor_t) -> f32;

extern fn wgf_camera3d_get_far(camera: wgf_actor_t) -> f32;

/// Sets or gets whether the camera is orthographic (true) or perspective (false) (default:
/// perspective).
extern fn wgf_camera3d_set_orthographic(camera: wgf_actor_t, orthographic: bool) -> bool;

extern fn wgf_camera3d_is_orthographic(camera: wgf_actor_t) -> bool;

/// Sets or gets how tall a view an orthographic camera sees, in units (default: 10).
///
/// set_ortho_height returns false for a height of 0 or less.
extern fn wgf_camera3d_set_ortho_height(camera: wgf_actor_t, height: f32) -> bool;

extern fn wgf_camera3d_get_ortho_height(camera: wgf_actor_t) -> f32;

/// Converts between the world and the screen's logical pixels, through the camera as it is now.
///
/// The world is the camera's tree's root's space. The view fills the visible area, as a stage
/// draws it.
///
/// - world_to_screen returns where a point shows: x and y on the screen, and z its depth. Depth
///   runs from 0 at the near plane to 1 at the far plane. Below 0 is behind the camera, where a
///   name tag would be hidden.
/// - screen_to_origin and screen_to_direction return the ray under a place on the screen. Its
///   origin is on the near plane, and its direction is a unit vector. Use it for picking, or
///   for a click in the world.
///
/// Each returns 0, 0, 0 if `camera` isn't a 3D camera.
extern fn wgf_camera3d_world_to_screen(camera: wgf_actor_t, x: f32, y: f32, z: f32) -> wgf_vec3_t;

extern fn wgf_camera3d_screen_to_origin(camera: wgf_actor_t, x: f32, y: f32) -> wgf_vec3_t;

extern fn wgf_camera3d_screen_to_direction(camera: wgf_actor_t, x: f32, y: f32) -> wgf_vec3_t;

// ---- wgf_color.h ----
extern let WGF_COLOR_BEIGE: wgf_color_t;
extern let WGF_COLOR_BLACK: wgf_color_t;
extern let WGF_COLOR_BLANK: wgf_color_t;
extern let WGF_COLOR_BLUE: wgf_color_t;
extern let WGF_COLOR_BROWN: wgf_color_t;
extern let WGF_COLOR_DARKBLUE: wgf_color_t;
extern let WGF_COLOR_DARKBROWN: wgf_color_t;
extern let WGF_COLOR_DARKGRAY: wgf_color_t;
extern let WGF_COLOR_DARKGREEN: wgf_color_t;
extern let WGF_COLOR_DARKPURPLE: wgf_color_t;
extern let WGF_COLOR_GOLD: wgf_color_t;
extern let WGF_COLOR_GRAY: wgf_color_t;
extern let WGF_COLOR_GREEN: wgf_color_t;
extern let WGF_COLOR_LIGHTGRAY: wgf_color_t;
extern let WGF_COLOR_LIME: wgf_color_t;
extern let WGF_COLOR_MAGENTA: wgf_color_t;
extern let WGF_COLOR_MAROON: wgf_color_t;
extern let WGF_COLOR_ORANGE: wgf_color_t;
extern let WGF_COLOR_PINK: wgf_color_t;
extern let WGF_COLOR_PURPLE: wgf_color_t;
extern let WGF_COLOR_RAYWHITE: wgf_color_t;
extern let WGF_COLOR_RED: wgf_color_t;
extern let WGF_COLOR_SKYBLUE: wgf_color_t;
extern let WGF_COLOR_VIOLET: wgf_color_t;
extern let WGF_COLOR_WHITE: wgf_color_t;
extern let WGF_COLOR_YELLOW: wgf_color_t;

/// The stock colors' names. A name isn't a color: wgf_color_get turns a name into its color.
///
/// A packed color doesn't fit in an enum, so names are what a binding can see.
extern wgf_color_stock_t;
extern let WGF_COLOR_STOCK_BLANK: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_WHITE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_BLACK: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_LIGHTGRAY: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_GRAY: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_DARKGRAY: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_YELLOW: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_GOLD: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_ORANGE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_PINK: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_RED: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_MAROON: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_GREEN: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_LIME: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_DARKGREEN: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_SKYBLUE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_BLUE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_DARKBLUE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_PURPLE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_VIOLET: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_DARKPURPLE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_BEIGE: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_BROWN: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_DARKBROWN: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_MAGENTA: wgf_color_stock_t;
extern let WGF_COLOR_STOCK_RAYWHITE: wgf_color_stock_t;

/// Returns the stock color `stock` names, or 0 (transparent) for a value that names none.
extern fn wgf_color_get(stock: wgf_color_stock_t) -> wgf_color_t;

/// Makes a color from components, clamped.
///
/// - make takes components from 0 to 255.
/// - make_float takes components from 0 to 1, and rounds to the nearest 8-bit step.
/// - Out-of-range components saturate. They never spill into the next channel.
extern fn wgf_color_make(r: i32, g: i32, b: i32, a: i32) -> wgf_color_t;

extern fn wgf_color_make_float(r: f32, g: f32, b: f32, a: f32) -> wgf_color_t;

/// Returns `color` with its alpha replaced by `a`, clamped to 0..255.
extern fn wgf_color_with_alpha(color: wgf_color_t, a: i32) -> wgf_color_t;

/// Returns a color's components, each 0..255.
extern fn wgf_color_get_red(color: wgf_color_t) -> i32;

extern fn wgf_color_get_green(color: wgf_color_t) -> i32;

extern fn wgf_color_get_blue(color: wgf_color_t) -> i32;

extern fn wgf_color_get_alpha(color: wgf_color_t) -> i32;

/// Blends straight from `from` (t = 0) to `to` (t = 1), component by component.
/// `t` is clamped to 0..1.
extern fn wgf_color_lerp(from: wgf_color_t, to: wgf_color_t, t: f32) -> wgf_color_t;

/// Makes a color from hue, saturation, and value, or gets a color's hue, saturation, and value.
///
/// - `hue` is in degrees, wrapped into 0..360.
/// - `saturation` and `value` are 0..1, clamped.
/// - `a`, the alpha, is 0..255.
///
/// Use it to walk a palette round the color wheel, or for a hit flash.
extern fn wgf_color_make_hsv(hue: f32, saturation: f32, value: f32, a: i32) -> wgf_color_t;

extern fn wgf_color_get_hue(color: wgf_color_t) -> f32;

extern fn wgf_color_get_saturation(color: wgf_color_t) -> f32;

extern fn wgf_color_get_value(color: wgf_color_t) -> f32;

/// Brightens or multiplies a color.
///
/// - brighten makes `color` lighter toward white by `amount` (0..1), or darker toward black
///   by a negative `amount`. Its alpha is kept.
/// - multiply multiplies two colors channel by channel, as a tint is applied.
extern fn wgf_color_brighten(color: wgf_color_t, amount: f32) -> wgf_color_t;

extern fn wgf_color_multiply(color: wgf_color_t, by: wgf_color_t) -> wgf_color_t;

// ---- wgf_cubemap.h ----

/// How one image holds the six faces. A face is a square of `size` pixels.
extern wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_AUTO: wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_LINE_VERTICAL: wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_LINE_HORIZONTAL: wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR: wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE: wgf_cubemap_layout_t;
extern let WGF_CUBEMAP_LAYOUT_FACES: wgf_cubemap_layout_t;

/// Creates a cubemap from the image file at `path`: PNG, JPEG, BMP, TGA, or GIF's first frame.
///
/// - The faces are laid out by `layout`. With AUTO, they are laid out by the image's shape.
/// - Creating the same path again gives the same cubemap, with one more reference. It keeps
///   the layout the first create gave. Another layout is warned about.
/// - An image whose shape isn't exactly the layout's (such as a 6 by 1 row of square faces)
///   FAILS.
/// - AUTO also FAILS for a shape that is none of the layouts.
///
/// Returns 0 for a `layout` that isn't a layout or is FACES (logged), or if there is no room
/// for another cubemap.
extern fn wgf_cubemap_create(path: const char*, layout: wgf_cubemap_layout_t) -> wgf_cubemap_t;

/// Creates a cubemap from six image files, one for each face.
///
/// - The faces must be square and all the same size, or the cubemap FAILS (logged, naming
///   the face).
/// - Each call makes a new cubemap, never shared.
/// - wgf_resource_get_path gives +X's file.
///
/// Returns 0 for a NULL path, or if there is no room for another cubemap.
extern fn wgf_cubemap_create_faces(
    positive_x: const char*,
    negative_x: const char*,
    positive_y: const char*,
    negative_y: const char*,
    positive_z: const char*,
    negative_z: const char*
) -> wgf_cubemap_t;

/// Returns a face's size in pixels, or 0 until the cubemap is READY.
extern fn wgf_cubemap_get_size(cubemap: wgf_cubemap_t) -> i32;

/// Returns how the cubemap's faces were read.
///
/// - It is the layout given, or, once READY, the one AUTO found.
/// - It is FACES for a cubemap of six files.
/// - It is AUTO for a handle that isn't a cubemap, or one AUTO hasn't read yet.
extern fn wgf_cubemap_get_layout(cubemap: wgf_cubemap_t) -> wgf_cubemap_layout_t;

// ---- wgf_draw.h ----

/// Immediate mode 2D drawing: each call draws once, in the frame it is made in, and keeps nothing.
///
/// - Calls draw in the order made, along with everything else drawn that frame.
/// - Coordinates are logical pixels from the frame's top-left, with y down (wgf_render.h).
/// - A draw outside a frame draws nothing.
///
/// Outlines and lines have a thickness in logical pixels, centered on the line. A thickness
/// of 0 or less draws a hairline one logical pixel wide. A polyline's corners are mitred.
/// Where a sharp corner's miter would reach past four thicknesses, the corner is bevelled.
extern fn wgf_draw_rectangle(x: f32, y: f32, width: f32, height: f32, color: wgf_color_t);

extern fn wgf_draw_rectangle_lines(x: f32, y: f32, width: f32, height: f32, thickness: f32, color: wgf_color_t);

/// Draws a rectangle with rounded corners, filled or outlined, such as a panel or a button.
///
/// - Each corner is a quarter circle of `radius` logical pixels, clamped to half the
///   rectangle's shorter side.
/// - A `radius` of 0 or less gives square corners: the plain rectangle.
/// - Each corner is drawn with `segments` straight edges (at most 64).
/// - A `segments` of 0 or less uses enough for the corner's size on screen, as a circle does.
extern fn wgf_draw_rectangle_rounded(
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    radius: f32,
    segments: i32,
    color: wgf_color_t
);

extern fn wgf_draw_rectangle_rounded_lines(
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    radius: f32,
    segments: i32,
    thickness: f32,
    color: wgf_color_t
);

extern fn wgf_draw_line(x0: f32, y0: f32, x1: f32, y1: f32, thickness: f32, color: wgf_color_t);

/// Draws a circle, filled or outlined, with enough segments for its size on screen.
extern fn wgf_draw_circle(center_x: f32, center_y: f32, radius: f32, color: wgf_color_t);

extern fn wgf_draw_circle_lines(center_x: f32, center_y: f32, radius: f32, thickness: f32, color: wgf_color_t);

extern fn wgf_draw_triangle(x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32, color: wgf_color_t);

/// Draws lines through `points`, joining the last point to the first when `closed` is true.
///
/// `points` holds x and y in turn: `count` floats, so count / 2 points.
///
/// Returns false, drawing nothing, for an odd `count`, fewer than 2 points, or a NULL `points`.
extern fn wgf_draw_polyline(points: const f32*, count: i32, closed: bool, thickness: f32, color: wgf_color_t) -> bool;

/// Draws a spline (wgf_spline.h) through or near `points`, as its `kind` makes it.
///
/// The spline is drawn as a polyline of `steps` points for each segment. A `steps` of 0 or
/// less uses 24.
///
/// Returns false for points that make no segment.
extern fn wgf_draw_spline(
    kind: wgf_spline_kind_t,
    points: const f32*,
    count: i32,
    steps: i32,
    thickness: f32,
    color: wgf_color_t
) -> bool;

/// Draws the polygon through `points`, filled.
///
/// - `points` holds x and y in turn: `count` floats.
/// - The polygon may be convex or not, in either winding, as long as its edges don't cross.
/// - A polygon that crosses itself is filled as the fan from its first point.
///
/// Returns false, drawing nothing, for an odd `count`, fewer than 3 points, or a NULL `points`.
extern fn wgf_draw_polygon(points: const f32*, count: i32, color: wgf_color_t) -> bool;

/// Draws UTF-8 `text` with its top-left at (x, y). Newlines break lines.
///
/// - `font` 0 uses the default font.
/// - `size` is in logical pixels. A `size` of 0 or less uses 16.
extern fn wgf_draw_text(font: wgf_font_t, text: const char*, x: f32, y: f32, size: f32, color: wgf_color_t);

/// Sets or gets how immediate mode drawing after this call blends with what is under it.
///
/// The modes are wgf_material.h's alpha modes: BLEND (the default), OPAQUE, ADD, MULTIPLY,
/// and PREMULTIPLIED. MASK draws as BLEND, because immediate mode cuts nothing out. The mode
/// stays as set from frame to frame, until it is set again.
///
/// The setter returns false for a `mode` that isn't an alpha mode.
extern fn wgf_draw_set_blend_mode(mode: wgf_alpha_mode_t) -> bool;

extern fn wgf_draw_get_blend_mode() -> wgf_alpha_mode_t;

/// Sets or gets the spacing added between letters and between lines, in logical pixels.
///
/// It applies to text drawn and measured after this call (wgf_draw_text, wgf_font_measure).
/// A text actor has its own spacing.
///
/// Both start at 0. A number that isn't finite is taken as 0.
extern fn wgf_draw_set_text_spacing(letter: f32, line: f32);

extern fn wgf_draw_get_text_spacing() -> wgf_vec2_t;

/// Draws text as wgf_draw_text does, with (x, y) as the point the text is aligned to.
///
/// `horizontal` aligns the text's left, center, or right to x. `vertical` aligns its top,
/// middle, or bottom to y (wgf_text.h's alignments). A HUD anchored to the visible area's
/// right edge (wgf_presentation_get_visible) then needs no guessed width.
extern fn wgf_draw_text_aligned(
    font: wgf_font_t,
    text: const char*,
    x: f32,
    y: f32,
    size: f32,
    color: wgf_color_t,
    horizontal: wgf_text_halign_t,
    vertical: wgf_text_valign_t
);

/// Draws a texture into the rectangle (x, y, width, height), multiplied by `tint`.
///
/// - A white `tint` leaves the texture as it is.
/// - A width or height of 0 or less draws the texture at its own size.
/// - Nothing is drawn while the texture is PENDING.
/// - The placeholder checker is drawn once the texture has FAILED.
extern fn wgf_draw_texture(texture: wgf_texture_t, x: f32, y: f32, width: f32, height: f32, tint: wgf_color_t);

/// Draws a region of a texture into the rectangle (x, y, width, height), as an icon is cut
/// from an atlas.
///
/// - The source region is in the texture's pixels, from its top-left.
/// - A source width or height of 0 or less uses the whole texture.
/// - A width or height of 0 or less draws the region at its own size.
/// - The placeholder fills the rectangle once the texture has FAILED.
extern fn wgf_draw_texture_region(
    texture: wgf_texture_t,
    source_x: f32,
    source_y: f32,
    source_width: f32,
    source_height: f32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    tint: wgf_color_t
);

/// Draws rings, sectors, arcs, and ellipses.
///
/// - wgf_draw_ring draws the band between two radii, from angle `start` to `end`.
/// - Angles are in radians from +x, clockwise on the screen.
/// - A whole turn draws a full ring. An inner radius of 0 draws a sector, such as a pie.
/// - wgf_draw_arc draws a ring `thickness` wide along a circle.
/// - wgf_draw_ellipse and wgf_draw_ellipse_lines draw an ellipse filled and outlined.
extern fn wgf_draw_ring(
    center_x: f32,
    center_y: f32,
    inner_radius: f32,
    outer_radius: f32,
    start: f32,
    end: f32,
    color: wgf_color_t
);

extern fn wgf_draw_arc(
    center_x: f32,
    center_y: f32,
    radius: f32,
    start: f32,
    end: f32,
    thickness: f32,
    color: wgf_color_t
);

extern fn wgf_draw_ellipse(center_x: f32, center_y: f32, radius_x: f32, radius_y: f32, color: wgf_color_t);

extern fn wgf_draw_ellipse_lines(
    center_x: f32,
    center_y: f32,
    radius_x: f32,
    radius_y: f32,
    thickness: f32,
    color: wgf_color_t
);

/// Draws gradients.
///
/// - A rectangle gives each of its four corners its own color, blended between them. Make
///   two corners alike for a vertical or a horizontal gradient.
/// - A circle blends from its center's color (`inner`) to its edge's (`outer`).
extern fn wgf_draw_rectangle_gradient(
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    top_left: wgf_color_t,
    top_right: wgf_color_t,
    bottom_right: wgf_color_t,
    bottom_left: wgf_color_t
);

extern fn wgf_draw_circle_gradient(center_x: f32, center_y: f32, radius: f32, inner: wgf_color_t, outer: wgf_color_t);

/// Draws a texture's region, as wgf_draw_texture_region does, turned about a pivot.
///
/// The region is drawn `width` by `height`, with its pivot at (x, y), turned `radians` about it.
/// The pivot is a share of the region's size: 0.5, 0.5 is its middle.
extern fn wgf_draw_texture_rotated(
    texture: wgf_texture_t,
    source_x: f32,
    source_y: f32,
    source_width: f32,
    source_height: f32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    pivot_x: f32,
    pivot_y: f32,
    radians: f32,
    tint: wgf_color_t
);

/// Draws a texture over a polygon.
///
/// - `points` holds x and y in turn: `count` floats, 3 points or more.
/// - The polygon is convex, or is drawn as a fan from its first point.
/// - `uvs` holds each point's texture coordinates, 0 to 1 across the whole texture.
/// - `uvs_count` is the number of floats in `uvs`, as many as in `points`.
///
/// Returns false for too few points, an odd `count`, or texture coordinates that aren't one
/// pair for each point.
extern fn wgf_draw_texture_polygon(
    texture: wgf_texture_t,
    points: const f32*,
    count: i32,
    uvs: const f32*,
    uvs_count: i32,
    tint: wgf_color_t
) -> bool;

/// Draws a texture's region repeated over the rectangle, starting from its top-left.
///
/// - `scale` 1 draws one texel to a logical pixel.
/// - The last row and column are cut off where the rectangle ends.
/// - A source width or height of 0 or less uses the whole texture.
extern fn wgf_draw_texture_tiled(
    texture: wgf_texture_t,
    source_x: f32,
    source_y: f32,
    source_width: f32,
    source_height: f32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    scale: f32,
    tint: wgf_color_t
);

/// Draws a texture's region as a nine-slice into the rectangle: a panel or a button of any
/// size from one small image.
///
/// - The borders are `left`, `top`, `right`, and `bottom` texels in from the region's edges.
/// - The corners keep their size. They are scaled down together when the rectangle is smaller
///   than its borders.
/// - The edges stretch along their length, and the middle stretches both ways.
/// - A source width or height of 0 or less uses the whole texture.
extern fn wgf_draw_texture_nine_slice(
    texture: wgf_texture_t,
    source_x: f32,
    source_y: f32,
    source_width: f32,
    source_height: f32,
    left: f32,
    top: f32,
    right: f32,
    bottom: f32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    tint: wgf_color_t
);

/// How wgf_draw_texture_fill fills: a texture drawn into the rectangle only up to `amount`
/// (0 to 1).
///
/// - LEFT_TO_RIGHT and BOTTOM_TO_TOP fill a bar from the left or from the bottom.
/// - CLOCKWISE sweeps clockwise from 12 o'clock, as for a cooldown or a health orb.
///
/// A width or height of 0 or less uses the texture's size.
extern wgf_draw_fill_t;
extern let WGF_DRAW_FILL_LEFT_TO_RIGHT: wgf_draw_fill_t;
extern let WGF_DRAW_FILL_BOTTOM_TO_TOP: wgf_draw_fill_t;
extern let WGF_DRAW_FILL_CLOCKWISE: wgf_draw_fill_t;

extern fn wgf_draw_texture_fill(
    texture: wgf_texture_t,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    amount: f32,
    fill: wgf_draw_fill_t,
    tint: wgf_color_t
);

/// Begins or ends immediate mode 3D drawing, as `camera` sees the world.
///
/// - Between begin_3d and end_3d, the 3D calls draw in the world as `camera` (a 3D camera,
///   wgf_camera3d.h) sees it, into the presentation's visible area, under the clip.
/// - They are depth tested against each other, and against the frame's 3D drawn before them.
/// - A 3D call outside begin_3d and end_3d draws nothing.
/// - A frame starts in 2D. A frame left in 3D ends there.
/// - A 2D call between them lands in the world's x-y plane.
///
/// begin_3d returns false if `camera` isn't a 3D camera, or outside a frame.
extern fn wgf_draw_begin_3d(camera: wgf_actor_t) -> bool;

extern fn wgf_draw_end_3d();

/// Draws shapes in the world, unlit, with lines a pixel wide.
///
/// - wgf_draw_line_3d draws a line.
/// - wgf_draw_cube and wgf_draw_cube_wires draw a cube, filled or its edges, `width` (x) by
///   `height` (y) by `length` (z), centered on (cx, cy, cz).
/// - wgf_draw_sphere draws a sphere.
/// - wgf_draw_grid draws a grid of `slices` by `slices` squares, `spacing` apart on the x-z
///   plane, centered on the origin.
/// - wgf_draw_rectangle_3d draws a filled rectangle, and wgf_draw_circle_3d a circle's
///   outline. Each is centered on (cx, cy, cz), in its x-y plane, turned by (rx, ry, rz)
///   radians as an actor's rotation turns it.
///
/// A color with alpha below 255 is blended over what is behind it, in the order drawn.
extern fn wgf_draw_line_3d(x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32, color: wgf_color_t);

extern fn wgf_draw_cube(cx: f32, cy: f32, cz: f32, width: f32, height: f32, length: f32, color: wgf_color_t);

extern fn wgf_draw_cube_wires(cx: f32, cy: f32, cz: f32, width: f32, height: f32, length: f32, color: wgf_color_t);

extern fn wgf_draw_sphere(cx: f32, cy: f32, cz: f32, radius: f32, color: wgf_color_t);

extern fn wgf_draw_grid(slices: i32, spacing: f32, color: wgf_color_t);

/// Draws debug shapes in the world.
///
/// - wgf_draw_triangle_3d draws a triangle.
/// - wgf_draw_cylinder and wgf_draw_cylinder_wires draw a cylinder upright (along y),
///   centered at (cx, cy, cz), filled or as wires.
/// - wgf_draw_sphere_wires draws a sphere as wires.
/// - wgf_draw_capsule_wires draws an upright capsule as wires, `height` from end to end.
extern fn wgf_draw_triangle_3d(
    x0: f32,
    y0: f32,
    z0: f32,
    x1: f32,
    y1: f32,
    z1: f32,
    x2: f32,
    y2: f32,
    z2: f32,
    color: wgf_color_t
);

extern fn wgf_draw_cylinder(cx: f32, cy: f32, cz: f32, radius: f32, height: f32, color: wgf_color_t);

extern fn wgf_draw_cylinder_wires(cx: f32, cy: f32, cz: f32, radius: f32, height: f32, color: wgf_color_t);

extern fn wgf_draw_sphere_wires(cx: f32, cy: f32, cz: f32, radius: f32, color: wgf_color_t);

extern fn wgf_draw_capsule_wires(cx: f32, cy: f32, cz: f32, radius: f32, height: f32, color: wgf_color_t);

extern fn wgf_draw_rectangle_3d(
    cx: f32,
    cy: f32,
    cz: f32,
    width: f32,
    height: f32,
    rx: f32,
    ry: f32,
    rz: f32,
    color: wgf_color_t
);

extern fn wgf_draw_circle_3d(cx: f32, cy: f32, cz: f32, radius: f32, rx: f32, ry: f32, rz: f32, color: wgf_color_t);

/// Draws a model as it stands this frame, for debugging: as wires, as points, or as its skeleton.
///
/// The model's mesh is placed by the model's actor. For a file's root (wgf_mesh_create),
/// each visible node of its tree is placed by its own actor. A skinned part is posed as its
/// animation has it, using the stage's joint matrices applied on the CPU.
///
/// - Wires draw every triangle's three edges.
/// - Points draw every vertex, a few pixels wide.
/// - Skeleton draws each joint of each skin of a file's root, or of a node's skin when given
///   a node. Each joint gets a line from the nearest joint above it, and a joint with none
///   above it gets a small cross.
///
/// Drawing is unlit, in `color`, with lines a pixel wide. A crowd's costs add up: wires
/// record 6 vertices for each triangle.
///
/// Returns false, drawing nothing, outside begin_3d and end_3d, for a handle that isn't a
/// model, or for a model whose mesh isn't READY (such as a file's root before its tree is
/// made). A model with no skin has no skeleton, and draws none.
extern fn wgf_draw_model_wires(model: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_draw_model_points(model: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_draw_model_skeleton(model: wgf_actor_t, color: wgf_color_t) -> bool;

/// Draws text in the world: a block centered on (x, y, z), facing the camera.
///
/// - Its lines are `size` world units tall. A `size` of 0 or less uses 1.
/// - `font` 0 uses the default font.
/// - The text is depth tested, and doesn't hide what is drawn behind it after it.
extern fn wgf_draw_text_3d(font: wgf_font_t, text: const char*, x: f32, y: f32, z: f32, size: f32, color: wgf_color_t);

// ---- wgf_emitter2d.h ----

/// Creates an emitter that doesn't emit yet: its rate is 0. Its particles are white 8-unit squares
/// that live a second, drawn added (ADD).
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_emitter2d_create() -> wgf_actor_t;

/// Sets or gets the texture each particle shows (0: a white square). A texture still loading shows
/// nothing until it is READY. The setter returns false if `texture` isn't a texture.
extern fn wgf_emitter2d_set_texture(emitter: wgf_actor_t, texture: wgf_texture_t) -> bool;

extern fn wgf_emitter2d_get_texture(emitter: wgf_actor_t) -> wgf_texture_t;

/// Sets or gets the region of the texture each particle shows, such as an atlas cell, in texture
/// pixels (default: the whole texture). A width or height of 0 or less goes back to the whole
/// texture.
extern fn wgf_emitter2d_set_source(emitter: wgf_actor_t, x: f32, y: f32, width: f32, height: f32) -> bool;

extern fn wgf_emitter2d_get_source(emitter: wgf_actor_t) -> wgf_vec4_t;

/// Sets or gets a flipbook: the source split into `columns` by `rows` frames, left to right, then
/// top to bottom (default: one frame).
///
/// - The first `count` frames are used. With 0 or less, all of them are.
/// - With `per_second` 0, each particle plays the frames once over its life: puffs.
/// - With `per_second` above 0, each particle loops them at that rate, from a random frame:
///   flames.
///
/// Returns false for less than 1 by 1, more than 4096 frames, a `count` past them, or a negative
/// rate.
extern fn wgf_emitter2d_set_frames(emitter: wgf_actor_t, columns: i32, rows: i32, count: i32, per_second: f32) -> bool;

extern fn wgf_emitter2d_get_frame_columns(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_frame_rows(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_frame_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_frame_rate(emitter: wgf_actor_t) -> f32;

/// Makes the actor's next move not count as a move, as for a teleport. Nothing spawns along the
/// way, and particles inherit none of it.
extern fn wgf_emitter2d_skip_trail(emitter: wgf_actor_t) -> bool;

/// Sets or gets how the emitter emits particles, how many can be alive, and how long they live.
///
/// - set_rate sets a steady rate, in particles a second (default: 0, for bursts only). It returns
///   false below 0.
/// - burst emits `count` particles at once, where the actor is. It returns false below 0.
/// - set_emitting(false) stops the steady rate. The particles alive finish their lives.
/// - set_max sets how many particles can be alive at once (default: 1024). New particles replace
///   the oldest. A new max empties the emitter.
/// - set_max returns false for a `count` below 1 or above 65536. It refuses rather than clamps,
///   since fewer particles than asked is a different effect.
/// - set_life sets each particle's life, in seconds, between `min_seconds` and `max_seconds`
///   (default: 1). It returns false for a min of 0 or less, or a max below the min.
extern fn wgf_emitter2d_set_rate(emitter: wgf_actor_t, per_second: f32) -> bool;

extern fn wgf_emitter2d_get_rate(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_burst(emitter: wgf_actor_t, count: i32) -> bool;

extern fn wgf_emitter2d_set_emitting(emitter: wgf_actor_t, emitting: bool) -> bool;

extern fn wgf_emitter2d_is_emitting(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter2d_set_max(emitter: wgf_actor_t, count: i32) -> bool;

extern fn wgf_emitter2d_get_max(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_set_life(emitter: wgf_actor_t, min_seconds: f32, max_seconds: f32) -> bool;

extern fn wgf_emitter2d_get_life_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_life_max(emitter: wgf_actor_t) -> f32;

/// Starts over as if the steady rate had been running for `seconds`: smoke already rising when it
/// appears.
///
/// The particles alive are removed. The particles the rate would have made over that time, and
/// that would still be alive now, are made where the actor is. Returns false below 0.
extern fn wgf_emitter2d_prewarm(emitter: wgf_actor_t, seconds: f32) -> bool;

/// Sets or gets where particles are born, and how they move.
///
/// - set_spawn_box: particles are born anywhere in a box around the position, given by its half
///   sizes (default: a point).
/// - set_spawn_circle: particles are born evenly within a circle. A radius below 0 is refused.
/// - The box and the circle each replace the other.
/// - set_velocity: particles move along (x, y), at its length's speed (default: still). The
///   direction is in the emitter's own frame, so it turns as its actor does. (0, -1) is up the
///   screen for an emitter that isn't turned.
/// - Each particle's direction is turned up to `spread` radians either way (TAU: every way). Its
///   speed is faster or slower by up to `speed_variance` (0..1) of it.
/// - set_gravity: an acceleration, in stage units a second squared, along the stage's axes
///   (default: none).
extern fn wgf_emitter2d_set_spawn_box(emitter: wgf_actor_t, half_width: f32, half_height: f32) -> bool;

extern fn wgf_emitter2d_get_spawn_box(emitter: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_emitter2d_set_spawn_circle(emitter: wgf_actor_t, radius: f32) -> bool;

extern fn wgf_emitter2d_get_spawn_circle(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_set_velocity(emitter: wgf_actor_t, x: f32, y: f32, spread: f32, speed_variance: f32) -> bool;

extern fn wgf_emitter2d_get_velocity(emitter: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_emitter2d_get_spread(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_speed_variance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_set_gravity(emitter: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_emitter2d_get_gravity(emitter: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets whether particles are born on the spawn shape's outline, rather than inside it
/// (default: off).
/// - With a circle, they are born at its radius.
/// - With a box, they are born on its edges, with an edge picked by its length.
/// - A box with a half size of 0 is a line, and its shell is that line's ends.
extern fn wgf_emitter2d_set_spawn_shell(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter2d_is_spawn_shell(emitter: wgf_actor_t) -> bool;

/// Sets or gets how particles move after birth (each defaults to 0).
///
/// - Drag slows particles in proportion to their speed, per second. At 1, a particle loses about
///   63% of its speed in a second, less gravity's pull. set_drag returns false below 0.
/// - Inherit velocity adds that fraction of the emitter's own velocity, its actor's movement, at
///   birth. At 1, particles are carried along with it.
/// - Stretch draws each particle along its motion, for sparks and streaks. Its texture's top
///   points along its velocity across the screen. It is as long as the distance it moves in
///   `seconds`, plus its size, trailing behind. Stretched particles don't spin. set_stretch
///   returns false below 0.
extern fn wgf_emitter2d_set_drag(emitter: wgf_actor_t, per_second: f32) -> bool;

extern fn wgf_emitter2d_get_drag(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_set_inherit_velocity(emitter: wgf_actor_t, fraction: f32) -> bool;

extern fn wgf_emitter2d_get_inherit_velocity(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_set_stretch(emitter: wgf_actor_t, seconds: f32) -> bool;

extern fn wgf_emitter2d_get_stretch(emitter: wgf_actor_t) -> f32;

/// Sets or gets whether each particle's top turns along its motion across the screen, like an
/// arrow or a thrown spark (default: off).
///
/// Its spin, clockwise on screen, is added to that angle rather than to a random one. A particle
/// standing still keeps its top up the screen. A stretched particle is already aligned.
extern fn wgf_emitter2d_set_aligned_to_motion(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter2d_is_aligned_to_motion(emitter: wgf_actor_t) -> bool;

/// Sets or gets wander: each particle strays off its path on a smooth course of its own, like
/// fireflies or dust motes.
///
/// - `distance` is how far it strays: up to about that many stage units (default: 0, none).
/// - `per_second` is about how many times a second its course turns (default: 1).
///
/// The course starts on the particle's path. Its motion, for alignment and stretch, includes the
/// stray. Returns false if either is below 0.
extern fn wgf_emitter2d_set_wander(emitter: wgf_actor_t, distance: f32, per_second: f32) -> bool;

extern fn wgf_emitter2d_get_wander_distance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_wander_rate(emitter: wgf_actor_t) -> f32;

/// Sets or gets orbit: each particle circles where the emitter was at its birth (default: none).
///
/// Its speed is picked between `min` and `max`, in radians a second, positive clockwise on screen.
/// Its whole path turns, its own motion included, so a particle thrown outward spirals.
extern fn wgf_emitter2d_set_orbit(emitter: wgf_actor_t, min: f32, max: f32) -> bool;

extern fn wgf_emitter2d_get_orbit_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_orbit_max(emitter: wgf_actor_t) -> f32;

/// Sets or gets pulse: each particle's alpha beats `per_second` times a second, on a phase of its
/// own, for twinkling.
///
/// At each beat's low, the alpha falls by `depth` of itself (0..1, clamped). Defaults: a rate of 0
/// (none), and a depth of 1 (to clear). Returns false for a rate below 0.
extern fn wgf_emitter2d_set_pulse(emitter: wgf_actor_t, per_second: f32, depth: f32) -> bool;

extern fn wgf_emitter2d_get_pulse_rate(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_pulse_depth(emitter: wgf_actor_t) -> f32;

/// Sets or gets whether particles move with the emitter, like an aura around a moving character
/// (default: off).
///
/// - Each particle is moved as far as its actor has moved since the particle's birth. Only the
///   actor's place counts, not its turn.
/// - An orbit circles where the emitter is now.
/// - Inherited velocity then does nothing.
///
/// When off, each particle keeps to its own path as the emitter moves.
extern fn wgf_emitter2d_set_local_space(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter2d_is_local_space(emitter: wgf_actor_t) -> bool;

/// Sets or gets curves over a particle's life: its size and its color.
///
/// - Size is in stage units. Each particle's size is scaled by up to `variance` (0..1).
/// - Color is a tint, alpha included, so a curve can fade particles out.
/// - set_size and set_color make two keys, at 0 (birth) and 1 (death).
/// - For more keys, clear the keys and add up to 8, each at `t` (0..1 of a life).
///
/// Between two keys, the value moves in a line. Before the first key and after the last, it holds.
/// Keys at the same time make a step. An emitter with no size keys, or with no color keys, draws nothing.
/// Defaults: size 8 to 8, and white to white.
///
/// The calls return false for a negative size, a `t` outside 0..1, or a ninth key. The getters
/// read the keys back by index, in time order (0 past the last).
extern fn wgf_emitter2d_set_size(emitter: wgf_actor_t, start: f32, end: f32, variance: f32) -> bool;

extern fn wgf_emitter2d_get_size_variance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_add_size_key(emitter: wgf_actor_t, t: f32, size: f32) -> bool;

extern fn wgf_emitter2d_clear_size_keys(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter2d_get_size_key_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_size_key_time(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter2d_get_size_key_value(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter2d_set_color(emitter: wgf_actor_t, start: wgf_color_t, end: wgf_color_t) -> bool;

extern fn wgf_emitter2d_add_color_key(emitter: wgf_actor_t, t: f32, color: wgf_color_t) -> bool;

extern fn wgf_emitter2d_clear_color_keys(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter2d_get_color_key_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_color_key_time(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter2d_get_color_key_value(emitter: wgf_actor_t, index: i32) -> wgf_color_t;

/// Sets or gets a palette of up to 8 colors (default: empty, no tint).
///
/// Each particle picks one color at birth, and it tints the particle's color over its life:
/// confetti from one emitter. add_palette_color returns false for a ninth color.
extern fn wgf_emitter2d_add_palette_color(emitter: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_emitter2d_clear_palette(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter2d_get_palette_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_get_palette_color(emitter: wgf_actor_t, index: i32) -> wgf_color_t;

/// Sets or gets spin, in radians a second, between `min` and `max`, from a random angle (default:
/// none). Positive is clockwise on screen.
extern fn wgf_emitter2d_set_spin(emitter: wgf_actor_t, min: f32, max: f32) -> bool;

extern fn wgf_emitter2d_get_spin_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter2d_get_spin_max(emitter: wgf_actor_t) -> f32;

/// Sets or gets how particles use alpha, one of wgf_material.h's modes (default: ADD, for glows,
/// sparks, and fire), and the cutoff MASK cuts out below (default: 0.5, clamped to 0..1).
///
/// The setter returns false if `mode` isn't an alpha mode.
extern fn wgf_emitter2d_set_alpha_mode(emitter: wgf_actor_t, mode: wgf_alpha_mode_t, cutoff: f32) -> bool;

extern fn wgf_emitter2d_get_alpha_mode(emitter: wgf_actor_t) -> wgf_alpha_mode_t;

extern fn wgf_emitter2d_get_alpha_cutoff(emitter: wgf_actor_t) -> f32;

/// Sets or gets where the emitter's random numbers start (default: drawn from wgf_random as it is
/// made). The same seed and settings give the same particles. The getter returns the seed as last
/// set.
extern fn wgf_emitter2d_set_seed(emitter: wgf_actor_t, seed: i32) -> bool;

extern fn wgf_emitter2d_get_seed(emitter: wgf_actor_t) -> i32;

/// Sets or gets whether the emitter ends itself, as a one-shot effect such as an explosion's burst
/// does (default: off).
///
/// The emitter's actor is destroyed, with the actors under it, once both are true:
/// - it has nothing left to emit: it isn't emitting, or its rate is 0;
/// - the last particle it made has died.
///
/// That happens in the update before a frame. An emitter that has made no particle yet waits for
/// its first.
extern fn wgf_emitter2d_set_ending(emitter: wgf_actor_t, ending: bool) -> bool;

extern fn wgf_emitter2d_is_ending(emitter: wgf_actor_t) -> bool;

/// Sets or gets whether the emitter's particles outlive it, as a ship's exhaust outlives the ship
/// (default: off).
///
/// If the emitter is destroyed while it has particles alive on a stage, directly or with an actor
/// above it, they finish their lives where they are. The emitter goes on as an actor of its own at
/// the stage's top, not emitting. It is made in the update before the next frame, and ends (as
/// above) with its last particle.
extern fn wgf_emitter2d_set_lingering(emitter: wgf_actor_t, lingering: bool) -> bool;

extern fn wgf_emitter2d_is_lingering(emitter: wgf_actor_t) -> bool;

/// Returns how many particles are alive now. clear removes them all, and the emitter keeps
/// emitting as it was.
extern fn wgf_emitter2d_get_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter2d_clear(emitter: wgf_actor_t) -> bool;

// ---- wgf_emitter3d.h ----

/// Creates an emitter that doesn't emit yet: its rate is 0. Its particles are white 1-unit squares
/// that live a second, drawn added (ADD).
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_emitter3d_create() -> wgf_actor_t;

/// Sets or gets the texture each particle shows (0: a white square). A texture still loading shows
/// nothing until it is READY. The setter returns false if `texture` isn't a texture.
extern fn wgf_emitter3d_set_texture(emitter: wgf_actor_t, texture: wgf_texture_t) -> bool;

extern fn wgf_emitter3d_get_texture(emitter: wgf_actor_t) -> wgf_texture_t;

/// Sets or gets the region of the texture each particle shows, such as an atlas cell, in texture
/// pixels (default: the whole texture). A width or height of 0 or less goes back to the whole
/// texture.
extern fn wgf_emitter3d_set_source(emitter: wgf_actor_t, x: f32, y: f32, width: f32, height: f32) -> bool;

extern fn wgf_emitter3d_get_source(emitter: wgf_actor_t) -> wgf_vec4_t;

/// Sets or gets a flipbook: the source split into `columns` by `rows` frames, left to right, then
/// top to bottom (default: one frame).
///
/// - The first `count` frames are used. With 0 or less, all of them are.
/// - With `per_second` 0, each particle plays the frames once over its life: puffs.
/// - With `per_second` above 0, each particle loops them at that rate, from a random frame:
///   flames.
///
/// Returns false for less than 1 by 1, more than 4096 frames, a `count` past them, or a negative
/// rate.
extern fn wgf_emitter3d_set_frames(emitter: wgf_actor_t, columns: i32, rows: i32, count: i32, per_second: f32) -> bool;

extern fn wgf_emitter3d_get_frame_columns(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_frame_rows(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_frame_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_frame_rate(emitter: wgf_actor_t) -> f32;

/// Makes the actor's next move not count as a move, as for a teleport. Nothing spawns along the
/// way, and particles inherit none of it.
extern fn wgf_emitter3d_skip_trail(emitter: wgf_actor_t) -> bool;

/// Sets or gets how the emitter emits particles, how many can be alive, and how long they live.
///
/// - set_rate sets a steady rate, in particles a second (default: 0, for bursts only). It returns
///   false below 0.
/// - burst emits `count` particles at once, where the actor is. It returns false below 0.
/// - set_emitting(false) stops the steady rate. The particles alive finish their lives.
/// - set_max sets how many particles can be alive at once (default: 1024). New particles replace
///   the oldest. A new max empties the emitter.
/// - set_max returns false for a `count` below 1 or above 65536. It refuses rather than clamps,
///   since fewer particles than asked is a different effect.
/// - set_life sets each particle's life, in seconds, between `min_seconds` and `max_seconds`
///   (default: 1). It returns false for a min of 0 or less, or a max below the min.
extern fn wgf_emitter3d_set_rate(emitter: wgf_actor_t, per_second: f32) -> bool;

extern fn wgf_emitter3d_get_rate(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_burst(emitter: wgf_actor_t, count: i32) -> bool;

extern fn wgf_emitter3d_set_emitting(emitter: wgf_actor_t, emitting: bool) -> bool;

extern fn wgf_emitter3d_is_emitting(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter3d_set_max(emitter: wgf_actor_t, count: i32) -> bool;

extern fn wgf_emitter3d_get_max(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_set_life(emitter: wgf_actor_t, min_seconds: f32, max_seconds: f32) -> bool;

extern fn wgf_emitter3d_get_life_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_life_max(emitter: wgf_actor_t) -> f32;

/// Starts over as if the steady rate had been running for `seconds`: smoke already rising when it
/// appears.
///
/// The particles alive are removed. The particles the rate would have made over that time, and
/// that would still be alive now, are made where the actor is. Returns false below 0.
extern fn wgf_emitter3d_prewarm(emitter: wgf_actor_t, seconds: f32) -> bool;

/// Sets or gets where particles are born, and how they move.
///
/// - set_spawn_box: particles are born anywhere in a box around the position, given by its half
///   sizes (default: a point).
/// - set_spawn_sphere: particles are born evenly within a sphere. A radius below 0 is refused.
/// - The box and the sphere each replace the other.
/// - set_velocity: particles move along (x, y, z), at its length's speed (default: still). The
///   direction is in the emitter's own frame, so it turns as its actor does.
/// - Each particle's direction is spread evenly within a cone of `spread` radians about it (PI:
///   every way). Its speed is faster or slower by up to `speed_variance` (0..1) of it.
/// - set_gravity: an acceleration, in stage units a second squared, along the stage's axes
///   (default: none).
extern fn wgf_emitter3d_set_spawn_box(emitter: wgf_actor_t, half_x: f32, half_y: f32, half_z: f32) -> bool;

extern fn wgf_emitter3d_get_spawn_box(emitter: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_emitter3d_set_spawn_sphere(emitter: wgf_actor_t, radius: f32) -> bool;

extern fn wgf_emitter3d_get_spawn_sphere(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_set_velocity(
    emitter: wgf_actor_t,
    x: f32,
    y: f32,
    z: f32,
    spread: f32,
    speed_variance: f32
) -> bool;

extern fn wgf_emitter3d_get_velocity(emitter: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_emitter3d_get_spread(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_speed_variance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_set_gravity(emitter: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_emitter3d_get_gravity(emitter: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets whether particles are born on the spawn shape's surface, rather than inside it
/// (default: off).
/// - With a sphere, they are born at its radius.
/// - With a box, they are born on its faces, with a face picked by its area.
/// - A box with a half size of 0 is a rectangle, and its shell is that rectangle's outline.
extern fn wgf_emitter3d_set_spawn_shell(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter3d_is_spawn_shell(emitter: wgf_actor_t) -> bool;

/// Sets or gets how particles move after birth (each defaults to 0).
///
/// - Drag slows particles in proportion to their speed, per second. At 1, a particle loses about
///   63% of its speed in a second, less gravity's pull. set_drag returns false below 0.
/// - Inherit velocity adds that fraction of the emitter's own velocity, its actor's movement, at
///   birth. At 1, particles are carried along with it.
/// - Stretch draws each particle along its motion, for sparks and streaks. Its texture's top
///   points along its velocity across the screen. It is as long as the distance it moves in
///   `seconds`, plus its size, trailing behind. Stretched particles don't spin. set_stretch
///   returns false below 0.
extern fn wgf_emitter3d_set_drag(emitter: wgf_actor_t, per_second: f32) -> bool;

extern fn wgf_emitter3d_get_drag(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_set_inherit_velocity(emitter: wgf_actor_t, fraction: f32) -> bool;

extern fn wgf_emitter3d_get_inherit_velocity(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_set_stretch(emitter: wgf_actor_t, seconds: f32) -> bool;

extern fn wgf_emitter3d_get_stretch(emitter: wgf_actor_t) -> f32;

/// Sets or gets whether each particle's top turns along its motion across the screen, like an
/// arrow or a thrown spark (default: off).
///
/// Its spin, clockwise as the camera sees it, is added to that angle rather than to a random one.
/// A particle standing still keeps its top up the screen. A stretched particle is already aligned.
extern fn wgf_emitter3d_set_aligned_to_motion(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter3d_is_aligned_to_motion(emitter: wgf_actor_t) -> bool;

/// Sets or gets wander: each particle strays off its path on a smooth course of its own, like
/// fireflies or dust motes.
///
/// - `distance` is how far it strays: up to about that many stage units (default: 0, none).
/// - `per_second` is about how many times a second its course turns (default: 1).
///
/// The course starts on the particle's path. Its motion, for alignment and stretch, includes the
/// stray. Returns false if either is below 0.
extern fn wgf_emitter3d_set_wander(emitter: wgf_actor_t, distance: f32, per_second: f32) -> bool;

extern fn wgf_emitter3d_get_wander_distance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_wander_rate(emitter: wgf_actor_t) -> f32;

/// Sets or gets orbit: each particle circles a line through where the emitter was at its birth
/// (default: none).
///
/// The line runs along the emitter's velocity (set_velocity's direction) at the particle's
/// birth, or up if it has none, turned as its actor was then.
///
/// Each particle's speed is picked between `min` and `max`, in radians a second, positive
/// counterclockwise seen from where that line points. Its whole path turns, its own motion
/// included, so a particle thrown outward spirals.
extern fn wgf_emitter3d_set_orbit(emitter: wgf_actor_t, min: f32, max: f32) -> bool;

extern fn wgf_emitter3d_get_orbit_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_orbit_max(emitter: wgf_actor_t) -> f32;

/// Sets or gets pulse: each particle's alpha beats `per_second` times a second, on a phase of its
/// own, for twinkling.
///
/// At each beat's low, the alpha falls by `depth` of itself (0..1, clamped). Defaults: a rate of 0
/// (none), and a depth of 1 (to clear). Returns false for a rate below 0.
extern fn wgf_emitter3d_set_pulse(emitter: wgf_actor_t, per_second: f32, depth: f32) -> bool;

extern fn wgf_emitter3d_get_pulse_rate(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_pulse_depth(emitter: wgf_actor_t) -> f32;

/// Sets or gets whether particles move with the emitter, like an aura around a moving character
/// (default: off).
///
/// - Each particle is moved as far as its actor has moved since the particle's birth. Only the
///   actor's place counts, not its turn.
/// - An orbit circles where the emitter is now.
/// - Inherited velocity then does nothing.
///
/// When off, each particle keeps to its own path as the emitter moves.
extern fn wgf_emitter3d_set_local_space(emitter: wgf_actor_t, on: bool) -> bool;

extern fn wgf_emitter3d_is_local_space(emitter: wgf_actor_t) -> bool;

/// Sets or gets curves over a particle's life: its size and its color.
///
/// - Size is in stage units. Each particle's size is scaled by up to `variance` (0..1).
/// - Color is a tint, alpha included, so a curve can fade particles out.
/// - set_size and set_color make two keys, at 0 (birth) and 1 (death).
/// - For more keys, clear the keys and add up to 8, each at `t` (0..1 of a life).
///
/// Between two keys, the value moves in a line. Before the first key and after the last, it holds.
/// Keys at the same time make a step. An emitter with no size keys, or with no color keys, draws nothing.
/// Defaults: size 1 to 1, and white to white.
///
/// The calls return false for a negative size, a `t` outside 0..1, or a ninth key. The getters
/// read the keys back by index, in time order (0 past the last).
extern fn wgf_emitter3d_set_size(emitter: wgf_actor_t, start: f32, end: f32, variance: f32) -> bool;

extern fn wgf_emitter3d_get_size_variance(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_add_size_key(emitter: wgf_actor_t, t: f32, size: f32) -> bool;

extern fn wgf_emitter3d_clear_size_keys(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter3d_get_size_key_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_size_key_time(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter3d_get_size_key_value(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter3d_set_color(emitter: wgf_actor_t, start: wgf_color_t, end: wgf_color_t) -> bool;

extern fn wgf_emitter3d_add_color_key(emitter: wgf_actor_t, t: f32, color: wgf_color_t) -> bool;

extern fn wgf_emitter3d_clear_color_keys(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter3d_get_color_key_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_color_key_time(emitter: wgf_actor_t, index: i32) -> f32;

extern fn wgf_emitter3d_get_color_key_value(emitter: wgf_actor_t, index: i32) -> wgf_color_t;

/// Sets or gets a palette of up to 8 colors (default: empty, no tint).
///
/// Each particle picks one color at birth, and it tints the particle's color over its life:
/// confetti from one emitter. add_palette_color returns false for a ninth color.
extern fn wgf_emitter3d_add_palette_color(emitter: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_emitter3d_clear_palette(emitter: wgf_actor_t) -> bool;

extern fn wgf_emitter3d_get_palette_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_get_palette_color(emitter: wgf_actor_t, index: i32) -> wgf_color_t;

/// Sets or gets spin, in radians a second, between `min` and `max`, from a random angle (default:
/// none). Positive is clockwise as the camera sees it.
extern fn wgf_emitter3d_set_spin(emitter: wgf_actor_t, min: f32, max: f32) -> bool;

extern fn wgf_emitter3d_get_spin_min(emitter: wgf_actor_t) -> f32;

extern fn wgf_emitter3d_get_spin_max(emitter: wgf_actor_t) -> f32;

/// Sets or gets how particles use alpha, one of wgf_material.h's modes (default: ADD, for glows,
/// sparks, and fire), and the cutoff MASK cuts out below (default: 0.5, clamped to 0..1).
///
/// The setter returns false if `mode` isn't an alpha mode.
extern fn wgf_emitter3d_set_alpha_mode(emitter: wgf_actor_t, mode: wgf_alpha_mode_t, cutoff: f32) -> bool;

extern fn wgf_emitter3d_get_alpha_mode(emitter: wgf_actor_t) -> wgf_alpha_mode_t;

extern fn wgf_emitter3d_get_alpha_cutoff(emitter: wgf_actor_t) -> f32;

/// Sets or gets where the emitter's random numbers start (default: drawn from wgf_random as it is
/// made). The same seed and settings give the same particles. The getter returns the seed as last
/// set.
extern fn wgf_emitter3d_set_seed(emitter: wgf_actor_t, seed: i32) -> bool;

extern fn wgf_emitter3d_get_seed(emitter: wgf_actor_t) -> i32;

/// Sets or gets whether the emitter ends itself, as a one-shot effect such as an explosion's burst
/// does (default: off).
///
/// The emitter's actor is destroyed, with the actors under it, once both are true:
/// - it has nothing left to emit: it isn't emitting, or its rate is 0;
/// - the last particle it made has died.
///
/// That happens in the update before a frame. An emitter that has made no particle yet waits for
/// its first.
extern fn wgf_emitter3d_set_ending(emitter: wgf_actor_t, ending: bool) -> bool;

extern fn wgf_emitter3d_is_ending(emitter: wgf_actor_t) -> bool;

/// Sets or gets whether the emitter's particles outlive it, as a car's dust outlives the car
/// (default: off).
///
/// If the emitter is destroyed while it has particles alive on a stage, directly or with an actor
/// above it, they finish their lives where they are. The emitter goes on as an actor of its own at
/// the stage's top, not emitting. It is made in the update before the next frame, and ends (as
/// above) with its last particle.
extern fn wgf_emitter3d_set_lingering(emitter: wgf_actor_t, lingering: bool) -> bool;

extern fn wgf_emitter3d_is_lingering(emitter: wgf_actor_t) -> bool;

/// Returns how many particles are alive now. clear removes them all, and the emitter keeps
/// emitting as it was.
extern fn wgf_emitter3d_get_count(emitter: wgf_actor_t) -> i32;

extern fn wgf_emitter3d_clear(emitter: wgf_actor_t) -> bool;

// ---- wgf_environment.h ----

/// Creates an environment from a panorama image file.
///
/// Returns 0 only if there is no room for another environment. A path or file that can't be
/// loaded gives an environment that FAILED.
extern fn wgf_environment_create(path: const char*) -> wgf_environment_t;

// ---- wgf_fly.h ----

/// Cameras flown by input: free-fly and first-person.
///
/// A 3D camera actor (wgf_camera3d.h) given a mode is turned and moved each frame, before the
/// frame callback. The keyboard, the mouse, and the pads fly it. At most 64 cameras have a mode
/// or a setting.
///
///   the mouse            looks: yaw and pitch, with the pitch held just short of straight
///                        up or down. The pointer is locked while it looks
///                        (wgf_mouse_set_locked). A click locks it again once the platform
///                        has let it go (Escape in a browser)
///   the right stick      looks, at the turn speed
///   W A S D, the arrows  move forward, left, back, and right. So does the left stick
///   Space or E           FREE: up (the world's +y). So does a pad's right bumper
///   Left Control or Q    FREE: down. So does a pad's left bumper
///
/// - FREE moves where the camera looks.
/// - FIRST_PERSON moves on the ground plane, and keeps the camera's height. The program sets
///   that height, for stairs or a jump.
/// - Every pad is read, and the one pushed furthest wins.
/// - Keys aren't read while the keyboard is captured. The mouse doesn't look while the pointer
///   is captured, as when a UI has it (wgf_input.h).
/// - The camera's position is read each frame, so the program may move it. While it flies, only
///   the look (wgf_fly_set_look) turns it.
/// - Every flown camera moves by the same input, so fly one at a time.
/// - A camera that also follows (wgf_follow.h) is placed by both.
extern wgf_fly_mode_t;
extern let WGF_FLY_MODE_NONE: wgf_fly_mode_t;
extern let WGF_FLY_MODE_FREE: wgf_fly_mode_t;
extern let WGF_FLY_MODE_FIRST_PERSON: wgf_fly_mode_t;

/// Sets or gets the mode the camera is flown in (default: NONE).
///
/// - NONE stops flying it. It stays where it is, and its settings are kept.
/// - When it starts flying, its look is taken from where it faces now.
///
/// set_mode returns false if `camera` isn't a 3D camera, if `mode` isn't a mode, or if 64
/// cameras already have a mode or a setting.
extern fn wgf_fly_set_mode(camera: wgf_actor_t, mode: wgf_fly_mode_t) -> bool;

extern fn wgf_fly_get_mode(camera: wgf_actor_t) -> wgf_fly_mode_t;

/// Sets or gets how fast the camera moves, in world units a second (default: 5.4).
///
/// A stick pushed part way moves it at that part of the speed.
///
/// set_speed returns false for a negative speed. Like every setter here, it also returns false
/// for a camera set_mode would refuse.
extern fn wgf_fly_set_speed(camera: wgf_actor_t, speed: f32) -> bool;

extern fn wgf_fly_get_speed(camera: wgf_actor_t) -> f32;

/// Sets or gets how far the mouse turns the camera, in radians a logical pixel (default:
/// 0.003).
///
/// At 0, the mouse doesn't look.
///
/// set_sensitivity returns false for a negative value.
extern fn wgf_fly_set_sensitivity(camera: wgf_actor_t, radians: f32) -> bool;

extern fn wgf_fly_get_sensitivity(camera: wgf_actor_t) -> f32;

/// Sets or gets how fast a stick pushed all the way turns the camera, in radians a second
/// (default: 2).
///
/// set_turn_speed returns false for a negative value.
extern fn wgf_fly_set_turn_speed(camera: wgf_actor_t, radians: f32) -> bool;

extern fn wgf_fly_get_turn_speed(camera: wgf_actor_t) -> f32;

/// Sets or gets where the camera looks. Setting it turns the camera at once.
///
/// - `yaw` is in radians about y. 0 faces -z, and a quarter turn faces -x.
/// - `pitch` is in radians up, clamped to just short of straight up or down.
///
/// get_look returns where it looks now, as yaw (-pi to pi) and pitch.
///
/// set_look returns false for a value that isn't finite.
extern fn wgf_fly_set_look(camera: wgf_actor_t, yaw: f32, pitch: f32) -> bool;

extern fn wgf_fly_get_look(camera: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets whether the mouse looks only while its right button is held (default: false).
///
/// - true: the mouse looks only while the right button is held, and the pointer is locked while
///   it is. Use it for a debug camera beside a game's own clicks.
/// - false: the mouse always looks, and the pointer is locked while the camera flies.
extern fn wgf_fly_set_look_held(camera: wgf_actor_t, held: bool) -> bool;

extern fn wgf_fly_is_look_held(camera: wgf_actor_t) -> bool;

// ---- wgf_follow.h ----

/// Cameras that follow a target actor: 2D follow, 3D follow, and 3D orbit.
///
/// A camera actor (wgf_camera2d.h, wgf_camera3d.h) given a target actor is moved each frame,
/// before the frame callback. It follows where the target is drawn. At most 64 cameras follow.
///
/// A 2D camera centers the view on a point that follows the target.
/// - The target moves freely inside a dead zone around the point. When it leaves, the point
///   catches up, smoothed.
/// - The view is kept inside the camera's bounds, when it has them. What must fit is the
///   presentation's visible area, divided by the camera's zoom.
///
/// A 3D camera sits at its offset from a point that follows the target the same way, and looks
/// at the point. Its dead zone is a width across and a height up, and it is smoothed too.
/// - CHASE: the offset is turned with the target's heading (its turn about y). It swings round
///   to it, smoothed, so it stays behind a car.
/// - FIXED: the offset isn't turned.
/// - ORBIT: the offset is the orbit's: a yaw, a pitch, and a distance the program sets, from a
///   stick or the pointer.
///
/// Either kind of camera shakes. wgf_follow_shake adds trauma (0 to 1), which is lost over
/// time. The view is thrown by the trauma's square, so small shakes are gentle.
extern wgf_follow_mode_t;
extern let WGF_FOLLOW_MODE_CHASE: wgf_follow_mode_t;
extern let WGF_FOLLOW_MODE_FIXED: wgf_follow_mode_t;
extern let WGF_FOLLOW_MODE_ORBIT: wgf_follow_mode_t;

/// Sets or gets the actor the camera follows.
///
/// A `target` of 0 stops following. The camera stays where it is.
///
/// set_target returns false if `camera` isn't a 2D or 3D camera, if `target` isn't an actor,
/// or if 64 cameras already follow.
extern fn wgf_follow_set_target(camera: wgf_actor_t, target: wgf_actor_t) -> bool;

extern fn wgf_follow_get_target(camera: wgf_actor_t) -> wgf_actor_t;

/// Sets or gets how quickly the point catches up, as a rate a second (default: 8, about a
/// fifth of a second).
///
/// At 0 or less, it catches up at once.
///
/// This setter, and every setter below, returns false for a camera that follows no actor.
extern fn wgf_follow_set_smoothing(camera: wgf_actor_t, rate: f32) -> bool;

extern fn wgf_follow_get_smoothing(camera: wgf_actor_t) -> f32;

/// Sets or gets the dead zone around the point, which the target moves in freely: its width
/// and height (default: 0, 0, always catching up). A negative size is refused.
extern fn wgf_follow_set_dead_zone(camera: wgf_actor_t, width: f32, height: f32) -> bool;

extern fn wgf_follow_get_dead_zone(camera: wgf_actor_t) -> wgf_vec2_t;

/// 2D: sets or gets the part of the world the view stays inside: left, top, right, bottom.
///
/// - If the bounds are smaller than the view, the view is centered on them.
/// - A right that isn't above the left lets the view go anywhere (the default).
extern fn wgf_follow_set_bounds(camera: wgf_actor_t, left: f32, top: f32, right: f32, bottom: f32) -> bool;

extern fn wgf_follow_get_bounds(camera: wgf_actor_t) -> wgf_vec4_t;

/// 3D: sets or gets where the camera sits from the point (default: 0, 3, 6, behind a target
/// facing -z, and up), and the mode that says how (see wgf_follow_mode_t).
extern fn wgf_follow_set_offset(camera: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_follow_get_offset(camera: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_follow_set_mode(camera: wgf_actor_t, mode: wgf_follow_mode_t) -> bool;

extern fn wgf_follow_get_mode(camera: wgf_actor_t) -> wgf_follow_mode_t;

/// 3D, ORBIT: sets or gets where the camera sits round the point.
///
/// - `yaw` is in radians about y. 0 is on the point's +z side.
/// - `pitch` is in radians up, clamped to just short of straight up or down.
/// - `distance` is how far out. A distance that isn't above 0 is refused.
///
/// get_orbit returns yaw, pitch, and distance.
extern fn wgf_follow_set_orbit(camera: wgf_actor_t, yaw: f32, pitch: f32, distance: f32) -> bool;

extern fn wgf_follow_get_orbit(camera: wgf_actor_t) -> wgf_vec3_t;

/// Adds trauma to the camera's shake, held to 1. Gets the trauma now.
///
/// For example, 0.3 for a bump, and 1 for an explosion. Trauma is lost at 1.5 a second.
extern fn wgf_follow_shake(camera: wgf_actor_t, amount: f32) -> bool;

extern fn wgf_follow_get_trauma(camera: wgf_actor_t) -> f32;

/// Puts the point on the target at once, and the camera with it, as for a respawn or a new
/// level.
extern fn wgf_follow_snap(camera: wgf_actor_t) -> bool;

// ---- wgf_font.h ----

/// Creates a font from a file under fs's root.
///
/// The file is one of these:
/// - a .ttf or .otf;
/// - an AngelCode BMFont .fnt, in its text format or its binary one (version 3), but not its
///   XML. Its pages are the images it names beside it, and its kerning pairs are honored;
/// - an image of glyphs (.png, .jpg, .jpeg, .bmp, .tga, .gif). The glyphs are in rows as
///   high as the first, each bordered by magenta (255, 0, 255) and as wide as its cell. They
///   run from the space (32) on, at most 256. The magenta is made transparent.
///
/// A bitmap font's glyphs are drawn from its pages:
/// - in their colors times the text's color, so white glyphs take the color, and colored
///   ones keep theirs under white;
/// - at wgf_font_get_size, scaled to the size asked;
/// - through its filter (wgf_font_set_filter).
///
/// A font loaded before, and released since, comes back READY at once.
///
/// A font loads again in place (wgf_asset_reload) when its file is saved, or a .fnt's page:
/// - It keeps its handle and its filter, and text in it is measured and drawn as the new
///   file says from then on. Text actors, the UI, and documents lay their text out again.
/// - A file that can't be loaded keeps the font as it was, with one error logged.
///
/// Returns 0 only if there is no room for another font. A font that can't be loaded FAILED.
/// A bitmap font also FAILED for a channel-packed .fnt, a page or number out of range, a
/// character given twice, or no glyphs.
extern fn wgf_font_create(path: const char*) -> wgf_font_t;

/// Enables bitmap fonts (a .fnt, or an image of glyphs: see wgf_font_create), or says whether
/// they are enabled.
///
/// Bitmap fonts are linked on purpose. This call links the code that reads their files, so a
/// program with TrueType fonts alone carries none of it. A game enables them with
/// "bitmap_fonts" in wgf.json's features.
///
/// Call it before the first bitmap font is created. Without it, a bitmap font FAILED (logged).
extern fn wgf_font_enable_bitmaps() -> bool;

extern fn wgf_font_is_bitmaps_enabled() -> bool;

/// Returns a bitmap font's own size: the height of its line, in its pixels.
///
/// - For an image of glyphs, it is the glyphs' height.
/// - It is the size the font's text is drawn at texel for texel, times the frame's DPI scale.
/// - A whole multiple of it stays sharp under NEAREST.
/// - Font 0 gives the default font's size.
///
/// Returns 0 for a TrueType font, a font that isn't READY, or a handle that isn't a font.
extern fn wgf_font_get_size(font: wgf_font_t) -> f32;

/// Sets or gets how a bitmap font's pages are sampled when its text is drawn at a size not
/// its own.
///
/// - NEAREST (the default, when unset) keeps its texels sharp, for pixel fonts.
/// - LINEAR smooths them.
///
/// A filter set before the font is READY is kept.
///
/// The setter returns false for a font that isn't a bitmap font (by its file's extension),
/// font 0, or a filter that isn't one. The getter returns LINEAR for those.
extern fn wgf_font_set_filter(font: wgf_font_t, filter: wgf_texture_filter_t) -> bool;

extern fn wgf_font_get_filter(font: wgf_font_t) -> wgf_texture_filter_t;

/// Sets or gets the font that font 0 means.
///
/// The default holds a reference to `font`. Setting 0 goes back to the built-in font. For
/// text beyond ASCII, set a font that has it.
///
/// The setter returns false for a handle that isn't a font.
extern fn wgf_font_set_default(font: wgf_font_t) -> bool;

extern fn wgf_font_get_default() -> wgf_font_t;

/// Returns how much room UTF-8 `text` takes at `size` logical pixels: the widest line, and
/// the lines' height together.
///
/// - A `size` of 0 or less uses 16. A bitmap font's line is `size` high.
/// - The text is measured at the pixels a logical pixel is in the frame (the DPI scale, or a
///   presentation's scale), as it is drawn.
/// - A bitmap font is measured with its advances, kerning, and letter spacing, as its glyphs
///   are placed.
/// - Newlines break lines, and nothing wraps.
/// - A line keeps its spaces, so " " measures a space's advance.
///
/// Returns 0, 0 for empty text, or before gfx is set up.
extern fn wgf_font_measure(font: wgf_font_t, text: const char*, size: f32) -> wgf_vec2_t;

// ---- wgf_image.h ----

/// Creates an image from a file: PNG, JPEG, BMP, TGA, or GIF (its first frame).
///
/// The file is decoded on a worker. wgf_asset_reload loads it again in place: the image
/// has the file's pixels and size, and a pixel set on it is gone. A texture or a mesh
/// already made from the image keeps what it was made with.
///
/// Returns 0 only if there is no room for another image. A path or file that can't be loaded
/// gives an image that FAILED (logged once, naming the file).
extern fn wgf_image_create(path: const char*) -> wgf_image_t;

/// Creates an image with every pixel `color`.
extern fn wgf_image_create_color(width: i32, height: i32, color: wgf_color_t) -> wgf_image_t;

/// Creates a gradient from `start` to `end` along a direction.
///
/// - `angle` is in degrees, clockwise from rightward. 0 runs left to right, and 90 top to
///   bottom.
/// - The corner furthest back along the direction is exactly `start`.
/// - The corner furthest along it is exactly `end`.
extern fn wgf_image_create_gradient_linear(
    width: i32,
    height: i32,
    angle: f32,
    start: wgf_color_t,
    end: wgf_color_t
) -> wgf_image_t;

/// Creates a gradient out from the middle, in circles.
///
/// - The radius runs from the middle to the pixels of the nearer sides.
/// - The image is `inner` within `density` of the radius (0 to 1, clamped).
/// - It then blends toward `outer`, reaching it at the radius, and stays `outer` beyond.
/// - So the middle is `inner`, and the corners are `outer`.
extern fn wgf_image_create_gradient_radial(
    width: i32,
    height: i32,
    density: f32,
    inner: wgf_color_t,
    outer: wgf_color_t
) -> wgf_image_t;

/// Creates a gradient as wgf_image_create_gradient_radial does, in squares rather than circles.
///
/// The image is `inner` within `density` of the way from the middle to the edges. It then
/// blends toward `outer`, and every edge pixel is `outer`.
extern fn wgf_image_create_gradient_square(
    width: i32,
    height: i32,
    density: f32,
    inner: wgf_color_t,
    outer: wgf_color_t
) -> wgf_image_t;

/// Creates a checkerboard of `check_width` by `check_height` pixel squares, with `a` at the
/// top-left. Also returns 0 for a check's side of 0 or less.
extern fn wgf_image_create_checked(
    width: i32,
    height: i32,
    check_width: i32,
    check_height: i32,
    a: wgf_color_t,
    b: wgf_color_t
) -> wgf_image_t;

/// Creates white noise: each pixel is white with the chance `factor` (0 to 1, clamped), and
/// black otherwise.
extern fn wgf_image_create_white_noise(width: i32, height: i32, factor: f32, seed: i32) -> wgf_image_t;

/// Creates Perlin noise in six octaves. Each octave has twice the last one's frequency and half
/// its weight.
///
/// - `scale` is the number of cells of the first octave across the image.
/// - `offset_x` and `offset_y` shift the noise, in pixels, so neighboring images tile.
///
/// Also returns 0 for a `scale` of 0 or less, over 4096, or not finite.
extern fn wgf_image_create_perlin_noise(
    width: i32,
    height: i32,
    offset_x: i32,
    offset_y: i32,
    scale: f32,
    seed: i32
) -> wgf_image_t;

/// Creates cells (Worley noise).
///
/// Each `tile_size` square has a point at random. Each pixel is as bright as it is far from
/// the nearest point, and white a tile's side away.
///
/// Also returns 0 for a `tile_size` of 0 or less.
extern fn wgf_image_create_cellular(width: i32, height: i32, tile_size: i32, seed: i32) -> wgf_image_t;

/// Creates an image from a copy of a texture's pixels read back (wgf_texture_read, DONE).
///
/// The image is READY at once. Returns 0 for a read that isn't DONE (logged).
extern fn wgf_image_create_from_read(read: wgf_texture_read_t) -> wgf_image_t;

/// Returns the image's size in pixels, or 0 until it is READY.
extern fn wgf_image_get_width(image: wgf_image_t) -> i32;

extern fn wgf_image_get_height(image: wgf_image_t) -> i32;

/// Returns the pixel at column `x`, row `y`, counted from the top-left.
///
/// Returns 0 (transparent black) outside the image, or for an image that isn't READY.
extern fn wgf_image_get_pixel(image: wgf_image_t, x: i32, y: i32) -> wgf_color_t;

/// Sets the pixel at column `x`, row `y` to `color`.
///
/// Returns false outside the image, or for an image that isn't READY.
extern fn wgf_image_set_pixel(image: wgf_image_t, x: i32, y: i32, color: wgf_color_t) -> bool;

/// Returns the image's pixels, and their size in bytes.
///
/// Pixels are RGBA, 8 bits a channel, width * 4 bytes a row, with the top row first. They are
/// valid until the image is released, or loaded again (wgf_asset_reload).
///
/// Returns NULL and 0 for an image that isn't READY.
extern fn wgf_image_get_data(image: wgf_image_t) -> const u8*;

extern fn wgf_image_get_size(image: wgf_image_t) -> i32;

/// Saves the image as a PNG file at `path`, with libwgf's own writer.
///
/// The path works as for wgf_fs_write: under the root, with its directories made. On the web,
/// the file is kept in the browser's store. The image is encoded on the calling thread.
///
/// Returns the write's task. Returns 0 for an image that isn't READY, a NULL or refused
/// `path`, or if there is no memory to encode it.
extern fn wgf_image_save(image: wgf_image_t, path: const char*) -> wgf_fs_task_t;

/// Creates a texture in code (as wgf_texture_create_blank) holding the image's pixels as they
/// are now.
///
/// - The pixels are seen from the next frame drawn.
/// - The texture has no mipmaps.
/// - You can write it again with wgf_texture_write or wgf_texture_write_image. You can't in
///   the frame it is made, because this is that frame's one write.
///
/// Returns 0 for an image that isn't READY, or before gfx runs (logged).
extern fn wgf_texture_create_from_image(image: wgf_image_t) -> wgf_texture_t;

/// Writes a texture made in code whole with the image's pixels, as wgf_texture_write does.
///
/// Returns false for a texture not made in code, an image that isn't READY or isn't the
/// texture's size, or a second write in a frame.
extern fn wgf_texture_write_image(texture: wgf_texture_t, image: wgf_image_t) -> bool;

// ---- wgf_light.h ----

/// A light: an actor that lights the stage it is on (wgf_stage3d.h).
///
/// Place and aim it with the actor calls (wgf_actor_look_at). A light shines down its -z.
///
/// - Nothing is lit implicitly. A stage with no lights and no ambient light is black.
/// - Each model is lit by the up to 8 lights that reach it most, by their brightness and their
///   falloff at its box. Point and spot lights whose range doesn't reach a model are skipped
///   for it.
/// - A light shines while it is enabled (with every actor above it) and visible (wgf_actor.h).
///   Hiding it turns it off, and leaves its children as they are, such as a lamp's bulb model
///   under it.
/// - Parameters follow glTF's KHR_lights_punctual, and shading follows glTF's materials
///   (wgf_material.h). So lights from glTF tools look the same here.
/// - Light colors are sRGB. Lighting happens in linear space.
/// - A white directional light of intensity pi (about 3) fully lights a white, rough,
///   non-metal surface facing it.
/// - Point and spot lights fall off with the inverse square of distance. They fade smoothly to
///   nothing at their range (0: no limit).
/// - Setters store values even where they don't apply to the light's type, such as a range on
///   a directional light.
/// - Directional and spot lights can cast shadows (below), turned on for each light.
extern wgf_light_type_t;
extern let WGF_LIGHT_TYPE_DIRECTIONAL: wgf_light_type_t;
extern let WGF_LIGHT_TYPE_POINT: wgf_light_type_t;
extern let WGF_LIGHT_TYPE_SPOT: wgf_light_type_t;

/// Creates a white light of intensity 1, with no range limit, and a spot cone of pi/6 to pi/4.
///
/// Returns 0 if `type` isn't a light type, or if there is no room for another actor.
extern fn wgf_light_create(type_: wgf_light_type_t) -> wgf_actor_t;

extern fn wgf_light_get_type(light: wgf_actor_t) -> wgf_light_type_t;

/// Sets or gets the light's color (default: white). Alpha is ignored.
extern fn wgf_light_set_color(light: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_light_get_color(light: wgf_actor_t) -> wgf_color_t;

/// Sets or gets how strong the light is: its color times this (default: 1).
///
/// It is clamped to 0 or more.
extern fn wgf_light_set_intensity(light: wgf_actor_t, intensity: f32) -> bool;

extern fn wgf_light_get_intensity(light: wgf_actor_t) -> f32;

/// Sets or gets how far a point or spot light reaches, in units (default: 0, unlimited).
///
/// The light fades to nothing at its range. A range below 0 is clamped to 0.
extern fn wgf_light_set_range(light: wgf_actor_t, range: f32) -> bool;

extern fn wgf_light_get_range(light: wgf_actor_t) -> f32;

/// Sets or gets a spot light's cone, in radians from its direction.
///
/// - Inside `inner`, the light is full.
/// - Past `outer`, there is none.
/// - Between them, it fades smoothly.
///
/// These are glTF's innerConeAngle and outerConeAngle. `outer` is clamped to 0..pi/2, and
/// `inner` to 0..outer.
extern fn wgf_light_set_spot_cone(light: wgf_actor_t, inner: f32, outer: f32) -> bool;

extern fn wgf_light_get_spot_inner_angle(light: wgf_actor_t) -> f32;

extern fn wgf_light_get_spot_outer_angle(light: wgf_actor_t) -> f32;

/// Sets or gets whether the light casts shadows (default: off).
///
/// A casting light draws what it can see into a depth map once a frame. Surfaces behind another
/// surface are then darkened. Shadows are off by default because a map costs a pass and its
/// memory.
///
/// - Models cast and receive shadows (wgf_model_set_shadow_casting and
///   wgf_model_set_shadow_receiving; both on by default). Their see-through parts cast nothing.
/// - Directional and spot lights cast. A point light doesn't: turning it on is refused (returns
///   false, warned), since it would need six maps, one each way.
/// - Up to 4 lights cast at once: the first ones a stage's draw finds in its tree. Past that, a
///   light lights the stage without shadowing it.
/// - Shadows fall on the frame's first stage drawn with a casting light. A stage drawn after it
///   (a HUD's) is lit without shadows.
/// - A model out of the camera's view still casts when its shadow reaches the view.
extern fn wgf_light_set_shadow_casting(light: wgf_actor_t, casting: bool) -> bool;

extern fn wgf_light_is_shadow_casting(light: wgf_actor_t) -> bool;

/// Sets or gets how far the light's shadows reach, in units (default: 50).
///
/// - A directional light covers that much of what the camera sees. It uses one map, fitted
///   around the view and snapped to its texels (no cascades). So a shorter distance gives a
///   sharper shadow.
/// - A spot light covers its cone out to this distance or its range, whichever is nearer.
///
/// set_shadow_distance returns false, and changes nothing, for a distance of 0 or less.
extern fn wgf_light_set_shadow_distance(light: wgf_actor_t, distance: f32) -> bool;

extern fn wgf_light_get_shadow_distance(light: wgf_actor_t) -> f32;

/// Sets or gets the size of the light's shadow map, in pixels each way (default: 2048).
///
/// The size is clamped to 256..4096 and rounded down to a power of two. Bigger is sharper and
/// slower. The casting lights share one map, so they all get the largest size any of them asked
/// for. get_shadow_map_size returns the size the GPU gets.
///
/// set_shadow_map_size returns false for a size below 1.
extern fn wgf_light_set_shadow_map_size(light: wgf_actor_t, size: i32) -> bool;

extern fn wgf_light_get_shadow_map_size(light: wgf_actor_t) -> i32;

/// Sets or gets how much of the light a shadow blocks, 0..1 (default: 1, all of it).
///
/// It is clamped to 0..1.
extern fn wgf_light_set_shadow_strength(light: wgf_actor_t, strength: f32) -> bool;

extern fn wgf_light_get_shadow_strength(light: wgf_actor_t) -> f32;

/// Sets or gets a color mixed into what a shadow leaves behind (default: black, nothing added).
///
/// It is scaled by how deep the shadow is. Use it to stylize shadows, as blue or warm ones.
extern fn wgf_light_set_shadow_color(light: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_light_get_shadow_color(light: wgf_actor_t) -> wgf_color_t;

/// Sets or gets the depth offsets that keep a surface from shadowing itself, in shadow-map
/// texels (default: 1 and 4).
///
/// - `constant` always applies.
/// - `slope` is scaled by how steeply the surface faces away from the light.
///
/// Too little bias and lit surfaces stripe ("shadow acne"). Too much, and a shadow creeps away
/// from its caster.
///
/// set_shadow_bias returns false, and changes nothing, if either is negative.
extern fn wgf_light_set_shadow_bias(light: wgf_actor_t, constant: f32, slope: f32) -> bool;

extern fn wgf_light_get_shadow_bias_constant(light: wgf_actor_t) -> f32;

extern fn wgf_light_get_shadow_bias_slope(light: wgf_actor_t) -> f32;

// ---- wgf_material.h ----

extern wgf_material_shading_t;
extern let WGF_MATERIAL_SHADING_PBR: wgf_material_shading_t;
extern let WGF_MATERIAL_SHADING_UNLIT: wgf_material_shading_t;
extern let WGF_MATERIAL_SHADING_CUSTOM: wgf_material_shading_t;

/// How a material, sprite, particle, or 2D drawing uses its alpha.
///
/// On a stage, the modes draw in this order:
/// - OPAQUE and MASK write depth and are drawn first, unsorted.
/// - BLEND is drawn next, sorted back to front.
/// - ADD is drawn last. It is for particles only: a material refuses it.
///
/// MULTIPLY and PREMULTIPLIED are for 2D drawing only: immediate mode
/// (wgf_draw_set_blend_mode), and sprites on a 2D stage. A sprite on a 3D stage draws them
/// as BLEND. Materials, emitters, and sprite batches refuse them.
extern wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_OPAQUE: wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_MASK: wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_BLEND: wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_ADD: wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_MULTIPLY: wgf_alpha_mode_t;
extern let WGF_ALPHA_MODE_PREMULTIPLIED: wgf_alpha_mode_t;

/// Creates a material with glTF's defaults.
///
/// Returns 0 if `shading` isn't PBR or UNLIT (logged), or if there is no room for another
/// material.
extern fn wgf_material_create(shading: wgf_material_shading_t) -> wgf_material_t;

/// Creates a material drawn by `shader` (wgf_shader_create), which may still be loading.
/// The material holds its own reference to the shader.
///
/// - With a surface shader, the material draws a stage's models.
/// - With a screen effect's shader, the material is added to the frame's effects
///   (wgf_render_add_effect).
///
/// Returns 0 if `shader` isn't a shader (logged), or if there is no room for another
/// material.
extern fn wgf_material_create_custom(shader: wgf_shader_t) -> wgf_material_t;

/// Returns a custom material's shader, or 0 for a material with built-in shading.
extern fn wgf_material_get_shader(material: wgf_material_t) -> wgf_shader_t;

/// Sets or gets the material's shading. The setter returns false if `shading` isn't PBR or
/// UNLIT, or if the material is a custom one.
extern fn wgf_material_set_shading(material: wgf_material_t, shading: wgf_material_shading_t) -> bool;

extern fn wgf_material_get_shading(material: wgf_material_t) -> wgf_material_shading_t;

/// Sets how the material uses alpha (default: OPAQUE), and the cutoff for MASK (default: 0.5).
/// MASK draws only where alpha reaches the cutoff. A cutoff below 0 is clamped to 0.
/// Returns false if `mode` isn't an alpha mode.
extern fn wgf_material_set_alpha_mode(material: wgf_material_t, mode: wgf_alpha_mode_t, cutoff: f32) -> bool;

extern fn wgf_material_get_alpha_mode(material: wgf_material_t) -> wgf_alpha_mode_t;

extern fn wgf_material_get_alpha_cutoff(material: wgf_material_t) -> f32;

/// Sets whether both sides of a surface are drawn (default: single sided). The back faces
/// of a double-sided surface are lit from their own side.
extern fn wgf_material_set_double_sided(material: wgf_material_t, double_sided: bool) -> bool;

extern fn wgf_material_is_double_sided(material: wgf_material_t) -> bool;

/// Sets or gets a parameter by name, from the table above.
///
/// - set_int refuses a texture coordinate set other than 0 or 1.
/// - set_color takes an sRGB color for a vec3 or vec4 parameter and stores it as linear.
///   Its alpha is stored unchanged. Read it back with get_vec3 or get_vec4.
extern fn wgf_material_set_int(material: wgf_material_t, name: const char*, value: i32) -> bool;

extern fn wgf_material_get_int(material: wgf_material_t, name: const char*) -> i32;

extern fn wgf_material_set_float(material: wgf_material_t, name: const char*, value: f32) -> bool;

extern fn wgf_material_get_float(material: wgf_material_t, name: const char*) -> f32;

extern fn wgf_material_set_vec2(material: wgf_material_t, name: const char*, x: f32, y: f32) -> bool;

extern fn wgf_material_get_vec2(material: wgf_material_t, name: const char*) -> wgf_vec2_t;

extern fn wgf_material_set_vec3(material: wgf_material_t, name: const char*, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_material_get_vec3(material: wgf_material_t, name: const char*) -> wgf_vec3_t;

extern fn wgf_material_set_vec4(material: wgf_material_t, name: const char*, x: f32, y: f32, z: f32, w: f32) -> bool;

extern fn wgf_material_get_vec4(material: wgf_material_t, name: const char*) -> wgf_vec4_t;

extern fn wgf_material_set_color(material: wgf_material_t, name: const char*, color: wgf_color_t) -> bool;

/// Sets or gets a texture parameter by name. The material holds its own reference to the
/// texture, and 0 clears it. Returns false if `texture` isn't a texture.
extern fn wgf_material_set_texture(material: wgf_material_t, name: const char*, texture: wgf_texture_t) -> bool;

extern fn wgf_material_get_texture(material: wgf_material_t, name: const char*) -> wgf_texture_t;

/// Sets or gets a custom material's cubemap (wgf_cubemap.h): its shader's textureCube
/// `name`, sampled as a samplerCube (wgf.glsl). The material holds its own reference to the
/// cubemap, and 0 clears it.
///
/// Returns false for a material with built-in shading, a handle that isn't a cubemap, or a
/// name that is one of the shader's texture2Ds (set those with wgf_material_set_texture).
/// If the shader is still loading, the cubemap is kept and checked once the shader is
/// READY. A wrong name is then dropped with a warning.
///
/// set_texture refuses a textureCube's name in the same way, and each getter returns 0 for
/// the other kind.
extern fn wgf_material_set_cubemap(material: wgf_material_t, name: const char*, cubemap: wgf_cubemap_t) -> bool;

extern fn wgf_material_get_cubemap(material: wgf_material_t, name: const char*) -> wgf_cubemap_t;

/// Sets or gets how texture parameter `name` is sampled (default: repeat, linear). A
/// cubemap uses only the filter, and is always clamped at its edges. Returns false for a
/// wrap or filter that isn't one.
extern fn wgf_material_set_texture_sampling(
    material: wgf_material_t,
    name: const char*,
    wrap_u: wgf_texture_wrap_t,
    wrap_v: wgf_texture_wrap_t,
    filter: wgf_texture_filter_t
) -> bool;

extern fn wgf_material_get_texture_wrap_u(material: wgf_material_t, name: const char*) -> wgf_texture_wrap_t;

extern fn wgf_material_get_texture_wrap_v(material: wgf_material_t, name: const char*) -> wgf_texture_wrap_t;

extern fn wgf_material_get_texture_filter(material: wgf_material_t, name: const char*) -> wgf_texture_filter_t;

// ---- wgf_mesh.h ----

extern fn wgf_mesh_create_plane(width: f32, length: f32, subdivisions: i32) -> wgf_mesh_t;

extern fn wgf_mesh_create_cube(width: f32, height: f32, length: f32) -> wgf_mesh_t;

extern fn wgf_mesh_create_sphere(radius: f32, rings: i32, segments: i32) -> wgf_mesh_t;

extern fn wgf_mesh_create_cylinder(radius: f32, height: f32, segments: i32) -> wgf_mesh_t;

extern fn wgf_mesh_create_cone(radius: f32, height: f32, segments: i32) -> wgf_mesh_t;

extern fn wgf_mesh_create_capsule(radius: f32, height: f32, rings: i32, segments: i32) -> wgf_mesh_t;

extern fn wgf_mesh_create_torus(radius: f32, thickness: f32, rings: i32, segments: i32) -> wgf_mesh_t;

/// Creates a mesh of the program's own triangles, such as a road along a centerline, or a
/// terrain.
///
/// - `positions`: the corners' positions, x, y, z each. `position_count` floats, a multiple
///   of 3.
/// - `normals`: as many as the positions. With none, smooth normals are made from the
///   triangles.
/// - `uvs`: texture coordinates, u, v each. With none, they are 0, 0.
/// - `indices`: the triangles, as indices into the corners, three each, counterclockwise seen
///   from the front. With none, the corners are taken in threes.
/// - A count of 0 means none, whatever its pointer.
///
/// The mesh is ready at once, as a generated mesh is. It has one material slot: white, not
/// metallic, roughness 0.5. The arrays are copied.
///
/// Returns 0 if the counts don't fit, or if an index is past the corners (logged).
extern fn wgf_mesh_create_triangles(
    positions: const f32*,
    position_count: i32,
    normals: const f32*,
    normal_count: i32,
    uvs: const f32*,
    uv_count: i32,
    indices: const i32*,
    index_count: i32
) -> wgf_mesh_t;

/// Creates a terrain from a grid of heights, filled from any array a game makes.
///
/// - Each row holds `columns` heights along x. The rows run along z, and there are
///   `height_count` / `columns` of them.
/// - Each height is a corner. Its y is the height times `height`.
/// - The grid spans `width` in x and `length` in z, centered on the origin in both.
/// - Each cell is two triangles facing up (counterclockwise seen from +y). The corners are
///   shared.
/// - Normals are smooth, made from the triangles as wgf_mesh_create_triangles makes them.
/// - Texture coordinates span the grid once: u along x, v along z.
///
/// It is a mesh made from numbers, as wgf_mesh_create_triangles's is. It is its own, ready at
/// once, and can be changed in place by the calls below.
///
/// Returns 0 (logged) if:
/// - There are fewer than 2 columns or rows, or more than 4096 of either.
/// - `height_count` isn't a whole number of rows.
/// - `width` or `length` is 0 or less.
extern fn wgf_mesh_create_heightmap(
    heights: const f32*,
    height_count: i32,
    columns: i32,
    width: f32,
    height: f32,
    length: f32
) -> wgf_mesh_t;

/// Changes a mesh made from numbers in place (wgf_mesh_create_triangles,
/// wgf_mesh_create_heightmap).
///
/// Each call replaces the corners' positions, normals, texture coordinates, or colors from your
/// array, as many as the mesh has corners. The change goes to the GPU when the mesh is next
/// drawn. Its triangles stay as they are. Use it for a deformed terrain, water, or geometry made
/// each frame.
///
/// - The first change makes the mesh's vertices a buffer the GPU expects to change. A mesh
///   never changed keeps a buffer that isn't.
/// - The GPU takes one change a frame. Of several changes in a frame, it draws the last, the
///   next frame.
///
/// Each call returns true when it changed the mesh. It returns false, and changes nothing:
/// - For a mesh not made from numbers. A generated shape is shared by its parameters, and a
///   file's mesh is its file's.
/// - For a count that isn't the mesh's corners times 3 (positions and normals), 2 (texture
///   coordinates), or 4 (colors). A count of 0 is allowed, and gives the default its create
///   call gives (except for positions, below).
///
///   positions  x, y, z each. The mesh's box (wgf_mesh_get_bounds_min, _max) is made
///              again. A count of 0 is refused. Its normals stay as they were: set them,
///              or make them smooth again with a count of 0
///   normals    x, y, z each, unit length. 0: smooth, made from the triangles as they are
///   uvs        u, v each (both texture coordinate sets). 0: all 0, 0
///   colors     red, green, blue, alpha each, 0..1 (clamped), as a wgf_color_t's channels
///              are (sRGB, stored linear). The built-in shadings multiply the material's
///              color by them, and a custom shader reads them as wgf_color. 0: white
///
/// The tangents follow. A physics body made from the mesh (wgf_body3d.h) keeps the shape it was
/// made with: make it again to collide with the new shape.
extern fn wgf_mesh_set_positions(mesh: wgf_mesh_t, positions: const f32*, position_count: i32) -> bool;

extern fn wgf_mesh_set_normals(mesh: wgf_mesh_t, normals: const f32*, normal_count: i32) -> bool;

extern fn wgf_mesh_set_uvs(mesh: wgf_mesh_t, uvs: const f32*, uv_count: i32) -> bool;

extern fn wgf_mesh_set_colors(mesh: wgf_mesh_t, colors: const f32*, color_count: i32) -> bool;

/// Reads the corners of a mesh of one part.
///
/// This works on any mesh of one part, including a generated shape's and a file's.
///
/// - get_vertex_count returns how many corners it has. It returns 0 for a handle that isn't a
///   READY mesh, and for a mesh of several parts or none, as a file's own mesh is.
/// - The others copy the corners' positions, normals, texture coordinates (set 0), or colors
///   into your array, as many whole corners as fit. Colors are sRGB, as wgf_mesh_set_colors
///   takes them: a file's COLOR_0, or white where it has none.
///
/// Each copy returns how many numbers it filled.
extern fn wgf_mesh_get_vertex_count(mesh: wgf_mesh_t) -> i32;

extern fn wgf_mesh_get_positions(mesh: wgf_mesh_t, positions: f32*, position_count: i32) -> i32;

extern fn wgf_mesh_get_normals(mesh: wgf_mesh_t, normals: f32*, normal_count: i32) -> i32;

extern fn wgf_mesh_get_uvs(mesh: wgf_mesh_t, uvs: f32*, uv_count: i32) -> i32;

extern fn wgf_mesh_get_colors(mesh: wgf_mesh_t, colors: f32*, color_count: i32) -> i32;

/// Creates the mesh in a glTF file: a .gltf with its buffers and images beside it, or a .glb.
///
/// It loads in the background, as a texture does (wgf_resource.h): PENDING, then READY or
/// FAILED. The asset part's search paths find it, and it is shared by its path.
///
/// It reads all of the file's scene's nodes:
/// - Their meshes. Each glTF mesh is one mesh, shared by every node showing it. Each of its
///   primitives has a material slot, with glTF's metallic-roughness material. Their textures
///   load with it.
/// - Their names and places.
/// - The lights KHR_lights_punctual gives them.
///
/// A model of it (wgf_model_set_mesh) is the file's root. Once the mesh is READY, the file's
/// node tree is made the model's children:
/// - A model of the mesh each node shows (wgf_model_get_mesh). Nodes sharing one mesh share
///   one handle.
/// - A plain actor for a node with no mesh.
/// - Each named and placed as in the file, and found as any actor is (wgf_actor_find).
/// - A light under a node that carries one.
///
/// The file's own mesh holds the tree and the materials, and no triangles. A model of a PENDING
/// mesh draws nothing. A model of a FAILED one draws the placeholder checker on a unit cube.
///
/// The file's skins and animations are read too: a model of the mesh poses and plays them (see
/// wgf_model.h). Morph targets, cameras, and `extras` (a node's or the file's own data) are not
/// read. A game's data beside its geometry is a file of its own.
///
/// Returns 0 if `path` is empty, or isn't .gltf or .glb (logged).
extern fn wgf_mesh_create(path: const char*) -> wgf_mesh_t;

/// Creates one mesh of several, drawn with fewer draws.
///
/// For example, a character's head, body, legs, and feet as one mesh, posed once and drawn as
/// few primitives.
///
/// `meshes`, `count` of them (1 to 64), are glTF files' meshes or meshes made in code. Each is
/// held until the merged mesh is made, so you may let go of them at once. The merged mesh is
/// PENDING until every one of them, and `skeleton`, is READY. Then it is made. It is FAILED if
/// one of them FAILED, or if the skeleton has no skin.
///
/// Merging materials:
/// - Primitives whose materials differ only in base color become one primitive. Each color is
///   multiplied into its vertices' colors, and drawn by a copy of the first material, made
///   white.
/// - Any other difference keeps them apart: shading, alpha, double sided, metal, roughness,
///   emission, or a texture or its sampling.
/// - A custom material merges only with itself.
///
/// With a `skeleton`, the merged mesh is a file's. The skeleton is a glTF file's mesh with a
/// skin, usually one of `meshes`.
/// - Its tree is the skeleton's nodes, with their names, places, and animations. A model of it
///   is the file's root (wgf_model.h): its joints are actors, wgf_model_find_node finds a
///   socket, and wgf_model_set_animations gives it clips.
/// - The skeleton's own meshes are not drawn, except as pieces.
/// - Each piece's skinned primitives are bound to the skeleton's first skin, by their joints'
///   names. A joint the skeleton hasn't follows its nearest ancestor the skeleton has. A vertex
///   following no joint follows the skin's first joint.
/// - A piece bound in another bind pose is bound again to the skeleton's.
/// - A piece's primitive that isn't skinned follows the joint its node, or its nearest
///   ancestor, is named as (a helmet under "Head"). It is placed as its file placed it under
///   that node.
/// - A primitive under no such node, and a mesh made in code, stays where it is, under the
///   root.
///
/// With a `skeleton` of 0, the merged mesh is a plain one, with no tree. Every primitive is
/// placed where its file put it at rest, and a skinned one at its bind pose.
///
/// Lights, and a piece's own animations, aren't carried. A piece loaded again
/// (wgf_asset_reload) doesn't change the merged mesh.
///
/// Returns 0 (logged) if there are no meshes or more than 64, if a handle isn't a mesh, or if
/// `skeleton` isn't a glTF file's mesh.
extern fn wgf_mesh_create_merged(meshes: const wgf_mesh_t*, count: i32, skeleton: wgf_mesh_t) -> wgf_mesh_t;

/// Returns how many materials the mesh has, and the material at a slot (wgf_material.h).
///
/// The mesh has one material a slot, and a generated mesh has one. The handle is borrowed: it
/// is valid while the mesh is. Changing it changes every model that draws the mesh with it.
///
/// get_material returns 0 for a slot the mesh hasn't.
extern fn wgf_mesh_get_material_count(mesh: wgf_mesh_t) -> i32;

extern fn wgf_mesh_get_material(mesh: wgf_mesh_t, slot: i32) -> wgf_material_t;

/// Returns the box around the mesh in its own space: its least and greatest corner.
///
/// Returns 0, 0, 0 for both while the mesh isn't READY, or if `mesh` isn't a mesh.
extern fn wgf_mesh_get_bounds_min(mesh: wgf_mesh_t) -> wgf_vec3_t;

extern fn wgf_mesh_get_bounds_max(mesh: wgf_mesh_t) -> wgf_vec3_t;

// ---- wgf_model.h ----
extern let WGF_MODEL_LAYERS: i32;

/// Creates a model of `mesh`. A `mesh` of 0 means none yet.
///
/// The model is tinted white, so it draws as its materials are.
///
/// Returns 0 if `mesh` isn't a mesh, or if there is no room for another actor.
extern fn wgf_model_create(mesh: wgf_mesh_t) -> wgf_actor_t;

/// Sets or gets the model's mesh. 0 means none, and nothing is drawn.
///
/// A glTF file's mesh (wgf_mesh_create) makes the model the file's root. Once the mesh is
/// READY, the file's node tree is made the model's children. The mesh is then the model's for
/// good.
///
/// To tell that a model has loaded, test its mesh's status (wgf_resource_get_status of
/// wgf_model_get_mesh). The moment it reads READY, the model's children are made and its
/// animations are there, so there is no need to test their counts.
///
/// When the file is loaded again (wgf_asset_reload), the tree is made again in place:
/// - A node's actor is kept, found by its name under its parent's actor, and moved.
/// - Its mesh keeps the same handle, with the new triangles.
/// - A node the file no longer has is gone, with its actor and every actor under it.
/// - A new node is made.
/// - The file's lights are made again.
/// - An animation playing goes on at its time, in the clip of the same name, whatever its
///   number in the file is now. It stops if the file no longer has a clip of that name
///   (logged). A layer does the same, and stops too if the file no longer has its bone.
/// - The same when the file a model takes its clips from (wgf_model_set_animations) loads
///   again: the model goes on in the clips of their names.
///
/// set_mesh returns false if:
/// - `mesh` isn't a mesh.
/// - `mesh` is a file's mesh, and the model has children.
/// - The model is a file's root or one of its nodes, whose meshes are the file's.
extern fn wgf_model_set_mesh(model: wgf_actor_t, mesh: wgf_mesh_t) -> bool;

extern fn wgf_model_get_mesh(model: wgf_actor_t) -> wgf_mesh_t;

/// Sets or gets a color the model's materials are multiplied by (default: white).
///
/// Alpha below 255 makes the model see-through, blended back to front.
///
/// A glTF file's root draws nothing itself, and stands for its file. Its tint multiplies its
/// nodes' own, so one call tints the whole file: an enemy in red, or a hit's flash.
extern fn wgf_model_set_tint(model: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_model_get_tint(model: wgf_actor_t) -> wgf_color_t;

/// Sets or gets the material a slot is drawn with, in place of the mesh's.
///
/// - `slot` is 0..31. A `slot` of -1 sets every slot.
/// - A `material` of 0 goes back to the mesh's.
/// - The model holds its own reference. Its materials stay when the mesh changes.
///
/// set_material returns false for a slot out of range, or a handle that isn't a material.
///
/// get_material returns the material the slot draws with: the model's own or the mesh's. The
/// handle is borrowed. It returns 0 for neither.
extern fn wgf_model_set_material(model: wgf_actor_t, slot: i32, material: wgf_material_t) -> bool;

extern fn wgf_model_get_material(model: wgf_actor_t, slot: i32) -> wgf_material_t;

/// Sets or gets whether the model casts and receives shadows, when a light on its stage casts
/// them (see wgf_light_set_shadow_casting).
///
/// - Casting (default: on): the model is drawn into the light's depth map, so it shadows what
///   is behind it. Turn it off for a glow or a sky.
/// - Receiving (default: on): shadows darken the model.
///
/// Each setting is the model's own. In a glTF file's tree, each node's model has its own
/// setting. A hidden model casts nothing, and its see-through parts never cast.
extern fn wgf_model_set_shadow_casting(model: wgf_actor_t, casting: bool) -> bool;

extern fn wgf_model_is_shadow_casting(model: wgf_actor_t) -> bool;

extern fn wgf_model_set_shadow_receiving(model: wgf_actor_t, receiving: bool) -> bool;

extern fn wgf_model_is_shadow_receiving(model: wgf_actor_t) -> bool;

/// Plays a glTF file's animations on its root: a model of wgf_mesh_create's mesh.
///
/// An animation moves the actors of the file's tree. Each joint of a skin is one of those
/// actors, and an actor put under a joint moves with it. That poses the skinned parts its skins
/// place, on the GPU, with up to 4 joints a vertex.
///
/// A clip's translation, rotation, and scale channels play as the file has them: linear (a
/// rotation takes the shorter arc), step, or cubic spline.
///
/// What plays has one state, a wgf_play_state.h state. Its transitions are those of play,
/// pause, resume, and stop, as a voice's are. libwgf advances it once a frame, by the frame's
/// time, before the frame callback, and poses the model then. So the frame reads this frame's
/// pose.
///
///   count, name, find, duration  the file's animations: how many there are (0 until it is
///                    READY), one's name ("" for none), the first one so named (-1 for
///                    none), and its length in seconds (its last key's time; 0 for none)
///   play             plays `animation` from its start (from its end with a negative speed),
///                    PLAYING, from any state. It is posed at once. A `fade` > 0 crossfades
///                    into it over that many seconds, from what shows now: the clip that was
///                    playing, still moving, or the pose held (a crossfade's middle, or a
///                    clip not moving). Each node's place, turn, and scale are blended. A
///                    `fade` of 0 or less cuts to it. A node that another animation of the
///                    file moves, and this one doesn't, is at the file's rest pose. Played
///                    before the file is READY, it plays once the file is there. If the file
///                    hasn't that animation, it is dropped then (warned). Returns false for
///                    a model that isn't a file's root, a negative animation, a fade that
///                    isn't a number, a file that FAILED, or an animation the READY file
///                    hasn't
///   get_animation    the animation played (or stopped at, or paused in); -1 for none
///   weight           how much of the pose is the played animation's: 0 as its crossfade
///                    begins, to 1 when it is through. 1 with no crossfade, 0 with no
///                    animation
///   pause, resume    pause works only from PLAYING, and resume only from PAUSED. The
///                    animation is held where it was, its crossfade too
///   stop             goes to STOPPED from any state, at time 0, showing the clip's first
///                    pose. Its crossfade is dropped
///   state            COMPLETE when an animation that isn't looping has run to the end it
///                    runs toward, and is held there. Also COMPLETE when its file FAILED
///                    while it played
///   speed            1 is normal (the default). Negative plays backwards. 0 holds, still
///                    PLAYING. Returns false for a speed that isn't finite
///   loop             wraps at the end (the default), or holds the last pose and becomes
///                    COMPLETE
///   time             where it is, in seconds from its start. set_time poses it there at
///                    once, wrapped when looping and clamped to [0, duration] when not. It
///                    leaves the state as it is. Returns false for a time that isn't finite
///
/// Each call returns false (or 0, -1, or "") for a model that isn't a file's root.
///
/// Because the frame moves an animation on, an animation is for what is seen. For what a game
/// decides by (a hit frame, a replay), drive it by hand: set speed 0, and call set_time from
/// the game's fixed tick.
///
/// A custom material (wgf_material_create_custom) on a skinned part draws it posed too. Its
/// vertex hook runs before the joints pose it.
extern fn wgf_model_get_animation_count(model: wgf_actor_t) -> i32;

extern fn wgf_model_get_animation_name(model: wgf_actor_t, animation: i32) -> const char*;

extern fn wgf_model_find_animation(model: wgf_actor_t, name: const char*) -> i32;

extern fn wgf_model_get_animation_duration(model: wgf_actor_t, animation: i32) -> f32;

extern fn wgf_model_play_animation(model: wgf_actor_t, animation: i32, fade: f32) -> bool;

extern fn wgf_model_get_animation(model: wgf_actor_t) -> i32;

extern fn wgf_model_get_animation_weight(model: wgf_actor_t) -> f32;

extern fn wgf_model_pause_animation(model: wgf_actor_t) -> bool;

extern fn wgf_model_resume_animation(model: wgf_actor_t) -> bool;

extern fn wgf_model_stop_animation(model: wgf_actor_t) -> bool;

extern fn wgf_model_get_animation_state(model: wgf_actor_t) -> wgf_play_state_t;

extern fn wgf_model_set_animation_speed(model: wgf_actor_t, speed: f32) -> bool;

extern fn wgf_model_get_animation_speed(model: wgf_actor_t) -> f32;

extern fn wgf_model_set_animation_loop(model: wgf_actor_t, loop_: bool) -> bool;

extern fn wgf_model_is_animation_loop(model: wgf_actor_t) -> bool;

extern fn wgf_model_set_animation_time(model: wgf_actor_t, seconds: f32) -> bool;

extern fn wgf_model_get_animation_time(model: wgf_actor_t) -> f32;

extern fn wgf_model_play_layer_animation(
    model: wgf_actor_t,
    index: i32,
    animation: i32,
    bone: const char*,
    fade: f32,
    loop_: bool
) -> bool;

extern fn wgf_model_stop_layer_animation(model: wgf_actor_t, index: i32, fade: f32) -> bool;

extern fn wgf_model_get_layer_animation(model: wgf_actor_t, index: i32) -> i32;

extern fn wgf_model_get_layer_state(model: wgf_actor_t, index: i32) -> wgf_play_state_t;

extern fn wgf_model_get_layer_weight(model: wgf_actor_t, index: i32) -> f32;

/// Sets `model` playing as `from` plays now.
///
/// It copies the animation, time, speed, loop, and state, and the layers (each layer's bone
/// found again by name). A crossfade running in `from` ends at its clip.
///
/// Use it for a part of a character put on while the others play, so it doesn't start its clip
/// again. For example, a part model swapped in, with each part given the same clips
/// (wgf_model_set_animations).
///
/// Returns false if `model` isn't a file's root, if `from` has no animation, or if `model`
/// hasn't `from`'s clips.
extern fn wgf_model_sync_animation(model: wgf_actor_t, from: wgf_actor_t) -> bool;

/// Returns a socket: the first node named `name` under a file's root, at any depth.
///
/// A file's joints are actors, so `name` can be a bone such as "Hand.R" or "Head". A sword
/// parented to the hand (wgf_actor_set_parent) follows it through every clip.
///
/// Returns 0 if there is no such node, or if `model` isn't a file's root.
extern fn wgf_model_find_node(model: wgf_actor_t, name: const char*) -> wgf_actor_t;

/// Sets or gets where the model's animations come from: another glTF file, `clips`.
///
/// `clips` is a file of animations alone, with its skeleton named as this file's is. For
/// example, Wardens' Animations.glb for each of a character's part models. Each clip's
/// channels move this file's nodes of the same names.
///
/// - A `clips` of 0 goes back to the model's own animations.
/// - What was playing stops.
/// - Each part of a character given the same clips, and played the same way, moves as one.
///
/// set_animations returns false if `model` isn't a file's root, or if `clips` isn't a mesh.
extern fn wgf_model_set_animations(model: wgf_actor_t, clips: wgf_mesh_t) -> bool;

extern fn wgf_model_get_animations(model: wgf_actor_t) -> wgf_mesh_t;

/// Returns the box around every model at and under `actor`: its least and greatest corner.
///
/// Each mesh's box is placed as the model is now, in the tree's root's space. Use it to place
/// a glTF file's tree on the ground, or to frame it in a camera.
///
/// Returns 0, 0, 0 for both if no model there has a READY mesh.
extern fn wgf_model_get_bounds_min(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_model_get_bounds_max(actor: wgf_actor_t) -> wgf_vec3_t;

/// Tests where a ray meets this model, as it is drawn now.
///
/// - For a model, it tests its triangles. Its box is tested first. A skinned model is tested in
///   its pose this frame.
/// - For a glTF file's root, it tests its file's visible nodes.
/// - It tests the model whether it is pickable or not (wgf_actor_set_pickable). To find a model
///   among others, see wgf_stage3d_pick.
///
/// The ray is its origin and its direction, in its stage's space. The direction need not be a
/// unit vector. The hit goes into `hit` as wgf_stage3d_pick_ray's does, all 0 after a miss.
///
/// Returns false for a miss, a handle that isn't a model, a mesh that isn't READY, or a
/// direction of 0 or not finite.
extern fn wgf_model_pick_ray(
    model: wgf_actor_t,
    ox: f32,
    oy: f32,
    oz: f32,
    dx: f32,
    dy: f32,
    dz: f32,
    hit: f32*,
    hit_count: i32
) -> bool;

// ---- wgf_pointer.h ----

/// Sets or gets whether the pointer picks a stage (default: not picked).
///
/// A stage that is destroyed leaves the list by itself.
///
/// set_interactive returns false if `stage` isn't a 2D or a 3D stage.
extern fn wgf_pointer_set_interactive(stage: wgf_actor_t, interactive: bool) -> bool;

extern fn wgf_pointer_is_interactive(stage: wgf_actor_t) -> bool;

/// Returns the topmost actor under the pointer, or 0 if there is none.
extern fn wgf_pointer_get_hovered() -> wgf_actor_t;

/// Returns whether `actor` is under the pointer.
///
/// - PRESSED: it came under the pointer.
/// - DOWN: it is under the pointer.
/// - RELEASED: the pointer left it.
/// - UP: it isn't under the pointer.
extern fn wgf_pointer_get_hover_state(actor: wgf_actor_t) -> wgf_input_state_t;

/// Returns the state of a press that started on `actor`, by the left button or a finger.
///
/// - PRESSED: it went down on the actor.
/// - DOWN: it is held, even once the pointer has moved off the actor (a drag).
/// - RELEASED: it was let go, wherever the pointer is then.
/// - UP: otherwise.
extern fn wgf_pointer_get_press_state(actor: wgf_actor_t) -> wgf_input_state_t;

/// Returns true for a click: a press let go while still over the actor it started on.
extern fn wgf_pointer_is_clicked(actor: wgf_actor_t) -> bool;

/// Returns the actor a held press started on: the actor being dragged. Returns 0 if no press is
/// held.
extern fn wgf_pointer_get_held() -> wgf_actor_t;

// ---- wgf_presentation.h ----

/// How a game's design resolution is fitted to the window or the screen.
///
/// A game is written for a design resolution. Its logical coordinates stay the design's at any
/// window size and in fullscreen. That holds for drawing, 2D stages, the UI, the pointer and
/// touches (mapped back into those coordinates), and an autopilot's mouse. It works the same
/// on the desktop, in a resized browser window, and in fullscreen.
///
///   NONE     the default: logical pixels are the window's (a framebuffer pixel divided by
///            the DPI scale), and the visible area is the window
///   STRETCH  the design scaled to the window on each axis separately, losing its aspect
///   FIT      scaled alike on both axes, as large as fits whole, and centered; the rest
///            is bars (wgf_presentation_set_bar_color), with nothing drawn in them
///   FILL     scaled alike, as small as covers the window, and centered; whatever is past
///            the window's edges is cropped
///   EXPAND   scaled as FIT is, but the visible area grows past the design to the
///            window's edges, centered on it; the design is the least the game shows,
///            and a UI anchored to the visible area's edges stays at them
///   INTEGER  as FIT, at a whole number of framebuffer pixels to a logical one (at
///            least 1), for pixel art; with bars around it
///
/// wgf_presentation_set sets the mode and the design size.
/// - Set it any time. It takes effect at the next frame.
/// - A program that never sets a mode links none of the fitting code.
/// - Natively, a window whose size the program didn't set (wgf_window_set_size) opens at the
///   design size.
/// - It returns false for a size under 1 (except with NONE, which takes no size), or a mode
///   that isn't one.
extern wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_NONE: wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_STRETCH: wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_FIT: wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_FILL: wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_EXPAND: wgf_presentation_mode_t;
extern let WGF_PRESENTATION_MODE_INTEGER: wgf_presentation_mode_t;

extern fn wgf_presentation_set(mode: wgf_presentation_mode_t, width: i32, height: i32) -> bool;

extern fn wgf_presentation_get_mode() -> wgf_presentation_mode_t;

/// Sets or gets the color of the bars (default: black).
///
/// The bars, under FIT and INTEGER, are the framebuffer outside the visible area. Nothing is
/// drawn in them.
extern fn wgf_presentation_set_bar_color(color: wgf_color_t);

extern fn wgf_presentation_get_bar_color() -> wgf_color_t;

/// Returns the design resolution, or the window's logical size under NONE.
extern fn wgf_presentation_get_width() -> i32;

extern fn wgf_presentation_get_height() -> i32;

/// Returns what is visible now, in logical coordinates, as x, y, width, height.
///
/// - Under STRETCH, FIT, and INTEGER, it is the design area: 0, 0, its width, its height.
/// - Under FILL, it is less of the design area.
/// - Under EXPAND, it is more, with x and y below 0 when it grows.
///
/// A HUD anchored to a corner places itself from this.
extern fn wgf_presentation_get_visible() -> wgf_vec4_t;

/// Returns how many framebuffer pixels make a logical pixel, across.
///
/// Under STRETCH each axis has its own scale, and this returns the horizontal one.
extern fn wgf_presentation_get_scale() -> f32;

// ---- wgf_render.h ----

/// Sets or gets the color each frame starts cleared to (default: black).
extern fn wgf_render_set_clear_color(color: wgf_color_t);

extern fn wgf_render_get_clear_color() -> wgf_color_t;

/// Returns the frame's size in pixels, and how many pixels make one logical pixel.
///
/// - The DPI scale is 2 on most high-density displays.
/// - Drawing is in logical pixels: the frame is get_width() / get_dpi_scale() of them wide.
/// - While there is no surface, these return 0, 0, and 1.
/// - Inside a render target (wgf_render_begin_target), they return the target's size, and 1.
///   Drawing there is in the target's own pixels, with no presentation (wgf_presentation.h).
///   A stage's camera sees the target at its aspect ratio.
extern fn wgf_render_get_width() -> i32;

extern fn wgf_render_get_height() -> i32;

extern fn wgf_render_get_dpi_scale() -> f32;

/// Returns frame stats: the last frame's draw calls and triangles, and the bytes the GPU holds.
///
/// - Draw calls and triangles count every pass: the stages', the shadows', the render
///   targets', and immediate mode's.
/// - GPU bytes count the buffers and images alive now, at their sizes as made, with each mip
///   level and slice. A GPU's own padding isn't counted.
/// - The stats are counted as the graphics backend is called, so they cover every draw.
///
/// Each returns 0 before the first frame.
extern fn wgf_render_get_draw_calls() -> i32;

extern fn wgf_render_get_triangle_count() -> f64;

extern fn wgf_render_get_gpu_bytes() -> f64;

/// Returns whether the GPU context is lost, and whether it was restored this frame.
///
/// On the web, the browser drops WebGL when a phone backgrounds the page or the GPU resets,
/// and gives it back later. Natively the context is never lost, and both calls always return
/// false.
///
/// While the context is lost (is_context_lost), nothing is drawn and nothing is sent to the
/// GPU. Frames, ticks, input, and sound go on.
/// - A draw, a stage's draw, a document's draw, or a target begun does nothing, silently.
/// - A UI is laid out and its buttons answer, but nothing is drawn.
/// - A texture, mesh, shader, font, or other resource that is loading finishes once the
///   context is back.
/// - A target or blank texture made meanwhile gets its GPU side then.
///
/// When the context comes back, everything is made again under the same handles, before the
/// next frame is drawn:
/// - shaders and pipelines;
/// - a texture, cubemap, environment, bitmap font's pages, or glTF file's images, read again
///   from its file as this run has it, with nothing fetched. Each is blank until it is in,
///   which takes a few frames;
/// - meshes, from their vertices;
/// - a blank texture, with its last write (wgf_texture.h);
/// - fonts' glyphs;
/// - RmlUi's documents' textures.
///
/// Render targets come back blank. is_context_restored is true once, in the frame the
/// context is back in. A game that draws a target only when its content changes should draw
/// it again in that frame.
extern fn wgf_render_is_context_lost() -> bool;

extern fn wgf_render_is_context_restored() -> bool;

/// Begins drawing into a render target (wgf_texture_create_target) instead of the screen,
/// until wgf_render_end_target.
///
/// - Call it inside a frame. Everything then draws into the target: stages, sprites,
///   particles, text, the UI, and immediate mode.
/// - Targets are drawn before the screen, in the order begun, so the screen shows what they
///   drew this frame.
/// - A target begun again in the same frame keeps what it drew before.
/// - Targets don't nest.
/// - A target isn't read while it is drawn into. Used inside its own pass, it draws nothing
///   there (warned once).
/// - A frame that ends inside a target ends the target (warned).
///
/// Returns false (logged) outside a frame, inside another target, for a texture that isn't
/// a target, or past 256 target passes in a frame.
extern fn wgf_render_begin_target(target: wgf_texture_t) -> bool;

extern fn wgf_render_end_target();

/// Reads the screen back as this frame ends, after its last pass and before it is shown.
///
/// - Outside a frame, it reads the next frame.
/// - The read (wgf_texture.h) is DONE then, holding the window's framebuffer at its pixels'
///   size (wgf_render_get_width times the DPI scale), with the top row first.
/// - In a headless build, the read FAILED.
/// - With wgf_texture_read_save, this takes a screenshot.
///
/// Returns 0 if there is no room for another read (logged).
extern fn wgf_render_read_screen() -> wgf_texture_read_t;

/// Sets or gets the color a pass into `target` starts cleared to (default: transparent black).
///
/// The color is kept with the target until changed. For a texture that isn't a render
/// target, the setter returns false, and the getter returns transparent black.
extern fn wgf_render_set_target_clear_color(target: wgf_texture_t, color: wgf_color_t) -> bool;

extern fn wgf_render_get_target_clear_color(target: wgf_texture_t) -> wgf_color_t;

/// Adds, clears, or counts screen effects: post-processing of the finished frame.
///
/// The finished frame (stages, sprites, text, and the UI) is redrawn by each effect in the
/// order added. The last effect draws onto the screen.
///
/// - An effect is a custom material (wgf_material_create_custom) whose shader is a screen
///   effect (wgf.glsl's wgf_screen, wgf_shader.h).
/// - Its parameters are the material's, and can change any frame.
/// - An effect whose shader is still loading is skipped until it is READY. One whose shader
///   FAILED is skipped.
/// - The chain is taken as each frame begins. Adding or clearing inside a frame shows from
///   the next frame.
/// - The effects hold their own references to their materials, and let go of them when
///   cleared.
/// - There can be up to 8 effects.
///
/// add returns false (logged) past 8 effects, for anything but a custom material, for a
/// surface shader's material, or before gfx runs (it works from init on).
extern fn wgf_render_add_effect(material: wgf_material_t) -> bool;

extern fn wgf_render_clear_effects();

extern fn wgf_render_get_effect_count() -> i32;

/// Clips drawing to a rectangle until the matching pop.
///
/// - The rectangle is in logical pixels from the top-left. Inside a render target, it is in
///   the target's own pixels.
/// - Everything drawn between push and pop is clipped: immediate mode, and the 2D stages
///   drawn there.
/// - Clips nest. Each push intersects with the clip it's pushed inside, so a scroll area
///   inside a panel stays inside the panel.
/// - A width or height of 0 clips everything away.
/// - A render target's pass starts unclipped. The screen's clips apply again when it ends.
/// - Clips go up to 32 deep. A push past that clips nothing more (warned once).
///
/// Pop every push within the frame, and a target's within its pass. Unmatched pushes are
/// dropped at the end, with a warning, as is a pop without a push. Outside a frame, both
/// calls do nothing (warned).
extern fn wgf_render_push_clip(x: f32, y: f32, width: f32, height: f32);

extern fn wgf_render_pop_clip();

// ---- wgf_shader.h ----

/// Creates a shader from the .wgfshader file at `path`, under fs's root.
///
/// Returns 0 only if there is no room for another shader. A shader that can't be loaded
/// FAILED (logged once, saying why). The reasons are:
/// - a file made by another version of pack_shader.py;
/// - a file with no program for this graphics backend;
/// - a file the graphics backend refused.
extern fn wgf_shader_create(path: const char*) -> wgf_shader_t;

// ---- wgf_shape2d.h ----

/// A 2D shape: an actor that draws a rectangle, a circle, a line, or a polygon on a 2D stage.
///
/// A shape is filled or outlined, in one color. Shapes are actors (wgf_actor.h): place, turn,
/// scale, parent, and destroy them with the actor calls. The shape turns and scales with its
/// actor, but an outline's thickness stays in the frame's logical pixels.
extern wgf_shape2d_kind_t;
extern let WGF_SHAPE2D_KIND_NONE: wgf_shape2d_kind_t;
extern let WGF_SHAPE2D_KIND_RECTANGLE: wgf_shape2d_kind_t;
extern let WGF_SHAPE2D_KIND_CIRCLE: wgf_shape2d_kind_t;
extern let WGF_SHAPE2D_KIND_LINE: wgf_shape2d_kind_t;
extern let WGF_SHAPE2D_KIND_POLYGON: wgf_shape2d_kind_t;

/// Creates a shape with nothing to draw yet, white and filled.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_shape2d_create() -> wgf_actor_t;

/// Returns the shape's kind, set by the calls below, or NONE for a handle that isn't a 2D
/// shape.
extern fn wgf_shape2d_get_kind(shape: wgf_actor_t) -> wgf_shape2d_kind_t;

/// Makes the shape a rectangle `width` by `height`, centered on its actor's position unless
/// its pivot is set. So are a sprite, a rectangle collider (wgf_collider.h), and an arcade
/// body, so each lines up with the others as it is made.
///
/// Returns false for a handle that isn't a 2D shape, or a size below 0.
extern fn wgf_shape2d_set_rectangle(shape: wgf_actor_t, width: f32, height: f32) -> bool;

/// Makes the shape a circle of `radius`, centered on its actor's position unless its pivot is
/// set.
///
/// Returns false for a handle that isn't a 2D shape, or a `radius` below 0.
extern fn wgf_shape2d_set_circle(shape: wgf_actor_t, radius: f32) -> bool;

/// Makes the shape a line from (x0, y0) to (x1, y1), in its own units.
///
/// The line is as thick as the outline, and a hairline at 0. Its ends are its own, so the
/// pivot doesn't move them.
///
/// Returns false for a handle that isn't a 2D shape.
extern fn wgf_shape2d_set_line(shape: wgf_actor_t, x0: f32, y0: f32, x1: f32, y1: f32) -> bool;

/// Makes the shape a polygon through `points`, in its own units.
///
/// - `points` holds x and y in turn: `count` floats, so count / 2 points, at most 1024.
/// - The points are copied.
/// - The polygon is filled whether convex or not, or outlined as a closed line.
/// - Its points are its own, so the pivot doesn't move them.
///
/// Returns false for a handle that isn't a 2D shape, a NULL `points`, an odd `count`, fewer
/// than 3 points, or more than 1024.
extern fn wgf_shape2d_set_polygon(shape: wgf_actor_t, points: const f32*, count: i32) -> bool;

/// Returns what was set.
///
/// - get_size returns a rectangle's width and height, or 0, 0 for another kind.
/// - get_radius returns a circle's radius, or 0 for another kind.
/// - get_line_start and get_line_end return a line's ends, or 0, 0 for another kind.
/// - get_point_count returns how many points a polygon has, or 0 for another kind.
/// - get_points copies a polygon's points into `out`, x and y in turn, as many as fit in
///   `count` floats. It returns how many floats it filled, or 0 for anything but a polygon.
extern fn wgf_shape2d_get_size(shape: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_shape2d_get_radius(shape: wgf_actor_t) -> f32;

extern fn wgf_shape2d_get_line_start(shape: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_shape2d_get_line_end(shape: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_shape2d_get_point_count(shape: wgf_actor_t) -> i32;

extern fn wgf_shape2d_get_points(shape: wgf_actor_t, out: f32*, count: i32) -> i32;

/// Sets or gets the pivot: the point of a rectangle or circle at its actor's position, which
/// it turns and scales about.
///
/// - The pivot is a fraction of the shape: 0, 0 is its top-left, and 1, 1 its bottom-right.
/// - The default is 0.5, 0.5: the shape's center.
/// - Set 0, 0 for a rectangle placed by its top-left corner, or 0, 0.5 for a bar that grows
///   from its left edge.
/// - A line and a polygon have their own points, which the pivot doesn't move.
///
/// The setter returns false for a handle that isn't a 2D shape.
extern fn wgf_shape2d_set_pivot(shape: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_shape2d_get_pivot(shape: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the outline: the shape is drawn as an outline `thickness` logical pixels wide,
/// centered on its edge.
///
/// - A `thickness` of 0 (the default) fills the shape. A line is then a hairline.
/// - The thickness is clamped to 0 or more.
///
/// The setter returns false for a handle that isn't a 2D shape.
extern fn wgf_shape2d_set_outline(shape: wgf_actor_t, thickness: f32) -> bool;

extern fn wgf_shape2d_get_outline(shape: wgf_actor_t) -> f32;

/// Sets or gets the radius a rectangle's corners are rounded to, in its own units (default: 0,
/// square).
///
/// - The corners are rounded as wgf_draw_rectangle_rounded rounds them, filled or outlined.
/// - The radius is clamped to 0 or more, and drawn at no more than half the shorter side.
/// - It is kept for the other kinds, which it doesn't change.
///
/// The setter returns false for a handle that isn't a 2D shape.
extern fn wgf_shape2d_set_corner_radius(shape: wgf_actor_t, radius: f32) -> bool;

extern fn wgf_shape2d_get_corner_radius(shape: wgf_actor_t) -> f32;

/// Sets or gets the shape's color (default: white). The setter returns false for a handle
/// that isn't a 2D shape.
extern fn wgf_shape2d_set_color(shape: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_shape2d_get_color(shape: wgf_actor_t) -> wgf_color_t;

// ---- wgf_shape3d.h ----

/// A 3D shape: an actor that draws a simple shape on a 3D stage (wgf_stage3d.h), in one
/// color, unlit.
///
/// Use shapes to draw debug views and markers. A shape is one of:
/// - a cube or a sphere;
/// - a filled rectangle, or a circle's outline, in its local x-y plane;
/// - a line, or a line strip.
///
/// On a 2D stage it draws nothing. For 2D shapes, see wgf_shape2d.h. Place, turn, scale, and
/// parent it with the actor calls.
///
/// On a stage, shapes are drawn after its opaque models and before its see-through ones,
/// depth tested. A see-through color blends over what is behind it, in the order the shapes
/// are found. Lines are a pixel wide.
extern wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_NONE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_CUBE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_SPHERE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_RECTANGLE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_CIRCLE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_LINE: wgf_shape3d_kind_t;
extern let WGF_SHAPE3D_KIND_LINE_STRIP: wgf_shape3d_kind_t;

/// Creates a shape with nothing to draw yet, white. Returns 0 if there is no room for another
/// actor.
extern fn wgf_shape3d_create() -> wgf_actor_t;

/// Returns the shape's kind, set by the calls below, or NONE for an actor that isn't a 3D
/// shape.
extern fn wgf_shape3d_get_kind(shape: wgf_actor_t) -> wgf_shape3d_kind_t;

/// Makes the shape a cube, a sphere, a rectangle, or a circle, about its actor's origin.
///
/// - set_cube makes a cube `width` by `height` by `length`.
/// - set_sphere makes a sphere of `radius`.
/// - set_rectangle makes a filled rectangle `width` by `height`, in its local x-y plane.
/// - set_circle makes a circle's outline of `radius`, in its local x-y plane.
///
/// Returns false for a size below 0.
extern fn wgf_shape3d_set_cube(shape: wgf_actor_t, width: f32, height: f32, length: f32) -> bool;

extern fn wgf_shape3d_set_sphere(shape: wgf_actor_t, radius: f32) -> bool;

extern fn wgf_shape3d_set_rectangle(shape: wgf_actor_t, width: f32, height: f32) -> bool;

extern fn wgf_shape3d_set_circle(shape: wgf_actor_t, radius: f32) -> bool;

/// Makes the shape a line from (x0, y0, z0) to (x1, y1, z1), in its own space.
extern fn wgf_shape3d_set_line(shape: wgf_actor_t, x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32) -> bool;

/// Makes the shape a line strip, or gets its points.
///
/// - `points` is your array, holding x, y, and z in turn: `float_count` floats, three for
///   each point. It is copied.
/// - The strip is drawn once it has two points.
/// - get_points fills your array with up to `float_count` floats of the points, and returns
///   how many it filled.
///
/// set_line_strip returns false for a `float_count` that isn't a multiple of 3, or past 65536
/// points.
extern fn wgf_shape3d_set_line_strip(shape: wgf_actor_t, points: const f32*, float_count: i32) -> bool;

extern fn wgf_shape3d_get_point_count(shape: wgf_actor_t) -> i32;

extern fn wgf_shape3d_get_points(shape: wgf_actor_t, points: f32*, float_count: i32) -> i32;

/// Returns what was set.
///
/// - get_size returns a cube's or rectangle's size, with a rectangle's z 0. It returns 0, 0, 0
///   for another kind.
/// - get_radius returns a sphere's or circle's radius, or 0 for another kind.
/// - get_line_start and get_line_end return a line's ends.
extern fn wgf_shape3d_get_size(shape: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_shape3d_get_radius(shape: wgf_actor_t) -> f32;

extern fn wgf_shape3d_get_line_start(shape: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_shape3d_get_line_end(shape: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets the shape's color (default: white). Alpha below 255 makes it see-through.
extern fn wgf_shape3d_set_color(shape: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_shape3d_get_color(shape: wgf_actor_t) -> wgf_color_t;

// ---- wgf_sheet.h ----

/// Creates a sheet over `texture`, cut into a grid of cells `frame_width` by `frame_height`
/// texels.
///
/// - Cells run left to right, then down.
/// - The grid starts `margin` texels in from the texture's edges, with `spacing` texels
///   between cells.
/// - The sheet has `count` frames. With 0, it has every cell that fits.
/// - The cells are cut once the texture is READY.
///
/// Returns 0 for a `texture` that isn't a texture, a frame size not above 0, or a `count`,
/// `margin`, or `spacing` below 0.
extern fn wgf_sheet_create_grid(
    texture: wgf_texture_t,
    frame_width: i32,
    frame_height: i32,
    count: i32,
    margin: i32,
    spacing: i32
) -> wgf_sheet_t;

/// Creates a sheet from the atlas at `path`, with its image. It loads as a resource does: it
/// is PENDING at once, and READY or FAILED in a later update. Returns 0 only if there is no
/// room for another sheet.
extern fn wgf_sheet_create(path: const char*) -> wgf_sheet_t;

/// Releases one reference to the sheet (as wgf_resource_release does). Releasing a grid's only
/// reference frees it.
extern fn wgf_sheet_destroy(sheet: wgf_sheet_t);

extern fn wgf_sheet_get_texture(sheet: wgf_sheet_t) -> wgf_texture_t;

/// Returns how many frames the sheet has, and one frame's region of the texture (x, y, width,
/// and height in texels). There are none while the texture isn't READY. Returns 0 for a handle
/// that isn't a sheet, or an `index` outside it.
extern fn wgf_sheet_get_frame_count(sheet: wgf_sheet_t) -> i32;

extern fn wgf_sheet_get_frame(sheet: wgf_sheet_t, index: i32) -> wgf_vec4_t;

/// Returns a frame's name, and the index of the frame named `name`.
///
/// - get_frame_name returns "" for a grid's frame, or an `index` outside the sheet.
/// - find_frame returns -1 if no frame has that name.
extern fn wgf_sheet_get_frame_name(sheet: wgf_sheet_t, index: i32) -> const char*;

extern fn wgf_sheet_find_frame(sheet: wgf_sheet_t, name: const char*) -> i32;

/// How a clip runs through its frames.
extern wgf_sheet_direction_t;
extern let WGF_SHEET_DIRECTION_FORWARD: wgf_sheet_direction_t;
extern let WGF_SHEET_DIRECTION_BACKWARD: wgf_sheet_direction_t;
extern let WGF_SHEET_DIRECTION_PING_PONG: wgf_sheet_direction_t;
extern let WGF_SHEET_DIRECTION_PING_PONG_BACKWARD: wgf_sheet_direction_t;

/// Adds a clip named `name`, replacing any clip of that name.
///
/// - `frames` lists the sheet's frames by index, `count` of them.
/// - Each frame shows for `seconds`. With 0, each frame shows for its own duration, as an
///   atlas gives it.
/// - The clip runs in `direction`.
///
/// A sheet has at most 64 clips. add_clip returns false for:
/// - a `name` that is empty or over 63 bytes;
/// - no frames;
/// - `seconds` below 0, or not finite;
/// - a `direction` that isn't a direction;
/// - a new name when the sheet already has 64 clips.
///
/// The other calls return how many clips the sheet has, one clip's name ("" for none), and the
/// index of the clip named `name` (-1 for none).
extern fn wgf_sheet_add_clip(
    sheet: wgf_sheet_t,
    name: const char*,
    frames: const i32*,
    count: i32,
    seconds: f32,
    direction: wgf_sheet_direction_t
) -> bool;

extern fn wgf_sheet_get_clip_count(sheet: wgf_sheet_t) -> i32;

extern fn wgf_sheet_get_clip_name(sheet: wgf_sheet_t, index: i32) -> const char*;

extern fn wgf_sheet_find_clip(sheet: wgf_sheet_t, name: const char*) -> i32;

/// Sets or gets an event on a clip's frame: a footstep's sound, or an attack's hit frame.
///
/// `event` (above 0) is raised each time the clip comes to its `place`th frame. Places count
/// from 0, the first frame, by place in the clip as it was added. An `event` of 0 removes the
/// event. The sprite playing the clip reads the events (wgf_sprite_take_clip_events).
///
/// The setter returns false for a clip the sheet doesn't have, a `place` outside the clip, or
/// an `event` below 0.
extern fn wgf_sheet_set_clip_event(sheet: wgf_sheet_t, clip: const char*, place: i32, event: i32) -> bool;

extern fn wgf_sheet_get_clip_event(sheet: wgf_sheet_t, clip: const char*, place: i32) -> i32;

// ---- wgf_sprite.h ----

/// Creates a sprite showing `texture`. With 0 for no texture, it draws nothing.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_sprite_create(texture: wgf_texture_t) -> wgf_actor_t;

/// Sets or gets the sprite's texture (0 is none). The setter returns false for a handle that
/// isn't a sprite, or a `texture` that isn't a texture.
extern fn wgf_sprite_set_texture(sprite: wgf_actor_t, texture: wgf_texture_t) -> bool;

extern fn wgf_sprite_get_texture(sprite: wgf_actor_t) -> wgf_texture_t;

/// Sets or gets the region of the texture the sprite shows, in texture pixels from the
/// top-left. A width or height of 0 or less shows the whole texture (default). The getter
/// returns x, y, width, and height. The setter returns false for a handle that isn't a
/// sprite.
extern fn wgf_sprite_set_source(sprite: wgf_actor_t, x: f32, y: f32, width: f32, height: f32) -> bool;

extern fn wgf_sprite_get_source(sprite: wgf_actor_t) -> wgf_vec4_t;

/// Sets or gets the sprite's size, in its own units.
///
/// A width or height of 0 or less (the default) means no size is set. The sprite then draws
/// at its region's size in pixels on a 2D stage, and at 1 by 1 on a 3D stage.
///
/// get_size returns the size set, or else the region's size in pixels, on either stage. It
/// returns 0, 0 while the texture isn't READY and no size is set. The setter returns false
/// for a handle that isn't a sprite.
extern fn wgf_sprite_set_size(sprite: wgf_actor_t, width: f32, height: f32) -> bool;

extern fn wgf_sprite_get_size(sprite: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the sprite's pivot: the point placed at its actor's position, which the
/// sprite turns and scales about. It is a fraction of the sprite's size.
///
/// - 0.5, 0.5 is its center (default).
/// - 0, 0 is its top-left.
///
/// The setter returns false for a handle that isn't a sprite.
extern fn wgf_sprite_set_pivot(sprite: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_sprite_get_pivot(sprite: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the sprite's nine-slice borders, in texels in from the region's edges. A
/// nine-slice draws a panel or a health bar's frame at any size from one small image.
///
/// - The corners, inside `left`, `top`, `right`, and `bottom`, keep their size, one texel a
///   unit. If the sprite is smaller than its borders, they are scaled down together.
/// - The edges stretch along their length.
/// - The middle stretches both ways.
///
/// All 0 means no nine-slice (default), and a border below 0 counts as 0. A nine-slice draws
/// only on a 2D stage. On a 3D stage the sprite draws whole. The getter returns left, top,
/// right, and bottom. The setter returns false for a handle that isn't a sprite, or for
/// numbers that aren't finite.
extern fn wgf_sprite_set_nine_slice(sprite: wgf_actor_t, left: f32, top: f32, right: f32, bottom: f32) -> bool;

extern fn wgf_sprite_get_nine_slice(sprite: wgf_actor_t) -> wgf_vec4_t;

/// Sets or gets the color the sprite's texels are multiplied by (default: white, which leaves
/// them unchanged). The setter returns false for a handle that isn't a sprite.
extern fn wgf_sprite_set_tint(sprite: wgf_actor_t, tint: wgf_color_t) -> bool;

extern fn wgf_sprite_get_tint(sprite: wgf_actor_t) -> wgf_color_t;

/// Sets or gets how the sprite uses its texels' alpha, one of wgf_material.h's modes (default:
/// BLEND), and the cutoff MASK cuts out below (default: 0.5, clamped to 0..1).
///
/// - OPAQUE draws without blending.
/// - ADD adds its color.
/// - MASK draws blended on a 2D stage, since immediate mode cuts nothing out.
///
/// The setter returns false for a handle that isn't a sprite, or a `mode` that isn't an alpha
/// mode.
extern fn wgf_sprite_set_alpha_mode(sprite: wgf_actor_t, mode: wgf_alpha_mode_t, cutoff: f32) -> bool;

extern fn wgf_sprite_get_alpha_mode(sprite: wgf_actor_t) -> wgf_alpha_mode_t;

extern fn wgf_sprite_get_alpha_cutoff(sprite: wgf_actor_t) -> f32;

/// Sets or gets the material (wgf_material.h) a sprite is drawn with on a 3D stage, as a
/// model's part is. 0 (the default) goes back to the texture times the tint.
///
/// - A PBR material is lit by the stage's lights (the up to 8 reaching it most) and its
///   environment, and shadows fall on it.
/// - An UNLIT material draws its base color.
/// - A custom material (wgf_material_create_custom) draws by its shader, with the same lights.
///
/// How the sprite and the material combine:
/// - The sprite's texture is the material's base color texture. The material's own base color
///   texture isn't used, but a custom shader samples the textures its material was given.
/// - The sprite's tint is the placement's tint.
/// - Every map of the material is read over the sprite's region of the texture. So a normal
///   map laid out like the sprite's sheet lights each frame of it.
/// - The quad is lit from the side it is seen from, so normal maps work on billboards.
/// - The sprite's own alpha mode still says how it draws. ADD draws as BLEND, and MASK uses
///   the sprite's cutoff.
/// - The sprite's facing, size, pivot, and depth offset still say where it draws.
///
/// A sprite with a material casts no shadow, and is drawn whole (no nine-slice). Sprites with
/// the same texture, material, and lights go up as one draw. A 2D stage has no lights, so
/// there the material isn't used and the sprite draws as it would without one.
///
/// The sprite holds a reference to the material. The setter returns false for a handle that
/// isn't a sprite, or a `material` that isn't a material.
extern fn wgf_sprite_set_material(sprite: wgf_actor_t, material: wgf_material_t) -> bool;

extern fn wgf_sprite_get_material(sprite: wgf_actor_t) -> wgf_material_t;

/// Sets or gets the alpha below which a pick passes through the sprite's texels, so a round
/// button or a character is hit only where it shows. This applies to picks on a 2D stage
/// (wgf_stage2d_pick, and the pointer, wgf_pointer.h).
///
/// `threshold` is 0..1. At 0 (the default), the whole quad is hit.
///
/// The texture's texels are read from its file on the CPU the first time a pick tests the
/// sprite, and kept while the texture is. The whole quad is hit until they arrive, and always
/// for a texture made in code, a nine-slice, or the placeholder.
///
/// The setter returns false for a handle that isn't a sprite, or a `threshold` outside 0..1.
extern fn wgf_sprite_set_pick_alpha(sprite: wgf_actor_t, threshold: f32) -> bool;

extern fn wgf_sprite_get_pick_alpha(sprite: wgf_actor_t) -> f32;

/// How a sprite on a 3D stage faces. On a 2D stage, a sprite lies in the stage, turned by its
/// actor.
extern wgf_sprite_facing_t;
extern let WGF_SPRITE_FACING_CAMERA: wgf_sprite_facing_t;
extern let WGF_SPRITE_FACING_CAMERA_FIXED_Y: wgf_sprite_facing_t;
extern let WGF_SPRITE_FACING_Y_UP: wgf_sprite_facing_t;
extern let WGF_SPRITE_FACING_FREE: wgf_sprite_facing_t;

/// Sets or gets how the sprite faces on a 3D stage (default: CAMERA). The setter returns false
/// for a handle that isn't a sprite, or a `facing` that isn't a facing.
extern fn wgf_sprite_set_facing(sprite: wgf_actor_t, facing: wgf_sprite_facing_t) -> bool;

extern fn wgf_sprite_get_facing(sprite: wgf_actor_t) -> wgf_sprite_facing_t;

/// Sets or gets how far the sprite is drawn nearer the camera on a 3D stage, along its line of
/// sight, in stage units (default: 0, where it is).
///
/// The sprite stays in the same place on the screen, but wins the depth test over whatever
/// shares its place: a bar's fill over its back, or a label over its sprite. A negative
/// `offset` draws it farther away.
///
/// For example, a health bar over a head, facing the camera, is two tinted sprites of one
/// white texture (wgf_texture_create_from_image of wgf_image_create_color):
/// - its back;
/// - its fill, pivoted at its left edge (wgf_sprite_set_pivot(fill, 0, 0.5)) and placed at the
///   back's left, its width the share left, with an offset of 0.01.
///
/// The setter returns false for a handle that isn't a sprite, or an `offset` that isn't
/// finite.
extern fn wgf_sprite_set_depth_offset(sprite: wgf_actor_t, offset: f32) -> bool;

extern fn wgf_sprite_get_depth_offset(sprite: wgf_actor_t) -> f32;

/// Plays a sprite sheet's clips (wgf_sheet.h) on a sprite.
///
/// - set_sheet sets the sheet, and makes the sheet's texture the sprite's.
/// - play_clip plays the clip named `name` from its start, looping or once. If that clip is
///   already playing, it goes on.
/// - The clip steps each frame by the frame's time times its speed. The speed defaults to 1,
///   and 0 holds the clip still.
///
/// The clip's state is one of these:
/// - PLAYING.
/// - PAUSED.
/// - COMPLETE, once a clip played once ends. It holds its last frame.
/// - STOPPED.
///
/// The calls return false for a handle that isn't a sprite, a `sheet` that isn't a sheet, or
/// a clip the sheet doesn't have.
extern fn wgf_sprite_set_sheet(sprite: wgf_actor_t, sheet: wgf_sheet_t) -> bool;

extern fn wgf_sprite_get_sheet(sprite: wgf_actor_t) -> wgf_sheet_t;

extern fn wgf_sprite_play_clip(sprite: wgf_actor_t, name: const char*, loop_: bool) -> bool;

extern fn wgf_sprite_pause_clip(sprite: wgf_actor_t) -> bool;

extern fn wgf_sprite_resume_clip(sprite: wgf_actor_t) -> bool;

extern fn wgf_sprite_stop_clip(sprite: wgf_actor_t) -> bool;

extern fn wgf_sprite_get_clip_state(sprite: wgf_actor_t) -> wgf_play_state_t;

/// Returns the name of the clip playing ("" for none), and which of its frames shows (0 is its
/// first, -1 for none).
extern fn wgf_sprite_get_clip(sprite: wgf_actor_t) -> const char*;

extern fn wgf_sprite_get_clip_frame(sprite: wgf_actor_t) -> i32;

extern fn wgf_sprite_set_clip_speed(sprite: wgf_actor_t, speed: f32) -> bool;

extern fn wgf_sprite_get_clip_speed(sprite: wgf_actor_t) -> f32;

/// Takes the events the sprite's clip raised as its frames came (wgf_sheet_set_clip_event).
///
/// The events are written into `out`, oldest first, as many as fit in `count`. Taken events
/// are gone, so a second call doesn't return them again. At most the last 16 are kept.
///
/// Returns how many events it wrote, or 0 for a sprite with no sheet.
extern fn wgf_sprite_take_clip_events(sprite: wgf_actor_t, out: i32*, count: i32) -> i32;

/// Sets or gets a facing for the sprite's clips: a direction a character faces, such as "up"
/// or "left".
///
/// A clip played, or playing, by name plays the sheet's clip named name_facing if it has one,
/// or else the clip named name. For example, "walk" with the facing "left" plays "walk_left".
/// If the facing changes while a clip plays, the clip for the new facing goes on from the same
/// place and time.
///
/// "" or NULL means no facing. The setter returns false for a sprite with no sheet, or a
/// `facing` over 15 bytes.
extern fn wgf_sprite_set_clip_facing(sprite: wgf_actor_t, facing: const char*) -> bool;

extern fn wgf_sprite_get_clip_facing(sprite: wgf_actor_t) -> const char*;

// ---- wgf_sprite_batch.h ----

/// Creates a batch of `texture` with no quads. With 0 for no texture, it draws nothing.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_sprite_batch_create(texture: wgf_texture_t) -> wgf_actor_t;

/// Sets or gets the batch's texture (0 is none). The setter returns false for a handle that
/// isn't a batch, or a `texture` that isn't a texture.
extern fn wgf_sprite_batch_set_texture(batch: wgf_actor_t, texture: wgf_texture_t) -> bool;

extern fn wgf_sprite_batch_get_texture(batch: wgf_actor_t) -> wgf_texture_t;

/// Sets or gets how many quads the batch draws. A larger count makes new quads, set as above.
/// A smaller count drops the quads past it.
///
/// The setter returns false for a handle that isn't a batch, a `count` below 0 or over
/// 16777216, or no memory for it.
extern fn wgf_sprite_batch_set_count(batch: wgf_actor_t, count: i32) -> bool;

extern fn wgf_sprite_batch_get_count(batch: wgf_actor_t) -> i32;

/// Sets or gets the quads' positions, from quad `first` on: where each quad's pivot goes, in
/// the batch's units.
///
/// `positions` holds x and y in turn: `count` floats, for count / 2 quads. Quads past the
/// batch's count are left out. The setter returns how many quads it wrote. It returns 0 for a
/// handle that isn't a batch, a `first` outside the batch, or an odd `count`.
///
/// The getter reads the positions back into `out`, as many as fit in `count` floats. It
/// returns how many floats it filled.
extern fn wgf_sprite_batch_set_positions(batch: wgf_actor_t, first: i32, positions: const f32*, count: i32) -> i32;

extern fn wgf_sprite_batch_get_positions(batch: wgf_actor_t, first: i32, out: f32*, count: i32) -> i32;

/// Sets or gets the quads' sizes, as width and height in turn, in the same way as positions.
///
/// - A width or height of 0 uses the region's size in texels.
/// - A negative width or height mirrors the quad across that axis, about its pivot: a tile
///   flipped.
extern fn wgf_sprite_batch_set_sizes(batch: wgf_actor_t, first: i32, sizes: const f32*, count: i32) -> i32;

extern fn wgf_sprite_batch_get_sizes(batch: wgf_actor_t, first: i32, out: f32*, count: i32) -> i32;

/// Sets or gets the quads' turns about their pivots, in radians. There is one float a quad
/// (`count` floats, for `count` quads). On a 2D stage they turn clockwise, as an actor's turn
/// does.
extern fn wgf_sprite_batch_set_rotations(batch: wgf_actor_t, first: i32, radians: const f32*, count: i32) -> i32;

extern fn wgf_sprite_batch_get_rotations(batch: wgf_actor_t, first: i32, out: f32*, count: i32) -> i32;

/// Sets or gets the quads' regions of the texture: x, y, width, and height, in texture pixels
/// from the top-left.
///
/// - There are four floats a quad, for count / 4 quads. A `count` that isn't a multiple of 4
///   writes none.
/// - Each value is rounded to a whole pixel and clamped to 0..32767.
/// - A width or height of 0 shows the whole texture.
extern fn wgf_sprite_batch_set_regions(batch: wgf_actor_t, first: i32, regions: const f32*, count: i32) -> i32;

extern fn wgf_sprite_batch_get_regions(batch: wgf_actor_t, first: i32, out: f32*, count: i32) -> i32;

/// Sets or gets the quads' tints, one a quad (`count` quads). Each is a wgf_color_t
/// (0xRRGGBBAA) as an int.
extern fn wgf_sprite_batch_set_tints(batch: wgf_actor_t, first: i32, tints: const i32*, count: i32) -> i32;

extern fn wgf_sprite_batch_get_tints(batch: wgf_actor_t, first: i32, out: i32*, count: i32) -> i32;

/// Sets or gets the pivot of every quad: the point placed at its position, which it turns
/// about. It is a fraction of the quad's size.
///
/// - 0.5, 0.5 is its center (default).
/// - 0, 0 is its top-left.
///
/// The setter returns false for a handle that isn't a batch.
extern fn wgf_sprite_batch_set_pivot(batch: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_sprite_batch_get_pivot(batch: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets how the batch's quads use their texels' alpha, one of wgf_material.h's modes
/// (default: BLEND), and the cutoff MASK cuts out below (default: 0.5, clamped to 0..1).
///
/// - OPAQUE draws without blending.
/// - MASK cuts out below the cutoff and draws the rest opaque.
/// - ADD adds its color.
///
/// The setter returns false for a handle that isn't a batch, or a `mode` that isn't an alpha
/// mode.
extern fn wgf_sprite_batch_set_alpha_mode(batch: wgf_actor_t, mode: wgf_alpha_mode_t, cutoff: f32) -> bool;

extern fn wgf_sprite_batch_get_alpha_mode(batch: wgf_actor_t) -> wgf_alpha_mode_t;

extern fn wgf_sprite_batch_get_alpha_cutoff(batch: wgf_actor_t) -> f32;

// ---- wgf_stage2d.h ----

/// Creates a 2D stage, with no camera.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_stage2d_create() -> wgf_actor_t;

/// Draws the stage into this frame. Outside a frame, it does nothing.
extern fn wgf_stage2d_draw(stage: wgf_actor_t);

/// Sets or gets the stage's camera (wgf_camera2d.h).
///
/// - With a camera, the stage's point at the camera's position is drawn at the frame's center,
///   turned and zoomed as the camera is. Use it for a 2D world.
/// - Without one (0, the default), stage units are the frame's logical pixels. Use it for a HUD.
///
/// The camera can be anywhere: on this stage, parented to the player so it follows, or in no
/// tree at all. A camera that is destroyed leaves the stage with none.
///
/// set_camera returns false if `camera` isn't a 2D camera.
extern fn wgf_stage2d_set_camera(stage: wgf_actor_t, camera: wgf_actor_t) -> bool;

extern fn wgf_stage2d_get_camera(stage: wgf_actor_t) -> wgf_actor_t;

/// Converts between the stage's units and the screen's logical pixels, through its camera as it
/// is now.
///
/// Logical pixels are what the pointer reads (wgf_mouse.h).
///
/// - world_to_screen returns where a point of the stage shows on the screen.
/// - screen_to_world returns the stage's point under a place on the screen, as for a click in
///   the world.
///
/// Each returns 0, 0 if `stage` isn't a 2D stage.
extern fn wgf_stage2d_world_to_screen(stage: wgf_actor_t, x: f32, y: f32) -> wgf_vec2_t;

extern fn wgf_stage2d_screen_to_world(stage: wgf_actor_t, x: f32, y: f32) -> wgf_vec2_t;

/// Returns the topmost actor on this stage at the screen's point (x, y).
///
/// The point is in logical pixels, where the pointer is (wgf_mouse.h), seen through the stage's
/// camera as it is now. The topmost actor is the one drawn last.
///
/// What can be hit:
/// - A sprite, by its quad, turned and scaled as it is drawn. Or by its texels' alpha, if set
///   (see wgf_sprite_set_pick_alpha).
/// - A 2D shape, by its area: a rectangle (with its corners rounded), circle, or polygon,
///   filled or outlined. A line isn't hit.
/// - A text, by its block.
///
/// An actor that isn't enabled isn't hit, and neither is any actor under it. An actor that
/// isn't visible, or isn't pickable (wgf_actor_set_pickable), lets the point through. Its
/// children can still be hit.
///
/// Where it hit goes into `hit`, your array, as many values as fit in `hit_count`. Pass NULL
/// and 0 for none.
/// - 0, 1: the point, in the stage's units.
/// - 2, 3: the point, in the hit actor's own units. Its origin is at the actor's position, so a
///   sprite's top-left corner is at minus its pivot times its size.
///
/// All values are 0 after a miss.
///
/// Returns the actor hit. Returns 0 if nothing is hit, or if `stage` isn't a 2D stage. It works
/// outside a frame, with the stage as it is placed now.
extern fn wgf_stage2d_pick(stage: wgf_actor_t, x: f32, y: f32, hit: f32*, hit_count: i32) -> wgf_actor_t;

/// Returns the actor on this stage named `name` (wgf_actor_set_name), at any depth.
///
/// It looks the name up in an index, rather than walking the tree.
///
/// Returns 0 if:
/// - No actor has that name.
/// - `stage` isn't a 2D stage.
/// - Two of its actors share the name (warned). Find it by its path from an actor above it
///   instead (see wgf_actor_find).
extern fn wgf_stage2d_find(stage: wgf_actor_t, name: const char*) -> wgf_actor_t;

// ---- wgf_stage3d.h ----

/// How a stage's lit colors map to the screen.
///
/// Lighting can exceed what a screen shows. Tone mapping rolls off highlights instead of
/// clipping them.
extern wgf_stage3d_tonemap_t;
extern let WGF_STAGE3D_TONEMAP_NONE: wgf_stage3d_tonemap_t;
extern let WGF_STAGE3D_TONEMAP_NEUTRAL: wgf_stage3d_tonemap_t;
extern let WGF_STAGE3D_TONEMAP_ACES: wgf_stage3d_tonemap_t;

/// Creates a 3D stage, with no camera, no ambient light, and NEUTRAL tone mapping at an
/// exposure of 0.
///
/// Returns 0 if there is no room for another actor.
extern fn wgf_stage3d_create() -> wgf_actor_t;

/// Draws the stage into this frame, through its camera.
///
/// It draws, in order:
/// - Its opaque models.
/// - Its 3D shapes (wgf_shape3d.h).
/// - Its see-through models, back to front. A model is see-through if it has a BLEND material,
///   or a tint with alpha below 255.
///
/// All are depth tested against each other, and against the frame's 3D drawn before them. Each
/// model is lit by the up to 8 lights that reach it most.
///
/// Outside a frame, or with no camera, it does nothing.
extern fn wgf_stage3d_draw(stage: wgf_actor_t);

/// Draws the stage as wgf_stage3d_draw does, but through `camera` in place of its own.
///
/// The stage's own camera is left as it is. Use it for a second view of the same stage, such as
/// a mirror or a minimap drawn into a render target (wgf_render_begin_target).
///
/// The frame's shadows are fit around one view: the first drawn on the screen, or else the
/// first drawn. The stage's other views are shaded with those shadows where they reach.
///
/// Does nothing if `camera` isn't a 3D camera, or outside a frame.
extern fn wgf_stage3d_draw_with(stage: wgf_actor_t, camera: wgf_actor_t);

/// Sets or gets the camera the stage is seen through (default: 0, none, so nothing is drawn).
///
/// It can be a 3D camera anywhere, on this stage or not. A camera that is destroyed leaves the
/// stage with none.
///
/// set_camera returns false if `camera` isn't a 3D camera.
extern fn wgf_stage3d_set_camera(stage: wgf_actor_t, camera: wgf_actor_t) -> bool;

extern fn wgf_stage3d_get_camera(stage: wgf_actor_t) -> wgf_actor_t;

/// Returns the actor on this stage named `name`, as wgf_stage2d_find does.
///
/// It looks the name up in an index, never by walking the tree.
///
/// Returns 0 if no actor has that name, if `stage` isn't a 3D stage, or if the name is shared
/// (warned).
extern fn wgf_stage3d_find(stage: wgf_actor_t, name: const char*) -> wgf_actor_t;

/// Returns the nearest actor on this stage that a ray meets.
///
/// - pick casts the ray from the screen's point (x, y), in logical pixels (where the pointer
///   is, wgf_mouse.h), through the stage's camera. It makes the ray as
///   wgf_camera3d_screen_to_origin and wgf_camera3d_screen_to_direction do.
/// - pick_ray casts any ray, from its origin along its direction. The direction need not be a
///   unit vector.
///
/// What can be hit:
/// - A model, by its triangles as it is drawn now. Its box is tested first. A skinned model is
///   tested in its pose this frame, with no box test first.
/// - A glTF file's node, which is reported as its file's root (the model wgf_model_create
///   made).
/// - A 3D shape's cube or sphere.
///
/// An actor that isn't enabled isn't hit, and neither is any actor under it. An actor that
/// isn't visible, or isn't pickable (wgf_actor_set_pickable), lets the ray through. Its
/// children can still be hit. A MASK or BLEND part is hit wherever it is drawn at all,
/// including its see-through texels.
///
/// The hit goes into `hit`, your array, as many values as fit in `hit_count`. Pass NULL and 0
/// for none. The layout is wgf_collide3d.h's ray hit:
/// - 0, 1, 2: the surface's normal there, a unit vector facing the ray.
/// - 3: zero.
/// - 4, 5, 6: the point, in the stage's space.
/// - 7: how far along the ray, in lengths of its direction. For a point on the screen, it is in
///   units from the camera's near plane.
///
/// All values are 0 after a miss.
///
/// Returns the actor hit. Returns 0 if:
/// - Nothing is hit.
/// - `stage` isn't a 3D stage.
/// - The stage has no camera (pick only).
/// - The direction is 0, or not finite (pick_ray only).
///
/// It works outside a frame, with the stage as it is placed now.
extern fn wgf_stage3d_pick(stage: wgf_actor_t, x: f32, y: f32, hit: f32*, hit_count: i32) -> wgf_actor_t;

extern fn wgf_stage3d_pick_ray(
    stage: wgf_actor_t,
    ox: f32,
    oy: f32,
    oz: f32,
    dx: f32,
    dy: f32,
    dz: f32,
    hit: f32*,
    hit_count: i32
) -> wgf_actor_t;

/// Sets or gets the ambient light: light that reaches everything evenly, from no direction
/// (default: none, an intensity of 0).
///
/// It is `color` times `intensity`. The intensity is clamped to 0 or more. Alpha is ignored.
extern fn wgf_stage3d_set_ambient(stage: wgf_actor_t, color: wgf_color_t, intensity: f32) -> bool;

extern fn wgf_stage3d_get_ambient_color(stage: wgf_actor_t) -> wgf_color_t;

extern fn wgf_stage3d_get_ambient_intensity(stage: wgf_actor_t) -> f32;

/// Sets or gets the stage's tone mapping, and its exposure in stops (EV) (default: NEUTRAL,
/// 0).
///
/// An exposure of +1 doubles the brightness.
///
/// set_tonemap returns false if `tonemap` isn't a tone mapping.
extern fn wgf_stage3d_set_tonemap(stage: wgf_actor_t, tonemap: wgf_stage3d_tonemap_t, exposure: f32) -> bool;

extern fn wgf_stage3d_get_tonemap(stage: wgf_actor_t) -> wgf_stage3d_tonemap_t;

extern fn wgf_stage3d_get_exposure(stage: wgf_actor_t) -> f32;

/// Sets or gets an environment (wgf_environment.h) that lights the stage's PBR models (default:
/// none).
///
/// It lights them as well as the stage's lights and ambient light. It gives soft light from all
/// around, and reflections that are sharp or blurred by each surface's roughness, darkened by
/// its occlusion.
///
/// - `intensity` scales it. 1 is as the image is. It is clamped to 0 or more.
/// - `rotation` turns it about +y, in radians.
/// - An `environment` of 0 removes it.
///
/// The stage holds a reference of its own. An environment that isn't READY lights nothing
/// until it is.
///
/// set_environment returns false if `environment` isn't an environment.
extern fn wgf_stage3d_set_environment(
    stage: wgf_actor_t,
    environment: wgf_environment_t,
    intensity: f32,
    rotation: f32
) -> bool;

extern fn wgf_stage3d_get_environment(stage: wgf_actor_t) -> wgf_environment_t;

extern fn wgf_stage3d_get_environment_intensity(stage: wgf_actor_t) -> f32;

extern fn wgf_stage3d_get_environment_rotation(stage: wgf_actor_t) -> f32;

/// Sets or gets an environment drawn behind everything the stage draws, as a sky (default:
/// none).
///
/// It is drawn before the stage's models, where nothing drawn before it in the frame's 3D is
/// nearer. It is tone mapped as the stage is.
///
/// - If it is the same environment as the stage's, it uses the stage's environment intensity
///   and rotation. Otherwise it is drawn at intensity 1, unturned.
/// - `blur` runs from 0, sharp, to 1, fully blurred (clamped).
/// - An `environment` of 0 removes it.
///
/// The stage holds a reference of its own. An environment that isn't READY draws nothing until
/// it is.
///
/// set_background returns false if `environment` isn't an environment.
extern fn wgf_stage3d_set_background(stage: wgf_actor_t, environment: wgf_environment_t, blur: f32) -> bool;

extern fn wgf_stage3d_get_background(stage: wgf_actor_t) -> wgf_environment_t;

extern fn wgf_stage3d_get_background_blur(stage: wgf_actor_t) -> f32;

/// Sets or gets whether the stage skips models the camera can't see (default: on).
///
/// Before a model is drawn, the box around it, as it is placed now, is tested against the
/// camera's view. The box is grown a little against rounding. The test is far cheaper than
/// drawing the model.
///
/// Turn it off to draw every model, for example when checking whether a model's bounds are
/// right.
extern fn wgf_stage3d_set_culling(stage: wgf_actor_t, culling: bool) -> bool;

extern fn wgf_stage3d_is_culling(stage: wgf_actor_t) -> bool;

// ---- wgf_text.h ----

/// A text actor: a string drawn in a font.
///
/// - On a 2D stage it is flat on the screen.
/// - On a 3D stage it is a block in the world, facing as it is told (wgf_text_set_facing).
///   It is depth tested, and sorted with the other see-through drawing.
/// - Its actor's position is where its block of lines sits, by its alignment. The actor
///   turns and scales it like any other.
/// - It holds a reference to its font (0: the default font).
///
/// Text is an actor (wgf_actor.h): place, parent, and destroy it with the actor calls.
extern wgf_text_halign_t;
extern let WGF_TEXT_HALIGN_LEFT: wgf_text_halign_t;
extern let WGF_TEXT_HALIGN_CENTER: wgf_text_halign_t;
extern let WGF_TEXT_HALIGN_RIGHT: wgf_text_halign_t;

extern wgf_text_valign_t;
extern let WGF_TEXT_VALIGN_TOP: wgf_text_valign_t;
extern let WGF_TEXT_VALIGN_MIDDLE: wgf_text_valign_t;
extern let WGF_TEXT_VALIGN_BOTTOM: wgf_text_valign_t;

/// Creates a text actor in `font` (0: the default font), with no string yet.
///
/// Returns 0 if `font` isn't a font, or if there is no room for another actor.
extern fn wgf_text_create(font: wgf_font_t) -> wgf_actor_t;

/// Sets or gets the text's font. The setter returns false if `font` isn't a font. 0 is a
/// font: the default font.
extern fn wgf_text_set_font(text: wgf_actor_t, font: wgf_font_t) -> bool;

extern fn wgf_text_get_font(text: wgf_actor_t) -> wgf_font_t;

/// Sets or gets what the text says, in UTF-8. The setter copies the string.
///
/// The string get_string returns belongs to the actor. It is valid until the next
/// set_string, or until the actor is destroyed.
extern fn wgf_text_set_string(text: wgf_actor_t, string_: const char*) -> bool;

extern fn wgf_text_get_string(text: wgf_actor_t) -> const char*;

/// Sets or gets the text's font size: the height of its lines in stage units, before the
/// actor's scale.
///
/// It is called a font size so it isn't taken for a sprite's size. A size of 0 or less (the
/// default) is 16 on a 2D stage, and 1 on a 3D one. The getter returns the size it draws at.
///
/// The setter returns false for a handle that isn't text.
extern fn wgf_text_set_font_size(text: wgf_actor_t, size: f32) -> bool;

extern fn wgf_text_get_font_size(text: wgf_actor_t) -> f32;

/// Sets or gets the text's color (default: white).
extern fn wgf_text_set_color(text: wgf_actor_t, color: wgf_color_t) -> bool;

extern fn wgf_text_get_color(text: wgf_actor_t) -> wgf_color_t;

/// Sets or gets the width the text's lines wrap to, in stage units (default: 0).
///
/// - Lines wrap at spaces and tabs to fit `width`.
/// - A word wider than `width` keeps a line to itself.
/// - 0 wraps nothing.
/// - Newlines always break a line.
/// - For its alignment, a wrapped block is `width` wide, or as wide as its widest line where
///   a word is wider.
///
/// The setter returns false for a `width` below 0.
extern fn wgf_text_set_wrap_width(text: wgf_actor_t, width: f32) -> bool;

extern fn wgf_text_get_wrap_width(text: wgf_actor_t) -> f32;

/// Sets or gets where the block sits relative to the actor's position, on each axis.
///
/// Lines line up the same way inside the block. The setter returns false for a value that
/// isn't an alignment.
extern fn wgf_text_set_align(text: wgf_actor_t, horizontal: wgf_text_halign_t, vertical: wgf_text_valign_t) -> bool;

extern fn wgf_text_get_halign(text: wgf_actor_t) -> wgf_text_halign_t;

extern fn wgf_text_get_valign(text: wgf_actor_t) -> wgf_text_valign_t;

/// Sets or gets the spacing added between the text's letters and between its lines, in
/// logical pixels.
///
/// Both start at 0. Spacing below 0 tightens the text. The setter returns false for numbers
/// that aren't finite.
extern fn wgf_text_set_spacing(text: wgf_actor_t, letter: f32, line: f32) -> bool;

extern fn wgf_text_get_letter_spacing(text: wgf_actor_t) -> f32;

extern fn wgf_text_get_line_spacing(text: wgf_actor_t) -> f32;

/// Sets or gets which way the text's block faces on a 3D stage, as a sprite's does
/// (wgf_sprite.h).
///
/// It faces one of these:
/// - the camera (the default);
/// - the camera, turning about Y only;
/// - up, lying flat;
/// - the way its actor is turned.
///
/// Text on a 2D stage is flat on the screen whatever this says. The setter returns false if
/// `facing` isn't a facing.
extern fn wgf_text_set_facing(text: wgf_actor_t, facing: wgf_sprite_facing_t) -> bool;

extern fn wgf_text_get_facing(text: wgf_actor_t) -> wgf_sprite_facing_t;

/// Sets or gets how far nearer the camera the text is drawn on a 3D stage, in stage units.
///
/// It works as a sprite's does (wgf_sprite_set_depth_offset). Use it for text over the sprite
/// it labels, to keep the text in front at a distance.
///
/// The setter returns false for a handle that isn't text, or an `offset` that isn't finite.
extern fn wgf_text_set_depth_offset(text: wgf_actor_t, offset: f32) -> bool;

extern fn wgf_text_get_depth_offset(text: wgf_actor_t) -> f32;

// ---- wgf_texture.h ----

/// How a texture is sampled where it is drawn.
extern wgf_texture_wrap_t;
extern let WGF_TEXTURE_WRAP_REPEAT: wgf_texture_wrap_t;
extern let WGF_TEXTURE_WRAP_CLAMP: wgf_texture_wrap_t;
extern let WGF_TEXTURE_WRAP_MIRROR: wgf_texture_wrap_t;

extern wgf_texture_filter_t;
extern let WGF_TEXTURE_FILTER_LINEAR: wgf_texture_filter_t;
extern let WGF_TEXTURE_FILTER_NEAREST: wgf_texture_filter_t;
extern let WGF_TEXTURE_FILTER_LINEAR_NO_MIPMAPS: wgf_texture_filter_t;

/// Creates a texture from an image file: PNG, JPEG, BMP, TGA, or GIF (its first frame), or a
/// compressed one.
///
/// "name.ktx" names a texture compressed for GPUs. tools/compress_textures.py writes these
/// beside name.png.
/// - The first of these that this GPU can sample is loaded: name.bc7.ktx (desktops),
///   name.astc.ktx (phones), then name.etc2.ktx (older phones).
/// - It is loaded as it is, with no decoding, in a quarter of the memory.
/// - If the GPU can sample none, or the file is missing or can't be used (warned), name.png
///   is loaded instead.
/// - A texture made before the window opens has no GPU to ask, so it loads name.png.
/// - A variant named outright (name.bc7.ktx) is loaded or FAILED, with no PNG in its place.
///
/// wgf_resource_get_path gives the file it read.
///
/// Returns 0 only if there is no room for another texture. A path or file that can't be
/// loaded gives a texture that FAILED.
extern fn wgf_texture_create(path: const char*) -> wgf_texture_t;

/// Creates a render target: a texture to draw into, `width` by `height` pixels.
///
/// - You draw into it between wgf_render_begin_target and wgf_render_end_target
///   (wgf_render.h).
/// - You then use it as any texture: drawn (wgf_draw_texture), on a sprite, or on a material.
/// - It has the screen's pixel format and samples (wgf_window_get_msaa_samples), and a depth buffer of
///   its own, so whatever draws to the screen draws into it.
/// - It has no mipmaps.
/// - It is made from numbers: READY at once, with no path.
/// - What was drawn into it is gone when the web's GPU context is lost
///   (wgf_render_is_context_lost). It comes back blank.
///
/// Returns 0 for a size of 0 or less or over 16384, or before gfx runs (in init or later)
/// (logged).
extern fn wgf_texture_create_target(width: i32, height: i32) -> wgf_texture_t;

/// Creates a texture in code, `width` by `height` pixels of RGBA, transparent black until
/// written.
///
/// Use it for a minimap, fog of war, or a picture the program works out. It is made from
/// numbers: READY at once, with no path, and no mipmaps.
///
/// Returns 0 for a size of 0 or less or over 16384, or before gfx runs (logged).
extern fn wgf_texture_create_blank(width: i32, height: i32) -> wgf_texture_t;

/// Writes every pixel of a texture made blank, copied from `data`.
///
/// - `data` is RGBA, 8 bits each, rows from the top: width x height x 4 bytes.
/// - The pixels are seen from the next frame drawn.
/// - A texture takes one write a frame, as the GPU takes one. A second write in a frame is
///   refused.
/// - On the web, the last write is also kept, a copy the texture's size. The texture then
///   comes back as it was when the GPU's context does (wgf_render.h).
/// - The frame the context comes back in takes no other write.
/// - While the context is lost, every write is kept and taken.
///
/// Returns false for a texture not made blank, a `size` that isn't the texture's, a NULL
/// `data`, or a second write in a frame.
extern fn wgf_texture_write(texture: wgf_texture_t, data: const u8*, size: i32) -> bool;

/// Returns the texture's size in pixels, or 0 until it is READY.
extern fn wgf_texture_get_width(texture: wgf_texture_t) -> i32;

extern fn wgf_texture_get_height(texture: wgf_texture_t) -> i32;

/// Sets or gets how the texture is sampled where it is drawn (default: clamp, linear).
///
/// Where it is drawn smaller than it is, it samples from its mipmaps, built when it loads.
///
/// The setter returns false for a handle that isn't a texture, or a wrap or filter that
/// isn't one.
extern fn wgf_texture_set_sampling(
    texture: wgf_texture_t,
    wrap_u: wgf_texture_wrap_t,
    wrap_v: wgf_texture_wrap_t,
    filter: wgf_texture_filter_t
) -> bool;

extern fn wgf_texture_get_wrap_u(texture: wgf_texture_t) -> wgf_texture_wrap_t;

extern fn wgf_texture_get_wrap_v(texture: wgf_texture_t) -> wgf_texture_wrap_t;

extern fn wgf_texture_get_filter(texture: wgf_texture_t) -> wgf_texture_filter_t;

extern wgf_texture_read_status_t;
extern let WGF_TEXTURE_READ_STATUS_NONE: wgf_texture_read_status_t;
extern let WGF_TEXTURE_READ_STATUS_PENDING: wgf_texture_read_status_t;
extern let WGF_TEXTURE_READ_STATUS_DONE: wgf_texture_read_status_t;
extern let WGF_TEXTURE_READ_STATUS_FAILED: wgf_texture_read_status_t;

/// Creates a read of `texture`.
///
/// `texture` may be a render target, a texture made in code, or one loaded from a file (its
/// largest level is read). The read holds a reference to the texture until it is read.
///
/// Returns 0 for a handle that isn't a texture, or if there is no room for another read
/// (logged).
extern fn wgf_texture_read(texture: wgf_texture_t) -> wgf_texture_read_t;

/// Returns the read's status: PENDING until the next frame's update, then DONE or FAILED.
///
/// Each read getter returns NONE, 0, or NULL for a handle that isn't a read.
extern fn wgf_texture_read_get_status(read: wgf_texture_read_t) -> wgf_texture_read_status_t;

/// Returns the texture's size as it was read, or 0 until DONE.
extern fn wgf_texture_read_get_width(read: wgf_texture_read_t) -> i32;

extern fn wgf_texture_read_get_height(read: wgf_texture_read_t) -> i32;

/// Returns a DONE read's pixels, and their size in bytes.
///
/// Pixels are RGBA, 8 bits a channel, width * 4 bytes a row, with the top row first, as an
/// image file stores them. They are valid until the read is destroyed.
///
/// Returns NULL and 0 for any read that isn't DONE.
extern fn wgf_texture_read_get_data(read: wgf_texture_read_t) -> const u8*;

extern fn wgf_texture_read_get_size(read: wgf_texture_read_t) -> i32;

/// Saves a DONE read's pixels as a PNG file at `path`.
///
/// With wgf_render_read_screen, this takes a screenshot.
///
/// - The path works as for wgf_fs_write: under the root, with its directories made. On the
///   web, the file is kept in the browser's store.
/// - The pixels are encoded on the calling thread. That takes a few hundredths of a second
///   for a 1280 x 720 frame.
///
/// Returns the write's task. Returns 0 for a read that isn't DONE, a NULL or refused `path`,
/// or if there is no memory to encode it.
extern fn wgf_texture_read_save(read: wgf_texture_read_t, path: const char*) -> wgf_fs_task_t;

/// Destroys a read. A read still PENDING is dropped, unread.
///
/// Returns false for a handle that isn't a read.
extern fn wgf_texture_read_destroy(read: wgf_texture_read_t) -> bool;

// ---- wgf_tilemap.h ----

/// What a layer holds.
extern wgf_tilemap_layer_kind_t;
extern let WGF_TILEMAP_LAYER_KIND_NONE: wgf_tilemap_layer_kind_t;
extern let WGF_TILEMAP_LAYER_KIND_TILES: wgf_tilemap_layer_kind_t;
extern let WGF_TILEMAP_LAYER_KIND_OBJECTS: wgf_tilemap_layer_kind_t;
extern let WGF_TILEMAP_LAYER_KIND_IMAGE: wgf_tilemap_layer_kind_t;

/// How a map's cells are laid out: Tiled's orientations.
extern wgf_tilemap_orientation_t;
extern let WGF_TILEMAP_ORIENTATION_NONE: wgf_tilemap_orientation_t;
extern let WGF_TILEMAP_ORIENTATION_ORTHOGONAL: wgf_tilemap_orientation_t;
extern let WGF_TILEMAP_ORIENTATION_ISOMETRIC: wgf_tilemap_orientation_t;
extern let WGF_TILEMAP_ORIENTATION_STAGGERED: wgf_tilemap_orientation_t;
extern let WGF_TILEMAP_ORIENTATION_HEXAGONAL: wgf_tilemap_orientation_t;

/// How a terrain (Wang) set's tiles meet: at their corners, their edges, or both.
extern wgf_tilemap_terrain_kind_t;
extern let WGF_TILEMAP_TERRAIN_KIND_NONE: wgf_tilemap_terrain_kind_t;
extern let WGF_TILEMAP_TERRAIN_KIND_CORNER: wgf_tilemap_terrain_kind_t;
extern let WGF_TILEMAP_TERRAIN_KIND_EDGE: wgf_tilemap_terrain_kind_t;
extern let WGF_TILEMAP_TERRAIN_KIND_MIXED: wgf_tilemap_terrain_kind_t;

/// An object's shape.
extern wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_NONE: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_RECTANGLE: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_POINT: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_ELLIPSE: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_POLYGON: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_POLYLINE: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_TILE: wgf_tilemap_shape_t;
extern let WGF_TILEMAP_SHAPE_TEXT: wgf_tilemap_shape_t;

/// A tile's flips, as bits.
///
/// Tiled applies them in this order: across the diagonal first, then left for right, then top
/// for bottom. With the others, the diagonal flip turns a tile by a quarter.
extern wgf_tilemap_flip_t;
extern let WGF_TILEMAP_FLIP_NONE: wgf_tilemap_flip_t;
extern let WGF_TILEMAP_FLIP_X: wgf_tilemap_flip_t;
extern let WGF_TILEMAP_FLIP_Y: wgf_tilemap_flip_t;
extern let WGF_TILEMAP_FLIP_DIAGONAL: wgf_tilemap_flip_t;

/// A custom property's type, as Tiled has it.
extern wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_NONE: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_STRING: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_INT: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_FLOAT: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_BOOL: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_COLOR: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_FILE: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_OBJECT: wgf_tilemap_property_type_t;
extern let WGF_TILEMAP_PROPERTY_TYPE_CLASS: wgf_tilemap_property_type_t;

/// Creates the map at `path`, a `.tmj` file, with its tilesets' images.
///
/// It loads as a resource does: it is PENDING at once, and READY or FAILED in a later update.
/// The same path again returns the same map, with one more reference. Returns 0 only if there
/// is no room for another map.
extern fn wgf_tilemap_create(path: const char*) -> wgf_tilemap_t;

/// Returns the map's size in tiles, and a tile's size in pixels.
extern fn wgf_tilemap_get_columns(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_rows(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_tile_width(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_tile_height(map: wgf_tilemap_t) -> i32;

/// Returns the map's background color, as Tiled sets it, or 0 if it has none.
extern fn wgf_tilemap_get_background_color(map: wgf_tilemap_t) -> wgf_color_t;

/// Returns how the map's cells are laid out, and whether it is infinite. Returns NONE and false
/// for a map that isn't READY.
extern fn wgf_tilemap_get_orientation(map: wgf_tilemap_t) -> wgf_tilemap_orientation_t;

extern fn wgf_tilemap_is_infinite(map: wgf_tilemap_t) -> bool;

/// Returns Tiled's column and row of the map's cell 0, 0. For an infinite map, that is its
/// chunks' top-left. For a finite map, it is 0.
extern fn wgf_tilemap_get_origin_column(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_origin_row(map: wgf_tilemap_t) -> i32;

/// Returns the size of the box the map's cells cover, in the map's pixels, as Tiled gives a
/// map's size.
///
/// - For an isometric map, it is the box around its diamond.
/// - For a staggered or hexagonal map, it is figured with the tile size made even.
extern fn wgf_tilemap_get_pixel_width(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_pixel_height(map: wgf_tilemap_t) -> i32;

/// Converts between cells and points, in the map's pixels from its top-left, y down, as Tiled
/// finds them.
///
/// - get_cell_middle returns the middle of the shape of cell `column`, `row`: a rectangle, a
///   diamond, or a hexagon. It works outside the map too.
/// - get_column_at and get_row_at return the column and row whose shape holds the point `x`,
///   `y`. They work outside the map too: below 0, or at its columns or rows and past.
///
/// A layer's offset isn't added here. wgf_tilemap_layer.h's calls add it. Returns 0 for a map
/// that isn't READY.
extern fn wgf_tilemap_get_cell_middle(map: wgf_tilemap_t, column: i32, row: i32) -> wgf_vec2_t;

extern fn wgf_tilemap_get_column_at(map: wgf_tilemap_t, x: f32, y: f32) -> i32;

extern fn wgf_tilemap_get_row_at(map: wgf_tilemap_t, x: f32, y: f32) -> i32;

/// Returns the map's layers, with groups flattened, in drawing order.
///
/// - get_layer_count returns how many layers there are.
/// - get_layer_name and get_layer_kind return one layer's name and kind. The kind is NONE past
///   the end.
/// - find_layer returns the first layer named `name`, or -1 for none.
extern fn wgf_tilemap_get_layer_count(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_layer_name(map: wgf_tilemap_t, layer: i32) -> const char*;

extern fn wgf_tilemap_get_layer_kind(map: wgf_tilemap_t, layer: i32) -> wgf_tilemap_layer_kind_t;

extern fn wgf_tilemap_find_layer(map: wgf_tilemap_t, name: const char*) -> i32;

/// Returns an image layer's image: a texture sampled nearest, whose reference is the map's.
/// Returns 0 for a layer of another kind, or one with no image.
extern fn wgf_tilemap_get_layer_texture(map: wgf_tilemap_t, layer: i32) -> wgf_texture_t;

/// Returns the map's tilesets, in order of first gid: how many there are, and one tileset's
/// name, first gid, tile count, and image. Past the end, each returns 0, and the name "".
extern fn wgf_tilemap_get_tileset_count(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_tileset_name(map: wgf_tilemap_t, tileset: i32) -> const char*;

extern fn wgf_tilemap_get_tileset_first_gid(map: wgf_tilemap_t, tileset: i32) -> i32;

extern fn wgf_tilemap_get_tileset_tile_count(map: wgf_tilemap_t, tileset: i32) -> i32;

extern fn wgf_tilemap_get_tileset_texture(map: wgf_tilemap_t, tileset: i32) -> wgf_texture_t;

/// Returns an object layer's objects, in Tiled's order.
///
/// - get_object_count returns how many there are, or 0 for a layer of another kind.
/// - get_object_id returns the object's id in the map.
/// - get_object_name returns its name.
/// - get_object_class returns its class: Tiled's Class, or Type before 1.9.
/// - get_object_shape returns its shape.
/// - get_object_position returns its place, in the map's pixels from the map's top-left, y
///   down. That is a tile object's bottom-left corner, a point's point, and any other shape's
///   top-left. Its layer's offset isn't added.
/// - get_object_size returns its size, or 0 for a point, a polygon, or a polyline.
/// - get_object_rotation returns its turn about its place, in radians, clockwise as Tiled's.
/// - is_object_visible returns whether Tiled shows it.
/// - get_object_tile returns a tile object's gid, or 0 for another shape.
///
/// Each returns "", 0, or none for an object or layer that isn't one.
extern fn wgf_tilemap_get_object_count(map: wgf_tilemap_t, layer: i32) -> i32;

extern fn wgf_tilemap_get_object_id(map: wgf_tilemap_t, layer: i32, object: i32) -> i32;

extern fn wgf_tilemap_get_object_name(map: wgf_tilemap_t, layer: i32, object: i32) -> const char*;

extern fn wgf_tilemap_get_object_class(map: wgf_tilemap_t, layer: i32, object: i32) -> const char*;

extern fn wgf_tilemap_get_object_shape(map: wgf_tilemap_t, layer: i32, object: i32) -> wgf_tilemap_shape_t;

extern fn wgf_tilemap_get_object_position(map: wgf_tilemap_t, layer: i32, object: i32) -> wgf_vec2_t;

extern fn wgf_tilemap_get_object_size(map: wgf_tilemap_t, layer: i32, object: i32) -> wgf_vec2_t;

extern fn wgf_tilemap_get_object_rotation(map: wgf_tilemap_t, layer: i32, object: i32) -> f32;

extern fn wgf_tilemap_is_object_visible(map: wgf_tilemap_t, layer: i32, object: i32) -> bool;

extern fn wgf_tilemap_get_object_tile(map: wgf_tilemap_t, layer: i32, object: i32) -> i32;

/// Returns a tile object's flips, as wgf_tilemap_flip_t's X and Y bits, or 0 for another shape.
/// Tiled doesn't flip a tile object across its diagonal.
extern fn wgf_tilemap_get_object_tile_flips(map: wgf_tilemap_t, layer: i32, object: i32) -> i32;

/// Returns an object's middle, in the map's pixels. On an isometric map, the object's place is
/// converted to the map's pixels first.
///
/// - A tile object's middle is its tile's, as drawn. Its place is the point of the tile that
///   its tileset's object alignment says. By default that is the bottom-left, or the bottom
///   middle on an isometric map.
/// - A rectangle's, an ellipse's, or a text's middle is half its size across and down from its
///   place, turned with it.
/// - Any other shape's middle is its place.
///
/// Returns 0, 0 for an object that isn't one.
extern fn wgf_tilemap_get_object_middle(map: wgf_tilemap_t, layer: i32, object: i32) -> wgf_vec2_t;

/// Returns a polygon's or a polyline's points, relative to its place and unturned.
///
/// get_object_points writes x and y in turn into `out`, as many as fit in `count` floats. It
/// returns how many floats it filled, or 0 for another shape. get_object_point_count returns
/// how many points the object has.
extern fn wgf_tilemap_get_object_points(map: wgf_tilemap_t, layer: i32, object: i32, out: f32*, count: i32) -> i32;

extern fn wgf_tilemap_get_object_point_count(map: wgf_tilemap_t, layer: i32, object: i32) -> i32;

/// Returns custom properties: the map's own (`layer` -1), a layer's (`object` -1), or an
/// object's in that layer.
///
/// - get_property_count returns how many there are.
/// - get_property_name returns each one's name, in Tiled's order ("" past the end).
/// - get_property_type returns one's type by name (NONE for a property it doesn't have).
/// - get_property returns its value as text: a number written out, or a bool as "true" or
///   "false". It returns "" for a property it doesn't have.
/// - get_property_number returns its value as a number: a bool as 1 or 0. It returns 0 for a
///   property it doesn't have, or for text.
///
/// The text belongs to the map, and is valid while the map is.
extern fn wgf_tilemap_get_property_count(map: wgf_tilemap_t, layer: i32, object: i32) -> i32;

extern fn wgf_tilemap_get_property_name(map: wgf_tilemap_t, layer: i32, object: i32, index: i32) -> const char*;

extern fn wgf_tilemap_get_property_type(
    map: wgf_tilemap_t,
    layer: i32,
    object: i32,
    name: const char*
) -> wgf_tilemap_property_type_t;

extern fn wgf_tilemap_get_property(map: wgf_tilemap_t, layer: i32, object: i32, name: const char*) -> const char*;

extern fn wgf_tilemap_get_property_number(map: wgf_tilemap_t, layer: i32, object: i32, name: const char*) -> f64;

/// Returns a tile's class ("" for none), and its custom properties as above. The tile is named
/// by its gid, apart from its flips.
extern fn wgf_tilemap_get_tile_class(map: wgf_tilemap_t, gid: i32) -> const char*;

extern fn wgf_tilemap_get_tile_property_count(map: wgf_tilemap_t, gid: i32) -> i32;

extern fn wgf_tilemap_get_tile_property_name(map: wgf_tilemap_t, gid: i32, index: i32) -> const char*;

extern fn wgf_tilemap_get_tile_property_type(
    map: wgf_tilemap_t,
    gid: i32,
    name: const char*
) -> wgf_tilemap_property_type_t;

extern fn wgf_tilemap_get_tile_property(map: wgf_tilemap_t, gid: i32, name: const char*) -> const char*;

extern fn wgf_tilemap_get_tile_property_number(map: wgf_tilemap_t, gid: i32, name: const char*) -> f64;

/// Returns the map's terrain (Wang) sets, by tileset and then as Tiled lists them. To paint
/// them into a layer, see wgf_tilemap_layer_paint_terrain.
///
/// Sets:
/// - get_terrainset_count returns how many there are.
/// - get_terrainset_name returns one set's name.
/// - get_terrainset_kind returns its kind (NONE past the end).
/// - get_terrainset_tileset returns its tileset's index (-1 past the end).
/// - find_terrainset returns the first set named `name` (-1 for none).
///
/// A set's terrains are numbered from 1. As in Tiled, 0 is none.
/// - get_terrain_count returns how many a set has.
/// - get_terrain_name returns one terrain's name ("" for 0 or past the end).
/// - find_terrain returns the number of the first terrain named `name` (0 for none).
///
/// get_tile_terrain returns a tile's terrain at `place`. The tile is named by its gid, apart
/// from its flips. Places go in Tiled's order, clockwise from the top:
/// - 0 is its top edge, 1 its top-right corner, 2 its right edge, and so on, to 7, its
///   top-left corner.
/// - An edge set's tiles have terrains at the even places, and a corner set's at the odd.
/// - It returns 0 for a tile the set doesn't hold, or a `place` past 7.
extern fn wgf_tilemap_get_terrainset_count(map: wgf_tilemap_t) -> i32;

extern fn wgf_tilemap_get_terrainset_name(map: wgf_tilemap_t, set: i32) -> const char*;

extern fn wgf_tilemap_get_terrainset_kind(map: wgf_tilemap_t, set: i32) -> wgf_tilemap_terrain_kind_t;

extern fn wgf_tilemap_get_terrainset_tileset(map: wgf_tilemap_t, set: i32) -> i32;

extern fn wgf_tilemap_find_terrainset(map: wgf_tilemap_t, name: const char*) -> i32;

extern fn wgf_tilemap_get_terrain_count(map: wgf_tilemap_t, set: i32) -> i32;

extern fn wgf_tilemap_get_terrain_name(map: wgf_tilemap_t, set: i32, terrain: i32) -> const char*;

extern fn wgf_tilemap_find_terrain(map: wgf_tilemap_t, set: i32, name: const char*) -> i32;

extern fn wgf_tilemap_get_tile_terrain(map: wgf_tilemap_t, set: i32, gid: i32, place: i32) -> i32;

/// Places the map under `parent` (0 for none), and returns its root actor.
///
/// The root is a plain actor named for the map's file: "level" for "maps/level.tmj". It is in
/// the map's pixels from its top-left, y down. Scale it to place the map in other units. Under
/// it is a layer actor (wgf_tilemap_layer.h) for each of the map's layers, in their order. Each
/// layer actor is named for its layer, and shown or hidden and offset as in Tiled.
///
/// The map draws on a 2D stage. Each layer is faded by its opacity.
///
/// A tile layer's cells are drawn as sprite batches' quads (wgf_sprite_batch.h) under it:
/// - Each tile is flipped as the map says. Its bottom-left is on its cell's box's bottom-left.
///   A tile larger than the map's cells reaches up and right, as Tiled draws it.
/// - Animated tiles step each frame. They hold still under a paused actor
///   (wgf_actor_set_paused).
/// - Where no tile can reach past its cell, there is a batch for each tileset the layer uses.
///   That is an orthogonal map whose tiles are its cells' size, unmoved by their tilesets'
///   offsets.
/// - Where a tile can reach past its cell, the cells are drawn in Tiled's order, with a batch
///   for each run of a tileset's tiles along a row of that order. That is a map with larger or
///   moved tiles, and every isometric, staggered, or hexagonal map. A tile later in Tiled's
///   order then draws over one before it, whatever their tilesets.
///
/// An object layer's tile objects are drawn as sprites (wgf_sprite.h) under it:
/// - Each shows its tile, sized as the object, at its middle (wgf_tilemap_get_object_middle).
/// - Each is turned, flipped, and shown as Tiled has it.
/// - They draw in the layer's draw order: by their y (Tiled's default), or as listed.
/// - wgf_tilemap_layer_get_object_actor finds one.
///
/// An image layer's image is drawn as a sprite under it, its top-left on the layer's.
///
/// The layers hold a reference to the map. Returns 0 for a map that isn't READY, a `parent`
/// that isn't an actor (0, for none, is allowed), or no room for the actors.
///
/// When the map is loaded again in place (wgf_asset_reload), its placed copy is built again:
/// - The root is kept.
/// - A layer actor whose layer the new file still has, by name and kind, is kept, with the
///   actors put under it. Of layers with the same name, the first is matched. It shows the new
///   file's layer, so changes from set_cell and paint_terrain are gone.
/// - A layer actor whose layer the file no longer has is destroyed, with the actors under it.
/// - A new layer gets a new layer actor.
/// - Tile objects' sprites are made anew.
extern fn wgf_tilemap_instantiate(map: wgf_tilemap_t, parent: wgf_actor_t) -> wgf_actor_t;

// ---- wgf_tilemap_layer.h ----

/// Returns the map the layer belongs to, and the layer's index in that map.
extern fn wgf_tilemap_layer_get_map(layer: wgf_actor_t) -> wgf_tilemap_t;

extern fn wgf_tilemap_layer_get_index(layer: wgf_actor_t) -> i32;

/// Returns the tile at `column`, `row` (counted from the top-left), and its flips. Returns 0
/// for an empty cell, or a cell outside the layer.
extern fn wgf_tilemap_layer_get_cell(layer: wgf_actor_t, column: i32, row: i32) -> i32;

extern fn wgf_tilemap_layer_get_cell_flips(layer: wgf_actor_t, column: i32, row: i32) -> i32;

/// Sets a cell to tile `gid`, flipped by `flips`. A `gid` of 0 empties the cell.
///
/// The cell draws so from the next frame. An animated tile's animation starts in step with the
/// others. Returns false for a cell outside the layer, a `gid` that none of the map's tilesets
/// holds, or `flips` past the three bits.
extern fn wgf_tilemap_layer_set_cell(layer: wgf_actor_t, column: i32, row: i32, gid: i32, flips: i32) -> bool;

/// Gets every cell, row by row from the top-left, as one int each (see above). This is what a
/// game saves of a layer it changed.
///
/// The cells are written into `out`, as many as fit in `count`. Returns how many it filled.
extern fn wgf_tilemap_layer_get_cells(layer: wgf_actor_t, out: i32*, count: i32) -> i32;

/// Sets every cell at once, in the form get_cells gives them. Returns false, and changes
/// nothing, for a `count` other than the map's columns times its rows, or a cell set_cell
/// refuses.
extern fn wgf_tilemap_layer_set_cells(layer: wgf_actor_t, cells: const i32*, count: i32) -> bool;

/// Returns the column and the row at the point `x`, `y`.
///
/// The point is in the layer's parent's units: the placed map's, which are the map's pixels
/// from its top-left. It goes through the layer's own place, turn, and scale. It works outside
/// the layer too: below 0, or at its columns or rows and past. Returns 0 for an actor that
/// isn't a placed layer.
extern fn wgf_tilemap_layer_get_column_at(layer: wgf_actor_t, x: f32, y: f32) -> i32;

extern fn wgf_tilemap_layer_get_row_at(layer: wgf_actor_t, x: f32, y: f32) -> i32;

/// Returns the middle of cell `column`, `row`, in the layer's parent's units. It works outside
/// the layer too, and is the reverse of get_column_at and get_row_at. Returns 0, 0 for an
/// actor that isn't a placed layer.
extern fn wgf_tilemap_layer_get_cell_middle(layer: wgf_actor_t, column: i32, row: i32) -> wgf_vec2_t;

/// Paints terrain `terrain` of terrain set `set` into cell `column`, `row`, as Tiled's Terrain
/// brush paints it. Sets and terrains are wgf_tilemap.h's. Terrains are numbered from 1, and 0
/// is none.
///
/// - A corner set's cell takes the terrain at its four corners.
/// - An edge set's cell takes it at its four edges.
/// - The cell, and the neighbors sharing those corners or edges, take the set's tile that fits
///   what is around them. That is the first such tile in the set's order. Flips are never
///   chosen.
/// - Where none of the set's tiles fits, a cell is left as it was.
/// - Where no terrain of the set is left, a cell showing a tile of the set's tileset is emptied.
///
/// The terrains around a cell are read from the layer's cells the first time a set is painted.
/// They are kept as painted until a cell is set another way (set_cell or set_cells), and then
/// read again.
///
/// Returns false, and paints nothing, for a cell outside the layer, a set or terrain the map
/// doesn't have, a mixed set, or a staggered or hexagonal map. Returns true once painted,
/// whether every cell found its tile or not. Each cell does when the set has a tile for every
/// arrangement.
extern fn wgf_tilemap_layer_paint_terrain(layer: wgf_actor_t, column: i32, row: i32, set: i32, terrain: i32) -> bool;

/// Returns the sprite (wgf_sprite.h) that draws tile object `object` of an object layer, under
/// the layer (see wgf_tilemap_instantiate).
///
/// Returns 0 for an object that isn't a tile, an `object` past the layer's objects, or a sprite
/// that was destroyed. wgf_scene_spawn_objects destroys a sprite when it spawns a prefab in its
/// place.
extern fn wgf_tilemap_layer_get_object_actor(layer: wgf_actor_t, object: i32) -> wgf_actor_t;

// ---- wgf_audio.h ----

/// Sets or gets the volume of every voice, multiplied into each voice's own.
///
/// - 1 plays the voices as they are.
/// - 0 is silent.
/// - Above 1 is louder, and may clip.
///
/// Returns false for a negative or non-finite volume.
extern fn wgf_audio_set_volume(volume: f32) -> bool;

extern fn wgf_audio_get_volume() -> f32;

/// Sets or gets whether every voice is held where it is, its state unchanged, until unpaused.
///
/// Use it for a game's pause screen. Paused or not, voices are told to play, pause, and stop as
/// usual.
extern fn wgf_audio_set_paused(paused: bool);

extern fn wgf_audio_is_paused() -> bool;

/// Returns whether the browser is holding sound back until the page's first key, click, or
/// touch. While it is, a voice told to play reads PLAYING, is silent, and its position stays.
///
/// Use it to show "click for sound" only while it is true. Returns false outside a browser,
/// and after that first input. Before any sound is made it is what the browser says of the
/// page's input, and true in a browser that doesn't say.
extern fn wgf_audio_is_blocked() -> bool;

/// Sets or gets the listener's position and facing. A spatial voice (wgf_voice_set_spatial) is
/// heard from the listener.
///
/// - The facing has y up, and is normalized when set.
/// - By default the listener is at the origin, facing -z.
/// - A spatial voice is quieter with distance (wgf_voice_set_range), and panned by which side
///   of the listener it is on.
/// - The ecs sets both from an actor (wgf_world_set_listener).
///
/// Returns false for a non-finite value, and for a facing of no length or straight up or
/// down.
extern fn wgf_audio_set_listener_position(x: f32, y: f32, z: f32) -> bool;

extern fn wgf_audio_get_listener_position() -> wgf_vec3_t;

extern fn wgf_audio_set_listener_facing(x: f32, y: f32, z: f32) -> bool;

extern fn wgf_audio_get_listener_facing() -> wgf_vec3_t;

// ---- wgf_bus.h ----

/// Returns one of the three buses that always exist.
extern fn wgf_bus_get_master() -> wgf_bus_t;

extern fn wgf_bus_get_music() -> wgf_bus_t;

extern fn wgf_bus_get_effects() -> wgf_bus_t;

/// Creates a game's own bus under `parent`, at volume 1, unmuted.
///
/// Returns 0 if `parent` isn't a bus, or if there are already 64 buses.
extern fn wgf_bus_create(parent: wgf_bus_t) -> wgf_bus_t;

/// Destroys `bus`. Its voices, and the buses under it, move to its parent.
///
/// Does nothing for the three buses that always exist, or a handle that isn't a bus.
extern fn wgf_bus_destroy(bus: wgf_bus_t);

/// Returns the bus's parent. Returns 0 for the master, and for a handle that isn't a bus.
extern fn wgf_bus_get_parent(bus: wgf_bus_t) -> wgf_bus_t;

/// Sets or gets the bus's volume.
///
/// - 1 plays its voices as they are.
/// - 0 is silent.
/// - Above 1 is louder, and may clip.
///
/// Setting it ends a fade. Returns false for a negative or non-finite volume, and for a handle
/// that isn't a bus.
extern fn wgf_bus_set_volume(bus: wgf_bus_t, volume: f32) -> bool;

extern fn wgf_bus_get_volume(bus: wgf_bus_t) -> f32;

/// Sets or gets whether the bus is muted.
///
/// While muted, its heard volume is 0, and so is everything heard through it or a bus under it.
/// Its volume is kept for unmuting. Returns false only for a handle that isn't a bus.
extern fn wgf_bus_set_muted(bus: wgf_bus_t, muted: bool) -> bool;

extern fn wgf_bus_is_muted(bus: wgf_bus_t) -> bool;

/// Returns the volume the bus is heard at now: its volume times its parents'. It is 0 when the
/// bus or a parent is muted.
///
/// Returns 0 for a handle that isn't a bus.
extern fn wgf_bus_get_heard_volume(bus: wgf_bus_t) -> f32;

/// Fades the bus's volume to `volume` over `seconds` of the runtime's frames.
///
/// - The fade is even in decibels, as an ear hears it. Silence is taken as -60 dB.
/// - 0 seconds or less sets the volume at once.
/// - A new fade, or setting the volume, ends the fade before it.
/// - wgf_bus_is_fading returns whether a fade has not yet ended.
///
/// Returns false for a negative or non-finite volume, non-finite seconds, or a handle that isn't
/// a bus.
extern fn wgf_bus_fade(bus: wgf_bus_t, volume: f32, seconds: f32) -> bool;

extern fn wgf_bus_is_fading(bus: wgf_bus_t) -> bool;

// ---- wgf_sound.h ----

/// Creates the sound at `path`, decoded whole as it loads.
///
/// The sound is PENDING at once, then READY. It is FAILED in a later update for a file that is
/// missing or won't decode. The same path again gives the same sound, with one more reference.
///
/// Returns 0 only if there is no room for another sound.
extern fn wgf_sound_create(path: const char*) -> wgf_sound_t;

/// Creates the sound at `path`, decoded while it plays rather than all at once.
///
/// Natively the file is held and decoded as it plays. On the web an <audio> element plays it.
/// A local file is READY once its length is known. A file still to be fetched plays as it
/// arrives:
///
///   natively  a file the program is downloading (wgf_asset_set_fetching) is READY once
///             its start has arrived and decodes, and plays while the rest comes. A
///             voice that catches up with the download waits where the file runs out,
///             still PLAYING, until more comes. A decoder keeps 128 KB ahead of where it
///             plays while the file arrives, so a file shorter than that starts once
///             whole. The sound is FAILED, and its voices stop, if the download fails, or
///             if the whole file isn't what a manifest lists (wgf_asset_set_manifest). So
///             is a file that reaches 2 GB while it arrives, logged with its size.
///   web       a copy here plays as any load's would: a bundled file, or one in the asset
///             cache that is fresh, trusted, matches its manifest, or is kept by a 304
///             when asked about. Without a copy, the <audio> element fetches the file
///             alone, from its URL, as it plays, trying the redirects in turn while one
///             is missing. It is READY once the browser has its start. What it fetches
///             is never written to the asset cache. To have the file local (offline,
///             checked against the manifest), ensure it first (wgf_asset_ensure), and
///             the next create plays the copy (wgf_asset.h). It needs CORS from another
///             origin, as any fetch does. If the element fails, the sound is FAILED and
///             its voices stop.
///
/// A streamed sound is a sound of its own: the same path made with wgf_sound_create is another
/// sound. Streaming is asked for, never chosen by a file's size, since a streamed sound plays
/// differently: on one voice at a time, with no segments and no negative pitch.
extern fn wgf_sound_create_streamed(path: const char*) -> wgf_sound_t;

/// Creates a decoded sound from `count` samples, for a sound made in code, such as a tone, a
/// sweep, or a noise burst.
///
/// - Samples are in -1 to 1, interleaved left then right when `channels` is 2.
/// - `sample_rate` is in frames a second.
/// - The sound plays as a file's does: its plays, polyphony, segments, and voices are the same.
/// - It is READY at once. The samples are copied, so the caller's can go.
/// - It has no path, so another call makes another sound.
///
/// Returns 0 for any of these:
/// - `samples` is NULL
/// - `count` is below 1, or not a whole number of frames
/// - `channels` is other than 1 or 2
/// - `sample_rate` is outside 8,000 to 192,000 (what every browser's buffers take)
/// - there is no room for another sound
///
/// For samples made as they play, use a pushed voice (wgf_voice_create_pushed).
extern fn wgf_sound_create_from_samples(
    samples: const f32*,
    count: i32,
    channels: i32,
    sample_rate: i32
) -> wgf_sound_t;

/// Adds a named segment of a decoded sound, from `start` to `end` seconds.
///
/// A voice selects a segment by name (wgf_voice_set_segment) and plays it as the whole sound.
/// It plays from the segment's start, loops within it, is COMPLETE at its end, and has its
/// position relative to it (see CONVENTIONS.md, "a named segment"). Many voices may play one
/// segment at once. Segments are for one file holding many effects.
///
/// - Times are given in seconds, and kept as the nearest of the sound's own frames.
/// - The end is clamped to the sound's length.
/// - The same name again changes that segment's range.
///
/// Returns false for any of these:
/// - a name that is NULL, "", or longer than 31 bytes
/// - a negative or non-finite start or end, or a start at or after the end
/// - a streamed sound (it can't seek freely), or a sound that FAILED
/// - a start at or past a READY sound's end
///
/// A segment added before the file arrives, and starting past its end, is dropped once the file
/// arrives. That is logged with the segment's name and the file's path.
///
/// MP3's encoder delay: an MP3 whose encoder wrote its delay plays its segments on time,
/// natively and in Chromium and Firefox (Safari not tested yet). The delay is written in a
/// Xing/Info frame with a LAME extension, as LAME and FFmpeg write. An MP3 without one plays
/// its segments 25 ms late everywhere. That is the encoder's and the decoder's delay, which
/// nothing in the file states. So a file of many effects is best as WAV or Ogg.
extern fn wgf_sound_add_segment(sound: wgf_sound_t, name: const char*, start: f32, end: f32) -> bool;

/// Plays `sound` once and forgets it, on a voice the mixer owns and lets go of when it ends.
///
/// - `volume` is 0 or more.
/// - `pitch` is as a voice's: clamped to -16 to 16, and negative plays from the end.
/// - `pan` is -1 (left) to 1 (right), clamped.
/// - A sound still PENDING plays once it is READY.
/// - The sound's polyphony is how many plays of it sound at once. Past that, its oldest play
///   starts again with these values.
/// - At most 64 plays sound at once, across every sound. Past that, the oldest is let go of.
/// - A game's own voices (wgf_voice.h) count toward neither limit. A loop, or a sound the game
///   must stop, needs one of those.
///
/// Returns false for any of these:
/// - a handle that isn't a decoded sound (a streamed one plays on a voice)
/// - a sound that FAILED
/// - a volume, pitch, or pan that isn't finite
/// - a volume below 0
extern fn wgf_sound_play(sound: wgf_sound_t, volume: f32, pitch: f32, pan: f32) -> bool;

/// Sets how many plays of `sound` (wgf_sound_play) sound at once, 1 to 64 (default: 8).
///
/// A lower count stops none already playing: each play past it takes the oldest. Returns false
/// for a handle that isn't a decoded sound, or a count outside 1 to 64.
extern fn wgf_sound_set_polyphony(sound: wgf_sound_t, count: i32) -> bool;

/// Returns the sound's polyphony. Returns 0 for a handle that isn't a decoded sound.
extern fn wgf_sound_get_polyphony(sound: wgf_sound_t) -> i32;

/// Sets or gets the bus the sound's plays (wgf_sound_play) are heard through (wgf_bus.h).
///
/// It is the effects bus until set, and again once the bus set is destroyed. Returns false for
/// a handle that isn't a decoded sound, or a bus that isn't one.
extern fn wgf_sound_set_bus(sound: wgf_sound_t, bus: wgf_bus_t) -> bool;

extern fn wgf_sound_get_bus(sound: wgf_sound_t) -> wgf_bus_t;

/// Returns the sound's length in seconds.
///
/// Returns 0 until it is READY, and for a handle that isn't a sound.
///
/// A streamed sound READY while its file arrives (wgf_sound_create_streamed) has its length if
/// the file states it at its start. Natively that is a WAV's header, or an MP3's Xing or Info
/// frame. On the web it is whatever the browser makes of the file. Otherwise the length is 0
/// until it is known. Natively that is once the file is whole, counted as a whole file's is.
///
/// The decoders each treat a file's edges their own way. So the same file's length can differ
/// by a few milliseconds between platforms, and between a decoded sound and a streamed one on
/// the web. A 10 ms Ogg reads 10.0 natively, and 8.7 and 12.9 in Chromium.
extern fn wgf_sound_get_duration(sound: wgf_sound_t) -> f32;

// ---- wgf_voice.h ----

/// Creates a voice of `sound`, STOPPED, at volume 1, pitch 1, and pan 0, not looping.
///
/// Pass 0 for no sound yet, and set one later with wgf_voice_set_sound. The voice holds a
/// reference to the sound.
///
/// Returns 0 for a handle that isn't a sound, or if there is no room for another voice.
extern fn wgf_voice_create(sound: wgf_sound_t) -> wgf_voice_t;

/// Destroys `voice` at once, letting go of its sound. Does nothing for a handle that isn't a
/// voice.
extern fn wgf_voice_destroy(voice: wgf_voice_t);

/// Sets the sound the voice plays instead (0 for none), keeping its state (see CONVENTIONS.md,
/// "choosing what to play keeps the state").
///
/// - PLAYING: it plays the new sound from its start (from its end, with a negative pitch).
/// - PAUSED: it waits there.
/// - STOPPED or COMPLETE: it is STOPPED there.
/// - With nothing it can play (0, a sound that FAILED, or a streamed sound another voice
///   holds), it is STOPPED.
/// - Any segment is cleared.
///
/// Returns false for a handle that isn't a voice, a `sound` that isn't a sound, or a pushed
/// voice (see wgf_voice_create_pushed).
extern fn wgf_voice_set_sound(voice: wgf_voice_t, sound: wgf_sound_t) -> bool;

/// Returns the voice's sound. The voice holds the reference, so don't release what this
/// returns: that would let go of the voice's own. Returns 0 for none, and for a handle that
/// isn't a voice.
extern fn wgf_voice_get_sound(voice: wgf_voice_t) -> wgf_sound_t;

/// Plays the voice from the start (the end, with a negative pitch), from any state: PLAYING.
///
/// Returns false for any of these:
/// - a voice with no sound, unless it is a pushed voice
/// - a voice whose sound FAILED
/// - a streamed sound that another voice is playing or holding paused (one voice at a time)
extern fn wgf_voice_play(voice: wgf_voice_t) -> bool;

/// Pauses a PLAYING voice, holding it where it is: PAUSED. Returns false in any other state.
extern fn wgf_voice_pause(voice: wgf_voice_t) -> bool;

/// Resumes a PAUSED voice: PLAYING. Returns false in any other state.
extern fn wgf_voice_resume(voice: wgf_voice_t) -> bool;

/// Stops the voice from any state, rewound to the start: STOPPED. Returns false only for a
/// handle that isn't a voice.
extern fn wgf_voice_stop(voice: wgf_voice_t) -> bool;

/// Returns the voice's state: STOPPED, PLAYING, PAUSED, or COMPLETE. Returns STOPPED for a
/// handle that isn't a voice.
extern fn wgf_voice_get_state(voice: wgf_voice_t) -> wgf_play_state_t;

/// Sets or gets whether the voice loops.
///
/// A looping voice goes on from the start at its end, and is never COMPLETE. With a negative
/// pitch, it goes from the start back to the end. Turning looping on while COMPLETE leaves the
/// voice COMPLETE until the next play. Returns false only for a handle that isn't a voice.
extern fn wgf_voice_set_loop(voice: wgf_voice_t, loop_: bool) -> bool;

extern fn wgf_voice_is_loop(voice: wgf_voice_t) -> bool;

/// Sets or gets the voice's volume.
///
/// - 1 plays the sound as the file is.
/// - 0 is silent.
/// - Above 1 is louder, and may clip.
///
/// Returns false for a negative or non-finite volume.
extern fn wgf_voice_set_volume(voice: wgf_voice_t, volume: f32) -> bool;

extern fn wgf_voice_get_volume(voice: wgf_voice_t) -> f32;

/// Sets or gets the voice's pitch: its speed and tone together, clamped to [-16, 16].
///
/// - 1 plays as recorded.
/// - 2 plays an octave up, at twice the speed.
/// - 0 holds it where it is. It is still PLAYING: that is not a pause.
/// - A negative pitch plays backwards.
///
/// Returns false for a non-finite pitch. Also returns false for a negative pitch on a streamed
/// sound (its decoders run forwards only) or on a pushed voice.
extern fn wgf_voice_set_pitch(voice: wgf_voice_t, pitch: f32) -> bool;

extern fn wgf_voice_get_pitch(voice: wgf_voice_t) -> f32;

/// Sets or gets the voice's pan, its balance, clamped to [-1, 1] (default: 0).
///
/// - -1 plays the left only.
/// - 0 plays both.
/// - 1 plays the right only.
/// - Between, the other side fades.
///
/// Returns false for a non-finite pan.
extern fn wgf_voice_set_pan(voice: wgf_voice_t, pan: f32) -> bool;

extern fn wgf_voice_get_pan(voice: wgf_voice_t) -> f32;

/// Sets or gets the bus the voice is heard through (wgf_bus.h).
///
/// It is the effects bus until set. Once the bus set is destroyed, it is that bus's parent. A
/// play (wgf_sound_play) is on its sound's bus instead. Returns false for a handle that isn't a
/// voice, or a bus that isn't one.
extern fn wgf_voice_set_bus(voice: wgf_voice_t, bus: wgf_bus_t) -> bool;

extern fn wgf_voice_get_bus(voice: wgf_voice_t) -> wgf_bus_t;

/// Sets or gets whether the voice is spatial, and its place and range.
///
/// A spatial voice is heard from its place by the listener (wgf_audio.h), on top of its own
/// volume and pan.
/// - It is at full volume within its range's near distance (default: 1).
/// - It falls off evenly to silent at its far distance (default: 50).
/// - It is panned by which side of the listener it is on.
/// - An actor's voice component that is spatial is placed at its actor each frame.
///
/// The place reads back as x, y, z, and the range as near, far.
///
/// Returns false only for a handle that isn't a voice. Also, set_place returns false for a
/// non-finite place, and set_range for a near below 0 or a far not above the near.
extern fn wgf_voice_set_spatial(voice: wgf_voice_t, spatial: bool) -> bool;

extern fn wgf_voice_is_spatial(voice: wgf_voice_t) -> bool;

extern fn wgf_voice_set_place(voice: wgf_voice_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_voice_get_place(voice: wgf_voice_t) -> wgf_vec3_t;

extern fn wgf_voice_set_range(voice: wgf_voice_t, near_distance: f32, far_distance: f32) -> bool;

extern fn wgf_voice_get_range(voice: wgf_voice_t) -> wgf_vec2_t;

/// Sets or gets where the voice is, in seconds from the sound's start, in any state.
///
/// When it plays a segment, the position is from the segment's start.
/// - On a looping voice, the position wraps into the sound (or the segment).
/// - On a voice that isn't looping, it is clamped to [0, its length].
/// - Set while PLAYING, the voice plays on from there. A non-looping voice set to its end is
///   COMPLETE at the next step.
/// - Set while STOPPED, PAUSED, or COMPLETE, it moves and the state stays.
/// - A streamed sound whose file is still arriving, and doesn't state its length
///   (wgf_sound_get_duration returns 0), bounds the position only below, by 0. Set past what
///   has arrived, the voice waits there for it.
///
/// Setting returns false for a non-finite position, for any position while the sound isn't
/// READY, and for any on a pushed voice. Getting returns 0 for a handle that isn't a voice.
extern fn wgf_voice_set_position(voice: wgf_voice_t, seconds: f32) -> bool;

extern fn wgf_voice_get_position(voice: wgf_voice_t) -> f32;

/// Sets the named segment of the voice's sound (wgf_sound_add_segment) to play as the whole
/// sound. Pass "" for the whole sound again.
///
/// The segment plays from its start (its end, with a negative pitch), loops within it, is
/// COMPLETE at its end, and has its position relative to it (see CONVENTIONS.md, "a named
/// segment").
///
/// The voice's state is kept, as wgf_voice_set_sound keeps it:
/// - PLAYING plays the segment from its start.
/// - PAUSED waits there.
/// - STOPPED or COMPLETE is STOPPED there.
///
/// Returns false for a name the sound has no segment of (a streamed sound has none), NULL, a
/// pushed voice, or a handle that isn't a voice.
extern fn wgf_voice_set_segment(voice: wgf_voice_t, name: const char*) -> bool;

/// Returns the name of the voice's segment. Returns "" for none, and for a handle that isn't a
/// voice. The string is valid while the voice plays that segment of that sound.
extern fn wgf_voice_get_segment(voice: wgf_voice_t) -> const char*;

/// Creates a pushed voice, STOPPED, with its queue empty, at volume 1, pitch 1, and pan 0.
///
/// - `capacity` is the queue's room, in frames. A frame is a sample of each channel.
/// - `channels` is 1 or 2.
/// - `sample_rate` is in frames a second.
///
/// Returns 0 for any of these:
/// - a rate outside 1000 to 384000
/// - channels other than 1 or 2
/// - a capacity outside 1 to 1048576
/// - no room for another voice
extern fn wgf_voice_create_pushed(sample_rate: i32, channels: i32, capacity: i32) -> wgf_voice_t;

/// Queues `count` samples from `samples`, as many frames as there is room for.
///
/// Samples are interleaved, -1 to 1 full scale, and `count` is a whole number of frames.
///
/// Returns how many frames it took. Returns 0 for a voice that isn't a pushed one, or a count
/// below 0 or not a whole number of frames.
extern fn wgf_voice_push(voice: wgf_voice_t, samples: const f32*, count: i32) -> i32;

/// Queues 16-bit samples, as wgf_voice_push does: -32768 to 32767 (clamped), one to an int.
///
/// Returns how many frames it took.
extern fn wgf_voice_push_int16(voice: wgf_voice_t, samples: const i32*, count: i32) -> i32;

/// Returns the frames the queue has room for now (get_room), and the frames queued and not yet
/// played (get_queued). Each returns 0 for a voice that isn't a pushed one.
extern fn wgf_voice_get_room(voice: wgf_voice_t) -> i32;

extern fn wgf_voice_get_queued(voice: wgf_voice_t) -> i32;

/// Returns how many times the queue ran out while the voice played, after having had samples.
/// Each is a gap in the sound.
///
/// Returns 0 for a voice that isn't a pushed one.
extern fn wgf_voice_get_underruns(voice: wgf_voice_t) -> i32;

// ---- wgf_arcade2d.h ----

/// Sets or gets the box's width and height (default: 1 by 1). The setter also returns false
/// for a size below 0, or one that isn't finite.
extern fn wgf_arcade2d_set_size(actor: wgf_actor_t, width: f32, height: f32) -> bool;

extern fn wgf_arcade2d_get_size(actor: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the velocity, in units a second, positive right and down. The setter also
/// returns false for numbers that aren't finite.
extern fn wgf_arcade2d_set_velocity(actor: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_arcade2d_get_velocity(actor: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets gravity: how fast the fall speeds up, in units a second each second. Positive
/// is down, and 0 is none, for a top-down game. The setter also returns false for a number
/// that isn't finite.
extern fn wgf_arcade2d_set_gravity(actor: wgf_actor_t, gravity: f32) -> bool;

extern fn wgf_arcade2d_get_gravity(actor: wgf_actor_t) -> f32;

/// Sets or gets the fastest fall, in units a second. 0 or less means no limit. The setter also
/// returns false for a number that isn't finite.
extern fn wgf_arcade2d_set_max_fall_speed(actor: wgf_actor_t, speed: f32) -> bool;

extern fn wgf_arcade2d_get_max_fall_speed(actor: wgf_actor_t) -> f32;

/// Sets or gets the collider layers that are solid to the arcade body (default: every layer,
/// -1).
extern fn wgf_arcade2d_set_solid_mask(actor: wgf_actor_t, mask: i32) -> bool;

extern fn wgf_arcade2d_get_solid_mask(actor: wgf_actor_t) -> i32;

/// Returns what the arcade body touched at its last tick, moving into it.
///
/// - is_grounded: it is standing on a collider or a solid cell. Gravity presses it down each
///   tick, so it reads grounded while it stands.
/// - is_blocked_left, is_blocked_right: it was stopped on that side.
/// - is_blocked_above: it was stopped on its top (it hit its head).
/// - get_air_time: the seconds since it was last grounded, or 0 while it is grounded.
///
/// A side reads blocked only while the arcade body moves that way. A body walking into a wall
/// each tick, as when a key is held, reads blocked. One stopped there and left still doesn't.
///
/// To allow a jump a moment after walking off a ledge (coyote time), check that the air time
/// is short.
extern fn wgf_arcade2d_is_grounded(actor: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_is_blocked_left(actor: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_is_blocked_right(actor: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_is_blocked_above(actor: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_get_air_time(actor: wgf_actor_t) -> f32;

/// Sets the grid of solid cells that the arcade bodies under `parent` slide against.
///
/// - `cells` holds `count` cells, row by row from the top, `columns` to a row. They are
///   copied. A nonzero cell is solid.
/// - Cell 0's top-left corner is at `x`, `y` in the parent's space. Each cell is a square
///   `size` wide.
/// - Outside the grid is open.
/// - A parent has one grid. Setting it again replaces it.
///
/// Returns false for a parent that isn't an actor, no cells, `columns` of 0 or less, or a
/// `size` that isn't above 0.
///
/// clear_grid removes the grid. get_grid_cell reads a cell, and returns 0 outside the grid or
/// when there is none. set_grid_cell sets one, such as a door opened or a block broken, and
/// returns false outside the grid.
extern fn wgf_arcade2d_set_grid(
    parent: wgf_actor_t,
    cells: const i32*,
    count: i32,
    columns: i32,
    size: f32,
    x: f32,
    y: f32
) -> bool;

/// Sets the grid from a placed Tiled map's tile layer (wgf_tilemap_layer.h).
///
/// - A cell with a tile is solid, and an empty cell is open.
/// - Each cell is the map's tile size.
/// - Cell 0 is where the layer's top-left cell is in the parent's space. That includes the
///   layer's offset, the placement of the map's root, and an infinite map's origin.
/// - A layer scaled or turned under the parent is placed, but the grid isn't scaled or turned.
/// - The grid copies the layer's cells as they are now. A cell set on the layer later must also
///   be set here, with set_grid_cell.
///
/// Also returns false for a layer that isn't a placed tile layer, a map that isn't orthogonal,
/// or a map whose tiles aren't square.
extern fn wgf_arcade2d_set_grid_from_layer(parent: wgf_actor_t, layer: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_clear_grid(parent: wgf_actor_t) -> bool;

extern fn wgf_arcade2d_get_grid_cell(parent: wgf_actor_t, column: i32, row: i32) -> i32;

extern fn wgf_arcade2d_set_grid_cell(parent: wgf_actor_t, column: i32, row: i32, value: i32) -> bool;

// ---- wgf_behavior.h ----

/// Adds a behavior named `name` to `actor`, after the ones it has, and returns its id.
/// Returns 0 if `actor` isn't an actor, the name breaks the limits above, or memory runs
/// out.
extern fn wgf_actor_add_behavior(actor: wgf_actor_t, name: const char*) -> i32;

/// Removes a behavior, raising DESTROYED for it.
extern fn wgf_actor_remove_behavior(actor: wgf_actor_t, behavior: i32) -> bool;

/// Lists the actor's behaviors, in the order they were added.
///
/// - get_behavior_count returns how many there are.
/// - get_behavior returns the id of the one at `index`, or 0 past the end.
/// - find_behavior returns the id of the first one named `name`, or 0 for none.
extern fn wgf_actor_get_behavior_count(actor: wgf_actor_t) -> i32;

extern fn wgf_actor_get_behavior(actor: wgf_actor_t, index: i32) -> i32;

extern fn wgf_actor_find_behavior(actor: wgf_actor_t, name: const char*) -> i32;

/// Returns the behavior's name. The actor owns the string, valid while the behavior is.
extern fn wgf_behavior_get_name(actor: wgf_actor_t, behavior: i32) -> const char*;

/// Sets or gets a parameter, as text.
///
/// - set_param sets `key` to `value`, adding the parameter the first time. A NULL `value`
///   removes it. It also returns false for a key or value that breaks the limits, or a 33rd
///   parameter.
/// - get_param returns the value. The actor owns the string, valid until it changes. It
///   returns "" for a parameter the behavior doesn't have.
/// - get_param_number reads the value as a number. It returns 0 for a parameter the behavior
///   doesn't have, or one that isn't a number.
///
/// A value starting with '@' refers to another actor. The actor is found once, when the value
/// is set, and again when all of a scene's actors are made. It is then kept, so
/// get_param_actor returns it without a search.
/// - "@start_gate" is the one actor with that name on this actor's stage (wgf_stage2d_find).
/// - "@car/wheel_rl" is a path from that actor (wgf_actor_find).
/// - "@./flame" is a path from this actor, and "@../gun" a path from its parent.
///
/// get_param_actor returns 0 for a parameter that isn't a reference, a reference that found no
/// actor, or an actor since destroyed.
extern fn wgf_behavior_set_param(actor: wgf_actor_t, behavior: i32, key: const char*, value: const char*) -> bool;

extern fn wgf_behavior_get_param(actor: wgf_actor_t, behavior: i32, key: const char*) -> const char*;

extern fn wgf_behavior_get_param_number(actor: wgf_actor_t, behavior: i32, key: const char*) -> f64;

extern fn wgf_behavior_get_param_actor(actor: wgf_actor_t, behavior: i32, key: const char*) -> wgf_actor_t;

extern fn wgf_behavior_has_param(actor: wgf_actor_t, behavior: i32, key: const char*) -> bool;

/// Lists the behavior's parameters, in the order they were first set. get_param_count returns
/// how many there are, and get_param_key returns each one's key, or "" past the end.
extern fn wgf_behavior_get_param_count(actor: wgf_actor_t, behavior: i32) -> i32;

extern fn wgf_behavior_get_param_key(actor: wgf_actor_t, behavior: i32, index: i32) -> const char*;

/// Finds the actors with a behavior named `name`, oldest first.
///
/// An actor's age is when its first component or behavior was added. find_with_behavior fills
/// `out` with as many as fit in `count`, and returns how many it filled. count_with_behavior
/// returns how many there are, to size `out`. An actor with two behaviors of that name counts
/// once. Each name is indexed, so neither call looks at every actor.
extern fn wgf_actor_find_with_behavior(name: const char*, out: wgf_actor_t*, count: i32) -> i32;

extern fn wgf_actor_count_with_behavior(name: const char*) -> i32;

// ---- wgf_bounds.h ----

/// Bounds (WGF_COMPONENT_BOUNDS): a rectangle that an actor's position is kept within.
///
/// The rectangle is in the actor's parent's space, at x and y. Each tick, after motion, an
/// actor whose position leaves it by more than its margin is wrapped, clamped, or destroyed,
/// as its mode says.
///
/// The rectangle keeps the actor's position, not its picture. For a ball to bounce as its rim
/// touches the screen's edge, make the rectangle smaller by its radius on each side.
///
/// Defaults: a rectangle at 0, 0, 800 by 600, WRAP, and a margin of 0.
///
/// Every call returns false (or 0) for an actor without bounds.
extern wgf_bounds_mode_t;
extern let WGF_BOUNDS_MODE_WRAP: wgf_bounds_mode_t;
extern let WGF_BOUNDS_MODE_CLAMP: wgf_bounds_mode_t;
extern let WGF_BOUNDS_MODE_DESTROY: wgf_bounds_mode_t;
extern let WGF_BOUNDS_MODE_BOUNCE: wgf_bounds_mode_t;

/// Sets or gets the rectangle. get_rect returns it as x, y, width, height. The setter also
/// returns false for a width or height below 0.
extern fn wgf_bounds_set_rect(actor: wgf_actor_t, x: f32, y: f32, width: f32, height: f32) -> bool;

extern fn wgf_bounds_get_rect(actor: wgf_actor_t) -> wgf_vec4_t;

/// Sets or gets the mode (default: WRAP). The setter also returns false for a mode that isn't
/// one.
extern fn wgf_bounds_set_mode(actor: wgf_actor_t, mode: wgf_bounds_mode_t) -> bool;

extern fn wgf_bounds_get_mode(actor: wgf_actor_t) -> wgf_bounds_mode_t;

/// Sets or gets whether the rectangle is the presentation's visible area (default: off).
///
/// The visible area (wgf_presentation.h) is read each tick. An actor that wraps at the screen's
/// edge then wraps at the window's edge, whatever its size. A scene file sets this with
/// `bounds visible=true`. get_rect returns the rectangle as it is now. Setting a rectangle
/// turns this off.
extern fn wgf_bounds_set_visible(actor: wgf_actor_t, visible: bool) -> bool;

extern fn wgf_bounds_is_visible(actor: wgf_actor_t) -> bool;

/// Sets or gets the margin: how far past the rectangle's edge the actor may go first
/// (default: 0). With a margin, a rock wraps only once it is wholly off the screen. It is
/// clamped to 0 or more.
extern fn wgf_bounds_set_margin(actor: wgf_actor_t, margin: f32) -> bool;

extern fn wgf_bounds_get_margin(actor: wgf_actor_t) -> f32;

// ---- wgf_collider.h ----
extern let WGF_COLLIDER_POLYGON_MAX: i32;

/// A collider (WGF_COMPONENT_COLLIDER): a shape that overlaps other colliders as a trigger.
///
/// The shape is placed about the actor's position, in its parent's space. Each tick, after
/// motion and bounds, colliders are compared (wgf_world.h):
/// - Two colliders that start to overlap raise TRIGGER_ENTER, told to each of them.
/// - Two that stop overlapping raise TRIGGER_EXIT, told to each of them.
///
/// Two colliders overlap only where one's layer meets the other's mask: (a's layer & b's mask)
/// or (b's layer & a's mask).
///
/// A collider pushes nothing apart. You can read how far apart would part a pair (see
/// wgf_collider_get_push), and the arcade body (wgf_arcade2d.h) is stopped by solid colliders.
///
/// Only colliders under the same parent actor are compared. They are found by a sweep of their
/// bounds, which handles a few thousand at once.
///
/// Shapes:
/// - A circle, which is a sphere: its z counts against another circle's. Its radius is scaled
///   by the larger of the actor's scale's x and y.
/// - A rectangle, a convex polygon, or a segment, on a 2D stage's plane (x and y, with z
///   ignored). Each is scaled by the actor's scale and turned by its turn about z.
///
/// Each shape is about the actor's position moved by its offset. The offset is scaled and
/// turned with the shape.
///
/// Defaults:
/// - a circle of radius 1
/// - no offset
/// - layer 1
/// - a mask of every layer (-1)
/// - enabled
///
/// Every call returns false (or 0) for an actor without a collider.
extern wgf_collider_shape_t;
extern let WGF_COLLIDER_SHAPE_CIRCLE: wgf_collider_shape_t;
extern let WGF_COLLIDER_SHAPE_RECTANGLE: wgf_collider_shape_t;
extern let WGF_COLLIDER_SHAPE_POLYGON: wgf_collider_shape_t;
extern let WGF_COLLIDER_SHAPE_SEGMENT: wgf_collider_shape_t;

/// Sets the shape to a circle of `radius`, or gets a circle's radius. The setter also returns
/// false for a radius below 0. get_radius returns 0 for another shape.
extern fn wgf_collider_set_radius(actor: wgf_actor_t, radius: f32) -> bool;

extern fn wgf_collider_get_radius(actor: wgf_actor_t) -> f32;

/// Sets the shape to a centered rectangle, `width` by `height`, or gets a rectangle's size.
/// The setter also returns false for a size below 0. get_size returns 0, 0 for another
/// shape.
extern fn wgf_collider_set_rectangle(actor: wgf_actor_t, width: f32, height: f32) -> bool;

extern fn wgf_collider_get_size(actor: wgf_actor_t) -> wgf_vec2_t;

/// Sets the shape to a convex polygon of `points`, about the actor's position.
///
/// `points` holds x and y in turn: `count` floats, for 3 to WGF_COLLIDER_POLYGON_MAX points.
/// A polygon that isn't convex overlaps as its convex hull would.
///
/// Also returns false for no points, too few or too many, or an odd `count`.
extern fn wgf_collider_set_polygon(actor: wgf_actor_t, points: const f32*, count: i32) -> bool;

/// Sets the shape to a segment from `x0`, `y0` to `x1`, `y1`, about the actor's position, such
/// as a wall or a laser.
extern fn wgf_collider_set_segment(actor: wgf_actor_t, x0: f32, y0: f32, x1: f32, y1: f32) -> bool;

/// Returns the collider's shape, and a polygon's or a segment's points.
///
/// get_points fills `out` with x and y in turn, as many as fit in `count` floats. It returns
/// how many floats it filled, or 0 for a circle or a rectangle.
extern fn wgf_collider_get_shape(actor: wgf_actor_t) -> wgf_collider_shape_t;

extern fn wgf_collider_get_points(actor: wgf_actor_t, out: f32*, count: i32) -> i32;

/// Sets or gets the offset: how far the shape is moved from the actor's position, before the
/// actor's scale and turn (default: no offset).
extern fn wgf_collider_set_offset(actor: wgf_actor_t, x: f32, y: f32) -> bool;

extern fn wgf_collider_get_offset(actor: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the layer and mask, as bits. The layer is what the collider is, and the mask is
/// what it meets (defaults: layer 1, mask -1).
///
/// A pair meets when either side's mask has the other's layer. Clearing one collider's mask
/// doesn't stop another collider, whose mask has its layer, from meeting it. To make a collider
/// meet nothing, switch it off (see wgf_collider_set_enabled).
extern fn wgf_collider_set_layer(actor: wgf_actor_t, layer: i32) -> bool;

extern fn wgf_collider_get_layer(actor: wgf_actor_t) -> i32;

extern fn wgf_collider_set_mask(actor: wgf_actor_t, mask: i32) -> bool;

extern fn wgf_collider_get_mask(actor: wgf_actor_t) -> i32;

/// Switches the collider on or off, or gets whether it is on (default: on).
///
/// A collider switched off meets nothing, from either side. A pair it was in ends, raising
/// TRIGGER_EXIT at the next tick. Its radius, layer, and mask are kept, so when it is switched
/// on again it meets as they say. Use it for a ship that can't be hit while it blinks.
extern fn wgf_collider_set_enabled(actor: wgf_actor_t, enabled: bool) -> bool;

extern fn wgf_collider_is_enabled(actor: wgf_actor_t) -> bool;

/// Fills `out` with the actors whose colliders this one overlaps as of the last tick, as many
/// as fit in `count`. Returns how many it filled.
extern fn wgf_collider_get_overlaps(actor: wgf_actor_t, out: wgf_actor_t*, count: i32) -> i32;

/// Returns the smallest move of `actor` that would part it from `other`, as of the last tick.
///
/// The move is out of the other collider, along the direction they meet, as deep as they
/// overlap. Use it as a push out, for a game that pushes. Returns 0, 0 when they don't
/// overlap.
extern fn wgf_collider_get_push(actor: wgf_actor_t, other: wgf_actor_t) -> wgf_vec2_t;

// ---- wgf_component.h ----

/// Components: the simulation's data on an actor, run each tick by libwgf's systems
/// (wgf_world.h).
///
/// Any actor of any kind can carry components, a 2D stage's UI actors and cameras included.
/// libwgf has one kind of object, the actor (SPEC.md), arranged like Godot's tree and given
/// components like Unity's:
/// - What an actor draws is its kind: a shape, a sprite, a model.
/// - What moves it, bounds it, ages it, and finds what it overlaps are its components.
/// - What your game does with it are its behaviors (wgf_behavior.h), several to an actor.
///
/// An actor with a component or a behavior is simulated (see wgf_actor_snap). Its transform is
/// set and read at the tick rate, and it is drawn between its last two ticks, so it moves
/// smoothly at any frame rate.
///
/// An actor's components are destroyed with it (wgf_actor_destroy). A system that ends an
/// actor, such as a lifetime run out or bounds of DESTROY, destroys it and every actor under
/// it, after the tick's systems have run.
extern wgf_component_t;
extern let WGF_COMPONENT_NONE: wgf_component_t;
extern let WGF_COMPONENT_MOTION: wgf_component_t;
extern let WGF_COMPONENT_BOUNDS: wgf_component_t;
extern let WGF_COMPONENT_LIFETIME: wgf_component_t;
extern let WGF_COMPONENT_COLLIDER: wgf_component_t;
extern let WGF_COMPONENT_VOICE: wgf_component_t;
extern let WGF_COMPONENT_BODY3D: wgf_component_t;
extern let WGF_COMPONENT_VEHICLE: wgf_component_t;
extern let WGF_COMPONENT_ARCADE2D: wgf_component_t;

/// Adds, removes, or checks for a component on an actor.
///
/// - add_component adds one with its defaults, which each component's header lists. Adding a
///   component the actor already has keeps it as it is.
/// - remove_component ends it. A voice is stopped and destroyed.
///
/// Returns false for a handle that isn't an actor, or a component that isn't one.
/// remove_component also returns false for a component the actor doesn't have.
///
/// A body or a vehicle belongs to physics (wgf_physics3d.h), an optional part. Adding one
/// before physics has started is refused (logged once).
extern fn wgf_actor_add_component(actor: wgf_actor_t, component: wgf_component_t) -> bool;

extern fn wgf_actor_remove_component(actor: wgf_actor_t, component: wgf_component_t) -> bool;

extern fn wgf_actor_has_component(actor: wgf_actor_t, component: wgf_component_t) -> bool;

/// Returns the voice component's voice, or 0 for an actor without one.
///
/// The actor owns the voice: play it, but never destroy it. Use it for a sound that lasts as
/// long as the actor, such as a car's engine or a ship's thrust, looping. It stops when the
/// actor is destroyed, with nothing for your game to end. For a sound played once, use
/// wgf_sound_play.
extern fn wgf_actor_get_voice(actor: wgf_actor_t) -> wgf_voice_t;

/// Finds the actors with a component, oldest first.
///
/// An actor's age is when its first component or behavior was added. find_with_component fills
/// `out` with as many as fit in `count`, and returns how many it filled. count_with_component
/// returns how many there are, to size `out`. Each component is indexed, so neither call looks
/// at every actor. NONE, or a value that isn't a component, finds none.
extern fn wgf_actor_find_with_component(component: wgf_component_t, out: wgf_actor_t*, count: i32) -> i32;

extern fn wgf_actor_count_with_component(component: wgf_component_t) -> i32;

// ---- wgf_lifetime.h ----

/// Sets the seconds left, from now. Returns false for an actor without a lifetime, or a time
/// below 0 or not finite.
extern fn wgf_lifetime_set_seconds(actor: wgf_actor_t, seconds: f32) -> bool;

/// Returns the seconds left, or 0 for an actor without a lifetime.
extern fn wgf_lifetime_get_seconds(actor: wgf_actor_t) -> f32;

// ---- wgf_motion.h ----

/// Sets or gets the velocity, in units a second, in the actor's parent's space.
extern fn wgf_motion_set_velocity(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_motion_get_velocity(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets the spin, in radians a second about each axis (in 2D, about z alone).
///
/// Each tick the actor turns by the tick's share, about its parent's axes. A spin about one
/// axis turns it steadily, past any half turn.
extern fn wgf_motion_set_spin(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_motion_get_spin(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets the damping: the part of its velocity the actor loses each second
/// (default: 0). 0 loses none and 1 loses all of it. It is clamped to 0 to 1.
extern fn wgf_motion_set_damping(actor: wgf_actor_t, damping: f32) -> bool;

extern fn wgf_motion_get_damping(actor: wgf_actor_t) -> f32;

/// Sets or gets the top speed, in units a second (default: 0, no limit). 0 means no limit.
/// It is clamped to 0 or more.
extern fn wgf_motion_set_max_speed(actor: wgf_actor_t, speed: f32) -> bool;

extern fn wgf_motion_get_max_speed(actor: wgf_actor_t) -> f32;

// ---- wgf_scene.h ----

/// Enables loading scenes again in place, or says whether it is enabled.
///
/// - It enables reload for every other kind too (wgf_asset_enable_reload), which scene reload
///   needs: a program that reloads only its other assets calls that alone.
/// - The wgf tool's own builds call it; a game's export doesn't, and carries none of scene
///   reload's code where the linker drops what nothing calls (the web).
/// - Call it before the scenes' actors are made: what a scene makes is kept from then on.
/// - Without it, a scene's file saved isn't loaded again in place: under `wgf serve --hot`
///   the page loads again.
///
/// Returns true.
extern fn wgf_scene_enable_reload() -> bool;

extern fn wgf_scene_is_reload_enabled() -> bool;

/// Creates the scene at `path`, and starts loading it. The same path again returns the same
/// scene, with one more reference. Returns 0 only when there is no room for another scene.
extern fn wgf_scene_create(path: const char*) -> wgf_scene_t;

/// Makes the scene's top actors' trees, in file order, under `parent` (0 for none).
///
/// Each actor is made as the file says, and each behavior's CREATED is raised. Returns the
/// number of top actors made. Returns 0 for a scene that isn't READY, or a `parent` that isn't
/// an actor (0 is allowed).
extern fn wgf_scene_instantiate(scene: wgf_scene_t, parent: wgf_actor_t) -> i32;

/// Returns the prefab `name` of a READY scene, to spawn. It returns the same handle each time
/// you ask.
///
/// Returns 0 for a scene that isn't READY, or a prefab it doesn't have. A released scene's
/// prefabs are released with it, and their handles go stale.
extern fn wgf_scene_find_prefab(scene: wgf_scene_t, name: const char*) -> wgf_prefab_t;

/// Returns what the file holds, once the scene is READY.
///
/// - get_actor_count returns the number of top actors in the file: those with no parent
///   there, whatever they are. It is not how many actors are simulated now
///   (wgf_actor_get_count).
/// - get_prefab_count returns the number of prefabs.
/// - get_prefab_name returns each prefab's name in file order, or "" past the end.
///
/// They return 0 and "" until the scene is READY.
extern fn wgf_scene_get_actor_count(scene: wgf_scene_t) -> i32;

extern fn wgf_scene_get_prefab_count(scene: wgf_scene_t) -> i32;

extern fn wgf_scene_get_prefab_name(scene: wgf_scene_t, index: i32) -> const char*;

extern fn wgf_scene_has_prefab(scene: wgf_scene_t, name: const char*) -> bool;

/// Makes one tree of the prefab under `parent` (0 for none), and returns its top actor.
///
/// Each actor is made as the file says, each behavior's CREATED is raised, and the tree's
/// references are found. Returns 0 for a prefab that isn't one (or whose scene is gone), or a
/// `parent` that isn't an actor.
extern fn wgf_prefab_spawn(prefab: wgf_prefab_t, parent: wgf_actor_t) -> wgf_actor_t;

/// Makes one tree of the prefab, as wgf_prefab_spawn does, with its top actor placed and turned.
///
/// - The top actor is placed at `x`, `y`, `z` in `parent`'s space.
/// - It is turned `angle` radians about its stage's up axis: y on a 3D stage, z otherwise.
/// - Its other angles and its scale are the prefab's.
///
/// The actor is then snapped, so it is drawn there from its first frame. Whatever it bursts as
/// it is made (an emitter's `burst=`) starts there too.
extern fn wgf_prefab_spawn_at(
    prefab: wgf_prefab_t,
    parent: wgf_actor_t,
    x: f32,
    y: f32,
    z: f32,
    angle: f32
) -> wgf_actor_t;

/// Makes actors from a placed Tiled map's object layer (wgf_tilemap_layer.h).
///
/// For each object whose class (wgf_tilemap_get_object_class) names one of the scene's
/// prefabs, that prefab is spawned under the layer (see wgf_prefab_spawn_at):
/// - It is placed at the object's middle (wgf_tilemap_get_object_middle). That is a point
///   object's point, a polygon's or polyline's place, or a tile object's tile as drawn.
/// - It takes the place of a tile object's sprite, which is destroyed.
/// - It is turned as the object is.
/// - It is named for the object, when the object has a name.
/// - It is hidden when Tiled hides the object.
/// - Each of the object's custom properties is set, as text, as a parameter of each behavior
///   on its top actor (wgf_tilemap_get_property). A value starting with '@' is a reference
///   (wgf_behavior.h). This happens before the binding takes their CREATED.
///
/// Objects with no class, or a class the scene has no prefab of, are left for your game to
/// read.
///
/// Returns the number spawned. Returns 0 for a scene that isn't READY, or an actor that isn't
/// a placed object layer.
extern fn wgf_scene_spawn_objects(scene: wgf_scene_t, layer: wgf_actor_t) -> i32;

// ---- wgf_screen.h ----

/// Screens and scene flow: a game as a stack of screens, such as a title, play, a pause menu,
/// and game over. Nothing is called back.
///
/// A screen is an actor, and your game's behaviors for it go on it. Its stages, 2D and 3D, are
/// added to it in the order they draw. Stages are always roots: they belong to the screen
/// without being its children. Every other actor of the screen hangs under its stages.
///
/// The stack:
/// - push puts a screen on top.
/// - pop takes the top screen off.
/// - replace swaps the top screen for another.
///
/// The top screen runs. The screens under it run or pause:
/// - A screen under one that pauses (the default) is paused, with its stages
///   (wgf_actor_set_paused: drawn, but frozen).
/// - A screen under one that doesn't pause, such as a HUD laid over play, runs on.
/// - What a paused screen's stages hold waits with them: their actors' motion, behaviors, and
///   tweens. A number's tween (wgf_tween_create) belongs to no stage, and runs on.
/// - A screen off the stack is switched off and paused, with its stages (wgf_actor_set_enabled:
///   not drawn, and nothing under them moving). It is kept for your game to push again or
///   destroy.
///
/// wgf_screen_draw draws what is shown. It draws from the bottom up, each screen's stages in
/// their order, but no screen under an opaque one (the default). It then draws the
/// transition's cover.
///
/// A change runs through the transition that is set (none to start, so changes happen at once).
/// - It covers the frame over half its seconds, makes the change at the middle, and uncovers
///   over the other half. Each half runs on the ease.
/// - A screen can wait for assets: a group (set_assets, wgf_asset.h), or every load pending
///   (set_wait_loads: the textures and meshes made as it was built). The change to it happens
///   only once they have settled.
/// - Meanwhile the stack is held covered. The loading screen (set_loading_screen) is drawn over
///   the cover, and its progress can be read.
/// - While a change runs, another change is refused (false).
///
/// Each change is told as world events (wgf_world.h):
/// - SCREEN_ENTER for the screen that comes to the top.
/// - SCREEN_EXIT for the one that leaves the top: pushed under, popped, or replaced.
///
/// Each event carries the other screen (0 for none) as its second value. A binding's behaviors
/// on a screen hear them.
extern wgf_transition_t;
extern let WGF_TRANSITION_NONE: wgf_transition_t;
extern let WGF_TRANSITION_FADE: wgf_transition_t;
extern let WGF_TRANSITION_SLIDE_LEFT: wgf_transition_t;
extern let WGF_TRANSITION_SLIDE_RIGHT: wgf_transition_t;
extern let WGF_TRANSITION_SLIDE_UP: wgf_transition_t;
extern let WGF_TRANSITION_SLIDE_DOWN: wgf_transition_t;
extern let WGF_TRANSITION_WIPE: wgf_transition_t;
extern let WGF_TRANSITION_IRIS: wgf_transition_t;

/// Creates a screen: an actor at the top of its own tree, off the stack and switched off.
/// Returns 0 when there is no room for another actor.
extern fn wgf_screen_create() -> wgf_actor_t;

/// Adds, removes, or lists a screen's stages, drawn in the order added (at most 8).
///
/// - add_stage returns false for an actor that isn't a screen, one that isn't a stage, or a
///   stage the screen already has.
/// - remove_stage returns false for a stage the screen doesn't have.
///
/// A stage that is destroyed leaves its screen.
extern fn wgf_screen_add_stage(screen: wgf_actor_t, stage: wgf_actor_t) -> bool;

extern fn wgf_screen_remove_stage(screen: wgf_actor_t, stage: wgf_actor_t) -> bool;

extern fn wgf_screen_get_stage_count(screen: wgf_actor_t) -> i32;

extern fn wgf_screen_get_stage(screen: wgf_actor_t, index: i32) -> wgf_actor_t;

/// Changes the stack, through the transition.
///
/// - push returns false for an actor that isn't a screen, or one already on the stack.
/// - pop returns false with no screen, or with the bottom screen alone.
/// - replace returns false as push does, or with no screen to replace.
///
/// All of them return false while a change runs.
extern fn wgf_screen_push(screen: wgf_actor_t) -> bool;

extern fn wgf_screen_pop() -> bool;

extern fn wgf_screen_replace(screen: wgf_actor_t) -> bool;

/// Returns the stack's screens.
///
/// - get_top returns the top screen, or 0 with none.
/// - get_count returns how many are on the stack.
/// - get returns the one `index` up from the bottom, or 0 for an index off the stack.
///
/// Each is as of the last change made. A change still running isn't counted yet.
extern fn wgf_screen_get_top() -> wgf_actor_t;

extern fn wgf_screen_get_count() -> i32;

extern fn wgf_screen_get(index: i32) -> wgf_actor_t;

/// Sets or gets whether a screen is opaque, and whether it is pausing.
///
/// - opaque: no screen under it is drawn (default: on). Turn it off for a pause menu over the
///   game.
/// - pausing: the screens under it are paused (default: on). Turn it off for a HUD over play.
///
/// Returns false for an actor that isn't a screen.
extern fn wgf_screen_set_opaque(screen: wgf_actor_t, opaque_: bool) -> bool;

extern fn wgf_screen_is_opaque(screen: wgf_actor_t) -> bool;

extern fn wgf_screen_set_pausing(screen: wgf_actor_t, pausing: bool) -> bool;

extern fn wgf_screen_is_pausing(screen: wgf_actor_t) -> bool;

/// Draws what is shown, into this frame: each shown screen's stages, then the cover.
extern fn wgf_screen_draw();

/// Sets or gets the transition the changes run through.
///
/// - Its kind, and its length in seconds. 0 or less means at once.
/// - Its color (default: black).
/// - Each half's ease (default: linear).
///
/// Returns false for a kind that isn't one, or seconds that aren't finite.
extern fn wgf_screen_set_transition(kind: wgf_transition_t, seconds: f32) -> bool;

extern fn wgf_screen_get_transition() -> wgf_transition_t;

extern fn wgf_screen_get_transition_seconds() -> f32;

extern fn wgf_screen_set_transition_color(color: wgf_color_t);

extern fn wgf_screen_get_transition_color() -> wgf_color_t;

extern fn wgf_screen_set_transition_ease(ease: wgf_easing_t) -> bool;

extern fn wgf_screen_get_transition_ease() -> wgf_easing_t;

/// Returns whether a change is running, and how far it has come.
///
/// - 0 to 0.5: covering.
/// - 0.5: covered. The change is made there, or it is waiting on a load.
/// - 0.5 to 1: uncovering.
///
/// The progress is 0 with no change running.
extern fn wgf_screen_is_changing() -> bool;

extern fn wgf_screen_get_change_progress() -> f32;

/// Sets or gets what `screen` waits for before it is changed to: an asset task (a group of its
/// files, made local), or 0 for none. Returns false for an actor that isn't a screen, or a
/// handle that isn't a task.
extern fn wgf_screen_set_assets(screen: wgf_actor_t, task: wgf_asset_task_t) -> bool;

extern fn wgf_screen_get_assets(screen: wgf_actor_t) -> wgf_asset_task_t;

/// Sets or gets whether a change to `screen` also waits for every load pending in your game
/// (default: off). Returns false for an actor that isn't a screen.
extern fn wgf_screen_set_wait_loads(screen: wgf_actor_t, wait: bool) -> bool;

extern fn wgf_screen_is_wait_loads(screen: wgf_actor_t) -> bool;

/// Sets or gets the loading screen, drawn over the cover while a change waits on loads (0 for
/// none). get_load_progress returns how far the loads have come, 0 to 1.
///
/// - With assets to wait for, it is their progress.
/// - Otherwise it is the share of the loads pending when the wait began that have settled.
/// - It is 1 with nothing waiting.
extern fn wgf_screen_set_loading_screen(screen: wgf_actor_t) -> bool;

extern fn wgf_screen_get_loading_screen() -> wgf_actor_t;

extern fn wgf_screen_get_load_progress() -> f32;

// ---- wgf_tween.h ----

/// Tweens: move a number, or an actor's position, turn, or scale, to a value over seconds on an
/// ease (wgf_ease.h).
///
/// Tweens step on the tick clock (wgf_loop.h), so an autopilot's run is the same each time.
///
/// - An actor's tween starts from where the actor is when the tween begins, after its delay.
/// - It ends with the actor: a tween of a destroyed actor is let go of.
/// - It waits while its actor is paused (wgf_actor_set_paused), as under a pause screen.
/// - A number's tween has no actor, so it runs on under a pause. Pause it yourself
///   (wgf_tween_set_paused), as in a screen's exit and enter.
/// - A tween that ends, its repeats done, is let go of too. Its handle is then dead (see
///   wgf_handle_is_alive), which is how your game knows it ended.
/// - There can be at most 4096 tweens.
///
/// Each call below creates a tween, running. Each returns 0 for `seconds` not above 0 or not
/// finite, an actor that isn't one, or no room for another tween.
extern fn wgf_tween_create(from: f32, to: f32, seconds: f32, easing: wgf_easing_t) -> wgf_tween_t;

extern fn wgf_tween_move(
    actor: wgf_actor_t,
    x: f32,
    y: f32,
    z: f32,
    seconds: f32,
    easing: wgf_easing_t
) -> wgf_tween_t;

extern fn wgf_tween_turn(
    actor: wgf_actor_t,
    x: f32,
    y: f32,
    z: f32,
    seconds: f32,
    easing: wgf_easing_t
) -> wgf_tween_t;

extern fn wgf_tween_scale(
    actor: wgf_actor_t,
    x: f32,
    y: f32,
    z: f32,
    seconds: f32,
    easing: wgf_easing_t
) -> wgf_tween_t;

/// Lets go of a tween at once, leaving its value, or its actor, where it is. Does nothing, and
/// logs nothing, for a handle that isn't a tween or a tween that has finished.
extern fn wgf_tween_destroy(tween: wgf_tween_t);

/// Returns a tween's value now.
///
/// - For a number's tween: the value, from `from` to `to` or between.
/// - For an actor's tween: its eased progress, 0 to 1.
///
/// Returns 0 for a handle that isn't a tween.
extern fn wgf_tween_get_value(tween: wgf_tween_t) -> f32;

/// Sets or gets the seconds a tween waits before it begins (default: 0). Set it before the
/// tween begins. The setter refuses a negative or non-finite delay, and a tween already
/// begun.
extern fn wgf_tween_set_delay(tween: wgf_tween_t, seconds: f32) -> bool;

extern fn wgf_tween_get_delay(tween: wgf_tween_t) -> f32;

/// Sets or gets how many more times a tween runs after the first (default: 0), and whether each
/// run after the first goes back the way it came (yoyo).
///
/// A repeat of -1 runs it for ever. set_repeat refuses a count below -1.
extern fn wgf_tween_set_repeat(tween: wgf_tween_t, count: i32) -> bool;

extern fn wgf_tween_get_repeat(tween: wgf_tween_t) -> i32;

extern fn wgf_tween_set_yoyo(tween: wgf_tween_t, yoyo: bool) -> bool;

extern fn wgf_tween_is_yoyo(tween: wgf_tween_t) -> bool;

/// Pauses a tween where it is, or runs it again, or gets whether it is paused. Returns false
/// only for a handle that isn't a tween.
extern fn wgf_tween_set_paused(tween: wgf_tween_t, paused: bool) -> bool;

extern fn wgf_tween_is_paused(tween: wgf_tween_t) -> bool;

// ---- wgf_world.h ----

/// The simulation as a whole: libwgf's systems over the actors' components (wgf_component.h),
/// the events they raise, and the simulated actors written out as text.
///
/// To find the actors with a behavior or a component, see wgf_actor_find_with_behavior
/// (wgf_behavior.h) and wgf_actor_find_with_component (wgf_component.h).
///
/// Each tick, as it begins, every simulated actor's transform is kept as it is. After your
/// game's tick, the systems run in this order:
/// - Lifetimes count down. An actor whose time is up is destroyed.
/// - Motion moves each actor by its velocity and spin, damped, with its speed capped.
/// - Bounds wrap, clamp, destroy, or bounce an actor that has left its rectangle.
/// - Colliders find the overlaps.
///
/// Each frame, a simulated actor is drawn between its last two ticks' transforms.
///
/// Events are what your game's behaviors are told (wgf_behavior.h). They are queued as they
/// happen and taken by your game, in order. Each is four ints: the event and three more.
///
///   CREATED          a behavior added: its actor, its id, 0
///   DESTROYED        a behavior removed, or its actor destroyed: its actor (stale by then,
///                    a name for what it was), its id, 0
///   TRIGGER_ENTER    two colliders starting to overlap, told to each: the actor, the other,
///                    and the other's collider layer as they met
///   TRIGGER_EXIT     two colliders ceasing to overlap, as TRIGGER_ENTER
///   CONTACT_BEGIN    two solid bodies beginning to touch (wgf_body3d.h), told to each: the
///                    actor, the other, and the other's body layer
///   CONTACT_END      two solid bodies ceasing to touch, as CONTACT_BEGIN
///   SCREEN_ENTER     a screen coming to the top of the stack (wgf_screen.h): the screen,
///                    the one it covers or replaced (0 for none)
///   SCREEN_EXIT      a screen leaving the top: the screen, the one now there (0 for none)
///
/// Notes:
/// - An actor destroyed while it overlaps another raises no TRIGGER_EXIT.
/// - Events taken in a batch can name an actor your game destroyed while handling an earlier
///   event of the batch. A binding's runtime drops a trigger whose actor or other actor is gone
///   by then.
/// - Nothing is called back. A binding takes the events at its tick's start and calls its
///   behaviors itself.
/// - At most 65536 events wait. Past that the oldest are dropped, with a warning once.
extern wgf_world_event_t;
extern let WGF_WORLD_EVENT_NONE: wgf_world_event_t;
extern let WGF_WORLD_EVENT_CREATED: wgf_world_event_t;
extern let WGF_WORLD_EVENT_DESTROYED: wgf_world_event_t;
extern let WGF_WORLD_EVENT_TRIGGER_ENTER: wgf_world_event_t;
extern let WGF_WORLD_EVENT_TRIGGER_EXIT: wgf_world_event_t;
extern let WGF_WORLD_EVENT_CONTACT_BEGIN: wgf_world_event_t;
extern let WGF_WORLD_EVENT_CONTACT_END: wgf_world_event_t;
extern let WGF_WORLD_EVENT_SCREEN_ENTER: wgf_world_event_t;
extern let WGF_WORLD_EVENT_SCREEN_EXIT: wgf_world_event_t;

/// Returns how many events wait, or takes the oldest off the queue.
///
/// take_events fills `out` with four ints an event (the event, then the three above). It takes
/// as many whole events as fit in `count` ints, and returns how many ints it filled.
extern fn wgf_world_get_event_count() -> i32;

extern fn wgf_world_take_events(out: i32*, count: i32) -> i32;

/// Returns how many actors have a component or a behavior: the simulated ones. An actor with
/// neither, such as a text or a sprite that only draws, isn't counted. For the actors a scene
/// file holds, see wgf_scene_get_actor_count.
extern fn wgf_actor_get_count() -> i32;

/// Destroys every actor with a component or a behavior, with every actor under it, oldest
/// first.
extern fn wgf_world_clear();

/// Sets or gets the actor that spatial audio is heard from (wgf_audio.h's listener).
///
/// Each frame the listener is put where the actor is drawn, facing its -z, as a camera views.
/// 0 sets none, and the listener stays as last set. Returns false for a handle that isn't an
/// actor.
extern fn wgf_world_set_listener(actor: wgf_actor_t) -> bool;

extern fn wgf_world_get_listener() -> wgf_actor_t;

/// Returns the simulated actors as a scene's text, in wgf_scene.h's format.
///
/// - Each top actor is written, oldest first, as an `actor` block. A top actor has a component
///   or a behavior, and its parent has none.
/// - Each block holds the actor's kind, its transform, its components, its behaviors, and the
///   actors under it, as they are now. Loading the text as a scene and instantiating it makes
///   the same actors again.
/// - An actor under a glTF file's model is written with the file's root, as its `model path=`
///   block.
/// - A node of the file is written only with what it has beyond what the file gives it: its
///   transform, components, behaviors, and the actors under it. Its kind is left to the file.
///
/// libwgf owns the string, valid until the next dump. Returns "" when no actor ever had a
/// component or a behavior.
extern fn wgf_world_dump() -> const char*;

// ---- wgf_body3d.h ----

/// A body (WGF_COMPONENT_BODY3D, wgf_component.h): an actor in the physics world
/// (wgf_physics3d.h), as a rigid shape.
///
/// Defaults:
/// - dynamic
/// - a box of 1 by 1 by 1 meters
/// - a mass from its size (1000 kilograms a cubic meter)
/// - friction 0.5, no bounce, and damping of 0.05
/// - layer 1, and a mask of every layer
///
/// Friction, bounce, and damping take effect at once, and the body's motion is kept. A car's
/// drag on grass can be set as it goes. Its other settings take effect at the next tick, when
/// the world's body is made again from them, at rest. Set them together, before the first
/// tick, as a scene does.
///
/// The actor's transform is the body's:
/// - Each tick, the actor is set to where the world moved a dynamic body.
/// - A transform your game sets puts the body there. A static or dynamic body jumps there. A
///   kinematic body is moved there over the tick, pushing the bodies it meets.
///
/// A box's, sphere's, or capsule's size isn't scaled with its actor. A convex or mesh shape is
/// read from the models at and under the actor, as they are drawn. That includes the actor's
/// own scale and each model's place under it.
///
/// The body's place is in its 3D stage's space, and the actor may be anywhere in the stage's
/// tree.
///
/// The calls return false (or 0) for an actor without a body.
extern wgf_body3d_type_t;
extern let WGF_BODY3D_TYPE_STATIC: wgf_body3d_type_t;
extern let WGF_BODY3D_TYPE_DYNAMIC: wgf_body3d_type_t;
extern let WGF_BODY3D_TYPE_KINEMATIC: wgf_body3d_type_t;
extern let WGF_BODY3D_TYPE_SENSOR: wgf_body3d_type_t;
extern let WGF_BODY3D_TYPE_CHARACTER: wgf_body3d_type_t;

extern wgf_body3d_shape_t;
extern let WGF_BODY3D_SHAPE_BOX: wgf_body3d_shape_t;
extern let WGF_BODY3D_SHAPE_SPHERE: wgf_body3d_shape_t;
extern let WGF_BODY3D_SHAPE_CAPSULE: wgf_body3d_shape_t;
extern let WGF_BODY3D_SHAPE_CONVEX: wgf_body3d_shape_t;
extern let WGF_BODY3D_SHAPE_MESH: wgf_body3d_shape_t;

extern fn wgf_body3d_set_type(actor: wgf_actor_t, type_: wgf_body3d_type_t) -> bool;

extern fn wgf_body3d_get_type(actor: wgf_actor_t) -> wgf_body3d_type_t;

/// Sets or gets the body's shape, centered on the actor (default: a box of 1 by 1 by 1).
///
/// - `x`, `y`, `z` mean what the shape says (see wgf_body3d_shape_t). Each is at least 0.01.
/// - CONVEX and MESH take no size. Their models' meshes are read when the body is made, and
///   a model not yet loaded is left out.
/// - A mesh can only be static. On another type it is its convex hull.
///
/// get_size returns `x`, `y`, `z` as set.
extern fn wgf_body3d_set_shape(actor: wgf_actor_t, shape: wgf_body3d_shape_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_body3d_get_shape(actor: wgf_actor_t) -> wgf_body3d_shape_t;

extern fn wgf_body3d_get_size(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets the shape's offset and the center of mass's offset, in the actor's space
/// (default: 0, 0, 0 for each).
///
/// - The offset is where the shape is centered from its actor. Use it for a gate's sensor on
///   the road, with its actor at the gate's foot.
/// - The mass offset is how far the center of mass is from the shape's own. Set it low on a
///   car, so it doesn't roll.
extern fn wgf_body3d_set_offset(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_body3d_get_offset(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_body3d_set_mass_offset(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_body3d_get_mass_offset(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets a dynamic body's mass, in kilograms (default: 0). 0 takes the mass from its
/// shape, at 1000 kilograms a cubic meter.
extern fn wgf_body3d_set_mass(actor: wgf_actor_t, kilograms: f32) -> bool;

extern fn wgf_body3d_get_mass(actor: wgf_actor_t) -> f32;

/// Sets or gets friction and bounce. Each is taken for a pair of bodies together.
///
/// - friction: 0 is ice and 1 is rubber (default: 0.5). It is clamped to 0 or more.
/// - bounce: 0 is none and 1 is all of it (default: 0). It is clamped to 0 to 1.
extern fn wgf_body3d_set_friction(actor: wgf_actor_t, friction: f32) -> bool;

extern fn wgf_body3d_get_friction(actor: wgf_actor_t) -> f32;

extern fn wgf_body3d_set_bounce(actor: wgf_actor_t, bounce: f32) -> bool;

extern fn wgf_body3d_get_bounce(actor: wgf_actor_t) -> f32;

/// Sets or gets damping: the share of its velocity (linear) and of its spin (angular) the body
/// loses each second, 0 to 1 (default: 0.05). get_damping returns (linear, angular).
extern fn wgf_body3d_set_damping(actor: wgf_actor_t, linear: f32, angular: f32) -> bool;

extern fn wgf_body3d_get_damping(actor: wgf_actor_t) -> wgf_vec2_t;

/// Sets or gets the body's layer and mask: what it meets (defaults: layer 1, mask every layer).
///
/// Two bodies meet when either one's mask has a bit of the other's layer, as two colliders do
/// (wgf_collider.h). Meeting means they collide, or a sensor tells of the other.
///
/// - Each is 15 bits (1 to 0x7FFF).
/// - Put the mask on the body that cares: a bullet whose mask has the enemies' layer meets
///   them, whatever their masks are.
/// - To make two bodies pass through each other, leave each one's layer out of the other's
///   mask. That goes for a moving body and a static one too.
/// - Two static bodies never meet.
extern fn wgf_body3d_set_layer(actor: wgf_actor_t, layer: i32) -> bool;

extern fn wgf_body3d_get_layer(actor: wgf_actor_t) -> i32;

extern fn wgf_body3d_set_mask(actor: wgf_actor_t, mask: i32) -> bool;

extern fn wgf_body3d_get_mask(actor: wgf_actor_t) -> i32;

/// Sets or gets the body's velocity and spin, in its stage's space, or gives it a push.
///
/// - The velocity is in units a second.
/// - The spin is in radians a second about each axis.
/// - add_impulse pushes it through its center, in kilogram units a second.
///
/// A body not yet made in the world (before its first tick) reads 0, and takes them when it
/// is made.
extern fn wgf_body3d_set_velocity(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_body3d_get_velocity(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_body3d_set_spin(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

extern fn wgf_body3d_get_spin(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_body3d_add_impulse(actor: wgf_actor_t, x: f32, y: f32, z: f32) -> bool;

/// Returns whether a dynamic body is asleep: the world stopped simulating it because it has
/// been still for about half a second. A touch, a push, or a new position or velocity wakes it.
///
/// Use it to ask whether things have settled, in place of testing each velocity. Returns false
/// for a body not yet made in the world, and for a static, kinematic, or character body.
extern fn wgf_body3d_is_sleeping(actor: wgf_actor_t) -> bool;

/// Returns whether a character is standing on ground.
///
/// A character (Jolt's CharacterVirtual) is moved by its velocity each tick. Use it for a
/// player, or an enemy that walks.
/// - It slides along walls and slopes.
/// - It climbs steps up to its step height, and is kept on the floor going down them.
/// - It pushes dynamic bodies.
/// - It stands on ground no steeper than its max slope.
///
/// Its velocity is its own. What you set stays, as for a walk. Its up part falls under the
/// world's gravity whenever it isn't standing, and is 0 on the ground. A jump sets it upward
/// once.
///
/// Its turn is its actor's. A transform your game sets puts it there. Rays, sensors, and
/// queries find it as a body of its shape. A capsule is its usual shape, with its center at the
/// actor.
extern fn wgf_body3d_is_grounded(actor: wgf_actor_t) -> bool;

/// Returns the normal of the ground a character stands on. Returns 0, 0, 0 when it isn't
/// standing, or isn't a character.
extern fn wgf_body3d_get_ground_normal(actor: wgf_actor_t) -> wgf_vec3_t;

/// Sets or gets the height of the steps a character climbs (default: 0.3). It takes effect at
/// once. The setter refuses a negative or non-finite height.
extern fn wgf_body3d_set_step_height(actor: wgf_actor_t, height: f32) -> bool;

extern fn wgf_body3d_get_step_height(actor: wgf_actor_t) -> f32;

/// Sets or gets the steepest ground a character stands on, in radians from level (default: 50
/// degrees). It takes effect at the next tick. The setter refuses a slope outside 0 to a right
/// angle.
extern fn wgf_body3d_set_max_slope(actor: wgf_actor_t, radians: f32) -> bool;

extern fn wgf_body3d_get_max_slope(actor: wgf_actor_t) -> f32;

// ---- wgf_physics3d.h ----

/// Enables characters (WGF_BODY3D_TYPE_CHARACTER in wgf_body3d.h, Jolt's CharacterVirtual), or
/// gets whether they are enabled.
///
/// Characters are linked on purpose. This call links them, so a game with no characters carries
/// none of their code (about 42 KB). A game enables them with "characters" in wgf.json's
/// features. Without it, a character type is refused (logged), in a scene too. Call it any time
/// before the first character.
extern fn wgf_physics3d_enable_characters() -> bool;

extern fn wgf_physics3d_is_characters_enabled() -> bool;

/// Enables vehicles (wgf_vehicle.h, Jolt's VehicleConstraint), or gets whether they are
/// enabled.
///
/// Vehicles are linked on purpose. This call links them, so a game with physics and no car
/// carries none of their code (about 46 KB). A game enables them with "vehicles" in wgf.json's
/// features. Without it, a vehicle component is refused (logged), in a scene too. Call it any
/// time before the first vehicle.
extern fn wgf_physics3d_enable_vehicles() -> bool;

extern fn wgf_physics3d_is_vehicles_enabled() -> bool;

/// Sets or gets the world's gravity, in units a second squared (default: 0, -9.81, 0, with y
/// up and units in meters). Setting it starts physics. The setter returns false only when
/// physics couldn't start (logged).
extern fn wgf_physics3d_set_gravity(x: f32, y: f32, z: f32) -> bool;

extern fn wgf_physics3d_get_gravity() -> wgf_vec3_t;

/// Draws every body's shape outlined in `color`, and each vehicle's wheels, as a debug view.
///
/// - A sensor is outlined at half the color's alpha.
/// - A mesh is drawn by its triangles' edges.
/// - It draws into the 3D drawing begun (wgf_draw_begin_3d, wgf_draw.h). It draws nothing
///   outside one, or before physics starts.
extern fn wgf_physics3d_draw_bodies(color: wgf_color_t);

/// Casts a ray or a sphere through the world, and returns what it hits.
///
/// The queries in this header see the bodies as they are now (as of their last tick), in their
/// 3D stage's space. Each meets the bodies whose layer is in `mask` (wgf_body3d_set_layer), and
/// never a sensor. Each starts physics.
///
/// - The ray starts at `x`, `y`, `z` and goes along `dx`, `dy`, `dz` for `distance`. The
///   direction may be any length: it is normalized.
/// - cast_sphere sweeps a sphere of `radius` the same way.
/// - Hits come nearest first, each body once (its nearest hit), as many as fit in `count`.
/// - Each hit's actor goes into `actors`.
/// - If `hits` is given, each hit also fills 7 floats of it, as many as fit in `hits_count`:
///   the point, the surface's normal there, and the distance along the ray.
///
/// Returns how many hits. Returns 0 for nothing hit, a direction of no length, a distance or
/// radius not above 0, or no array.
extern fn wgf_physics3d_cast_ray(
    x: f32,
    y: f32,
    z: f32,
    dx: f32,
    dy: f32,
    dz: f32,
    distance: f32,
    mask: i32,
    actors: wgf_actor_t*,
    count: i32,
    hits: f32*,
    hits_count: i32
) -> i32;

extern fn wgf_physics3d_cast_sphere(
    x: f32,
    y: f32,
    z: f32,
    radius: f32,
    dx: f32,
    dy: f32,
    dz: f32,
    distance: f32,
    mask: i32,
    actors: wgf_actor_t*,
    count: i32,
    hits: f32*,
    hits_count: i32
) -> i32;

/// Finds the bodies overlapping a sphere or a box, and returns how many.
///
/// - overlap_sphere: a sphere of `radius` at `x`, `y`, `z`.
/// - overlap_box: a box `width`, `height`, and `depth`, centered there, with the world's axes.
///
/// The bodies go into `actors` in no order, as many as fit in `count`. Like the casts, these
/// see the bodies as of their last tick, meet only those whose layer is in `mask` and never a
/// sensor, and start physics. Returns 0 for none, a size not above 0, or no array.
extern fn wgf_physics3d_overlap_sphere(
    x: f32,
    y: f32,
    z: f32,
    radius: f32,
    mask: i32,
    actors: wgf_actor_t*,
    count: i32
) -> i32;

extern fn wgf_physics3d_overlap_box(
    x: f32,
    y: f32,
    z: f32,
    width: f32,
    height: f32,
    depth: f32,
    mask: i32,
    actors: wgf_actor_t*,
    count: i32
) -> i32;

// ---- wgf_vehicle.h ----

/// A wheeled vehicle (WGF_COMPONENT_VEHICLE, wgf_component.h), on an actor with a dynamic body
/// (wgf_body3d.h).
///
/// A vehicle has wheels on springs, an engine, an automatic gearbox, and differentials. Each
/// tick it is driven by your game's intent (see wgf_vehicle_set_input), in the physics world
/// (wgf_physics3d.h). It faces its actor's +z, with +y up.
///
/// Its wheels are actors under it, given in left and right pairs, front first.
/// - Where each wheel is when the vehicle is made is where it attaches, with its spring at
///   rest.
/// - Each tick, the wheel's actor is set where the wheel is: steered, sprung, and turning about
///   its own x axis. A model under it with its axle along x shows the wheel.
/// - The first pair steers.
///
/// Defaults:
/// - no wheels
/// - an engine of 500 Nm, up to 6000 rpm
/// - Jolt's gear ratios
/// - rear drive
/// - wheels 0.3 meters in radius and 0.2 meters wide
/// - 0.3 meters of spring travel, at 1.5 Hz, damped by half
/// - 0.5 radians of steering
/// - grip 1
///
/// Its settings take effect at the next tick, when it is made again from them, at rest, as a
/// body's are. A change to its anti-roll bars is the exception: it takes effect at once.
/// wgf_vehicle_reset puts it at rest where it is.
///
/// The calls return false (or 0) for an actor without a vehicle.
extern wgf_vehicle_drive_t;
extern let WGF_VEHICLE_DRIVE_FRONT: wgf_vehicle_drive_t;
extern let WGF_VEHICLE_DRIVE_REAR: wgf_vehicle_drive_t;
extern let WGF_VEHICLE_DRIVE_ALL: wgf_vehicle_drive_t;

/// Sets or gets the vehicle's wheels: 2 to 8 actors under it, in left and right pairs, front
/// first. The setter returns false for an odd count, more than 8, or a wheel that isn't an
/// actor under it.
extern fn wgf_vehicle_set_wheels(actor: wgf_actor_t, wheels: const wgf_actor_t*, count: i32) -> bool;

extern fn wgf_vehicle_get_wheel_count(actor: wgf_actor_t) -> i32;

extern fn wgf_vehicle_get_wheel(actor: wgf_actor_t, index: i32) -> wgf_actor_t;

/// Sets the wheels, springs, steering, and grip.
///
/// - set_wheel_size: each wheel's radius and width, in meters.
/// - set_suspension: each spring's travel (meters), stiffness (Hz), and damping (0 is none, and
///   1 is just enough).
/// - set_steering: how far the front pair steers, in radians.
/// - set_grip: the tires' grip. 1 is a road tire's, and more grips harder.
extern fn wgf_vehicle_set_wheel_size(actor: wgf_actor_t, radius: f32, width: f32) -> bool;

extern fn wgf_vehicle_set_suspension(actor: wgf_actor_t, travel: f32, stiffness: f32, damping: f32) -> bool;

extern fn wgf_vehicle_set_steering(actor: wgf_actor_t, radians: f32) -> bool;

extern fn wgf_vehicle_set_grip(actor: wgf_actor_t, grip: f32) -> bool;

/// Sets or gets each axle's anti-roll bar stiffness, in N/m (default: 0, none). The stiffer it
/// is, the less the vehicle leans in a corner. A change takes effect at once.
extern fn wgf_vehicle_set_anti_roll(actor: wgf_actor_t, stiffness: f32) -> bool;

extern fn wgf_vehicle_get_anti_roll(actor: wgf_actor_t) -> f32;

/// Returns the settings as set.
///
/// - get_wheel_size: (radius, width).
/// - get_suspension: (travel, stiffness, damping).
/// - get_steering: radians.
/// - get_grip: the grip.
extern fn wgf_vehicle_get_wheel_size(actor: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_vehicle_get_suspension(actor: wgf_actor_t) -> wgf_vec3_t;

extern fn wgf_vehicle_get_steering(actor: wgf_actor_t) -> f32;

extern fn wgf_vehicle_get_grip(actor: wgf_actor_t) -> f32;

/// Sets the engine, the gearbox, and the drive.
///
/// - set_engine: the engine's torque (Nm) and top speed (rpm).
/// - set_gears: the gearbox's forward ratios, 1 to 8 of them, the first the lowest. For
///   example, 3.2 down to 0.9.
/// - set_drive: which axles the engine drives.
extern fn wgf_vehicle_set_engine(actor: wgf_actor_t, torque: f32, max_rpm: f32) -> bool;

extern fn wgf_vehicle_set_gears(actor: wgf_actor_t, ratios: const f32*, count: i32) -> bool;

extern fn wgf_vehicle_set_drive(actor: wgf_actor_t, drive: wgf_vehicle_drive_t) -> bool;

/// Returns the engine, gearbox, and drive as set.
///
/// - get_engine: (torque, max_rpm).
/// - get_gear_count: how many forward ratios.
/// - get_gear_ratio: ratio `index`, or 0 for one the gearbox doesn't have.
/// - get_drive: the drive.
extern fn wgf_vehicle_get_engine(actor: wgf_actor_t) -> wgf_vec2_t;

extern fn wgf_vehicle_get_gear_count(actor: wgf_actor_t) -> i32;

extern fn wgf_vehicle_get_gear_ratio(actor: wgf_actor_t, index: i32) -> f32;

extern fn wgf_vehicle_get_drive(actor: wgf_actor_t) -> wgf_vehicle_drive_t;

/// Sets the driver's intent, which holds until it is set again. Set it each tick from the input
/// (wgf_action.h). Each value is clamped.
///
/// - `throttle`: 0 to 1. Below 0 is reverse.
/// - `brake`: 0 to 1.
/// - `steer`: -1 (full left) to 1 (full right).
/// - `hand_brake`: the hand brake, on the rear wheels.
extern fn wgf_vehicle_set_input(actor: wgf_actor_t, throttle: f32, brake: f32, steer: f32, hand_brake: bool) -> bool;

/// Returns how the vehicle is going.
///
/// - get_speed: its speed along its +z, in meters a second. Below 0 is backing up.
/// - get_rpm: the engine's rpm.
/// - get_gear: the gear it is in. 1 is the lowest, -1 is reverse, and 0 is neutral.
/// - get_wheel_slip: how hard wheel `index`'s tire works, as a share of its grip's peak. It is
///   the larger of the slip along the tire and across it.
///
/// Wheel slip:
/// - Below 1, the tire grips. A free-rolling wheel reads a little above 0, from its small slip
///   angle.
/// - 1 is at the limit.
/// - Above 1 it is sliding or spinning, up to 10. Traction control keeps it near 1, and tire
///   smoke shows above about 1.5.
/// - It is 0 for a wheel the vehicle doesn't have, or a wheel in the air.
extern fn wgf_vehicle_get_speed(actor: wgf_actor_t) -> f32;

extern fn wgf_vehicle_get_rpm(actor: wgf_actor_t) -> f32;

extern fn wgf_vehicle_get_gear(actor: wgf_actor_t) -> i32;

extern fn wgf_vehicle_get_wheel_slip(actor: wgf_actor_t, index: i32) -> f32;

/// Puts the vehicle at rest where it is. Its velocity, spin, wheels, engine, and gearbox are
/// stopped, and its intent is cleared. To put a car back on the grid, set its transform, then
/// reset it.
extern fn wgf_vehicle_reset(actor: wgf_actor_t) -> bool;

// ---- wgf_document.h ----

/// What happened to an element, as wgf_document_take_events gives it.
extern wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_NONE: wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_CLICK: wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_CHANGE: wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_SUBMIT: wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_FOCUS: wgf_document_event_t;
extern let WGF_DOCUMENT_EVENT_BLUR: wgf_document_event_t;

/// Creates the document in the .rml file at `path` under fs's root, and starts loading it. It
/// is hidden until shown.
///
/// A path created before returns the same document, with one more reference. Returns 0 only
/// when there is no room for another document (at most 4096).
extern fn wgf_document_create(path: const char*) -> wgf_document_t;

/// Shows or hides a document, or gets whether it is shown.
///
/// A shown document is drawn by wgf_ui_draw_documents, and worked by the input. A document
/// asked to show while it loads is shown once it is READY. Shown documents are drawn in the
/// order they were last shown, the last on top.
///
/// Returns false for a handle that isn't a document, or one that FAILED.
extern fn wgf_document_set_visible(document: wgf_document_t, visible: bool) -> bool;

extern fn wgf_document_is_visible(document: wgf_document_t) -> bool;

/// Returns the element of `document` whose id is `id`. The same element returns the same
/// handle. Returns 0 if no element has that id, or the document isn't READY.
extern fn wgf_document_find(document: wgf_document_t, id: const char*) -> wgf_element_t;

/// Sets or gets the element of `document` that has the focus (0 for none).
///
/// Setting it moves the focus there, shown as keys move it (`:focus-visible`). 0 takes the
/// focus from the document.
///
/// The setter returns false for a handle that isn't a document, an element of another
/// document, or an element that can't take the focus. An element can't take it if it is
/// hidden, disabled, or neither a form control nor `tab-index: auto`.
extern fn wgf_document_set_focus(document: wgf_document_t, element: wgf_element_t) -> bool;

extern fn wgf_document_get_focus(document: wgf_document_t) -> wgf_element_t;

/// Returns how many events of `document` wait, or takes the oldest, since they were last
/// taken.
///
/// take_events fills `out` with two ints an event: the event (a wgf_document_event_t) and its
/// element (a wgf_element_t). It takes as many whole events as fit in `count` ints, oldest
/// first, and returns how many ints it filled.
///
/// An event's element is the one it happened to. If that element has no id, it is the nearest
/// element around it that has one: a click on a button's label is the button's.
///
/// Events wait while nobody takes them. Past 1024, the oldest are dropped. Returns 0 for a
/// handle that isn't a document, or no array.
extern fn wgf_document_get_event_count(document: wgf_document_t) -> i32;

extern fn wgf_document_take_events(document: wgf_document_t, out: i32*, count: i32) -> i32;

/// Returns the document an element is in, and its id ("" for none). Returns 0 or "" for a
/// handle that isn't an element.
extern fn wgf_element_get_document(element: wgf_element_t) -> wgf_document_t;

extern fn wgf_element_get_id(element: wgf_element_t) -> const char*;

/// Sets or gets an element's content, as plain text or as RML.
///
/// - set_text shows `text` as it is, with no markup.
/// - set_rml parses `rml` and makes its elements.
/// - get_text returns the text of every element inside it, in order.
/// - get_rml returns its content as RML.
///
/// Returns false for a handle that isn't an element, or no text. Text a getter returns is valid
/// until the next call in this header that returns text.
extern fn wgf_element_set_text(element: wgf_element_t, text: const char*) -> bool;

extern fn wgf_element_get_text(element: wgf_element_t) -> const char*;

extern fn wgf_element_set_rml(element: wgf_element_t, rml: const char*) -> bool;

extern fn wgf_element_get_rml(element: wgf_element_t) -> const char*;

/// Sets, gets, checks, or removes an attribute, such as `class`, `src`, or a form control's
/// `value`.
///
/// - get_attribute returns "" for an attribute that isn't set.
/// - has_attribute returns whether it is set.
/// - remove_attribute unsets it, and returns false if it wasn't set.
///
/// Returns false for a handle that isn't an element, or no name.
extern fn wgf_element_set_attribute(element: wgf_element_t, name: const char*, value: const char*) -> bool;

extern fn wgf_element_get_attribute(element: wgf_element_t, name: const char*) -> const char*;

extern fn wgf_element_has_attribute(element: wgf_element_t, name: const char*) -> bool;

extern fn wgf_element_remove_attribute(element: wgf_element_t, name: const char*) -> bool;

/// Adds a class (`on`) or takes it off, as RCSS's selectors see it. has_class returns whether it
/// is on. Returns false for a handle that isn't an element, or no name.
extern fn wgf_element_set_class(element: wgf_element_t, name: const char*, on: bool) -> bool;

extern fn wgf_element_has_class(element: wgf_element_t, name: const char*) -> bool;

/// Sets or gets an RCSS property on the element itself, over its style sheets' value
/// (`"color"`, `"#ffcc00"`).
///
/// - A `value` of "" or NULL takes the element's own value off.
/// - get_property returns the property's value as the element has it now, from wherever it
///   comes, as RCSS text. It returns "" for a name that isn't a property.
///
/// The setter returns false for a handle that isn't an element, a name that isn't a property, or
/// a value that isn't one of its values (logged).
extern fn wgf_element_set_property(element: wgf_element_t, name: const char*, value: const char*) -> bool;

extern fn wgf_element_get_property(element: wgf_element_t, name: const char*) -> const char*;

/// Sets or gets a form control's value, as text or as a number.
///
/// - The value is a text field's text, a slider's number, a choice's chosen value, or a
///   checkbox's own value.
/// - As a number: a slider's value is clamped to its range. Text is read as a number, and text
///   that isn't one reads 0.
/// - A tabset's number is its chosen tab, from 0 in its `<tabs>`' order. Set it as a whole
///   number among them. A tab chosen by the player raises the tabset's CHANGE.
///
/// Setting either raises no event. Returns false (and "", or 0) for a handle that isn't a form
/// control or a tabset. set_value takes a form control only.
extern fn wgf_element_set_value(element: wgf_element_t, value: const char*) -> bool;

extern fn wgf_element_get_value(element: wgf_element_t) -> const char*;

extern fn wgf_element_set_number(element: wgf_element_t, value: f32) -> bool;

extern fn wgf_element_get_number(element: wgf_element_t) -> f32;

/// Sets or gets whether a checkbox or a radio button is checked. Returns false for a handle that
/// isn't one.
extern fn wgf_element_set_checked(element: wgf_element_t, checked: bool) -> bool;

extern fn wgf_element_is_checked(element: wgf_element_t) -> bool;

/// Sets or gets whether a form control is disabled. A disabled control is drawn as RCSS's
/// `:disabled` says, and takes no input or focus. Returns false for a handle that isn't a form
/// control.
extern fn wgf_element_set_disabled(element: wgf_element_t, disabled: bool) -> bool;

extern fn wgf_element_is_disabled(element: wgf_element_t) -> bool;

// ---- wgf_ui.h ----

/// Game UI, in immediate mode: each frame your game describes the UI as it is now.
///
/// You describe boxes, panels, labels, buttons, and progress bars between wgf_ui_begin and
/// wgf_ui_end, inside the frame callback. libwgf lays them out, answers what the
/// pointer, the keys, and the pads did to them, and draws them at wgf_ui_end, over what the
/// frame drew before.
///
/// The screen is the root: a column of every widget given, centered both ways. A box lays its
/// children out in a column or a row, sized to fit them unless set otherwise. A button's answer
/// comes from where the widgets were in the frame before, as in every immediate-mode UI. A UI
/// that moves under the pointer is answered where it was.
///
/// Focus: one widget at a time has it, by its id. A widget that can take it is a button, a
/// toggle, a checkbox, a slider, a number, tabs, a choice, a combo, a tile, a list, a dropdown,
/// or a text field.
/// - The arrow keys and a pad's D-pad move it to the nearest widget that way on the screen, as
///   last laid out. A grid of tiles moves in two dimensions.
/// - With no widget that way, they move it through the frame's widgets in the order they were
///   given: Down and Right to the next, Up and Left to the one before, wrapping.
/// - Tab and Shift+Tab always go in that order.
/// - The first press of one puts the focus on the first or the last widget.
/// - A focused widget keeps the arrows it uses. A slider, a number, tabs, a choice, a combo,
///   and a text field keep left and right. A slider that fills up or down, and a list, keep up
///   and down. An open dropdown keeps all four.
/// - Enter, Space, or a pad's south button activates the focused widget.
/// - The pointer activates the widget it is pressed and released over, and gives it the focus.
/// - A focus moved by keys or pads is drawn. One given by the pointer isn't.
/// - A focused widget that isn't given in a frame loses the focus.
/// - A disabled widget (wgf_ui_set_disabled) is drawn disabled, answers nothing, and is never
///   focused.
///
/// The UI says when it has the pointer and the keyboard:
/// - The pointer (wgf_input_set_pointer_captured), while it is over a panel, a button, or a box
///   with a color, or while a press on a button is held.
/// - The keyboard (wgf_input_set_keyboard_captured), while a button has the focus.
/// - A frame without wgf_ui_end lets both go.
///
/// Ids name boxes, panels, groups, and widgets, and are unique in a frame. A second
/// one is refused (logged). A box, panel, or group may have no id (NULL or ""). Text is copied, so
/// it may change or go after the call.
///
/// Outside a begun UI, every call but the style's and the skins' returns false, and a widget's
/// call returns its value as given.
///
/// A widget with a value takes it and returns it as the user left it. Your game keeps the
/// value, and the call shows it and answers what was done to it this frame:
/// `volume = wgf_ui_slider("volume", volume, 0, 10)`.
extern wgf_ui_direction_t;
extern let WGF_UI_DIRECTION_COLUMN: wgf_ui_direction_t;
extern let WGF_UI_DIRECTION_ROW: wgf_ui_direction_t;

extern wgf_ui_align_t;
extern let WGF_UI_ALIGN_START: wgf_ui_align_t;
extern let WGF_UI_ALIGN_CENTER: wgf_ui_align_t;
extern let WGF_UI_ALIGN_END: wgf_ui_align_t;

extern wgf_ui_sizing_t;
extern let WGF_UI_SIZING_FIT: wgf_ui_sizing_t;
extern let WGF_UI_SIZING_GROW: wgf_ui_sizing_t;
extern let WGF_UI_SIZING_FIXED: wgf_ui_sizing_t;
extern let WGF_UI_SIZING_PERCENT: wgf_ui_sizing_t;

/// Begins the frame's UI, with the screen at its logical size as the root. Returns false when
/// a UI is already begun, or outside a frame.
extern fn wgf_ui_begin() -> bool;

/// Lays out, answers, and draws the frame's UI. Boxes left open are closed, and the call then
/// returns false (logged). Also returns false with no UI begun.
extern fn wgf_ui_end() -> bool;

/// Begins a grid, closed by wgf_ui_end_grid.
///
/// Its children are laid out in rows of `columns`, left to right, then top to bottom. They are
/// gapped by the style's gap both ways. Nothing else wraps a row: the grid makes them. Also
/// returns false for fewer than 1 column.
///
/// - The columns line up. Each is as wide as its widest child, and each row as tall as its
///   tallest. A form of labels and widgets is a grid of 2 columns.
/// - wgf_ui_set_align on the grid places each child in its cell. By default it is at the top left.
/// - A column's width comes from the last frame's layout, so a grid's first frame, or the frame
///   after a child changes size, is laid out with each child at its own width.
/// - A child sized to grow doesn't grow in a grid: it takes its smallest size.
/// - Columns past the 8th, and grids past the 16th in a frame, don't line up.
extern fn wgf_ui_begin_grid(id: const char*, columns: i32) -> bool;

extern fn wgf_ui_end_grid() -> bool;

/// Begins a box, a panel, or a group, each closed by its own end call.
///
/// - A box lays its children out in `direction`. Close it with wgf_ui_end_box.
/// - A panel is a column drawn with the style's panel color, corners, and padding, and gapped
///   by the style's gap. Close it with wgf_ui_end_panel.
/// - A group is a column drawn as an outline, in the style's separator color and line width.
///   Its `title` (NULL or "" for none) is its first line. It is padded and gapped as a panel.
///   Close it with wgf_ui_end_group.
///
/// An end call returns false with nothing of its kind open.
extern fn wgf_ui_begin_box(id: const char*, direction: wgf_ui_direction_t) -> bool;

extern fn wgf_ui_end_box() -> bool;

extern fn wgf_ui_begin_panel(id: const char*) -> bool;

extern fn wgf_ui_end_panel() -> bool;

extern fn wgf_ui_begin_group(id: const char*, title: const char*) -> bool;

extern fn wgf_ui_end_group() -> bool;

/// Begins a scroll area, closed by wgf_ui_end_scroll.
///
/// A scroll area is a window onto its children, `width` by `height` logical pixels. 0 takes the
/// room its parent has left that way. Its children are a column, clipped to the window, and
/// scrolled when they are longer or wider than it.
///
/// It scrolls by:
/// - The wheel over it. The innermost area under the pointer scrolls. A wheel across, or the
///   wheel with Shift, scrolls sideways.
/// - A drag. A press that moves a few pixels belongs to the area, and the widget it began on
///   isn't pressed, unless that widget is a slider. Let go while moving, it flings.
/// - Its scroll bars. Drag the thumb, or press the track for a page. Each bar is shown while
///   there is more to scroll to that way. With the style's WGF_UI_VALUE_SCROLL_BAR_ALWAYS it
///   is always shown, and with no more to scroll it is disabled, its thumb the whole track.
///
/// Focus:
/// - Focus moved to a widget in it, by keys, a pad, or wgf_ui_set_focus, scrolls the widget
///   into view.
/// - Page Up and Page Down page while the focus is in it.
/// - An area with no widget in it to focus (a page of text), and more than it shows, is focused
///   itself, by its id. That starts from the frame after it was first laid out so. Focused, its
///   arrows scroll it a row at a time, and the page keys a page.
///
/// The layout calls (padding, gap, alignment, color) apply to its content. Its size is the
/// call's, so wgf_ui_set_width and wgf_ui_set_height refuse it. Its scroll is kept while it is
/// given each frame. What it scrolls to shows from the next frame.
///
/// Also returns false for no id, or a size below 0.
extern fn wgf_ui_begin_scroll(id: const char*, width: f32, height: f32) -> bool;

extern fn wgf_ui_end_scroll() -> bool;

/// Sets or gets how far the scroll area or list `id` is scrolled, in logical pixels.
///
/// x is across and y is down, from its content's top left. get_scroll returns 0, 0 for one not
/// laid out. set_scroll scrolls it there, shown from its next layout, and held to its content
/// as last laid out. Use it to keep a chat log at its end.
///
/// The setter returns false for an id that isn't a scroll area or list laid out in the frame
/// before, or a value that isn't finite. These two work outside a begun UI too.
extern fn wgf_ui_set_scroll(id: const char*, x: f32, y: f32) -> bool;

extern fn wgf_ui_get_scroll(id: const char*) -> wgf_vec2_t;

/// Shows a text buffer's text (wgf_text_buffer.h), wrapped and scrolled: a chat, a log, credits,
/// help. Read-only.
///
/// It is a scroll area `width` by `height` (0 takes its parent's room that way), down only,
/// scrolled as wgf_ui_begin_scroll says, by its id. Its text is in the style's text size and
/// color, broken at each newline and before a word that would pass its width.
///
/// A frame passes no text: libwgf holds the buffer, and the view keeps its lines.
/// - The text is broken into lines again only when the buffer's version, the view's width, or
///   the style's size or font changes.
/// - Only the lines in view are laid out and drawn, so a long text costs what its visible
///   lines do.
///
/// With `follow`, a view scrolled to its end stays at it as its text grows, as a chat's does.
/// Scrolled up, it stays where it is.
///
/// A buffer that isn't READY shows nothing. Its lines are laid out from its second frame, when
/// its width is known. Returns false for no id, the text buffer 0, or a size below 0.
extern fn wgf_ui_text_view(id: const char*, text: wgf_text_buffer_t, width: f32, height: f32, follow: bool) -> bool;

/// Sets the open box's or panel's layout, before its first child.
///
/// Your game describes the open box each frame, so nothing keeps it to read back. A color draws
/// its background, and 0 (the default) draws none.
///
/// Returns false after its first child, with none open, for a sizing or alignment that isn't
/// one, or a value below 0 (or above 1 for a percent).
extern fn wgf_ui_set_width(sizing: wgf_ui_sizing_t, value: f32) -> bool;

extern fn wgf_ui_set_height(sizing: wgf_ui_sizing_t, value: f32) -> bool;

extern fn wgf_ui_set_padding(x: f32, y: f32) -> bool;

extern fn wgf_ui_set_gap(gap: f32) -> bool;

extern fn wgf_ui_set_align(x: wgf_ui_align_t, y: wgf_ui_align_t) -> bool;

extern fn wgf_ui_set_color(color: wgf_color_t) -> bool;

/// Shows text, in the style's font and text color, at `size` logical pixels. 0 or less takes
/// the style's text size. Each newline starts a line. Also returns false for no text.
extern fn wgf_ui_label(text: const char*, size: f32) -> bool;

/// Adds room along the open box's direction: `size` logical pixels, or 0 for the room left.
extern fn wgf_ui_spacer(size: f32) -> bool;

/// Draws a line across the open box, in the style's separator color and line width. It runs
/// along a column's width, or down a row's height.
extern fn wgf_ui_separator() -> bool;

/// Shows a texture placed by the layout, `width` by `height` logical pixels.
///
/// 0 or less takes the texture's own size, as it is when called: 0 by 0 until it is READY. The
/// texture is stretched to fill the size, and untinted (dimmed when disabled). Also returns
/// false for a handle that isn't a texture.
extern fn wgf_ui_image(texture: wgf_texture_t, width: f32, height: f32) -> bool;

/// Adds room `width` by `height` logical pixels that your game draws in itself (wgf_draw.h).
/// Draw where wgf_ui_get_bounds says it was laid out. Use it for what no widget draws. Also
/// returns false for no id, or a size below 0.
extern fn wgf_ui_custom(id: const char*, width: f32, height: f32) -> bool;

/// Returns where the box, panel, group, widget, or custom room `id` was laid out, in the
/// screen's logical pixels.
///
/// x and y are its top left, and z and w its width and height. After wgf_ui_end it is this
/// frame's layout, and until then the frame before's. Returns all 0 for an id not laid out.
extern fn wgf_ui_get_bounds(id: const char*) -> wgf_vec4_t;

/// Shows a button with `text`, and returns true in the frame it is activated. Also returns
/// false for no id.
///
/// An icon button shows `icon` (a texture, or 0 for none) before its text. The icon is as tall
/// as the text, and as wide as its shape keeps. With `text` NULL or "", it shows the icon
/// alone.
extern fn wgf_ui_button(id: const char*, text: const char*) -> bool;

extern fn wgf_ui_icon_button(id: const char*, icon: wgf_texture_t, text: const char*) -> bool;

/// Shows a button that is its art, and returns true in the frame it is activated.
///
/// - `normal` is drawn at its size.
/// - `pressed` is drawn while it is held (0 draws `normal`).
/// - `mask` is a CPU image (0 for none, so the whole button). The pointer presses the button
///   only where the mask isn't clear, so a round button's corners belong to the screen. The
///   mask is read as stretched over the button.
///
/// Also returns false for no id, or a handle that isn't a texture or an image.
extern fn wgf_ui_image_button(
    id: const char*,
    normal: wgf_texture_t,
    pressed: wgf_texture_t,
    mask: wgf_image_t
) -> bool;

/// Shows a toggle or a checkbox, and returns whether it is on.
///
/// - A toggle is a button that stays down while on.
/// - A checkbox is a box, checked while on, with `text` beside it (NULL or "" for none).
///
/// Each is turned by an activation. It returns `on` as given, or flipped in the frame it is
/// activated. It returns `on` as given when refused (no id).
extern fn wgf_ui_toggle(id: const char*, text: const char*, on: bool) -> bool;

extern fn wgf_ui_checkbox(id: const char*, text: const char*, on: bool) -> bool;

/// Shows a slider for `value` between `min` and `max`, and returns the value.
///
/// - It shows the value by its handle along its track, and the fill behind it.
/// - It fills in the slider's fill direction (see wgf_ui_set_fill), from the left by default.
///   Filling from the top or bottom, it stands up.
/// - Its size is the style's slider width and height, and handle size.
/// - A press on it, or a drag from one, sets it where the pointer is.
/// - When it is focused, its arrows (and a pad's D-pad's) move it a twentieth of its range.
///   Held ones repeat.
///
/// Returns the value as given (clamped to the range), or as moved. Returns the value as given
/// when refused: no id, `max` not above `min`, or either not finite.
extern fn wgf_ui_slider(id: const char*, value: f32, min: f32, max: f32) -> f32;

/// Shows a number for `value` between `min` and `max`, and returns the value.
///
/// It shows the value between a minus and a plus, which step it by `step`. When it is focused,
/// its arrows (and a pad's D-pad's) step it too. Held ones repeat. It is shown with as many
/// decimals as `step` has, up to 4.
///
/// Returns the value as given (clamped to the range), or as stepped. Returns the value as given
/// when refused: no id, `max` not above `min`, `step` not above 0, or any not finite.
extern fn wgf_ui_number(id: const char*, value: f32, min: f32, max: f32, step: f32) -> f32;

/// Shows tabs, a choice, or a combo among `labels`, and returns the one chosen.
///
/// `labels` holds one label a line, up to 32 ("Easy\nNormal\nHard").
/// - Tabs are a row of the labels, with the chosen one pressed. Your game draws its panel
///   below.
/// - A choice is the same, drawn as toggles.
/// - A combo shows the chosen label alone, and steps to the next when activated. Its arrows
///   step either way, wrapping.
///
/// A press chooses the tab or toggle it is on. When focused, the arrows step.
///
/// Returns `selected` as given (clamped to the labels), or as the user chose this frame. Returns
/// `selected` as given when refused: no id, or no labels.
extern fn wgf_ui_tabs(id: const char*, labels: const char*, selected: i32) -> i32;

extern fn wgf_ui_choice(id: const char*, labels: const char*, selected: i32) -> i32;

extern fn wgf_ui_combo(id: const char*, labels: const char*, selected: i32) -> i32;

/// Shows a tile, and returns true in the frame it is activated.
///
/// A tile is `picture` (a texture, or 0 for none) above `text` (NULL or "" for none). It is the
/// style's tile size wide, with its picture square in it. Use it for a level select's level, or
/// an inventory's item, in a grid.
///
/// Also returns false for no id, or a handle that isn't a texture.
extern fn wgf_ui_tile(id: const char*, picture: wgf_texture_t, text: const char*) -> bool;

/// Sets or gets whether the widgets given after it, until it is changed, are disabled.
///
/// A disabled widget is drawn in its disabled state, answers nothing, and is never focused.
/// Each UI begins with no widget disabled. Returns false with no UI begun.
extern fn wgf_ui_set_disabled(disabled: bool) -> bool;

extern fn wgf_ui_is_disabled() -> bool;

/// Returns whether the widget given just before it was activated this frame.
///
/// - For a button, an icon or image button, a toggle, a checkbox, or a tile: as its own call
///   answered.
/// - For a list: whether its chosen item was activated (see wgf_ui_list).
///
/// Returns false for any other widget, with no widget before it in the frame, and outside a
/// begun UI.
extern fn wgf_ui_is_activated() -> bool;

/// Shows a list of `items`, and returns the one chosen.
///
/// - `items` holds one item a line, any number ("" or NULL for none).
/// - The list is `rows` items tall, and as wide as its parent's room (at least the style's
///   button width).
/// - `selected` is the chosen item (-1 for none).
///
/// Choosing:
/// - A press and release on an item chooses it. A drag scrolls, choosing none.
/// - When focused, Up and Down (a pad's too) step, and held ones repeat. Page Up and Page Down
///   step a page. The chosen item is scrolled into view.
///
/// It scrolls as a scroll area does, down only. Only the items in view are laid out, so a long
/// list costs only its rows.
///
/// Its chosen item is activated (ask wgf_ui_is_activated after the call) by:
/// - Enter, Space, or a pad's south button, while the list is focused.
/// - A press and release on the item already chosen. On an item not yet chosen, that takes a
///   double press.
///
/// Returns `selected` as given (clamped to the items), or as the user chose this frame. Returns
/// `selected` as given when refused: no id, or `rows` below 1.
extern fn wgf_ui_list(id: const char*, items: const char*, selected: i32, rows: i32) -> i32;

/// Shows a text field: a line of text typed in, the text of a text buffer (wgf_text_buffer.h).
/// Returns true in the frame Enter is pressed in it.
///
/// Its text is the buffer's, held by libwgf, so it isn't given each frame: make the buffer
/// once, give it to the field each frame, and read or set it when the game wants.
/// - What is typed is written to the buffer as it is typed. Read it with
///   wgf_text_buffer_get_text, at Enter or any time.
/// - A text set on the buffer (or added, or loaded again) is shown at the field's next call,
///   its caret at the end and its undo forgotten.
/// - A buffer that isn't READY (loading, failed, released) shows "" and takes nothing typed.
/// - The field holds 4095 bytes of a line. A longer text in the buffer is cut, in the buffer
///   too, as is one longer than `max_length`.
///
/// The UI keeps the field's caret, selection, and undo by its id until the UI stops.
///
/// It is as wide as its parent's room, at least the style's button width.
///
/// Focused, it takes what is typed (wgf_input_get_chars) in place of the selection, and the
/// keys:
///
///   Left, Right         move the caret a character; with Ctrl (Alt on macOS) a word
///   Home, End           go to the start, the end (Cmd+Left and +Right on macOS too)
///   Shift with a move   extends the selection
///   Backspace, Delete   delete the selection, else the character before or after (a word with
///                       Ctrl or Alt), held ones repeating
///   Ctrl+A (Cmd on macOS)        selects all
///   Ctrl+C, +X, +V               copy, cut, and paste, through the system's clipboard
///                                (wgf_input_set_clipboard); newlines pasted are stripped
///   Ctrl+Z; Ctrl+Y, Ctrl+Shift+Z undo and redo, a run of typing or of deleting one step
///
/// The pointer and touch:
/// - A press places the caret. With Shift, it extends the selection to it.
/// - A drag selects.
/// - A double press selects the word under it, and a triple press the whole text.
/// - By touch, the same taps work.
///
/// Its caret blinks, and the text scrolls to keep it in view. Focus moved to it by keys or a
/// pad selects the whole text. A press off it lets the focus go.
///
/// While it is focused, the platform's on-screen keyboard is shown. That is a phone's, and on
/// the web, the page's hidden input that a phone's keyboard types into.
///
/// - `placeholder` (NULL or "" for none) is shown, dimmed, while the field is empty.
/// - It holds at most `max_length` characters (0 or less: 4095 bytes' worth). A longer text is
///   cut to it.
/// - A password field is the same, drawn as dots. Its words are the whole of it, and it is
///   never copied or cut.
///
/// Also returns false when refused (no id, or the text buffer 0).
extern fn wgf_ui_text_field(
    id: const char*,
    text: wgf_text_buffer_t,
    placeholder: const char*,
    max_length: i32
) -> bool;

extern fn wgf_ui_password_field(
    id: const char*,
    text: wgf_text_buffer_t,
    placeholder: const char*,
    max_length: i32
) -> bool;

/// Sets or gets whether the text fields given after it, until it is changed, show their text
/// as refused.
///
/// Whatever reads the text decides, as for a name already taken. An invalid field's text is
/// drawn in the style's invalid color, and outlined in it. Each UI begins with no field invalid.
/// Returns false with no UI begun.
extern fn wgf_ui_set_invalid(invalid: bool) -> bool;

extern fn wgf_ui_is_invalid() -> bool;

/// The popup layer: widgets drawn over every other widget, clipped by none, and placed by the
/// layer.
///
/// A dropdown shows the chosen one of `labels`, and returns the one chosen. `labels` holds one
/// label a line, up to 32.
/// - When activated, it opens a list of the labels over everything. The list hangs below it, or
///   above when the screen has no room below and more above. It is moved in to stay on the
///   screen.
/// - A press and release on a label chooses it.
/// - When focused, Up and Down (a pad's too) step through the labels. Enter, Space, or a pad's
///   south button chooses the one stepped to.
/// - It keeps every arrow while open.
/// - A press anywhere off it closes it, and does nothing else.
/// - Escape and a pad's east button close it. So does the dropdown losing the focus, being
///   disabled, or not being given in a frame.
/// - One dropdown is open at a time.
///
/// Returns `selected` as given (clamped to the labels), or as chosen this frame. Returns
/// `selected` as given when refused: no id, or no labels.
extern fn wgf_ui_dropdown(id: const char*, labels: const char*, selected: i32) -> i32;

/// Begins a modal, closed by wgf_ui_end_modal: a panel at the screen's center, such as
/// "Quit? Yes / No".
///
/// - Its layout, its skin, and its children are a panel's.
/// - It is drawn over the screen, dimmed in the style's dim color. Nothing under it answers the
///   pointer.
/// - While it is given, the focus moves among its own widgets alone. The focus is put on its
///   first widget when it opens.
/// - When it closes (is no longer given), the focus goes back to the widget that had it.
/// - A dropdown in it opens over it.
/// - There is one modal a frame.
///
/// Also returns false for no id, or a modal already open.
///
/// A modal is open while the game gives it, so the game closes it. wgf_ui_is_modal_cancelled
/// returns whether the player asked to: Escape or a pad's east button was pressed this frame,
/// with a modal begun and no dropdown open (the press closes the dropdown instead). Ask it
/// after wgf_ui_begin_modal, and stop giving the modal when it is true.
extern fn wgf_ui_begin_modal(id: const char*) -> bool;

extern fn wgf_ui_end_modal() -> bool;

extern fn wgf_ui_is_modal_cancelled() -> bool;

/// Shows `text` as a tooltip for the widget given just before it, a disabled one too.
///
/// - It shows once the pointer has rested on the widget half a second, or once the focus is
///   moved to it by keys or a pad.
/// - It is drawn in a box in the style's popup color, below the widget, or above when the screen
///   has no room below and more above. It is moved in to stay on the screen.
/// - The pointer passes through it, and a press hides it.
///
/// Also returns false for no text, or no widget given before it in the frame.
extern fn wgf_ui_tooltip(text: const char*) -> bool;

/// Sets or gets the whole UI's alpha (default: 1), kept until it is changed.
///
/// 0 is unseen, and 1 is as drawn. Use it to fade a menu in or out. The UI answers as ever: a
/// UI faded to nothing is still there until it isn't given.
///
/// The setter returns false for a value outside 0 to 1, or not finite. These two work outside a
/// begun UI too.
extern fn wgf_ui_set_alpha(alpha: f32) -> bool;

extern fn wgf_ui_get_alpha() -> f32;

/// Shows a progress bar for `value`, from 0 (empty) to 1 (full), such as how far a loading
/// screen's files have come (wgf_asset_task_get_progress).
///
/// - It fills from the left. The progress bar's fill direction is set with wgf_ui_set_fill.
///   Filling from the top or bottom, its bar width and height swap.
/// - It uses the style's bar width and height, its track and fill colors, and its corners.
/// - It only shows a value, so the pointer over it isn't the UI's.
/// - A value below 0 shows 0, above 1 shows 1, and NaN shows 0.
extern fn wgf_ui_progress(value: f32) -> bool;

/// Sets or gets the focused widget.
///
/// - set_focus gives the focus to the widget `id` (NULL or "" for none). It is drawn as a key
///   or pad would draw it. It returns false for an id of 64 bytes or more.
/// - get_focus returns the focused widget's id, or "" for none. The string is valid until the
///   focus changes.
///
/// These two work outside a begun UI too. Each frame a UI ends, the focus is published as the
/// text probe "ui.focus" (wgf_probe.h), so an autopilot can expect which widget has it.
extern fn wgf_ui_set_focus(id: const char*) -> bool;

extern fn wgf_ui_get_focus() -> const char*;

/// The style: your game's own colors, sizes in logical pixels, and font (0 for the default
/// font), kept until changed. wgf_ui_reset_style restores libwgf's.
extern wgf_ui_color_t;
extern let WGF_UI_COLOR_TEXT: wgf_ui_color_t;
extern let WGF_UI_COLOR_PANEL: wgf_ui_color_t;
extern let WGF_UI_COLOR_BUTTON: wgf_ui_color_t;
extern let WGF_UI_COLOR_BUTTON_HOVERED: wgf_ui_color_t;
extern let WGF_UI_COLOR_BUTTON_PRESSED: wgf_ui_color_t;
extern let WGF_UI_COLOR_BUTTON_TEXT: wgf_ui_color_t;
extern let WGF_UI_COLOR_FOCUS: wgf_ui_color_t;
extern let WGF_UI_COLOR_BAR: wgf_ui_color_t;
extern let WGF_UI_COLOR_BAR_FILL: wgf_ui_color_t;
extern let WGF_UI_COLOR_SEPARATOR: wgf_ui_color_t;
extern let WGF_UI_COLOR_HANDLE: wgf_ui_color_t;
extern let WGF_UI_COLOR_POPUP: wgf_ui_color_t;
extern let WGF_UI_COLOR_DIM: wgf_ui_color_t;
extern let WGF_UI_COLOR_INVALID: wgf_ui_color_t;
extern let WGF_UI_COLOR_SELECTION: wgf_ui_color_t;

extern wgf_ui_value_t;
extern let WGF_UI_VALUE_TEXT_SIZE: wgf_ui_value_t;
extern let WGF_UI_VALUE_PADDING: wgf_ui_value_t;
extern let WGF_UI_VALUE_GAP: wgf_ui_value_t;
extern let WGF_UI_VALUE_CORNER_RADIUS: wgf_ui_value_t;
extern let WGF_UI_VALUE_BUTTON_PADDING: wgf_ui_value_t;
extern let WGF_UI_VALUE_BUTTON_WIDTH: wgf_ui_value_t;
extern let WGF_UI_VALUE_FOCUS_WIDTH: wgf_ui_value_t;
extern let WGF_UI_VALUE_BAR_WIDTH: wgf_ui_value_t;
extern let WGF_UI_VALUE_BAR_HEIGHT: wgf_ui_value_t;
extern let WGF_UI_VALUE_CHECK_SIZE: wgf_ui_value_t;
extern let WGF_UI_VALUE_SLIDER_WIDTH: wgf_ui_value_t;
extern let WGF_UI_VALUE_SLIDER_HEIGHT: wgf_ui_value_t;
extern let WGF_UI_VALUE_HANDLE_SIZE: wgf_ui_value_t;
extern let WGF_UI_VALUE_LINE_WIDTH: wgf_ui_value_t;
extern let WGF_UI_VALUE_TILE_SIZE: wgf_ui_value_t;
extern let WGF_UI_VALUE_SCROLL_BAR: wgf_ui_value_t;
extern let WGF_UI_VALUE_SCROLL_BAR_ALWAYS: wgf_ui_value_t;

/// Sets or gets a style color or value. The setters return false for a color or value that
/// isn't one, or a value below 0. The getters return 0 for one that isn't one.
extern fn wgf_ui_set_style_color(which: wgf_ui_color_t, color: wgf_color_t) -> bool;

extern fn wgf_ui_get_style_color(which: wgf_ui_color_t) -> wgf_color_t;

extern fn wgf_ui_set_style_value(which: wgf_ui_value_t, value: f32) -> bool;

extern fn wgf_ui_get_style_value(which: wgf_ui_value_t) -> f32;

/// Sets or gets the style's font. Returns false for a handle that isn't a font (0 is allowed).
extern fn wgf_ui_set_style_font(font: wgf_font_t) -> bool;

extern fn wgf_ui_get_style_font() -> wgf_font_t;

extern fn wgf_ui_reset_style();

/// Skins: a widget's parts drawn from your game's art, in place of the style's colors.
///
/// A skin is a widget's part in a state:
/// - A texture's region. A source width or height of 0 or less takes the whole texture.
/// - Nine-sliced by its borders (wgf_draw_texture_nine_slice). Borders of 0 top and bottom
///   make a bar with caps at its ends. Borders of 0 left and right make one up and down.
/// - Multiplied by its tint (white until set).
///
/// A state with no skin of its own draws the normal state's skin, dimmed if disabled. A part
/// drawn from art has its art's corners, not the corner radius.
///
/// The parts each widget draws:
///
///   PANEL      base: its body
///   BUTTON     base: the button (an icon button's too)
///   TOGGLE     base: the toggle, PRESSED while on
///   CHECKBOX   base: the box; fill: the check, over the box
///   SLIDER     base: the track; fill: behind the handle; handle: the handle
///   PROGRESS   base: the track; fill: the progress; edge: at the fill's front
///   GROUP      base: its outline, in place of the line
///   TAB        base: each tab, PRESSED while chosen
///   COMBO      base: the combo
///   NUMBER     base: the box its value is in (its minus and plus are BUTTON's)
///   TILE       base: the tile
///   SCROLL     base: a scroll bar's track; handle: its thumb (a scroll area's, a list's)
///   LIST       base: its box; item: each item, PRESSED while chosen
///   DROPDOWN   base: the dropdown; item: each item of its open list, PRESSED while chosen,
///              HOVERED under the pointer or stepped to
///   POPUP      base: a dropdown's open list's box, a tooltip's box
///   TEXT       base: a text field's box, PRESSED while it is focused
///
/// A choice's toggles are TOGGLE's, each PRESSED while chosen. A modal's panel is PANEL's.
///
/// A fill is drawn one of two ways, from the left, right, top, or bottom (see wgf_ui_set_fill):
/// - Stretched over the filled part.
/// - Clipped: drawn over the whole track, and shown up to the value. A bar with round ends then
///   shows its far end only when full, like Godot's TextureProgressBar.
///
/// An edge is drawn at its art's size, centered on the fill's front. A widget's text (a
/// button's, a toggle's) moves by its state's text offset, so a face that sinks when pressed
/// takes its text with it.
///
/// The style holds a reference to each texture, and wgf_ui_reset_style lets them go.
///
/// The skin calls return false for a widget, part, or state that isn't one, a handle that isn't
/// a texture, or a value that isn't finite (or a border below 0).
extern wgf_ui_widget_t;
extern let WGF_UI_WIDGET_PANEL: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_BUTTON: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_TOGGLE: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_CHECKBOX: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_SLIDER: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_PROGRESS: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_GROUP: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_TAB: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_COMBO: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_NUMBER: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_TILE: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_SCROLL: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_LIST: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_DROPDOWN: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_POPUP: wgf_ui_widget_t;
extern let WGF_UI_WIDGET_TEXT: wgf_ui_widget_t;

extern wgf_ui_part_t;
extern let WGF_UI_PART_BASE: wgf_ui_part_t;
extern let WGF_UI_PART_FILL: wgf_ui_part_t;
extern let WGF_UI_PART_HANDLE: wgf_ui_part_t;
extern let WGF_UI_PART_EDGE: wgf_ui_part_t;
extern let WGF_UI_PART_ITEM: wgf_ui_part_t;

extern wgf_ui_state_t;
extern let WGF_UI_STATE_NORMAL: wgf_ui_state_t;
extern let WGF_UI_STATE_HOVERED: wgf_ui_state_t;
extern let WGF_UI_STATE_PRESSED: wgf_ui_state_t;
extern let WGF_UI_STATE_DISABLED: wgf_ui_state_t;

extern wgf_ui_fill_t;
extern let WGF_UI_FILL_STRETCHED: wgf_ui_fill_t;
extern let WGF_UI_FILL_CLIPPED: wgf_ui_fill_t;

extern wgf_ui_from_t;
extern let WGF_UI_FROM_LEFT: wgf_ui_from_t;
extern let WGF_UI_FROM_RIGHT: wgf_ui_from_t;
extern let WGF_UI_FROM_TOP: wgf_ui_from_t;
extern let WGF_UI_FROM_BOTTOM: wgf_ui_from_t;

/// How a skin's edges and middle fill the room between its corners.
///
/// - STRETCHED: stretched.
/// - TILED: its art repeated at its own size, an edge along its length and the middle both ways.
///   The last repeat is cut where the room ends. Use it for art that can't stretch, such as a
///   rope border or a brick panel.
/// - TILED_FIT: repeated a whole number of times, each repeat stretched the little it takes to
///   end on a whole one.
///
/// A part drawn smaller than its borders is stretched, whichever is set.
extern wgf_ui_patch_t;
extern let WGF_UI_PATCH_STRETCHED: wgf_ui_patch_t;
extern let WGF_UI_PATCH_TILED: wgf_ui_patch_t;
extern let WGF_UI_PATCH_TILED_FIT: wgf_ui_patch_t;

/// Sets or gets a skin: its texture, region, borders, and tint.
///
/// - set_skin with texture 0 draws the part in its colors again.
/// - get_skin returns its texture, or 0 for none.
/// - get_skin_source returns its region: x, y, z the width, and w the height.
/// - get_skin_borders returns its borders: x left, y top, z right, and w bottom.
/// - get_skin_tint returns its tint, or white for none.
extern fn wgf_ui_set_skin(
    widget: wgf_ui_widget_t,
    part: wgf_ui_part_t,
    state: wgf_ui_state_t,
    texture: wgf_texture_t,
    source_x: f32,
    source_y: f32,
    source_width: f32,
    source_height: f32
) -> bool;

extern fn wgf_ui_get_skin(widget: wgf_ui_widget_t, part: wgf_ui_part_t, state: wgf_ui_state_t) -> wgf_texture_t;

extern fn wgf_ui_get_skin_source(widget: wgf_ui_widget_t, part: wgf_ui_part_t, state: wgf_ui_state_t) -> wgf_vec4_t;

extern fn wgf_ui_set_skin_borders(
    widget: wgf_ui_widget_t,
    part: wgf_ui_part_t,
    state: wgf_ui_state_t,
    left: f32,
    top: f32,
    right: f32,
    bottom: f32
) -> bool;

extern fn wgf_ui_get_skin_borders(widget: wgf_ui_widget_t, part: wgf_ui_part_t, state: wgf_ui_state_t) -> wgf_vec4_t;

extern fn wgf_ui_set_skin_tint(
    widget: wgf_ui_widget_t,
    part: wgf_ui_part_t,
    state: wgf_ui_state_t,
    tint: wgf_color_t
) -> bool;

extern fn wgf_ui_get_skin_tint(widget: wgf_ui_widget_t, part: wgf_ui_part_t, state: wgf_ui_state_t) -> wgf_color_t;

/// Sets or gets how a skin's patches fill (default: STRETCHED). The setter also returns false
/// for a fill that isn't one.
extern fn wgf_ui_set_skin_patch(
    widget: wgf_ui_widget_t,
    part: wgf_ui_part_t,
    state: wgf_ui_state_t,
    patch: wgf_ui_patch_t
) -> bool;

extern fn wgf_ui_get_skin_patch(widget: wgf_ui_widget_t, part: wgf_ui_part_t, state: wgf_ui_state_t) -> wgf_ui_patch_t;

/// Sets or gets a widget's text offset in a state, in logical pixels (default: 0, 0).
extern fn wgf_ui_set_text_offset(widget: wgf_ui_widget_t, state: wgf_ui_state_t, x: f32, y: f32) -> bool;

extern fn wgf_ui_get_text_offset(widget: wgf_ui_widget_t, state: wgf_ui_state_t) -> wgf_vec2_t;

/// Sets or gets how a progress bar's or a slider's fill is drawn, and which end it fills from
/// (default: stretched, from the left). Returns false for a widget other than those two.
extern fn wgf_ui_set_fill(widget: wgf_ui_widget_t, fill: wgf_ui_fill_t, from: wgf_ui_from_t) -> bool;

extern fn wgf_ui_get_fill(widget: wgf_ui_widget_t) -> wgf_ui_fill_t;

extern fn wgf_ui_get_fill_from(widget: wgf_ui_widget_t) -> wgf_ui_from_t;

/// Sets or gets a part drawn from your game's art, by its color. It is a short form of
/// wgf_ui_set_skin for a part's base.
///
/// The part draws `texture` whole, nine-sliced by its borders, and untinted. 0 draws the color
/// again. The parts are:
/// - WGF_UI_COLOR_PANEL: the panel's base.
/// - WGF_UI_COLOR_BUTTON, _BUTTON_HOVERED, and _BUTTON_PRESSED: the button's base in those
///   states.
/// - WGF_UI_COLOR_BAR and _BAR_FILL: the progress bar's base and fill.
///
/// Returns false for a part that isn't one of these, a handle that isn't a texture, or a border
/// below 0 or not finite.
extern fn wgf_ui_set_style_texture(
    which: wgf_ui_color_t,
    texture: wgf_texture_t,
    left: f32,
    top: f32,
    right: f32,
    bottom: f32
) -> bool;

extern fn wgf_ui_get_style_texture(which: wgf_ui_color_t) -> wgf_texture_t;

/// Sets or gets the font that RCSS's `font-family: <family>` means in every document.
///
/// The family's name is matched without case. 0 unsets it, so the family draws in the default
/// font. The UI holds a reference to `font`. Returns false for no family, or a handle that
/// isn't a font.
extern fn wgf_ui_set_document_font(family: const char*, font: wgf_font_t) -> bool;

extern fn wgf_ui_get_document_font(family: const char*) -> wgf_font_t;

/// Sets or gets one of a family's own faces.
///
/// A face is the font that `font-family: <family>` draws in at `font-weight: <weight>`, and, if
/// `italic`, at `font-style: italic`. `weight` is 1 to 1000: 400 is normal, and 700 bold.
///
/// Text draws in the family's face nearest the one it asks for:
/// - A face of its style, when the family has one of that style. Otherwise, one of the other
///   style.
/// - The nearest weight. A tie goes to the heavier above 400, and to the lighter at or below.
/// - The family's font (wgf_ui_set_document_font) is its face at 400, upright.
///
/// A face no font is set for is never made up: no bold is drawn from a regular. 0 unsets a
/// face. The UI holds a reference to `font`.
///
/// Returns false for no family, a weight outside 1 to 1000, or a handle that isn't a font.
extern fn wgf_ui_set_document_font_face(family: const char*, weight: i32, italic: bool, font: wgf_font_t) -> bool;

extern fn wgf_ui_get_document_font_face(family: const char*, weight: i32, italic: bool) -> wgf_font_t;

/// Works, lays out, and draws the shown documents, here in the frame callback.
///
/// The documents are worked by this frame's input, and drawn over what was drawn before. Their
/// events are raised as they are worked. Call it once a frame: a second call in a frame draws
/// them again, without the input.
///
/// Returns false outside a frame (logged), or before any document was created.
extern fn wgf_ui_draw_documents() -> bool;

// ---- wgf_app.h ----

/// Opens the window and runs the program until it quits, calling:
///
///   init      once, when the window is open and core and gfx have started
///   tick      0 or more times before each frame, at the fixed tick rate
///             (wgf_loop_set_tick_rate). For simulation, with a step of
///             wgf_loop_get_tick_delta seconds. Never draw here
///   frame     once per displayed frame. For drawing, and whatever runs at the frame
///             rate (wgf_loop_get_frame_delta)
///   shutdown  once, as the program quits, before gfx and core stop
///
/// Any of them may be NULL.
///
/// Each frame, app does these in order:
/// - Takes the window's events.
/// - Updates core, so tasks and loads move on.
/// - Runs the ticks that are due.
/// - Runs the frame between gfx's begin and end, and presents it.
///
/// Input read in a tick sees what changed since the previous tick. Input read in a frame
/// sees what changed since the previous frame.
///
/// Make this the last call in main. Put everything after the program's start in init, and
/// everything before its end in shutdown. On the desktop it returns when the program has
/// quit, but on the web it returns at once and the browser runs the frames.
///
/// Returns false, doing nothing, if the program is already running.
///
/// This is the one public call that takes callbacks, since the window system owns the
/// loop.
extern fn wgf_app_run(
    init: wgf_app_callback_t,
    tick: wgf_app_callback_t,
    frame: wgf_app_callback_t,
    shutdown: wgf_app_callback_t,
    user: void*
) -> bool;

/// Lets an autopilot fly this run, or returns whether that is enabled. Call it before
/// wgf_app_run, as a build that is tested or checked does.
///
/// - Natively the autopilot is the file LIBWGF_AUTOPILOT names.
/// - On the web it is the one the page gives the module.
/// - See BUILDING.md, "Autopilot files".
///
/// This call is what links the autopilot's runner. A program that never calls it, such as
/// a game's web export by default, carries none of it. Given an autopilot all the same, such
/// a program logs that it has no runner and quits.
///
/// Returns false once the program is running.
extern fn wgf_app_enable_autopilot() -> bool;

extern fn wgf_app_is_autopilot_enabled() -> bool;

/// Asks the program to quit. The frame under way finishes, then shutdown runs.
extern fn wgf_app_quit();

/// Returns whether quitting means anything on this platform.
///
/// Returns false on the web, where the page stays when the program would end, and the
/// browser owns Escape. Offer a quit key or button only where this is true.
extern fn wgf_app_can_quit() -> bool;

/// Returns whether the program is running: from wgf_app_run starting it until shutdown
/// finishes.
extern fn wgf_app_is_running() -> bool;

/// Reads the program's options by name, the same way on both platforms.
///
/// - Natively an option is `--name=value`, or `--name`, among the program's arguments.
/// - On the web it is `name=value`, or `name`, in the page's address after the `?`. For
///   example, Wardens' `enemies=200`, or a benchmark's `count=10000`.
/// - If a name is given more than once, the last one wins.
///
/// The calls:
/// - has_option returns whether the option was given.
/// - get_option returns its value, valid for the program's life. It returns "" for an
///   option given without a value, or not given.
/// - get_option_int and get_option_float return the value as a number. They return
///   `otherwise` if the option wasn't given or isn't a number.
///
/// For a NULL `name` they return false, "", or `otherwise`.
extern fn wgf_app_has_option(name: const char*) -> bool;

extern fn wgf_app_get_option(name: const char*) -> const char*;

extern fn wgf_app_get_option_int(name: const char*, otherwise: i32) -> i32;

extern fn wgf_app_get_option_float(name: const char*, otherwise: f32) -> f32;

// ---- wgf_debug.h ----

/// Shows, hides, or reports the frame-rate overlay, for a program under development.
///
/// The overlay reads "<fps> FPS <cost> ms": the frames a second, and a frame's own cost
/// (see wgf_loop.h). The runtime draws it every frame, over everything the program drew.
///
/// - (x, y) is its position, in logical pixels.
/// - `font` is the font to draw it in. 0 is the built-in font.
/// - `size` is its size. A size of 0 or less draws nothing, so it isn't shown.
/// - `color` is its color.
///
/// It is off by default. Showing it again moves or restyles it. A program that never shows
/// it links none of it.
extern fn wgf_debug_show_fps(font: wgf_font_t, x: f32, y: f32, size: f32, color: wgf_color_t);

extern fn wgf_debug_hide_fps();

extern fn wgf_debug_is_fps_shown() -> bool;

/// The frame stats you can read.
///
/// - Each frame is counted as its drawing ends.
/// - A frame's time runs from the previous frame's end. It is real time, whatever the time
///   scale, and under an autopilot too.
/// - A frame's cost is wgf_loop_get_frame_cost's.
/// - Times and costs are in seconds.
/// - A percentile is the least of the slowest share: P95 is the least of the slowest 5%. So
///   a single slow frame in twenty shows.
/// - Every stat is 0 when there are no frames.
extern wgf_frame_stat_t;
extern let WGF_FRAME_STAT_FRAMES: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_FPS: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_TIME_MEAN: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_TIME_MEDIAN: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_TIME_P95: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_TIME_P99: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_TIME_SLOWEST: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_COST_MEAN: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_COST_P95: wgf_frame_stat_t;
extern let WGF_FRAME_STAT_COST_SLOWEST: wgf_frame_stat_t;

/// Returns a stat of the frames in the last half second.
///
/// Frames are counted from the first call of this or wgf_debug_start_frame_recording. So
/// the first call returns 0, and later ones cover the frames since then, up to the last half
/// second. A program that never asks counts no frames.
///
/// Returns 0 for a value of `stat` that isn't a stat.
extern fn wgf_debug_get_frame_stat(stat: wgf_frame_stat_t) -> f32;

/// Starts, stops, or reports a recording of frame stats.
///
/// - A recording runs from the next frame's end until it is stopped. It keeps its latest
///   65,536 frames.
/// - Starting again drops what the recording held.
/// - Once stopped, its stats are kept for reading (wgf_debug_get_recorded_frame_stat) until
///   the next start.
/// - Stop returns false, and keeps nothing, if no recording was started.
/// - Recording doesn't change the stats of the last half second.
extern fn wgf_debug_start_frame_recording();

extern fn wgf_debug_stop_frame_recording() -> bool;

extern fn wgf_debug_is_frame_recording() -> bool;

/// Returns a stat of the stopped recording's frames. Returns 0 while a recording runs, or if
/// there is none.
extern fn wgf_debug_get_recorded_frame_stat(stat: wgf_frame_stat_t) -> f32;

/// Copies the stopped recording's frame times, or their costs if `costs` is true, into `out`,
/// oldest first. Writes at most `count`, and returns the number written.
extern fn wgf_debug_get_recorded_frame_times(out: f32*, count: i32, costs: bool) -> i32;

// ---- wgf_loop.h ----

/// Returns the seconds since the previous frame, at most 0.1.
///
/// - A frame after a stall counts as 0.1 seconds.
/// - The first frame counts as one display frame.
/// - It is real time: the time scale doesn't change it.
extern fn wgf_loop_get_frame_delta() -> f32;

/// Sets or gets the tick rate, in ticks a second (default: 60). 0 or less turns ticks off.
/// A new rate takes effect at the next frame, and time not yet ticked is dropped.
extern fn wgf_loop_set_tick_rate(hz: i32);

extern fn wgf_loop_get_tick_rate() -> i32;

/// Returns the seconds one tick steps the simulation: 1 / the tick rate. Returns 0 with
/// ticks off.
extern fn wgf_loop_get_tick_delta() -> f32;

/// Returns how far the loop is into the next tick, from 0 up to 1.
///
/// Use it to draw ticked state smoothly: lerp(previous tick's value, latest, fraction). It
/// holds still while the time scale is 0. Returns 0 with ticks off.
extern fn wgf_loop_get_tick_fraction() -> f32;

/// Sets or gets how fast ticks run against real time (default: 1). A scale below 0 is
/// clamped to 0.
///
/// - 1 is normal speed.
/// - 0.5 is slow motion.
/// - 0 is paused: no ticks run, while frames still draw and read input.
extern fn wgf_loop_set_time_scale(scale: f32);

extern fn wgf_loop_get_time_scale() -> f32;

/// Sets or gets whether ticks stop while the window, or the page, isn't focused (default:
/// off). The game pauses when the player looks away, and frames still draw. A run that an
/// autopilot flies or records isn't held.
extern fn wgf_loop_set_pause_unfocused(pause: bool);

extern fn wgf_loop_is_pause_unfocused() -> bool;

/// Sets or gets the most frames a second, to save power or heat. 0 or less is the
/// display's rate (default: 0).
///
/// With vsync on, a cap can only lower the rate. On the web, a frame the browser offers too
/// early is skipped.
extern fn wgf_loop_set_target_fps(fps: i32);

extern fn wgf_loop_get_target_fps() -> i32;

/// Returns the frames per second, from a moving average of the frame deltas. It counts the
/// frames that ran, not the display's refreshes. Returns 0 before the first frame.
extern fn wgf_loop_get_fps() -> f32;

/// Returns the last frame's own cost, in seconds: the real time the runtime spent on it.
///
/// The cost runs from the frame's start to its drawing's end. It covers the ticks, the
/// optional parts, the frame callback, and gfx's end. What the GPU and the browser do after
/// that isn't in it.
///
/// It is real time under an autopilot too, though the autopilot sets the frames' time. So a
/// flown run's cost is measured as it would be played. Returns 0 before the first frame.
extern fn wgf_loop_get_frame_cost() -> f32;

// ---- wgf_replay.h ----

/// Starts recording, from the next frame.
///
/// Each input that reaches the program is written at the frame it reached it, counting
/// frames from 0. The pointer is written first, where it is. A recording starts with
/// nothing held, so a key that is down as it starts is not in it.
///
/// Returns false while recording, or while a replay plays or is paused.
extern fn wgf_replay_start_recording() -> bool;

/// Stops recording, writing an `end` at its last frame. Returns false if not recording.
extern fn wgf_replay_stop_recording() -> bool;

/// Returns whether it is recording.
extern fn wgf_replay_is_recording() -> bool;

/// Returns the recording as an autopilot's text: so far, while recording. Returns "" if there
/// is none. Valid until the next start or clear.
extern fn wgf_replay_get_recording() -> const char*;

/// Returns the number of frames recorded: so far, while recording. Returns 0 if there is
/// none.
extern fn wgf_replay_get_recording_frame_count() -> i32;

/// Clears the recording, stopping it first if it is recording.
extern fn wgf_replay_clear_recording();

/// Plays `text`, an autopilot such as a recording, as a replay from the next frame.
///
/// - Each frame of the program's plays one frame of the replay.
/// - It plays in place of whatever is playing.
/// - Only its inputs are played. An autopilot's seed, expectations, waits, logs,
///   screenshots, and dumps belong to an autopilot run, so a replay passes over them.
/// - It lasts until its `end`, or without one, until its last line's frame. Then it is
///   COMPLETE.
///
/// While it plays, and while it is paused, the program's input is the replay's alone:
/// - Real input, from the window or an autopilot run, is held back and never reaches an
///   input call.
/// - Every gamepad is the replay's. A gamepad is disconnected unless the replay connects it.
/// - wgf_replay_has_real_press tells whether a real key, mouse button, finger, or pad button
///   was pressed meanwhile, so an attract mode can end on one.
///
/// Everything held is released as a replay starts, and as it ends (stopped or complete). So
/// it starts from nothing held and leaves nothing held, and the releases are that frame's
/// edges. While paused, it keeps held what it holds.
///
/// Its state is a wgf_play_state_t, with play, pause, resume, and stop as wgf_play_state.h
/// says.
///
/// Returns false while recording. It also returns false for text that isn't an autopilot,
/// logging each bad line, and leaves whatever plays still playing.
extern fn wgf_replay_play(text: const char*) -> bool;

/// Pauses the replay. Returns false unless it is PLAYING.
extern fn wgf_replay_pause() -> bool;

/// Resumes the replay. Returns false unless it is PAUSED.
extern fn wgf_replay_resume() -> bool;

/// Stops the replay, releasing its input with it. Returns false if it is STOPPED.
extern fn wgf_replay_stop() -> bool;

/// Returns the replay's state: STOPPED when none plays.
extern fn wgf_replay_get_state() -> wgf_play_state_t;

/// Returns how many of the replay's frames have played so far.
///
/// It is 0 before the first, and the replay's frame count once COMPLETE. Returns 0 when
/// STOPPED.
extern fn wgf_replay_get_frame() -> i32;

/// Returns the replay's length in frames, through its end. Returns 0 when STOPPED.
extern fn wgf_replay_get_frame_count() -> i32;

/// Returns whether the real input a replay holds back pressed a key, a mouse button, a
/// finger, or a pad button this frame.
///
/// It covers the presses since the previous frame, and reads the same through the whole
/// frame and its ticks. Returns false while nothing plays.
extern fn wgf_replay_has_real_press() -> bool;
