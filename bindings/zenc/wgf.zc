// ---- wgf_fs.h ----

extern wgf_fs_task_status_t;
extern let WGF_FS_TASK_STATUS_NONE: wgf_fs_task_status_t;
extern let WGF_FS_TASK_STATUS_PENDING: wgf_fs_task_status_t;
extern let WGF_FS_TASK_STATUS_DONE: wgf_fs_task_status_t;
extern let WGF_FS_TASK_STATUS_NOT_FOUND: wgf_fs_task_status_t;
extern let WGF_FS_TASK_STATUS_FAILED: wgf_fs_task_status_t;

/// Sets or gets the root that paths resolve against.
///
/// - Natively the root is a directory, absolute or relative to the working directory. The
///   default is the program's own directory, where its executable is. Where that can't be
///   told, the default is the working directory.
/// - On the web the default is "/wgf". Another root is another browser store, and requests
///   wait while it opens.
///
/// The setter returns false if core isn't running.
extern fn wgf_fs_set_root(root: const char*) -> bool;

extern fn wgf_fs_get_root() -> const char*;

/// Requests. Each one returns a task.
///
/// Returns 0 if core isn't running, if `path` breaks the rules above or is too long, if
/// `data` is NULL with a size, or if memory runs out.
extern fn wgf_fs_read(path: const char*) -> wgf_fs_task_t;

/// Writes `data` to `path`, making the parent directories.
///
/// `data` is copied before the call returns. The task is DONE once the file is written, so
/// a read of the path then gives the new bytes. On the web, the copy kept between visits is
/// stored in the background after that.
extern fn wgf_fs_write(path: const char*, data: const u8*, size: i32) -> wgf_fs_task_t;

extern fn wgf_fs_exists(path: const char*) -> wgf_fs_task_t;

extern fn wgf_fs_remove(path: const char*) -> wgf_fs_task_t;

/// Makes a directory and its parents.
///
/// The task is DONE if the directory exists afterwards, so an existing directory is DONE.
/// Otherwise it is FAILED.
extern fn wgf_fs_mkdir(path: const char*) -> wgf_fs_task_t;

/// Removes a directory and everything in it.
///
/// - DONE once it is removed.
/// - NOT_FOUND if there is no such directory. A link to a directory isn't one: remove the
///   link instead.
/// - FAILED if a file or directory in it couldn't be removed.
extern fn wgf_fs_rmdir(path: const char*) -> wgf_fs_task_t;

/// Lists what a directory holds.
///
/// When DONE, the task's text holds the names, sorted, one a line. A directory's name has
/// a slash after it: "levels/\nsave.json\n". An empty directory gives "". On the web the
/// list also includes the files kept only in the browser's store.
///
/// The task is NOT_FOUND if there is no such directory.
extern fn wgf_fs_list(path: const char*) -> wgf_fs_task_t;

extern wgf_fs_write_text;

/// Reads a task. A getter returns NONE, "", NULL, or 0 for a handle that isn't a task.
extern fn wgf_fs_task_get_status(task: wgf_fs_task_t) -> wgf_fs_task_status_t;

extern fn wgf_fs_task_get_path(task: wgf_fs_task_t) -> const char*;

/// Returns a DONE read's bytes, or a list's text, and their size.
///
/// The bytes end in a NUL, so they also read as text. They are valid until the task is
/// destroyed. Any other task gives NULL, 0, and "".
extern fn wgf_fs_task_get_data(task: wgf_fs_task_t) -> const u8*;

extern fn wgf_fs_task_get_size(task: wgf_fs_task_t) -> i32;

extern fn wgf_fs_task_get_text(task: wgf_fs_task_t) -> const char*;

/// Destroys a task. Returns false for a handle that isn't a task.
extern fn wgf_fs_task_destroy(task: wgf_fs_task_t) -> bool;

// ---- wgf_handle.h ----

/// Returns the kind of `handle` as "<layer>.<type>", such as "gfx.texture".
///
/// The kind is read from the handle alone, so a handle whose object or resource was already
/// destroyed still names its kind. Returns "" for 0, or for a number that no kind has.
extern fn wgf_handle_get_kind_name(handle: wgf_handle_t) -> const char*;

/// Returns whether `handle` refers to an object or a resource that is still alive.
///
/// Returns false for:
/// - 0, or a number that no kind has.
/// - A handle that was destroyed or released.
/// - A resource whose last reference was released.
///
/// Ask this first wherever a handle may be dead, such as the other side of a trigger or an
/// actor kept across frames. Every other call refuses a dead handle, returning false, 0, or
/// nothing. In a debug build it also warns, naming the call and the handle. Each call
/// warns only the first time.
extern fn wgf_handle_is_alive(handle: wgf_handle_t) -> bool;

// ---- wgf_identity.h ----

/// Sets or gets the program's identity: its company and product names.
///
/// On the desktop, the identity names the program's own directories:
/// - Its saved files ("user:" paths, wgf_fs.h) go under <the user's data>/<company>/<product>.
/// - Its downloaded assets (wgf_asset.h) go under <the user's cache>/<company>/<product>.
/// - The company is "DefaultCompany" until set, so that no unset name looks like anyone's.
/// - The product is the executable's name without its extension. Where that can't be
///   told, it is "DefaultApp".
///
/// Set both for anything you ship. Two programs left with the defaults and the same name
/// share a cache, and renaming the executable would leave its cache behind. Set them before
/// libwgf keeps any files.
///
/// Each name is made safe as one path component:
/// - Separators, and the characters Windows refuses, become "_".
/// - Leading and trailing dots and spaces are removed.
/// - A Windows device name, such as "CON", gets a "_" in front.
///
/// NULL or "" puts the default back. A setter returns false, and keeps the last name, if
/// nothing is left of the name after that, or if it is 128 bytes or more. A long name is
/// refused, never cut short.
///
/// On the web nothing is kept by these names, since the browser keeps each site's files
/// apart itself.
extern fn wgf_identity_set_company(company: const char*) -> bool;

extern fn wgf_identity_get_company() -> const char*;

extern fn wgf_identity_set_product(name: const char*) -> bool;

extern fn wgf_identity_get_product() -> const char*;

// ---- wgf_log.h ----
extern let WGF_LOG_FORMAT_MAX: i32;

/// Logging to stderr, or to the browser console on the web.
///
/// A message below the current level is dropped. The level starts at INFO. Text is UTF-8.
///
/// The exported calls take finished text, so a binding formats in its own language and
/// passes one string. C code formats with the wgf_log_<level> macros, such as wgf_log_debug,
/// from wgf_log.h.
extern wgf_log_level_t;
extern let WGF_LOG_LEVEL_TRACE: wgf_log_level_t;
extern let WGF_LOG_LEVEL_DEBUG: wgf_log_level_t;
extern let WGF_LOG_LEVEL_INFO: wgf_log_level_t;
extern let WGF_LOG_LEVEL_WARN: wgf_log_level_t;
extern let WGF_LOG_LEVEL_ERROR: wgf_log_level_t;
extern let WGF_LOG_LEVEL_FATAL: wgf_log_level_t;

extern fn wgf_log_set_level(level: wgf_log_level_t);

extern fn wgf_log_get_level() -> wgf_log_level_t;

/// Keeps the last lines logged for the program to read, such as for a game's console or a
/// bug report.
///
/// - set_history keeps the last `count` lines, at most 1024 (default: 0, none). It forgets
///   the lines already kept. It returns false for a count outside 0 to 1024.
/// - get_history_line returns a line as the console shows it, without its level, such as
///   "file.c:12: text" (255 bytes at most). Index 0 is the oldest.
/// - get_history_level returns that line's level.
/// - For an index outside the lines kept, they return "" and TRACE.
///
/// A line read is a copy, valid until the next read. Lines below the level aren't kept,
/// just as they aren't shown.
extern fn wgf_log_set_history(count: i32) -> bool;

extern fn wgf_log_get_history() -> i32;

extern fn wgf_log_get_history_count() -> i32;

extern fn wgf_log_get_history_line(index: i32) -> const char*;

extern fn wgf_log_get_history_level(index: i32) -> wgf_log_level_t;

extern fn wgf_log_clear_history();

/// Logs one message.
extern fn wgf_log_message(level: wgf_log_level_t, text: const char*);

/// Logs one message with the file and line it came from.
extern fn wgf_log_message_source(level: wgf_log_level_t, file: const char*, line: i32, text: const char*);

extern wgf_log_format;

/// C's macro wgf_log_trace(...), as the header defines it.
extern wgf_log_trace;

/// C's macro wgf_log_debug(...), as the header defines it.
extern wgf_log_debug;

/// C's macro wgf_log_info(...), as the header defines it.
extern wgf_log_info;

/// C's macro wgf_log_warn(...), as the header defines it.
extern wgf_log_warn;

/// C's macro wgf_log_error(...), as the header defines it.
extern wgf_log_error;

/// C's macro wgf_log_fatal(...), as the header defines it.
extern wgf_log_fatal;

// ---- wgf_play_state.h ----

/// The state of whatever plays over time: for now, an audio voice and a model's animation.
/// See docs/CONVENTIONS.md, "What plays over time has one state and four calls".
///
/// Each of these has play, pause, resume, and stop, with the same transitions:
///
///   play     to PLAYING from the start, from any state. COMPLETE is included: that is
///            how a one-shot plays again
///   pause    from PLAYING only, to PAUSED, held where it was
///   resume   from PAUSED only, back to PLAYING
///   stop     to STOPPED, rewound to the start, from any state
///
/// Each returns false where it doesn't apply, and its header names those cases.
///
/// - A speed or pitch of 0 holds where it is, still PLAYING. That is not a pause.
/// - A negative speed or pitch runs backwards: play starts at the end, and COMPLETE comes
///   at the start.
/// - The state changes only in an update, as a resource's status does (wgf_resource.h).
extern wgf_play_state_t;
extern let WGF_PLAY_STATE_STOPPED: wgf_play_state_t;
extern let WGF_PLAY_STATE_PLAYING: wgf_play_state_t;
extern let WGF_PLAY_STATE_PAUSED: wgf_play_state_t;
extern let WGF_PLAY_STATE_COMPLETE: wgf_play_state_t;

// ---- wgf_probe.h ----

/// Sets probe `name` to the number `value`, adding the probe the first time.
///
/// Returns false, and sets nothing, if `name` breaks the rules above, if `value` isn't
/// finite, if it would be a 257th probe, or if core isn't running.
extern fn wgf_probe_set_value(name: const char*, value: f64) -> bool;

/// Returns the number of probe `name`, or 0 for a probe never set. wgf_probe_has_value tells
/// those apart.
extern fn wgf_probe_get_value(name: const char*) -> f64;

/// Returns whether probe `name` has been set since core started, as a number or as text.
extern fn wgf_probe_has_value(name: const char*) -> bool;

/// Sets or gets probe `name` as text (UTF-8, at most 255 bytes).
///
/// set_text adds the probe the first time. From then on the probe is text, and its number
/// is 0, until a number is set again. It returns false, and sets nothing, if:
/// - `name` breaks the rules above.
/// - `text` is NULL or longer than 255 bytes.
/// - It would be a 257th probe.
/// - Core isn't running, or memory runs out.
///
/// get_text returns the probe's text, borrowed until the probe next changes. It returns ""
/// for a probe that is a number or was never set.
extern fn wgf_probe_set_text(name: const char*, text: const char*) -> bool;

extern fn wgf_probe_get_text(name: const char*) -> const char*;

/// Returns how many probes there are, and each one's name, in the order they were first set.
///
/// A name is borrowed, valid until core stops. get_name returns "" for an index out of
/// range.
extern fn wgf_probe_get_count() -> i32;

extern fn wgf_probe_get_name(index: i32) -> const char*;

// ---- wgf_random.h ----

/// Starts the sequence again from `seed`. A seed's sequence is the same everywhere.
extern fn wgf_random_set_seed(seed: i32);

/// Returns the seed the sequence last started from.
extern fn wgf_random_get_seed() -> i32;

/// Returns the next number, from 0 up to but not including 1.
extern fn wgf_random_get_float() -> f32;

/// Returns the next number from `min` up to but not including `max`.
///
/// Returns `min` if they are equal. If `max` is less than `min`, they are swapped.
extern fn wgf_random_get_range(min: f32, max: f32) -> f32;

/// Returns the next whole number from `min` to `max`, both included, each equally likely.
/// If `max` is less than `min`, they are swapped.
extern fn wgf_random_get_int(min: i32, max: i32) -> i32;

/// Shuffles the `count` numbers in `values` into a random order, each order equally likely,
/// such as for a deck of cards or a bag of pieces. Returns how many were shuffled.
extern fn wgf_random_shuffle(values: i32*, count: i32) -> i32;

/// Creates a generator of the game's own, seeded with `seed`, and destroys one.
///
/// Use one where a part of the game should draw its own numbers, such as a world's layout.
/// Then the program's sequence, which an autopilot seeds, stays the game's. A generator
/// takes the same steps as the program's, so a seed gives the same numbers everywhere.
///
/// Returns 0 if there are already 4096 generators.
extern fn wgf_random_create(seed: i32) -> wgf_generator_t;

extern fn wgf_random_destroy(generator: wgf_generator_t);

/// Sets or gets a generator's seed. The setter starts its sequence again from `seed`, and
/// the getter returns the seed it last started from. They return false (or 0) for a handle
/// that isn't a generator.
extern fn wgf_random_set_generator_seed(generator: wgf_generator_t, seed: i32) -> bool;

extern fn wgf_random_get_generator_seed(generator: wgf_generator_t) -> i32;

/// Returns a generator's next numbers, as the program's calls above do, and shuffles as
/// wgf_random_shuffle does. Each returns 0 for a handle that isn't a generator.
extern fn wgf_random_next_float(generator: wgf_generator_t) -> f32;

extern fn wgf_random_next_range(generator: wgf_generator_t, min: f32, max: f32) -> f32;

extern fn wgf_random_next_int(generator: wgf_generator_t, min: i32, max: i32) -> i32;

extern fn wgf_random_next_shuffle(generator: wgf_generator_t, values: i32*, count: i32) -> i32;

// ---- wgf_resource.h ----

/// Resources: the shared, reference-counted data that objects use, such as a texture, mesh,
/// material, font, environment, or shader.
///
/// This header holds what every resource has in common. Each kind's own calls are in its
/// own header (wgf_texture.h, and so on). See docs/ARCHITECTURE.md, "Resources and
/// objects".
///
/// A resource loads when it is created:
/// - wgf_<kind>_create(path) takes a path under fs's root, and returns the handle at once,
///   PENDING.
/// - A worker prepares the file, and the main thread finishes it. The handle turns READY
///   or FAILED in a later update. Nothing is called back.
/// - Creating the same path again gives the same handle, with one more reference, whatever
///   its status.
/// - Releasing the last reference of a resource that is still loading stops the load.
/// - A resource made from numbers alone, such as a generated mesh or a material, is READY
///   from the start.
///
/// An object, such as an actor or a voice, takes a resource in any status. Until the
/// resource is READY it draws or plays a stand-in, or nothing, as each kind's header says. So a
/// program can create everything at once and never wait. The status is for what a program
/// wants to show, such as a loading screen.
extern wgf_resource_status_t;
extern let WGF_RESOURCE_STATUS_NONE: wgf_resource_status_t;
extern let WGF_RESOURCE_STATUS_PENDING: wgf_resource_status_t;
extern let WGF_RESOURCE_STATUS_READY: wgf_resource_status_t;
extern let WGF_RESOURCE_STATUS_FAILED: wgf_resource_status_t;

/// Returns a resource's status: PENDING, READY, or FAILED, for a resource of any kind.
/// Returns NONE for a handle that isn't a resource.
extern fn wgf_resource_get_status(resource: wgf_handle_t) -> wgf_resource_status_t;

/// Returns the file a resource was read from, as a path under fs's root.
///
/// For "name.ktx" it is the variant this GPU got, or the PNG. The path is borrowed, valid
/// while the resource is. Returns "" until the resource is READY, for a resource made from
/// numbers, and for a handle that isn't a resource.
extern fn wgf_resource_get_path(resource: wgf_handle_t) -> const char*;

/// Releases this handle's reference to a resource.
///
/// Resources are shared and reference counted, so a resource is freed when its last
/// reference is released, not when this is called. A resource still loading then stops
/// loading. A built-in resource, such as the placeholder texture, is never freed.
///
/// Objects, and resources such as a material, hold their own references. So handing a
/// resource to an object and releasing it right away is the normal pattern.
///
/// Returns false for a handle that isn't a resource: 0, an object, or a resource already
/// freed.
extern fn wgf_resource_release(resource: wgf_handle_t) -> bool;

/// Sets or gets the load budget: the milliseconds each frame may spend on loading, so that
/// loading doesn't stall the frames it runs beside (default: 4).
///
/// - The budget covers finishing loads on the main thread, such as GPU uploads.
/// - On the web, where there are no worker threads, it also covers preparing the
///   resources that prepare in steps, such as an environment.
/// - At least one step runs each frame, however small the budget. So one large file can
///   exceed it: a 4096x4096 texture is one upload of about 45 ms.
/// - 0 finishes one step a frame.
/// - It applies to every load, whether the file is bundled, cached, or fetched.
///
/// The smaller the budget, the longer loading takes, and more so where frames are slow. A
/// loading screen, with nothing else to draw, can raise it (to 16 ms, say) and set it back
/// once loaded. A measurement of every frame of a run, such as tools/bench/measure_frames.py,
/// counts those as slow frames too.
///
/// The setter returns false, and changes nothing, for a negative or non-finite value.
extern fn wgf_resource_set_load_budget(milliseconds: f32) -> bool;

extern fn wgf_resource_get_load_budget() -> f32;

// ---- wgf_time.h ----

/// Returns the seconds since the runtime started.
///
/// The clock is monotonic: it never goes back, and changes to the wall clock don't move it.
/// Returns 0 if core isn't running.
extern fn wgf_time_get_seconds() -> f64;

// ---- wgf_action.h ----

/// Adds a binding to `action`, making the action with its first binding.
///
/// Returns false for any of these:
/// - a name that breaks the rule above
/// - a 65th action, or a 17th binding
/// - a key, button, or axis that isn't one
/// - a direction that isn't -1, 0, or 1
/// - a threshold outside 0 to 1
/// - a region with no area
extern fn wgf_action_bind_key(action: const char*, key: wgf_keyboard_key_t) -> bool;

extern fn wgf_action_bind_keys(
    action: const char*,
    negative: wgf_keyboard_key_t,
    positive: wgf_keyboard_key_t
) -> bool;

extern fn wgf_action_bind_pad_button(action: const char*, button: wgf_gamepad_button_t) -> bool;

extern fn wgf_action_bind_pad_buttons(
    action: const char*,
    negative: wgf_gamepad_button_t,
    positive: wgf_gamepad_button_t
) -> bool;

extern fn wgf_action_bind_pad_axis(
    action: const char*,
    axis: wgf_gamepad_axis_t,
    direction: i32,
    threshold: f32
) -> bool;

extern fn wgf_action_bind_touch(action: const char*, x: f32, y: f32, width: f32, height: f32) -> bool;

/// Binds an on-screen stick to `action_x` (across) and `action_y` (up).
///
/// A finger landing in the region (logical pixels) makes a stick where it landed. Its pull, up
/// to `radius` away, is read as `action_x` and `action_y`, each -1 to 1 and held within the
/// circle. That is how a pad's left stick bound to them reads. The stick ends when the finger
/// lifts.
///
/// - At most 4 sticks are bound at once.
/// - A stick whose actions are cleared (wgf_action_clear) is gone.
/// - Bound again, as a game does as the screen changes, it is the same stick. A finger
///   holding it keeps holding it.
///
/// Returns false for two actions alike, a region with no area, a radius not above 0, or a
/// fifth stick. It is also refused for the reasons the other bindings are.
///
/// For drawing the stick, the getters take its across action:
/// - is_stick_held: whether a finger holds it.
/// - get_stick_origin: where the finger landed.
/// - get_stick_knob: where its knob is.
/// Positions are in logical pixels, and 0, 0 while no finger holds it.
extern fn wgf_action_bind_touch_stick(
    action_x: const char*,
    action_y: const char*,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    radius: f32
) -> bool;

extern fn wgf_action_is_stick_held(action_x: const char*) -> bool;

extern fn wgf_action_get_stick_origin(action_x: const char*) -> wgf_vec2_t;

extern fn wgf_action_get_stick_knob(action_x: const char*) -> wgf_vec2_t;

/// Removes every binding of `action` and keeps the action, so a remap screen can bind it
/// again.
///
/// Returns false if there is no such action.
extern fn wgf_action_clear(action: const char*) -> bool;

/// Returns the action as it is now: its axis (-1 to 1), its value (0 to 1), and its state.
///
/// Returns 0, 0, and UP for an action that doesn't exist.
extern fn wgf_action_get_axis(action: const char*) -> f32;

extern fn wgf_action_get_value(action: const char*) -> f32;

extern fn wgf_action_get_state(action: const char*) -> wgf_input_state_t;

extern fn wgf_action_is_down(action: const char*) -> bool;

extern fn wgf_action_is_pressed(action: const char*) -> bool;

extern fn wgf_action_is_released(action: const char*) -> bool;

/// Lists the actions, in the order they were made, and each one's bindings as text.
///
/// The text is for a help line or a remap screen, such as "Left / Right", "Space", "Pad south",
/// "Left stick X", "Right trigger", or "Touch". libwgf owns the strings, which are valid until
/// the next call here. Returns "" past the end.
extern fn wgf_action_get_count() -> i32;

extern fn wgf_action_get_name(index: i32) -> const char*;

extern fn wgf_action_get_binding_count(action: const char*) -> i32;

extern fn wgf_action_get_binding_text(action: const char*, index: i32) -> const char*;

// ---- wgf_gamepad.h ----

/// A pad's buttons, named by where they are on an Xbox-style pad, not by their labels.
extern wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_NONE: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_SOUTH: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_EAST: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_WEST: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_NORTH: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_LEFT_BUMPER: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_RIGHT_BUMPER: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_LEFT_TRIGGER: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_RIGHT_TRIGGER: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_BACK: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_START: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_GUIDE: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_LEFT_STICK: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_RIGHT_STICK: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_DPAD_UP: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_DPAD_DOWN: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_DPAD_LEFT: wgf_gamepad_button_t;
extern let WGF_GAMEPAD_BUTTON_DPAD_RIGHT: wgf_gamepad_button_t;

extern wgf_gamepad_stick_t;
extern let WGF_GAMEPAD_STICK_LEFT: wgf_gamepad_stick_t;
extern let WGF_GAMEPAD_STICK_RIGHT: wgf_gamepad_stick_t;

extern wgf_gamepad_trigger_t;
extern let WGF_GAMEPAD_TRIGGER_LEFT: wgf_gamepad_trigger_t;
extern let WGF_GAMEPAD_TRIGGER_RIGHT: wgf_gamepad_trigger_t;

/// Every axis of a pad, each read as one number.
///
/// - A stick's axes read as wgf_gamepad_get_stick gives them: -1 to 1, y down, past the dead
///   zone.
/// - A trigger reads 0 to 1.
///
/// Input actions bind these (wgf_action.h), and an autopilot's `pad axis` lines use their
/// names.
extern wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_LEFT_X: wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_LEFT_Y: wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_RIGHT_X: wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_RIGHT_Y: wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_LEFT_TRIGGER: wgf_gamepad_axis_t;
extern let WGF_GAMEPAD_AXIS_RIGHT_TRIGGER: wgf_gamepad_axis_t;

/// Returns whether pad `pad` (0 to 3) is connected.
extern fn wgf_gamepad_is_connected(pad: i32) -> bool;

/// Returns the platform's name for the pad, such as "Microsoft X-Box 360 pad".
///
/// Returns "" if no pad is there.
extern fn wgf_gamepad_get_name(pad: i32) -> const char*;

/// Returns the state of `button`: UP, PRESSED, DOWN, or RELEASED, as for keys.
///
/// A pad unplugged while a button is held releases that button. Returns UP for a pad or button
/// that isn't one.
extern fn wgf_gamepad_get_button_state(pad: i32, button: wgf_gamepad_button_t) -> wgf_input_state_t;

extern fn wgf_gamepad_is_down(pad: i32, button: wgf_gamepad_button_t) -> bool;

extern fn wgf_gamepad_is_pressed(pad: i32, button: wgf_gamepad_button_t) -> bool;

extern fn wgf_gamepad_is_released(pad: i32, button: wgf_gamepad_button_t) -> bool;

/// Returns the button of `pad` pressed in this frame (in a tick, in that tick).
///
/// When several were pressed, returns the lowest-numbered. Returns WGF_GAMEPAD_BUTTON_NONE if
/// none was, or if `pad` is out of range. A rebinding screen's "press a button" uses it, beside
/// wgf_keyboard_get_last_pressed.
extern fn wgf_gamepad_get_last_pressed(pad: i32) -> wgf_gamepad_button_t;

/// Returns where a stick points, -1 to 1 on each axis, with y down as on the screen.
///
/// Within the dead zone it is (0, 0). Past it, the length is rescaled to reach 1 at the edge, so
/// a stick moves smoothly out of the dead zone in every direction.
extern fn wgf_gamepad_get_stick(pad: i32, stick: wgf_gamepad_stick_t) -> wgf_vec2_t;

/// Returns how far a trigger is pulled, 0 to 1.
extern fn wgf_gamepad_get_trigger(pad: i32, trigger: wgf_gamepad_trigger_t) -> f32;

/// Returns one axis, as get_stick and get_trigger give it. Returns 0 for a pad or axis that
/// isn't one.
extern fn wgf_gamepad_get_axis(pad: i32, axis: wgf_gamepad_axis_t) -> f32;

/// Sets or gets the dead zone: how far from the middle a stick still counts as the middle.
///
/// It is the same for every pad, clamped to 0 to 0.9 (default: 0.15).
extern fn wgf_gamepad_set_deadzone(radius: f32);

extern fn wgf_gamepad_get_deadzone() -> f32;

/// Rumbles a pad's two motors for `seconds`, in place of whatever rumble it was doing.
///
/// - `low` drives the low-frequency motor (the heavy, left one), 0 to 1 (clamped).
/// - `high` drives the high-frequency motor (the light, right one), 0 to 1 (clamped).
/// - `seconds` is clamped to at most 2.
/// - libwgf stops the rumble once the time is up. wgf_gamepad_stop_rumble stops it sooner.
///
/// Each platform rumbles its own way:
/// - Linux: evdev's FF_RUMBLE, where the pad's device could be opened for writing.
/// - Windows: XInput.
/// - Web: the Gamepad API's vibration actuator ("dual-rumble"), or a haptic actuator's pulse,
///   where the browser has one. Firefox has neither.
///
/// Returns false for a pad that isn't connected or can't rumble, or if `seconds` isn't above 0.
/// The first such refusal in a run is warned about.
extern fn wgf_gamepad_rumble(pad: i32, low: f32, high: f32, seconds: f32) -> bool;

/// Stops a pad's rumble. Returns false if it isn't rumbling.
extern fn wgf_gamepad_stop_rumble(pad: i32) -> bool;

/// Returns whether a pad is rumbling.
///
/// It is rumbling from wgf_gamepad_rumble until its time is up, it is stopped, or the pad is
/// unplugged.
extern fn wgf_gamepad_is_rumbling(pad: i32) -> bool;

/// Returns whether a pad is connected and has motors libwgf can reach. Ask before offering a
/// rumble setting.
extern fn wgf_gamepad_can_rumble(pad: i32) -> bool;

/// Adds mappings for pads libwgf doesn't know, in the format of SDL's game controller database.
///
/// `text` holds one mapping a line, such as `GUID,name,a:b0,b:b1,leftx:a0,...,platform:Linux,`.
/// - Buttons, axes (`+a2`, `-a2`, `a2~`), and hats (`h0.4`) use SDL's numbering. A target's
///   halves (`+leftx:b3`) are read too.
/// - A line for another platform and a comment (`#`) are left out.
/// - A target libwgf has no place for (misc1, the paddles, the touchpad) is left out.
/// - A line that isn't a mapping is skipped, with a warning giving its line number.
/// - A GUID given again replaces its mapping.
///
/// From the next frame, a pad whose GUID has a mapping is read through it, in place of libwgf's
/// own reading. So SDL's community database (gamecontrollerdb.txt, read with wgf_fs) maps the
/// pads it knows.
///
/// Returns how many of this call's mappings were kept. Only this platform's mappings are kept.
///
/// Mappings apply on Linux, where pads are read raw. Windows' pads are XInput's, and the web's
/// use the browser's standard mapping, both already in libwgf's order. There a mapping is kept
/// but drives no pad.
extern fn wgf_gamepad_add_mappings(text: const char*) -> i32;

/// Returns pad `pad`'s GUID as SDL writes it, 32 hex digits, for writing a mapping of its own.
///
/// Returns "" if there is no pad, and where the platform makes no GUID (Windows, the web).
extern fn wgf_gamepad_get_guid(pad: i32) -> const char*;

/// Returns whether a mapping drives pad `pad`.
extern fn wgf_gamepad_is_mapped(pad: i32) -> bool;

// ---- wgf_input.h ----

/// The state of a key or button, as read inside a tick or a frame.
extern wgf_input_state_t;
extern let WGF_INPUT_STATE_UP: wgf_input_state_t;
extern let WGF_INPUT_STATE_PRESSED: wgf_input_state_t;
extern let WGF_INPUT_STATE_DOWN: wgf_input_state_t;
extern let WGF_INPUT_STATE_RELEASED: wgf_input_state_t;

/// Returns the characters typed since the previous tick or frame, in order, as one UTF-8
/// string.
///
/// This is what a text field appends. A character can be several bytes.
/// - The characters come after the keyboard layout and any input method: Shift and A give "A".
/// - A held key repeats.
/// - Backspace, Enter, and the arrows type no characters. Read them as keys.
///
/// Returns "" if nothing was typed. Reading doesn't use the characters up: they stay until the
/// next tick or frame.
extern fn wgf_input_get_chars() -> const char*;

/// Sets or gets whether a UI has the pointer or the keyboard, so game controls should leave it
/// alone.
///
/// Game controls are camera drags, selection, and hotkeys. The flags are advisory: input keeps
/// reporting everything, and game code checks these first.
///
/// Each is captured while the game's UI says so, and a setting stays until it is set again.
/// libwgf's UI (wgf_ui.h) sets both from its own hit testing and focus in every frame it is
/// drawn. It lets them go in a frame it isn't drawn.
extern fn wgf_input_set_pointer_captured(captured: bool);

extern fn wgf_input_is_pointer_captured() -> bool;

extern fn wgf_input_set_keyboard_captured(captured: bool);

extern fn wgf_input_is_keyboard_captured() -> bool;

/// Sets or gets the text on the system's clipboard.
///
/// - Text is UTF-8, at most 64 KB.
/// - The string read is valid until the next clipboard call.
/// - On the web, a copy works only in the frame of an input, as browsers allow. A read returns
///   what the page last copied or was pasted.
///
/// wgf_input_set_clipboard returns false for NULL.
extern fn wgf_input_set_clipboard(text: const char*) -> bool;

extern fn wgf_input_get_clipboard() -> const char*;

// ---- wgf_keyboard.h ----

