/// It is an exponential approach, so the result is the same however the frames fall. A `rate`
/// of 0 or less returns `to` at once.
extern wgf_scalar_damp;

/// Returns `from` moved toward `to` by at most `step`, never past it.
extern wgf_scalar_move_toward;

/// Returns the turn from angle `a` to angle `b` the short way round, in radians (-pi..pi).
extern wgf_scalar_angle_delta;

// ---- wgf_spline.h ----

/// A spline: a path through or near a list of points. To draw one, see wgf_draw_spline.
///
/// The points are `points`, x and y in turn, `count` floats in all. A spline is read at `t`,
/// from 0 at its start to 1 at its end. Each of its segments takes an equal share of `t`.
///
/// The kinds, and how many points each needs:
///   LINEAR            straight from each point to the next (2 points or more)
///   BASIS             a cubic B-spline, near its points but through none (4 or more)
///   CATMULL_ROM       through every point but the first and last, which steer its ends (4 or more)
///   BEZIER_QUADRATIC  start, control, end; each next one starts at the last's end (3, 5, 7...)
///   BEZIER_CUBIC      start, control, control, end, and so on in the same way (4, 7, 10...)
extern wgf_spline_kind_t;
extern let WGF_SPLINE_KIND_LINEAR: wgf_spline_kind_t;
extern let WGF_SPLINE_KIND_BASIS: wgf_spline_kind_t;
extern let WGF_SPLINE_KIND_CATMULL_ROM: wgf_spline_kind_t;
extern let WGF_SPLINE_KIND_BEZIER_QUADRATIC: wgf_spline_kind_t;
extern let WGF_SPLINE_KIND_BEZIER_CUBIC: wgf_spline_kind_t;

/// Returns how many segments `count` floats of points make for `kind`.
///
/// Returns 0 if there are too few points, if `count` is odd, or if `kind` isn't a
/// wgf_spline_kind_t value.
extern fn wgf_spline_get_segment_count(kind: wgf_spline_kind_t, points: const f32*, count: i32) -> i32;

/// Returns the point at `t`, which is held to 0..1.
///
/// Returns 0, 0 if the points make no segment.
extern fn wgf_spline_get_point(kind: wgf_spline_kind_t, points: const f32*, count: i32, t: f32) -> wgf_vec2_t;

// ---- wgf_trig.h ----

/// Returns the sine, cosine, or tangent of an angle in radians, with the same bits on every target.
///
/// The results match natively, under Windows, and in a browser. So a simulation started from
/// the same numbers runs the same everywhere. The rotations (wgf_quat.h) and the generated
/// meshes are made with these calls.
///
/// The C library's sinf and cosf don't match. glibc's and Emscripten's (musl's) differ in the
/// last bit for some angles. That is enough for a pile of a thousand physics boxes, each turned
/// as it is made, to come apart within seconds. A binding's own functions (Haxe's Math on hxcpp
/// and on JS) differ in the same way.
///
/// Each result is within an ulp of the C library's, and usually equal to it.
///
/// The results are exact in this way for angles up to about 1.6 million radians. A larger angle
/// is first brought within one turn. Its result is always within -1..1, but it loses accuracy
/// as the angle grows.
///
/// Returns NaN for an infinite or NaN angle, as the C library does. asin and acos also return
/// NaN past -1..1.
extern fn wgf_trig_sin(radians: f32) -> f32;

extern fn wgf_trig_cos(radians: f32) -> f32;

extern fn wgf_trig_tan(radians: f32) -> f32;

/// Returns the cosine (x) and the sine (y) of an angle in radians together.
///
/// Each is what wgf_trig_cos and wgf_trig_sin give, for about the cost of one of them. The
/// result is the point at that angle on a circle of radius 1, which is what a turn needs.
///
/// Returns NaN, NaN for an infinite or NaN angle.
extern fn wgf_trig_cos_sin(radians: f32) -> wgf_vec2_t;

/// Returns the angle of (x, y) from the x axis, in radians (-pi..pi), as atan2f(y, x) does.
extern fn wgf_trig_atan2(y: f32, x: f32) -> f32;

/// Returns the angle, in radians, whose sine (asin, -pi/2..pi/2) or cosine (acos, 0..pi) is `x`.
extern fn wgf_trig_asin(x: f32) -> f32;

extern fn wgf_trig_acos(x: f32) -> f32;

