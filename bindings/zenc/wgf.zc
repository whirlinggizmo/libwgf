/// It scales, then rotates, then moves.
extern wgf_mat4_from_trs;

/// Returns a matrix's translation, scale, or rotation: the pieces wgf_mat4_from_trs makes it of.
///
/// They are exact unless the matrix shears, as an uneven scale over a turn does. Then the
/// nearest rotation is given.
extern wgf_mat4_get_translation;

extern wgf_mat4_get_scale;

extern wgf_mat4_get_rotation;

/// Returns a point moved by the whole transform, or a direction only turned and scaled.
///
/// transform_point divides by w where w isn't 0, so a projection maps the point into clip
/// space. transform_direction ignores the translation.
extern wgf_mat4_transform_point;

extern wgf_mat4_transform_direction;

/// Returns a perspective projection into OpenGL's clip space, where z is -1 at near and 1 at far.
///
/// - `fov_y` is the vertical field of view, in radians.
/// - `aspect` is the width over the height.
/// - `near_z` and `far_z` are how far in front of the camera it sees from and to. Both must
///   be more than 0.
extern wgf_mat4_perspective;

/// Returns an orthographic projection into OpenGL's clip space.
///
/// It projects the box from `left` to `right`, `bottom` to `top`, and `near_z` to `far_z` in
/// front of the camera.
extern wgf_mat4_orthographic;

/// Returns a view matrix: the world as seen from `eye`, looking at `target`.
///
/// The camera's up is as near to `up` as it can be. Returns the identity if `eye` and `target`
/// are the same, or if `up` is along the line between them.
extern wgf_mat4_look_at;

// ---- wgf_quat.h ----

extern wgf_quat_make;

extern wgf_quat_identity;

/// Returns a turn of `radians` about `axis`, right-handed.
///
/// `axis` needn't be unit length. A zero axis gives the identity.
extern wgf_quat_from_axis_angle;

/// Returns a rotation from three angles in radians: about x, then y, then z.
///
/// Each turn is about the fixed axes: roll, then pitch, then yaw. As a product, that is z
/// times y times x.
extern wgf_quat_from_euler;

/// Returns the three angles, in radians, that wgf_quat_from_euler takes for the unit quaternion `q`.
///
/// - x and z are in -pi..pi.
/// - y is in -pi/2..pi/2.
///
/// Where y is +-pi/2 (gimbal lock), x and z share one turn, and x is given as 0.
extern wgf_quat_to_euler;

/// Returns `b`, then `a`: rotating by the result is rotating by `b` and then by `a`.
extern wgf_quat_mul;

extern wgf_quat_dot;

/// Returns the inverse of a unit quaternion.
extern wgf_quat_conjugate;

/// Returns `q` at length 1. A zero quaternion gives the identity.
extern wgf_quat_normalize;

/// Returns `v` rotated by the unit quaternion `q`.
extern wgf_quat_rotate;

/// Returns the rotation from `a` (at `t` = 0) to `b` (at `t` = 1).
///
/// It turns along the shorter arc, at a steady angular speed.
extern wgf_quat_slerp;

/// Returns the rotation that turns the -z axis to `forward`, and +y as near to `up` as it can.
///
/// This is how a camera or a light, which looks down its -z, is aimed. Neither `forward` nor
/// `up` needs unit length. Returns the identity if `forward` is zero, or along `up`.
extern wgf_quat_look_rotation;

/// Returns the shortest turn that takes direction `from` to direction `to`.
///
/// Either may be any length. Returns the identity if either has no length.
extern wgf_quat_from_to;

/// Returns the rotation from `a` to `b` at `t`, blended straight and then normalized.
///
/// It is a cheaper wgf_quat_slerp, for small steps.
extern wgf_quat_nlerp;

// ---- wgf_scalar.h ----

/// Returns `v` held within `lo`..`hi`.
extern wgf_scalar_clamp;

/// Returns the value from `a` to `b` at `t`. `t` isn't clamped.
extern wgf_scalar_lerp;

/// Returns `v` mapped from the range `a`..`b` to the range `c`..`d`, not clamped.
///
/// Returns `c` if `a` and `b` are equal.
extern wgf_scalar_remap;

/// Returns `v` wrapped into `lo`..`hi`. `hi` itself wraps to `lo`.
