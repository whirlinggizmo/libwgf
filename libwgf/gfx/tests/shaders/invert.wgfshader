#version 410

uniform vec4 params[1];
uniform sampler2D wgf_screen_tex_wgf_screen_smp;

layout(location = 0) in vec2 wgf_screen_uv;
layout(location = 0) out vec4 wgf_frag_color;

vec3 wgf_srgb_to_linear(vec3 c)
{
    return mix(c * vec3(0.077399380505084991455078125), pow((max(c, vec3(0.040449999272823333740234375)) + vec3(0.054999999701976776123046875)) * vec3(0.947867333889007568359375), vec3(2.400000095367431640625)), step(vec3(0.040449999272823333740234375), c));
}

vec4 wgf_screen_color_at(vec2 uv)
{
    vec4 _98 = texture(wgf_screen_tex_wgf_screen_smp, uv);
    vec3 param = _98.xyz;
    return vec4(wgf_srgb_to_linear(param), _98.w);
}

vec4 wgf_screen_color()
{
    vec2 param = wgf_screen_uv;
    return wgf_screen_color_at(param);
}

vec3 wgf_linear_to_srgb(inout vec3 c)
{
    c = clamp(c, vec3(0.0), vec3(1.0));
    return mix(c * 12.9200000762939453125, (pow(max(c, vec3(0.003130800090730190277099609375)), vec3(0.4166666567325592041015625)) * 1.05499994754791259765625) - vec3(0.054999999701976776123046875), step(vec3(0.003130800090730190277099609375), c));
}

void wgf_output(vec3 color, float alpha)
{
    vec3 param = color;
    vec3 _124 = wgf_linear_to_srgb(param);
    wgf_frag_color = vec4(_124, alpha);
}

void main()
{
    vec3 param = wgf_screen_color().xyz;
    vec3 _136 = wgf_linear_to_srgb(param);
    vec3 param_1 = mix(_136, vec3(1.0) - _136, vec3(params[0].x));
    vec3 param_2 = wgf_srgb_to_linear(param_1);
    float param_3 = 1.0;
    wgf_output(param_2, param_3);
}


